package goals

import (
	"strconv"

	"github.com/NorthAIProject/north-client/internal/goals/goal"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// GoalForm carries a submitted goal back to the page when something is
// rejected, so nothing the person typed is lost.
type GoalForm struct {
	Title      string
	Motivation string
	Success    string
	Category   string
	TargetDate string

	Errors map[string]string

	// Open keeps the form expanded after a rejection; a collapsed form with an
	// error inside it is an error nobody sees.
	Open bool

	// UpdateError belongs to the progress-note form on the detail page.
	UpdateError string

	MilestoneTitle   string
	MilestoneDate    string
	MilestoneErrors  map[string]string
	MilestoneOpen    bool
	EditingMilestone string
}

func (f GoalForm) fieldError(name string) string { return f.Errors[name] }

func (f GoalForm) milestoneError(name string) string { return f.MilestoneErrors[name] }

// Instruments holds chart configs for the goals index header.
type Instruments struct {
	ActiveCount       int
	AvgProgress       int
	OverdueMilestones int
	CategoryDonut     map[string]any
	HasCategoryDonut  bool
}

func hasProgress(g goal.Goal) bool {
	_, ok := g.Progress()
	return ok
}

func progressPct(g goal.Goal) int {
	pct, _ := g.Progress()
	return pct
}

// FormFor pre-fills the edit form from an existing goal.
func FormFor(g goal.Goal) GoalForm {
	f := GoalForm{
		Title:      g.Title,
		Motivation: g.Motivation,
		Success:    g.Success,
		Category:   g.Category,
	}
	if g.HasDeadline() {
		f.TargetDate = g.TargetDate.Format("2006-01-02")
	}
	return f
}

func categoryLabel(category string) string {
	switch category {
	case goal.CategoryFitness:
		return "Fitness"
	case goal.CategoryHealth:
		return "Health"
	case goal.CategoryWork:
		return "Work"
	case goal.CategoryLearning:
		return "Learning"
	case goal.CategoryPersonal:
		return "Personal"
	default:
		return "Other"
	}
}

func statusLabel(status string) string {
	switch status {
	case goal.StatusAchieved:
		return "Achieved"
	case goal.StatusPaused:
		return "Paused"
	case goal.StatusAbandoned:
		return "Let go"
	default:
		return "Active"
	}
}

templ IndexPage(user users.User, list []goal.Goal, inst Instruments, f GoalForm) {
	@layout.App("Goals", user, layout.BuildNav("/app/goals")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8" x-data={ "{ open: " + boolJS(f.Open) + " }" }>
			<header>
				@ui.MonoLabel("Direction")
				<div class="mt-2 flex items-start justify-between gap-4">
					<div>
						<h1 class="text-2xl font-medium tracking-tight">Goals</h1>
						<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
							What you are working toward. Khepri reads these before every reply.
						</p>
					</div>
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"@click": "open = !open"}}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						New goal
					}
				</div>
			</header>
			@kpiStrip(inst)
			@categoryDonut(inst)
			<div x-show="open" x-cloak>
				@card.Card() {
					@card.Content() {
						<form method="post" action="/app/goals" class="space-y-4 pt-6">
							@ui.CSRFInput()
							@goalFields(f)
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								Add goal
							}
						</form>
					}
				}
			</div>
			if len(list) == 0 {
				@ui.Empty(ui.EmptyProps{
					Eyebrow: "Direction",
					Title:   "Nothing to aim at yet",
					Body:    "The coach works better once it knows what you are aiming at. One goal is enough to start.",
				}) {
					@button.Button(button.Props{
						Class:      "bg-signal text-background hover:bg-signal/90",
						Attributes: templ.Attributes{"@click": "open = true"},
					}) {
						Add a goal
					}
				}
			} else {
				<div class="space-y-3">
					for _, g := range list {
						@goalCard(g)
					}
				</div>
			}
		</div>
		@input.Script()
		@label.Script()
		@textarea.Script()
		@selectbox.Script()
		@progress.Script()
		@ui.ChartScripts()
	}
}

templ kpiStrip(inst Instruments) {
	@ui.KpiStrip() {
		@kpiCell("Active", strconv.Itoa(inst.ActiveCount), "", "")
		@kpiCell("Avg progress", avgProgressKPI(inst), "", "")
		@kpiCell("Overdue milestones", overdueMilestonesKPI(inst), "", "")
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func avgProgressKPI(inst Instruments) string {
	if inst.ActiveCount == 0 {
		return "—"
	}
	return strconv.Itoa(inst.AvgProgress) + "%"
}

func overdueMilestonesKPI(inst Instruments) string {
	if inst.OverdueMilestones == 0 {
		return "None"
	}
	return strconv.Itoa(inst.OverdueMilestones)
}

templ categoryDonut(inst Instruments) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Active by category
			}
		}
		@card.Content() {
			if inst.HasCategoryDonut && len(inst.CategoryDonut) > 0 {
				@templ.JSONScript("goals-category-donut-option", inst.CategoryDonut)
				@ui.EChartsMount("goals-category-donut", "goals-category-donut-option", "min-h-48 w-full max-w-sm mx-auto")
			} else {
				<p class="text-muted-foreground text-sm">No active goals yet.</p>
			}
		}
	}
}

templ goalCard(g goal.Goal) {
	<a href={ templ.SafeURL("/app/goals/" + g.ID.String()) } class="block">
		@card.Card(card.Props{Class: "hover:border-muted-foreground/30 transition-colors"}) {
			@card.Content() {
				<div class="pt-6">
					<div class="flex items-start justify-between gap-3">
						<h2 class={ "font-medium", templ.KV("text-muted-foreground line-through", !g.IsActive()) }>
							{ g.Title }
						</h2>
						@statusBadge(g)
					</div>
					if g.Motivation != "" {
						<p class="text-muted-foreground mt-1 text-sm">{ g.Motivation }</p>
					}
					<div class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
						<span>{ categoryLabel(g.Category) }</span>
						<span>·</span>
						<span class={ templ.KV("text-destructive", g.Overdue()) }>{ g.Deadline() }</span>
						if hasProgress(g) {
							<span>·</span>
							<span>{ g.ProgressLabel() }</span>
						}
						if g.LatestUpdate != nil {
							<span>·</span>
							<span>Last note { g.LatestUpdate.CreatedAt.Format("2 Jan") }</span>
						}
					</div>
					if hasProgress(g) {
						<div class="mt-3">
							@progress.Progress(progress.Props{Value: progressPct(g), Max: 100, Size: progress.SizeSm})
						</div>
					}
				</div>
			}
		}
	</a>
}

templ statusBadge(g goal.Goal) {
	if g.Status == goal.StatusAchieved {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			Achieved
		}
	} else if g.Overdue() {
		@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
			Overdue
		}
	} else if !g.IsActive() {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			{ statusLabel(g.Status) }
		}
	}
}

templ DetailPage(user users.User, g goal.Goal, updates []goal.Update, f GoalForm) {
	@layout.App(g.Title, user, layout.BuildNav("/app/goals")) {
		<div class="mx-auto w-full max-w-3xl p-6 md:p-8" x-data={ "{ editing: " + boolJS(f.Open) + " }" }>
			<a href="/app/goals" class="text-muted-foreground hover:text-foreground mb-4 inline-flex items-center gap-1 text-sm">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				All goals
			</a>
			<header class="mb-6">
				<div class="flex items-start justify-between gap-4">
					<h1 class="text-2xl font-semibold tracking-tight">{ g.Title }</h1>
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"@click": "editing = !editing"},
					}) {
						Edit
					}
				</div>
				<div class="text-muted-foreground mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
					<span>{ categoryLabel(g.Category) }</span>
					<span>·</span>
					<span class={ templ.KV("text-destructive", g.Overdue()) }>{ g.Deadline() }</span>
					<span>·</span>
					<span>{ statusLabel(g.Status) }</span>
					if hasProgress(g) {
						<span>·</span>
						<span>{ g.ProgressLabel() }</span>
					}
				</div>
			</header>
			<div x-show="editing" x-cloak class="mb-6">
				@card.Card() {
					@card.Content() {
						<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String()) } class="space-y-4 pt-6">
							@ui.CSRFInput()
							@goalFields(f)
							<div class="flex gap-2">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									Save
								}
								@button.Button(button.Props{
									Variant:    button.VariantGhost,
									Attributes: templ.Attributes{"@click.prevent": "editing = false"},
								}) {
									Cancel
								}
							</div>
						</form>
					}
				}
			</div>
			if !f.Open {
				@goalDetails(g)
			}
			@statusActions(g)
			@milestonesCard(g, f)
			@progressForm(g, f.UpdateError)
			if len(updates) > 0 {
				<h2 class="mt-8 mb-3 text-sm font-medium">Progress</h2>
				<div class="space-y-3">
					for _, u := range updates {
						@updateCard(u)
					}
				</div>
			}
			@dangerZone(g)
		</div>
		@input.Script()
		@label.Script()
		@textarea.Script()
		@selectbox.Script()
		@progress.Script()
	}
}

templ goalDetails(g goal.Goal) {
	if g.Motivation != "" || g.Success != "" {
		@card.Card(card.Props{Class: "mb-6"}) {
			@card.Content() {
				<dl class="space-y-4 pt-6 text-sm">
					if g.Motivation != "" {
						<div>
							<dt class="text-muted-foreground text-xs uppercase tracking-wide">Why it matters</dt>
							<dd class="mt-1">{ g.Motivation }</dd>
						</div>
					}
					if g.Success != "" {
						<div>
							<dt class="text-muted-foreground text-xs uppercase tracking-wide">Done when</dt>
							<dd class="mt-1">{ g.Success }</dd>
						</div>
					}
				</dl>
			}
		}
	}
}

// statusActions offers only the transitions that make sense from here, rather
// than a dropdown containing the state the goal is already in.
templ statusActions(g goal.Goal) {
	<div class="mb-6 flex flex-wrap gap-2">
		if g.IsActive() {
			@statusButton(g, goal.StatusAchieved, "Mark achieved", button.VariantDefault)
			@statusButton(g, goal.StatusPaused, "Pause", button.VariantOutline)
			@statusButton(g, goal.StatusAbandoned, "Let this one go", button.VariantGhost)
		} else {
			@statusButton(g, goal.StatusActive, "Make active again", button.VariantOutline)
		}
	</div>
}

templ statusButton(g goal.Goal, status, labelText string, variant button.Variant) {
	<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/status") }>
		@ui.CSRFInput()
		<input type="hidden" name="status" value={ status }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: variant}) {
			{ labelText }
		}
	</form>
}

templ milestonesCard(g goal.Goal, f GoalForm) {
	@card.Card(card.Props{Class: "mb-6"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-base"}) {
				Milestones
			}
			@card.Description() {
				if len(g.Milestones) == 0 {
					The steps that make this goal feel alive. Optional, but the coach can see them.
				} else {
					{ g.ProgressLabel() } complete.
				}
			}
		}
		@card.Content() {
			if hasProgress(g) && g.MilestoneTotal > 0 {
				<div class="mb-4">
					@progress.Progress(progress.Props{Value: progressPct(g), Max: 100, Size: progress.SizeSm, ShowValue: true})
				</div>
			}
			if len(g.Milestones) > 0 {
				<ul class="mb-4 space-y-2">
					for _, m := range g.Milestones {
						@milestoneRow(g, m, f)
					}
				</ul>
			}
			@addMilestoneForm(g, f)
		}
	}
}

templ milestoneRow(g goal.Goal, m goal.Milestone, f GoalForm) {
	<li
		class="border-border rounded-lg border p-3"
		x-data={ "{ editing: " + boolJS(f.EditingMilestone == m.ID.String()) + " }" }
	>
		<div x-show="!editing" class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class={ "text-sm font-medium", templ.KV("text-muted-foreground line-through", m.IsComplete()) }>
					{ m.Title }
				</p>
				if m.HasDeadline() {
					<p class="text-muted-foreground mt-0.5 text-xs">{ m.TargetDate.Format("2 Jan 2006") }</p>
				}
			</div>
			<div class="flex shrink-0 flex-wrap items-center justify-end gap-1">
				if m.IsComplete() {
					@milestoneStatusButton(g, m, goal.MilestoneOpen, "Reopen", button.VariantGhost)
				} else {
					@milestoneStatusButton(g, m, goal.MilestoneCompleted, "Complete", button.VariantOutline)
				}
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"@click": "editing = true", "type": "button"},
				}) {
					Edit
				}
				@milestoneDeleteButton(g, m)
			</div>
		</div>
		<div x-show="editing" x-cloak>
			@editMilestoneForm(g, m, f)
		</div>
	</li>
}

templ milestoneStatusButton(g goal.Goal, m goal.Milestone, status, labelText string, variant button.Variant) {
	<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/milestones/" + m.ID.String() + "/status") }>
		@ui.CSRFInput()
		<input type="hidden" name="status" value={ status }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: variant}) {
			{ labelText }
		}
	</form>
}

templ milestoneDeleteButton(g goal.Goal, m goal.Milestone) {
	<form
		method="post"
		action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/milestones/" + m.ID.String() + "/delete") }
		@submit="if (!confirm('Remove this milestone?')) $event.preventDefault()"
	>
		@ui.CSRFInput()
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantGhost}) {
			Remove
		}
	</form>
}

templ editMilestoneForm(g goal.Goal, m goal.Milestone, f GoalForm) {
	<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/milestones/" + m.ID.String()) } class="space-y-3">
		@ui.CSRFInput()
		@field("milestone_title", "Milestone", f.milestoneError("title")) {
			@input.Input(input.Props{
				ID:       "milestone_title_" + m.ID.String(),
				Name:     "milestone_title",
				Value:    milestoneEditTitle(m, f),
				Required: true,
				HasError: f.EditingMilestone == m.ID.String() && f.milestoneError("title") != "",
			})
		}
		@field("milestone_date", "Target date", "") {
			@input.Input(input.Props{
				ID:    "milestone_date_" + m.ID.String(),
				Name:  "milestone_date",
				Type:  input.TypeDate,
				Value: milestoneEditDate(m, f),
			})
		}
		<div class="flex gap-2">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				Save
			}
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"@click.prevent": "editing = false"},
			}) {
				Cancel
			}
		</div>
	</form>
}

templ addMilestoneForm(g goal.Goal, f GoalForm) {
	<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/milestones") } class="space-y-3">
		@ui.CSRFInput()
		<div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
			@field("milestone_title", "Add a milestone", f.milestoneError("title")) {
				@input.Input(input.Props{
					ID:          "milestone_title",
					Name:        "milestone_title",
					Value:       addMilestoneTitle(f),
					Placeholder: "Run 5k without stopping",
					HasError:    f.EditingMilestone == "" && f.milestoneError("title") != "",
				})
			}
			<div class="w-full sm:w-40">
				@field("milestone_date", "Target date", "") {
					@input.Input(input.Props{
						ID:    "milestone_date",
						Name:  "milestone_date",
						Type:  input.TypeDate,
						Value: addMilestoneDate(f),
					})
				}
			</div>
		</div>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
			Add milestone
		}
	</form>
}

func milestoneEditTitle(m goal.Milestone, f GoalForm) string {
	if f.EditingMilestone == m.ID.String() && f.MilestoneTitle != "" {
		return f.MilestoneTitle
	}
	return m.Title
}

func milestoneEditDate(m goal.Milestone, f GoalForm) string {
	if f.EditingMilestone == m.ID.String() && f.MilestoneDate != "" {
		return f.MilestoneDate
	}
	if m.HasDeadline() {
		return m.TargetDate.Format("2006-01-02")
	}
	return ""
}

func addMilestoneTitle(f GoalForm) string {
	if f.EditingMilestone != "" {
		return ""
	}
	return f.MilestoneTitle
}

func addMilestoneDate(f GoalForm) string {
	if f.EditingMilestone != "" {
		return ""
	}
	return f.MilestoneDate
}

templ progressForm(g goal.Goal, errMsg string) {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-base"}) {
				How is it going?
			}
			@card.Description() {
				Khepri reads your most recent note, so this is how the coach stays current.
			}
		}
		@card.Content() {
			<form method="post" action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/updates") } class="space-y-3">
				@ui.CSRFInput()
				@textarea.Textarea(textarea.Props{
					ID:          "note",
					Name:        "note",
					Placeholder: "Ran 5k three times this week without stopping.",
					Rows:        2,
					HasError:    errMsg != "",
				})
				if errMsg != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ errMsg }
					}
				}
				<div class="flex items-end gap-3">
					<div class="w-32">
						@label.Label(label.Props{For: "progress", Class: "text-xs"}) {
							Progress %
						}
						@input.Input(input.Props{
							ID:          "progress",
							Name:        "progress",
							Type:        input.TypeNumber,
							Placeholder: "optional",
							Attributes:  templ.Attributes{"min": "0", "max": "100"},
						})
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Add note
					}
				</div>
			</form>
		}
	}
}

templ updateCard(u goal.Update) {
	<div class="border-border rounded-lg border p-4">
		<div class="text-muted-foreground mb-1 flex items-center gap-2 text-xs">
			<span>{ u.CreatedAt.Format("2 January 2006, 15:04") }</span>
			if u.Progress != nil {
				<span>·</span>
				<span>{ strconv.Itoa(*u.Progress) }%</span>
			}
		</div>
		<p class="text-sm whitespace-pre-wrap">{ u.Note }</p>
	</div>
}

templ dangerZone(g goal.Goal) {
	<div class="border-border mt-10 border-t pt-6">
		<form
			method="post"
			action={ templ.SafeURL("/app/goals/" + g.ID.String() + "/delete") }
			@submit="if (!confirm('Delete this goal, its milestones, and every note on it? This cannot be undone.')) $event.preventDefault()"
		>
			@ui.CSRFInput()
			<button type="submit" class="text-muted-foreground hover:text-destructive text-sm transition-colors">
				Delete this goal
			</button>
		</form>
	</div>
}

// goalFields is shared by create and edit, so the two cannot drift apart.
templ goalFields(f GoalForm) {
	@field("title", "What is the goal?", f.fieldError("title")) {
		@input.Input(input.Props{
			ID:          "title",
			Name:        "title",
			Value:       f.Title,
			Placeholder: "Run 10k without stopping",
			Required:    true,
			HasError:    f.fieldError("title") != "",
		})
	}
	@field("motivation", "Why does it matter?", f.fieldError("motivation")) {
		@textarea.Textarea(textarea.Props{
			ID:          "motivation",
			Name:        "motivation",
			Value:       f.Motivation,
			Placeholder: "I want to stop feeling out of breath on the stairs.",
			Rows:        2,
			HasError:    f.fieldError("motivation") != "",
		})
	}
	@field("success", "How will you know it happened?", f.fieldError("success")) {
		@textarea.Textarea(textarea.Props{
			ID:          "success",
			Name:        "success",
			Value:       f.Success,
			Placeholder: "I run 10k, at any pace, without walking.",
			Rows:        2,
			HasError:    f.fieldError("success") != "",
		})
	}
	<div class="grid gap-4 sm:grid-cols-2">
		@field("category", "Category", f.fieldError("category")) {
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{ID: "category", Name: "category"}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose one"})
				}
				@selectbox.Content() {
					for _, c := range goal.Categories {
						@selectbox.Item(selectbox.ItemProps{Value: c, Selected: f.Category == c}) {
							{ categoryLabel(c) }
						}
					}
				}
			}
		}
		@field("target_date", "Target date", f.fieldError("target_date")) {
			@input.Input(input.Props{
				ID:       "target_date",
				Name:     "target_date",
				Type:     input.TypeDate,
				Value:    f.TargetDate,
				HasError: f.fieldError("target_date") != "",
			})
			if f.fieldError("target_date") == "" {
				@form.Description() {
					Optional. Plenty of goals do not have one.
				}
			}
		}
	</div>
}

templ field(name, labelText, errMsg string) {
	@form.Item() {
		@label.Label(label.Props{For: name, Error: errMsg}) {
			{ labelText }
		}
		{ children... }
		if errMsg != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ errMsg }
			}
		}
	}
}

// boolJS renders a Go bool as a JavaScript literal for an Alpine x-data.
func boolJS(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
