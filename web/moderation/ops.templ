package moderation

// The operator queue is an internal tool for the people named in
// OPERATOR_USER_IDS, so its copy is English and not in the catalogues.

import (
	"fmt"
	"sort"
	"time"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/table"
)

// Group is one reported subject in the queue. internal/moderation fills it;
// it lives here so the page does not import the slice that renders it.
type Group struct {
	Kind      string
	SubjectID uuid.UUID
	AuthorID  *uuid.UUID
	Reasons   map[string]int
	Hidden    bool
	Excerpt   string
	FirstAt   time.Time
}

templ OpsPage(user users.User, groups []Group) {
	@layout.App("Moderation", user, layout.BuildNav(ctx, "/app/ops/moderation")) {
		<div class="mx-auto max-w-5xl space-y-4 p-4 sm:p-6">
			<h1 class="text-2xl font-semibold">Reports</h1>
			<p class="text-sm text-muted-foreground">Open reports, oldest first. Aim to decide each within 24 hours.</p>
			if len(groups) == 0 {
				<p class="text-sm">Nothing to review.</p>
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								What
							}
							@table.Head() {
								Reasons
							}
							@table.Head() {
								Since
							}
							@table.Head() {
								Decide
							}
						}
					}
					@table.Body() {
						for _, g := range groups {
							@table.Row() {
								@table.Cell() {
									<div class="max-w-md whitespace-pre-wrap break-words text-sm">{ g.Excerpt }</div>
									<div class="mt-1 flex gap-2 text-xs text-muted-foreground">
										<span>{ g.Kind }</span>
										if g.Hidden {
											@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
												hidden
											}
										}
									</div>
								}
								@table.Cell() {
									<span class="text-sm">{ reasons(g) }</span>
								}
								@table.Cell() {
									<span class="text-sm">{ g.FirstAt.Format("2 Jan 15:04") }</span>
								}
								@table.Cell() {
									<div class="flex flex-wrap gap-2">
										for _, action := range actions(g) {
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/app/ops/moderation/%s/%s/%s", g.Kind, g.SubjectID, action)) }>
												@ui.CSRFInput()
												@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: variant(action)}) {
													{ action }
												}
											</form>
										}
										if g.AuthorID != nil {
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/app/ops/moderation/users/%s/suspend", *g.AuthorID)) }>
												@ui.CSRFInput()
												<input type="hidden" name="hours" value="0"/>
												@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantDestructive}) {
													suspend author
												}
											</form>
										}
									</div>
								}
							}
						}
					}
				}
			}
		</div>
	}
}

func actions(g Group) []string {
	if g.Hidden {
		return []string{"unhide", "hide"}
	}
	return []string{"hide", "dismiss"}
}

func variant(action string) button.Variant {
	if action == "hide" {
		return button.VariantDefault
	}
	return button.VariantOutline
}

func reasons(g Group) string {
	keys := make([]string, 0, len(g.Reasons))
	for k := range g.Reasons {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	out := ""
	for i, k := range keys {
		if i > 0 {
			out += ", "
		}
		out += fmt.Sprintf("%s ×%d", k, g.Reasons[k])
	}
	return out
}
