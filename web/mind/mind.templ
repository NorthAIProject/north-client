package mind

import (
	"context"
	"fmt"

	"github.com/NorthAIProject/north-client/internal/mind/journal"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/dictate"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// Instruments holds chart configs for the mind page header.
type Instruments struct {
	MoodChart    chart.Props
	HasData      bool
	AvgMood      float64
	AvgEnergy    float64
	CheckInCount int
}

// JournalForm carries a submitted (or rejected) journal entry.
type JournalForm struct {
	Content string
	Mood    *int
	Errors  map[string]string
}

func (f JournalForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

func (f JournalForm) moodSelected(n int) bool { return f.Mood != nil && *f.Mood == n }

templ IndexPage(user users.User, entries []journal.Entry, inst Instruments, f JournalForm) {
	@layout.App(i18n.T(ctx, "mind.title"), user, layout.BuildNav(ctx, "/app/mind")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "mind.title"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "mind.heading") }</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					{ i18n.T(ctx, "mind.intro") }
				</p>
			</header>
			@kpiStrip(inst)
			@moodChart(inst)
			@journalFormCard(f)
			if len(entries) > 0 {
				<section class="space-y-3">
					<h2 class="text-sm font-medium">{ i18n.T(ctx, "mind.journal") }</h2>
					for _, e := range entries {
						@entryCard(e)
					}
				</section>
			}
		</div>
		@label.Script()
		@selectbox.Script()
		@ui.ChartScripts()
		@dictate.Script()
	}
}

templ kpiStrip(inst Instruments) {
	@ui.KpiStrip() {
		@kpiCell(i18n.T(ctx, "mind.kpi.mood"), avgMoodKPI(inst), "/app/check-ins", i18n.T(ctx, "mind.check_in"))
		@kpiCell(i18n.T(ctx, "mind.kpi.energy"), avgEnergyKPI(inst), "/app/check-ins", i18n.T(ctx, "mind.check_in"))
		@kpiCell(i18n.T(ctx, "mind.kpi.checkins"), checkInCountKPI(ctx, inst), "/app/check-ins", i18n.T(ctx, "mind.view"))
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func avgMoodKPI(inst Instruments) string {
	if inst.CheckInCount <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.1f/5", inst.AvgMood)
}

func avgEnergyKPI(inst Instruments) string {
	if inst.CheckInCount <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.1f/5", inst.AvgEnergy)
}

func checkInCountKPI(ctx context.Context, inst Instruments) string {
	if inst.CheckInCount <= 0 {
		return "—"
	}
	return i18n.Tf(ctx, "mind.kpi.checkins.value", inst.CheckInCount)
}

templ moodChart(inst Instruments) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "mind.chart.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "mind.chart.desc") }
			}
		}
		@card.Content() {
			if inst.HasData {
				@chart.Chart(inst.MoodChart)
			} else {
				<p class="text-muted-foreground mb-4 text-sm">{ i18n.T(ctx, "mind.chart.empty") }</p>
				@button.Button(button.Props{Href: "/app/check-ins", Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "mind.check_in") }
				}
			}
		}
	}
}

templ journalFormCard(f JournalForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "mind.form.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "mind.form.desc") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/mind/journal" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label(label.Props{For: "content"}) {
						{ i18n.T(ctx, "mind.form.reflection") }
					}
					// Value, not children: the component renders p.Value and has no
					// children block, so a reflection handed to it that way was
					// dropped and the writer lost it on every rejected submission.
					@dictate.Field(dictate.Props{Target: "content"}) {
						@textarea.Textarea(textarea.Props{
							ID:          "content",
							Name:        "content",
							Rows:        4,
							Placeholder: i18n.T(ctx, "mind.form.ph"),
							Value:       f.Content,
							HasError:    f.fieldError("content") != "",
						})
					}
					if f.fieldError("content") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("content") }
						}
					}
				}
				@form.Item() {
					@label.Label() {
						{ i18n.T(ctx, "mind.form.mood") }
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "mood", Name: "mood"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mind.form.no_rating")})
						}
						@selectbox.Content() {
							@selectbox.Item(selectbox.ItemProps{Value: "", Selected: f.Mood == nil}) {
								{ i18n.T(ctx, "mind.form.no_rating") }
							}
							for i := 1; i <= 5; i++ {
								@selectbox.Item(selectbox.ItemProps{Value: fmt.Sprintf("%d", i), Selected: f.moodSelected(i)}) {
									{ fmt.Sprintf("%d/5", i) }
								}
							}
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "mind.form.save") }
				}
			</form>
		}
	}
}

templ entryCard(e journal.Entry) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "py-4"}) {
			<p class="text-muted-foreground text-xs">
				{ i18n.Date(ctx, e.CreatedAt, "2 Jan 2006") }
				if e.Mood != nil {
					{ " " + i18n.Tf(ctx, "mind.entry.mood", *e.Mood) }
				}
			</p>
			<p class="mt-1 text-sm">{ e.Content }</p>
		}
	}
}
