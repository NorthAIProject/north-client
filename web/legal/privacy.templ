package legal

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/layout"
)

// Privacy is the privacy policy. Every paragraph is one catalogue key under
// legal.privacy; see prose for why the markup lives in the catalogue.
templ Privacy() {
	@layout.Public(i18n.T(ctx, "legal.privacy.page"), signedIn(ctx)) {
		@document(i18n.T(ctx, "legal.privacy.title")) {
			<p class="lead">
				@prose(ctx, "legal.privacy.lead")
			</p>
			<p>
				@prose(ctx, "legal.privacy.controller", OperatorName, OperatorAddress, ContactEmail)
			</p>
			@section(i18n.T(ctx, "legal.privacy.stored.h")) {
				<p>
					@prose(ctx, "legal.privacy.stored.p")
				</p>
				<ul>
					<li>
						@prose(ctx, "legal.privacy.stored.account")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.health")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.activity")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.nutrition")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.writing")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.memory")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.documents")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.integrations")
					</li>
					<li>
						@prose(ctx, "legal.privacy.stored.operational")
					</li>
				</ul>
			}
			@section(i18n.T(ctx, "legal.privacy.consent.h")) {
				<p>
					@prose(ctx, "legal.privacy.consent.p1")
				</p>
				<p>
					@prose(ctx, "legal.privacy.consent.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.privacy.where.h")) {
				<p>
					@prose(ctx, "legal.privacy.where.p")
				</p>
				<ul>
					<li>
						@prose(ctx, "legal.privacy.where.ai")
					</li>
					<li>
						@prose(ctx, "legal.privacy.where.strava")
					</li>
					<li>
						@prose(ctx, "legal.privacy.where.telegram")
					</li>
					<li>
						@prose(ctx, "legal.privacy.where.analytics.events")
						<br/>
						@prose(ctx, "legal.privacy.where.analytics.pages")
						<br/>
						@prose(ctx, "legal.privacy.where.analytics.sessions")
					</li>
					<li>
						@prose(ctx, "legal.privacy.where.hosting")
					</li>
				</ul>
			}
			@section(i18n.T(ctx, "legal.privacy.kept.h")) {
				<p>
					@prose(ctx, "legal.privacy.kept.p1")
				</p>
				<p>
					@prose(ctx, "legal.privacy.kept.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.privacy.rights.h")) {
				<p>
					@prose(ctx, "legal.privacy.rights.p")
				</p>
				<ul>
					<li>
						@prose(ctx, "legal.privacy.rights.export")
					</li>
					<li>
						@prose(ctx, "legal.privacy.rights.delete")
					</li>
				</ul>
				<p>
					@prose(ctx, "legal.privacy.rights.other", ContactEmail)
				</p>
			}
			@section(i18n.T(ctx, "legal.privacy.security.h")) {
				<p>
					@prose(ctx, "legal.privacy.security.p1")
				</p>
				<p>
					@prose(ctx, "legal.privacy.security.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.privacy.changes.h")) {
				<p>
					@prose(ctx, "legal.privacy.changes.p")
				</p>
			}
		}
	}
}
