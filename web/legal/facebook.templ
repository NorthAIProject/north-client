package legal

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/layout"
)

// FacebookDataDeletion is the page Meta asks every app using Facebook Login to
// link as its "Data Deletion Instructions URL". It says what Khepri keeps from
// Facebook and how to remove it, without needing an account to read it.
templ FacebookDataDeletion() {
	@layout.Public(i18n.T(ctx, "legal.fb.page"), signedIn(ctx)) {
		@document(i18n.T(ctx, "legal.fb.title")) {
			<p class="lead">
				@prose(ctx, "legal.fb.lead")
			</p>
			@section(i18n.T(ctx, "legal.fb.keeps.h")) {
				<p>
					@prose(ctx, "legal.fb.keeps.p1")
				</p>
				<p>
					@prose(ctx, "legal.fb.keeps.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.fb.delete.h")) {
				<ol>
					<li>
						@prose(ctx, "legal.fb.delete.disconnect")
					</li>
					<li>
						@prose(ctx, "legal.fb.delete.account")
					</li>
					<li>
						@prose(ctx, "legal.fb.delete.facebook")
					</li>
				</ol>
				<p>
					@prose(ctx, "legal.fb.delete.email", ContactEmail)
				</p>
			}
		}
	}
}
