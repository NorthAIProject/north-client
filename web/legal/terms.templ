package legal

import "github.com/NorthAIProject/north-client/web/shared/layout"

templ Terms() {
	@layout.Public("Terms", signedIn(ctx)) {
		@document("Terms of service") {
			<p class="lead">
				The agreement between you and { OperatorName }, covering your use
				of Khepri. Plain terms, and one section that matters more than
				the rest: Khepri is not a doctor.
			</p>
			@section("Not medical advice") {
				<p>
					Khepri is a personal coaching and journalling tool. It is not a
					medical device, and nothing it produces — training plans,
					calorie targets, observations about your sleep, or anything the
					coach says — is medical, nutritional or psychological advice.
				</p>
				<p>
					Its answers are generated by language models. They can be
					confidently wrong, and they can be wrong about you
					specifically. Do not use Khepri to diagnose or treat anything,
					do not stop or start a treatment because of something it said,
					and speak to a qualified professional before making a
					meaningful change to how you eat, train or medicate.
				</p>
				<p>
					<strong>If you are in crisis or may be in danger, contact your
					local emergency services or a crisis line. Khepri is not
					monitored by a human and cannot help you.</strong>
				</p>
			}
			@section("Your account") {
				<p>
					You must be at least 16, provide accurate details, keep your
					credentials to yourself, and remain responsible for what
					happens under your account. One account is for one person.
				</p>
			}
			@section("Acceptable use") {
				<p>Do not:</p>
				<ul>
					<li>upload anything you do not have the right to upload;</li>
					<li>upload another person's health data without their consent;</li>
					<li>attempt to reach another account's data, or to break, overload or probe the service;</li>
					<li>resell the service, or use it to build a competing dataset;</li>
					<li>use it for anything illegal.</li>
				</ul>
				<p>
					Accounts that do these things can be suspended without notice.
				</p>
			}
			@section("Your content stays yours") {
				<p>
					You keep every right you have in what you write and upload. You
					grant { OperatorName } only the permission needed to run the
					service for you: to store your content, process it, send the
					relevant parts to the AI provider serving your account, and
					show it back to you.
				</p>
				<p>
					Your content is not used to train models. Note that the AI
					provider receiving it has its own terms, and if you supply your
					own API key those terms are between you and that provider.
				</p>
			}
			@section("Availability, and what you should assume") {
				<p>
					Khepri is early software offered as it is, without warranty of
					any kind. There is no uptime commitment. Features may change or
					be removed. It may lose data.
				</p>
				<p>
					<strong>Keep your own copy of anything you cannot afford to
					lose.</strong> Settings → Export produces a complete archive at
					any time, and using it periodically is the sensible assumption
					to operate under.
				</p>
			}
			@section("Paid plans") {
				<p>
					Khepri is currently free to use. If paid plans are introduced,
					the terms, prices and any effect on existing accounts will be
					published before they apply, and you will not be charged
					without agreeing first.
				</p>
			}
			@section("Ending it") {
				<p>
					You may delete your account at any time from Settings, which
					removes your data as described in the
					<a href="/privacy">privacy policy</a>.
					{ OperatorName } may suspend or close an account that breaches
					these terms, or discontinue the service with reasonable notice
					and an opportunity to export.
				</p>
			}
			@section("Liability") {
				<p>
					To the fullest extent the law allows, { OperatorName } is not
					liable for indirect or consequential loss, lost data, or lost
					profits, and total liability for any claim is limited to the
					greater of the amount you paid in the preceding twelve months
					or £50.
				</p>
				<p>
					Nothing here limits liability for death or personal injury
					caused by negligence, for fraud, or for anything else that
					cannot lawfully be limited. If you are a consumer, your
					statutory rights are unaffected.
				</p>
			}
			@section("Governing law") {
				<p>
					These terms are governed by the laws of { Jurisdiction }, whose
					courts have exclusive jurisdiction — without depriving a
					consumer of the protection of their home country's mandatory
					law.
				</p>
			}
			@section("Contact") {
				<p>
					<a href={ templ.SafeURL("mailto:" + ContactEmail) }>{ ContactEmail }</a>
				</p>
			}
		}
	}
}
