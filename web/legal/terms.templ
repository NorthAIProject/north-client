package legal

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/layout"
)

// Terms is the terms of service. Every paragraph is one catalogue key under
// legal.terms; see prose for why the markup lives in the catalogue.
templ Terms() {
	@layout.Public(i18n.T(ctx, "legal.terms.page"), signedIn(ctx)) {
		@document(i18n.T(ctx, "legal.terms.title")) {
			<p class="lead">
				@prose(ctx, "legal.terms.lead", OperatorName)
			</p>
			@section(i18n.T(ctx, "legal.terms.medical.h")) {
				<p>
					@prose(ctx, "legal.terms.medical.p1")
				</p>
				<p>
					@prose(ctx, "legal.terms.medical.p2")
				</p>
				<p>
					@prose(ctx, "legal.terms.medical.crisis")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.account.h")) {
				<p>
					@prose(ctx, "legal.terms.account.p")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.use.h")) {
				<p>
					@prose(ctx, "legal.terms.use.intro")
				</p>
				<ul>
					<li>
						@prose(ctx, "legal.terms.use.rights")
					</li>
					<li>
						@prose(ctx, "legal.terms.use.others")
					</li>
					<li>
						@prose(ctx, "legal.terms.use.probe")
					</li>
					<li>
						@prose(ctx, "legal.terms.use.resell")
					</li>
					<li>
						@prose(ctx, "legal.terms.use.illegal")
					</li>
				</ul>
				<p>
					@prose(ctx, "legal.terms.use.suspend")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.content.h")) {
				<p>
					@prose(ctx, "legal.terms.content.p1", OperatorName)
				</p>
				<p>
					@prose(ctx, "legal.terms.content.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.avail.h")) {
				<p>
					@prose(ctx, "legal.terms.avail.p1")
				</p>
				<p>
					@prose(ctx, "legal.terms.avail.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.paid.h")) {
				<p>
					@prose(ctx, "legal.terms.paid.p")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.ending.h")) {
				<p>
					@prose(ctx, "legal.terms.ending.p", OperatorName)
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.liability.h")) {
				<p>
					@prose(ctx, "legal.terms.liability.p1", OperatorName)
				</p>
				<p>
					@prose(ctx, "legal.terms.liability.p2")
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.law.h")) {
				<p>
					@prose(ctx, "legal.terms.law.p", Jurisdiction)
				</p>
			}
			@section(i18n.T(ctx, "legal.terms.contact.h")) {
				<p>
					<a href={ templ.SafeURL("mailto:" + ContactEmail) }>{ ContactEmail }</a>
				</p>
			}
		}
	}
}
