package checkins

import (
	"context"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/checkins/checkin"
	"github.com/NorthAIProject/north-client/internal/goals/goal"
	"github.com/NorthAIProject/north-client/internal/moments"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/live"
	"github.com/NorthAIProject/north-client/web/shared/moment"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/dictate"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/skeleton"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// PanelID is the element the guided form swaps itself into. The handler and the
// template both need it, and a typo in either would silently append a second
// copy of the form to the page instead of replacing the first.
const PanelID = "checkin-panel"

// LiveID is the self-refreshing part of the page: history, KPIs and charts.
// It re-fetches itself when a check-in is saved in this tab and every 20s to
// catch saves from other tabs and devices.
const LiveID = "checkins-live"

// LiveData is what the self-refreshing region shows.
type LiveData struct {
	List        []checkin.CheckIn
	Streak      int
	Instruments Instruments
	// Version fingerprints the check-ins this was drawn from; the region
	// sends it back so an unchanged poll costs a 204.
	Version string
	// Loc is the person's zone, for the times on each entry.
	Loc *time.Location
}

// LiveURL is where the region re-fetches itself.
func LiveURL(version string) string {
	return "/app/check-ins/live?v=" + url.QueryEscape(version)
}

// Instruments holds chart configs for the check-ins page header.
type Instruments struct {
	MoodChart    chart.Props
	Heatmap      map[string]any
	HasData      bool
	AvgMood      float64
	AvgEnergy    float64
	CheckInCount int
}

// CheckInForm carries today's reflection back on validation failure.
type CheckInForm struct {
	Mood       int
	Energy     int
	Wins       string
	Challenges string
	Notes      string
	GoalID     string
	// Stress and SleepQuality are 0 when not given.
	Stress       int
	SleepQuality int
	// Tags is the comma-separated text the person typed.
	Tags   string
	Errors map[string]string
}

func (f CheckInForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// stepFor maps a validation field name onto the pane that owns it.
var stepFor = map[string]int{
	"mood":            1,
	"energy":          2,
	"stress":          2,
	"sleep_quality":   2,
	"wins":            3,
	"challenges":      4,
	"notes":           5,
	"related_goal_id": 5,
	"tags":            5,
}

// FirstErrorStep is the pane the wizard should open on.
//
// A rejected submission re-renders the whole form, so without this the user
// lands back on step one and has to walk forward through four panes to reach
// the field that actually failed. Earliest failing pane wins, so fixing them in
// order works; the map iteration order is irrelevant because we take the
// minimum rather than the first seen.
func (f CheckInForm) FirstErrorStep() int {
	step := 0
	for name := range f.Errors {
		s, ok := stepFor[name]
		if !ok {
			continue
		}
		if step == 0 || s < step {
			step = s
		}
	}
	if step == 0 {
		return 1
	}
	return step
}

// FormFor pre-fills from an existing check-in.
func FormFor(c checkin.CheckIn) CheckInForm {
	f := CheckInForm{
		Mood:       c.Mood,
		Energy:     c.Energy,
		Wins:       c.Wins,
		Challenges: c.Challenges,
		Notes:      c.Notes,
		Tags:       strings.Join(c.Tags, ", "),
	}
	if c.RelatedGoalID != nil {
		f.GoalID = c.RelatedGoalID.String()
	}
	if c.Stress != nil {
		f.Stress = *c.Stress
	}
	if c.SleepQuality != nil {
		f.SleepQuality = *c.SleepQuality
	}
	return f
}

templ IndexPage(user users.User, form CheckInForm, activeGoals []goal.Goal, saved bool, m *moments.Moment, data LiveData) {
	@layout.App(i18n.T(ctx, "nav.check-ins"), user, layout.BuildNav(ctx, "/app/check-ins")) {
		<div class="mx-auto flex w-full max-w-6xl flex-col gap-8 p-4 md:p-8">
			@header()
			if saved && m != nil {
				@moment.Card(*m)
			} else if saved {
				<p class="rounded-lg border border-signal/30 bg-signal/10 px-4 py-3 text-sm">{ i18n.T(ctx, "checkins.saved") }</p>
			}
			@Panel(form, activeGoals, len(data.List) == 0)
			@Live(data)
		</div>
		@textarea.Script()
		@input.Script()
		@label.Script()
		@selectbox.Script()
		@ui.ChartScripts()
		@dictate.Script()
	}
}

templ header() {
	<header>
		<p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">{ i18n.T(ctx, "checkins.mono") }</p>
		<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "checkins.heading") }</h1>
		<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
			{ i18n.T(ctx, "checkins.intro") }
		</p>
	</header>
}

// Live is the region that refreshes itself. Every hx attribute sits on this
// element: htmx 4 does not inherit them. A 204 from the poll leaves it alone.
templ Live(data LiveData) {
	<div
		id={ LiveID }
		class="flex flex-col gap-8"
		hx-get={ LiveURL(data.Version) }
		hx-trigger={ live.CheckInTrigger }
		hx-swap="outerHTML"
	>
		@recent(data.List, data.Loc)
		@kpiStrip(data.Streak, data.Instruments)
		@instrumentsRow(data.Instruments)
	</div>
}

templ kpiStrip(streak int, inst Instruments) {
	@ui.KpiStrip() {
		@kpiCell(i18n.T(ctx, "checkins.kpi.streak"), streakKPI(ctx, streak), "/app/check-ins", i18n.T(ctx, "checkins.kpi.checkcta"))
		@kpiCell(i18n.T(ctx, "checkins.kpi.avgmood"), avgMoodKPI(ctx, inst), "", "")
		@kpiCell(i18n.T(ctx, "checkins.kpi.avgenergy"), avgEnergyKPI(ctx, inst), "", "")
		@kpiCell(i18n.T(ctx, "checkins.kpi.logged"), checkInCountKPI(ctx, inst), "", "")
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func streakKPI(ctx context.Context, streak int) string {
	switch {
	case streak <= 0:
		return "—"
	case streak == 1:
		return i18n.T(ctx, "checkins.kpi.streak.one")
	default:
		return i18n.Tf(ctx, "checkins.kpi.streak.many", streak)
	}
}

func avgMoodKPI(ctx context.Context, inst Instruments) string {
	if inst.CheckInCount <= 0 {
		return "—"
	}
	return i18n.Decimal(ctx, inst.AvgMood, 1) + "/5"
}

func avgEnergyKPI(ctx context.Context, inst Instruments) string {
	if inst.CheckInCount <= 0 {
		return "—"
	}
	return i18n.Decimal(ctx, inst.AvgEnergy, 1) + "/5"
}

func checkInCountKPI(ctx context.Context, inst Instruments) string {
	switch {
	case inst.CheckInCount <= 0:
		return "—"
	case inst.CheckInCount == 1:
		return i18n.T(ctx, "checkins.kpi.count.one")
	default:
		return i18n.Tf(ctx, "checkins.kpi.count.many", inst.CheckInCount)
	}
}

templ instrumentsRow(inst Instruments) {
	<div class="grid gap-4 lg:grid-cols-2">
		@moodChart(inst)
		@moodHeatmap(inst)
	</div>
}

templ moodChart(inst Instruments) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "checkins.mood.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "checkins.mood.desc") }
			}
		}
		@card.Content() {
			if inst.HasData {
				@chart.Chart(inst.MoodChart)
			} else {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "checkins.mood.empty") }</p>
			}
		}
	}
}

templ moodHeatmap(inst Instruments) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "checkins.heatmap.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "checkins.heatmap.desc") }
			}
		}
		@card.Content() {
			if len(inst.Heatmap) > 0 {
				@templ.JSONScript("checkins-mood-heatmap-option", inst.Heatmap)
				@ui.EChartsMount("checkins-mood-heatmap", "checkins-mood-heatmap-option", "border-hairline min-h-32 w-full rounded-md border")
			} else {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "checkins.heatmap.empty") }</p>
			}
		}
	}
}

// Panel is the swappable region for the form. History, KPIs and charts live
// in Live, which refreshes itself on the checkin-saved event a save announces,
// so the form can be swapped without redrawing them by hand.
templ Panel(form CheckInForm, activeGoals []goal.Goal, first bool) {
	<div id={ PanelID } class="space-y-8">
		@todayForm(form, activeGoals, first)
	</div>
}

// SavedView is what the panel shows after a save.
type SavedView struct {
	CheckIn checkin.CheckIn
	Run     checkin.Run
	Moment  *moments.Moment
	// Reply loads the coach's note under the panel. Only for today's
	// check-in: an edit of an older day has none.
	Reply bool
}

// SavedPanel replaces the form once the check-in is stored. Same element id, so
// it swaps into the same place. When the save earned a moment the card comes
// first: the mascot celebrates once, above the receipt. The coach's note is
// fetched after the panel lands, so the receipt never waits on the model.
templ SavedPanel(v SavedView) {
	<div id={ PanelID } class="space-y-8">
		if v.Moment != nil {
			@moment.Card(*v.Moment)
		}
		@card.Card(card.Props{Class: "border-signal/30 bg-signal/5"}) {
			@card.Content() {
				<p class="font-mono text-[10px] uppercase tracking-[0.14em] text-signal">{ i18n.T(ctx, "checkins.logged") }</p>
				<p class="mt-2 text-lg font-medium tracking-tight">{ checkinLabel(ctx, v.CheckIn) }</p>
				if v.CheckIn.RelatedGoalTitle != "" {
					<p class="text-muted-foreground mt-1 text-sm">{ i18n.Tf(ctx, "checkins.related", v.CheckIn.RelatedGoalTitle) }</p>
				}
				if v.Run.Current > 0 {
					<p class="text-muted-foreground mt-1 text-sm">
						{ runLine(ctx, v.Run) }
					</p>
				}
				if v.Run.RestsHeld > 0 {
					<p class="text-muted-foreground mt-1 text-xs">{ restsHeld(ctx, v.Run.RestsHeld) }</p>
				}
				if !v.Run.Week[0].Date.IsZero() {
					@weekDots(v.Run)
				}
				<div class="mt-5 flex flex-col gap-2 sm:flex-row">
					@button.Button(button.Props{
						Class: "min-h-11 flex-1",
						Attributes: templ.Attributes{
							"hx-get":    "/app/check-ins",
							"hx-target": "#" + PanelID,
							"hx-swap":   "outerHTML",
						},
					}) {
						{ i18n.T(ctx, "checkins.edit") }
					}
					@button.Button(button.Props{Href: "/app", Variant: button.VariantOutline, Class: "min-h-11 flex-1"}) {
						{ i18n.T(ctx, "checkins.back") }
					}
				</div>
			}
		}
		if v.Reply {
			<div hx-get="/app/check-ins/today/reply" hx-trigger="load" hx-swap="outerHTML">
				@skeleton.Skeleton(skeleton.Props{Class: "h-14 w-full rounded-lg"})
			</div>
		}
	</div>
}

// weekDots is Monday to Sunday of this week. Hand-rolled: no templUI
// component draws a row of day states. A past day without a check-in is
// "none", drawn like any empty day and never labelled as missed.
templ weekDots(run checkin.Run) {
	<div class="mt-4">
		<ol class="flex gap-2" aria-label={ i18n.T(ctx, "checkins.week.label") }>
			for _, d := range run.Week {
				<li
					data-day-state={ string(d.State) }
					class={ "size-3 rounded-full", dotClass(d.State, run.PerfectWeek) }
					aria-label={ i18n.Date(ctx, d.Date, "Mon") + ": " + dayStateLabel(ctx, d.State) }
				></li>
			}
		</ol>
		if run.PerfectWeek {
			<p class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-ember">{ i18n.T(ctx, "checkins.week.perfect") }</p>
		}
	</div>
}

templ recent(list []checkin.CheckIn, loc *time.Location) {
	if len(list) > 0 {
		<section class="space-y-3">
			<h2 class="text-sm font-medium">{ i18n.T(ctx, "checkins.recent") }</h2>
			for _, c := range list {
				@historyCard(c, loc)
			}
		</section>
	}
}

templ todayForm(f CheckInForm, activeGoals []goal.Goal, first bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "checkins.today") }
			}
			@card.Description() {
				if first {
					{ i18n.T(ctx, "checkins.first") }
				} else {
					{ i18n.T(ctx, "checkins.again") }
				}
			}
		}
		@card.Content() {
			// method/action are kept alongside the hx- attributes so the flow still
			// saves with JavaScript disabled; the handler falls back to a redirect
			// when the HX-Request header is absent.
			//
			// A rejected submission answers 422 with this same form re-rendered
			// around the error messages. htmx is configured in the base layout to
			// swap that status; see the htmx-config meta tag there.
			<form
				method="post"
				action="/app/check-ins"
				class="space-y-6"
				hx-post="/app/check-ins"
				hx-target={ "#" + PanelID }
				hx-swap="outerHTML"
				hx-disable="find button[type='submit']"
				x-data={ "{ step: " + strconv.Itoa(f.FirstErrorStep()) + ", mood: " + strconv.Itoa(f.Mood) + ", energy: " + strconv.Itoa(f.Energy) + " }" }
			>
				@ui.CSRFInput()
				@stepStrip()
				<div x-show="step === 1" class="space-y-3">
					@label.Label() {
						{ i18n.T(ctx, "checkins.q.mood") }
					}
					@scalePicker("mood", i18n.T(ctx, "checkins.field.mood"), f.Mood)
					@fieldMessage(f.fieldError("mood"))
					@stepNav(0, 2)
				</div>
				<div x-show="step === 2" x-cloak class="space-y-3">
					@label.Label() {
						{ i18n.T(ctx, "checkins.q.energy") }
					}
					@scalePicker("energy", i18n.T(ctx, "checkins.field.energy"), f.Energy)
					@fieldMessage(f.fieldError("energy"))
					// Stress and sleep share the energy pane: three quick taps about
					// how the body feels, and both may be skipped.
					<div class="space-y-3 pt-3">
						@label.Label() {
							{ i18n.T(ctx, "checkins.q.stress") }
						}
						@optionalScalePicker("stress", i18n.T(ctx, "checkins.field.stress"), f.Stress)
						@fieldMessage(f.fieldError("stress"))
					</div>
					<div class="space-y-3 pt-3">
						@label.Label() {
							{ i18n.T(ctx, "checkins.q.sleep") }
						}
						@optionalScalePicker("sleep_quality", i18n.T(ctx, "checkins.field.sleep"), f.SleepQuality)
						@fieldMessage(f.fieldError("sleep_quality"))
					</div>
					@stepNav(1, 3)
				</div>
				<div x-show="step === 3" x-cloak class="space-y-3">
					@form.Item() {
						@label.Label(label.Props{For: "wins"}) {
							{ i18n.T(ctx, "checkins.q.wins") }
						}
						// Value, not children: the component renders p.Value and drops
						// anything passed as children, so text handed to it that way
						// vanished silently on every re-render.
						@dictate.Field(dictate.Props{Target: "wins"}) {
							@textarea.Textarea(textarea.Props{
								ID:          "wins",
								Name:        "wins",
								Rows:        3,
								Placeholder: i18n.T(ctx, "checkins.ph.wins"),
								Value:       f.Wins,
								HasError:    f.fieldError("wins") != "",
							})
						}
						@fieldMessage(f.fieldError("wins"))
					}
					@stepNav(2, 4)
				</div>
				<div x-show="step === 4" x-cloak class="space-y-3">
					@form.Item() {
						@label.Label(label.Props{For: "challenges"}) {
							{ i18n.T(ctx, "checkins.q.hard") }
						}
						@dictate.Field(dictate.Props{Target: "challenges"}) {
							@textarea.Textarea(textarea.Props{
								ID:          "challenges",
								Name:        "challenges",
								Rows:        3,
								Placeholder: i18n.T(ctx, "checkins.ph.hard"),
								Value:       f.Challenges,
								HasError:    f.fieldError("challenges") != "",
							})
						}
						@fieldMessage(f.fieldError("challenges"))
					}
					@stepNav(3, 5)
				</div>
				<div x-show="step === 5" x-cloak class="space-y-3">
					@form.Item() {
						@label.Label(label.Props{For: "notes"}) {
							{ i18n.T(ctx, "checkins.q.notes") }
						}
						@dictate.Field(dictate.Props{Target: "notes"}) {
							@textarea.Textarea(textarea.Props{
								ID:          "notes",
								Name:        "notes",
								Rows:        3,
								Placeholder: i18n.T(ctx, "checkins.ph.notes"),
								Value:       f.Notes,
								HasError:    f.fieldError("notes") != "",
							})
						}
						@fieldMessage(f.fieldError("notes"))
					}
					@form.Item() {
						@label.Label(label.Props{For: "tags"}) {
							{ i18n.T(ctx, "checkins.tags") }
						}
						@input.Input(input.Props{
							ID:          "tags",
							Name:        "tags",
							Placeholder: i18n.T(ctx, "checkins.ph.tags"),
							Value:       f.Tags,
							HasError:    f.fieldError("tags") != "",
						})
						@fieldMessage(f.fieldError("tags"))
					}
					if len(activeGoals) > 0 {
						@form.Item() {
							@label.Label() {
								{ i18n.T(ctx, "checkins.goal") }
							}
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{ID: "related_goal_id", Name: "related_goal_id"}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "checkins.goal.none")})
								}
								@selectbox.Content() {
									@selectbox.Item(selectbox.ItemProps{Value: "", Selected: f.GoalID == ""}) {
										{ i18n.T(ctx, "checkins.goal.none") }
									}
									for _, g := range activeGoals {
										@selectbox.Item(selectbox.ItemProps{Value: g.ID.String(), Selected: f.GoalID == g.ID.String()}) {
											{ g.Title }
										}
									}
								}
							}
							@fieldMessage(f.fieldError("related_goal_id"))
						}
					}
					@stepNav(4, 0)
				</div>
			</form>
		}
	}
}

// stepStrip doubles as progress and as navigation — on a phone it is the only
// way back to an earlier answer without walking the Back button. Both scales
// default to a valid value, so jumping ahead can never submit an empty pane.
templ stepStrip() {
	<div class="flex flex-wrap gap-1.5">
		@stepChip(1, i18n.T(ctx, "checkins.field.mood"))
		@stepChip(2, i18n.T(ctx, "checkins.field.energy"))
		@stepChip(3, i18n.T(ctx, "checkins.step.wins"))
		@stepChip(4, i18n.T(ctx, "checkins.step.hard"))
		@stepChip(5, i18n.T(ctx, "checkins.step.notes"))
	</div>
}

templ stepChip(n int, title string) {
	<button
		type="button"
		@click={ "step = " + strconv.Itoa(n) }
		:aria-current={ "step === " + strconv.Itoa(n) + " ? 'step' : null" }
		:class={ "step >= " + strconv.Itoa(n) + " ? 'border-signal/40 text-signal' : 'border-hairline text-muted-foreground'" }
		class="min-h-11 rounded-full border px-3 font-mono text-[10px] uppercase tracking-[0.12em] transition-colors"
	>
		{ title }
	</button>
}

// stepNav is pinned to the bottom of the viewport so the primary action stays
// under the thumb on a phone rather than riding up above a grown textarea.
// A back target of 0 means first pane; a next target of 0 means submit.
templ stepNav(back int, next int) {
	<div class="sticky bottom-0 -mx-6 -mb-6 flex gap-2 border-t border-hairline bg-surface/95 px-6 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur">
		if back > 0 {
			@button.Button(button.Props{
				Type:       button.TypeButton,
				Variant:    button.VariantOutline,
				Class:      "min-h-11 flex-1",
				Attributes: templ.Attributes{"@click": "step = " + strconv.Itoa(back)},
			}) {
				{ i18n.T(ctx, "checkins.nav.back") }
			}
		}
		if next > 0 {
			@button.Button(button.Props{
				Type:       button.TypeButton,
				Class:      "min-h-11 flex-1",
				Attributes: templ.Attributes{"@click": "step = " + strconv.Itoa(next)},
			}) {
				{ i18n.T(ctx, "checkins.nav.next") }
			}
		} else {
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "min-h-11 flex-1 bg-signal text-background hover:bg-signal/90"}) {
				{ i18n.T(ctx, "checkins.nav.save") }
			}
		}
	</div>
}

templ fieldMessage(msg string) {
	if msg != "" {
		@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
			{ msg }
		}
	}
}

// scalePicker renders a 1–5 radio group. The inputs are visually replaced by
// the squares but stay real radios, so keyboard and screen-reader users get the
// group for free — hence the per-option label, which otherwise announces as a
// bare digit. `checked` is set server-side so a value is selected before Alpine
// boots and on the no-JavaScript path.
templ scalePicker(name string, legend string, current int) {
	<fieldset class="space-y-1.5">
		<legend class="sr-only">{ i18n.Tf(ctx, "checkins.scale.legend", legend) }</legend>
		<div class="flex gap-2">
			for i := 1; i <= 5; i++ {
				<label class="flex-1 cursor-pointer">
					<input
						type="radio"
						name={ name }
						value={ strconv.Itoa(i) }
						class="peer sr-only"
						aria-label={ i18n.Tf(ctx, "checkins.scale.option", legend, i) }
						checked?={ i == current }
						x-model.number={ name }
					/>
					<span class="flex min-h-11 w-full items-center justify-center rounded-lg border border-hairline text-sm font-medium peer-checked:border-signal peer-checked:bg-signal/15 peer-checked:text-signal peer-focus-visible:ring-2 peer-focus-visible:ring-ring">
						{ strconv.Itoa(i) }
					</span>
				</label>
			}
		</div>
		<div class="text-muted-foreground flex justify-between text-[10px]">
			<span>{ i18n.T(ctx, "checkins.scale.low") }</span>
			<span>{ i18n.T(ctx, "checkins.scale.high") }</span>
		</div>
	</fieldset>
}

// optionalScalePicker is scalePicker for a scale that may be left out. The
// extra first option submits an empty value, which is how a value given
// earlier is cleared; it is checked when nothing was given.
templ optionalScalePicker(name string, legend string, current int) {
	<fieldset class="space-y-1.5">
		<legend class="sr-only">{ i18n.Tf(ctx, "checkins.scale.legend", legend) }</legend>
		<div class="flex gap-2">
			<label class="flex-1 cursor-pointer">
				<input
					type="radio"
					name={ name }
					value=""
					class="peer sr-only"
					aria-label={ i18n.T(ctx, "checkins.scale.skip") }
					checked?={ current < 1 || current > 5 }
				/>
				<span class="flex min-h-11 w-full items-center justify-center rounded-lg border border-hairline text-xs text-muted-foreground peer-checked:border-signal peer-checked:bg-signal/15 peer-checked:text-signal peer-focus-visible:ring-2 peer-focus-visible:ring-ring">
					{ i18n.T(ctx, "checkins.scale.skip") }
				</span>
			</label>
			for i := 1; i <= 5; i++ {
				<label class="flex-1 cursor-pointer">
					<input
						type="radio"
						name={ name }
						value={ strconv.Itoa(i) }
						class="peer sr-only"
						aria-label={ i18n.Tf(ctx, "checkins.scale.option", legend, i) }
						checked?={ i == current }
					/>
					<span class="flex min-h-11 w-full items-center justify-center rounded-lg border border-hairline text-sm font-medium peer-checked:border-signal peer-checked:bg-signal/15 peer-checked:text-signal peer-focus-visible:ring-2 peer-focus-visible:ring-ring">
						{ strconv.Itoa(i) }
					</span>
				</label>
			}
		</div>
		<div class="text-muted-foreground flex justify-between text-[10px]">
			<span>{ i18n.T(ctx, "checkins.scale.low") }</span>
			<span>{ i18n.T(ctx, "checkins.scale.high") }</span>
		</div>
	</fieldset>
}

templ historyCard(c checkin.CheckIn, loc *time.Location) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "py-4"}) {
			<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
				<p class="text-sm font-medium">{ checkinLabel(ctx, c) }</p>
				<p class="text-muted-foreground font-mono text-[10px] tabular-nums" data-checkin-meta>
					{ entryTimes(ctx, c, loc) }
					if label := SourceLabel(ctx, c.Source); label != "" {
						· { label }
					}
				</p>
			</div>
			<p class="text-muted-foreground mt-1 text-xs tabular-nums">
				{ i18n.Tf(ctx, "checkins.meta.moodenergy", c.Mood, c.Energy) }
				if c.Stress != nil {
					· { i18n.Tf(ctx, "checkins.meta.stress", *c.Stress) }
				}
				if c.SleepQuality != nil {
					· { i18n.Tf(ctx, "checkins.meta.sleep", *c.SleepQuality) }
				}
			</p>
			if len(c.Tags) > 0 {
				<div class="mt-2 flex flex-wrap gap-1.5">
					for _, tag := range c.Tags {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ tag }
						}
					}
				</div>
			}
			if c.RelatedGoalTitle != "" {
				<p class="text-muted-foreground mt-1 text-sm">{ i18n.Tf(ctx, "checkins.related", c.RelatedGoalTitle) }</p>
			}
			if c.Wins != "" {
				<p class="text-muted-foreground mt-1 text-sm">Wins: { c.Wins }</p>
			}
			if c.Challenges != "" {
				<p class="text-muted-foreground mt-1 text-sm">Hard: { c.Challenges }</p>
			}
		}
	}
}

// ClockIn is an instant as HH:MM in the person's zone.
func ClockIn(t time.Time, loc *time.Location) string {
	if loc == nil {
		loc = time.UTC
	}
	return t.In(loc).Format("15:04")
}

// entryTimes is when the entry was logged, and when it was last edited if
// that was notably later.
func entryTimes(ctx context.Context, c checkin.CheckIn, loc *time.Location) string {
	out := i18n.Tf(ctx, "checkins.meta.at", ClockIn(c.CreatedAt, loc))
	if c.Edited() {
		out += " · " + i18n.Tf(ctx, "checkins.meta.edited", ClockIn(c.UpdatedAt, loc))
	}
	return out
}

// SourceLabel names where a check-in came from, in the reader's language.
// Unknown and unrecognised sources get no label rather than a raw value.
func SourceLabel(ctx context.Context, s checkin.Source) string {
	switch s {
	case checkin.SourceWeb, checkin.SourceIOS, checkin.SourceSiri,
		checkin.SourceCoach, checkin.SourceMCP, checkin.SourceCapture:
		return i18n.T(ctx, "checkins.source."+string(s))
	default:
		return ""
	}
}

// checkinLabel is checkin.CheckIn.Label in the reader's language. The domain
// method stays English: it is what the coach reads.
func checkinLabel(ctx context.Context, c checkin.CheckIn) string {
	return i18n.Tf(ctx, "checkins.label", i18n.Date(ctx, c.LocalDate, "Mon 2 Jan"), c.Mood, c.Energy)
}

// streakSaved has a singular because "1-day streak" is not how any of these
// languages count one day.
func streakSaved(ctx context.Context, streak int) string {
	if streak == 1 {
		return i18n.T(ctx, "checkins.streak.saved.one")
	}
	return i18n.Tf(ctx, "checkins.streak.saved.many", streak)
}

// runLine is the streak line under a saved check-in. The first day of a new
// run names the best one rather than the gap; a run a rest day kept says so,
// honestly, instead of pretending the day happened.
func runLine(ctx context.Context, run checkin.Run) string {
	if run.Current == 1 && run.Best >= 3 {
		return i18n.Tf(ctx, "checkins.streak.newrun", run.Best)
	}
	line := streakSaved(ctx, run.Current)
	switch {
	case run.RestsUsed == 1:
		line += " · " + i18n.T(ctx, "checkins.rests.used.one")
	case run.RestsUsed > 1:
		line += " · " + i18n.Tf(ctx, "checkins.rests.used.many", run.RestsUsed)
	}
	return line
}

func restsHeld(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "checkins.rests.held.one")
	}
	return i18n.Tf(ctx, "checkins.rests.held.many", n)
}

func dayStateLabel(ctx context.Context, s checkin.DayState) string {
	switch s {
	case checkin.DayChecked, checkin.DayRest, checkin.DayToday, checkin.DayUpcoming:
		return i18n.T(ctx, "checkins.week."+string(s))
	default:
		return i18n.T(ctx, "checkins.week.none")
	}
}

// dotClass colours one day. A perfect week turns the checked days ember.
func dotClass(s checkin.DayState, perfect bool) string {
	switch s {
	case checkin.DayChecked:
		if perfect {
			return "bg-ember"
		}
		return "bg-signal"
	case checkin.DayRest:
		return "border-2 border-signal"
	case checkin.DayToday:
		return "border-2 border-dashed border-muted-foreground"
	case checkin.DayUpcoming:
		return "bg-muted/40"
	default:
		return "bg-muted"
	}
}
