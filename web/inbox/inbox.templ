package inbox

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/goals/goal"
	"github.com/NorthAIProject/north-client/internal/inbox/item"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

type AddForm struct {
	Text  string
	Error string
}

func suggestionLabel(s *item.Suggestion) string {
	switch s.Destination {
	case item.DestinationGoalNote:
		return "A note on " + s.GoalTitle
	case item.DestinationKnowledge:
		if s.Title != "" {
			return "Knowledge: " + s.Title
		}
		return "Knowledge"
	default:
		return "Journal"
	}
}

func goalIDValue(s *item.Suggestion) string {
	if s == nil || s.GoalID == nil {
		return ""
	}
	return s.GoalID.String()
}

// Each filing choice is its own small form with hidden fields: templUI has no
// hidden-input component, and a hidden field has no look or behaviour to share.
templ Page(user users.User, items []item.Item, open int, active []goal.Goal, f AddForm) {
	@layout.App("Inbox", user, layout.BuildNav(ctx, "/app/inbox")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Capture")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Inbox</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					Save now, decide later. The coach suggests where each thing belongs; nothing is filed until you say so.
				</p>
			</header>
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Content(card.ContentProps{Class: "pt-6"}) {
					<form method="post" action="/app/inbox" class="space-y-3">
						@ui.CSRFInput()
						@form.Item() {
							@textarea.Textarea(textarea.Props{ID: "text", Name: "text", Rows: 3, Value: f.Text, Placeholder: "A thought, a link, something that happened…", HasError: f.Error != ""})
							if f.Error != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ f.Error }
								}
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Save to Inbox
						}
					</form>
				}
			}
			if len(items) == 0 {
				<p class="text-muted-foreground text-sm">Nothing waiting.</p>
			} else {
				<p class="text-muted-foreground text-sm">{ fmt.Sprint(open) } waiting</p>
			}
			for _, it := range items {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Content(card.ContentProps{Class: "space-y-3 pt-6"}) {
						<p class="text-sm whitespace-pre-line">{ it.Text }</p>
						if it.Suggestion != nil {
							<p class="text-muted-foreground text-xs">Suggested: { suggestionLabel(it.Suggestion) }. { it.Suggestion.Why }</p>
							<form method="post" action={ templ.SafeURL("/app/inbox/" + it.ID.String() + "/file") }>
								@ui.CSRFInput()
								<input type="hidden" name="destination" value={ it.Suggestion.Destination }/>
								<input type="hidden" name="goal_id" value={ goalIDValue(it.Suggestion) }/>
								<input type="hidden" name="title" value={ it.Suggestion.Title }/>
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
									File as suggested
								}
							</form>
						} else {
							<p class="text-muted-foreground text-xs">The coach is still looking at this one.</p>
						}
						<div class="flex flex-wrap items-end gap-2">
							<form method="post" action={ templ.SafeURL("/app/inbox/" + it.ID.String() + "/file") }>
								@ui.CSRFInput()
								<input type="hidden" name="destination" value={ item.DestinationJournal }/>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
									Journal
								}
							</form>
							<form method="post" action={ templ.SafeURL("/app/inbox/" + it.ID.String() + "/file") }>
								@ui.CSRFInput()
								<input type="hidden" name="destination" value={ item.DestinationKnowledge }/>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
									Knowledge
								}
							</form>
							if len(active) > 0 {
								<form method="post" action={ templ.SafeURL("/app/inbox/" + it.ID.String() + "/file") } class="flex items-end gap-2">
									@ui.CSRFInput()
									<input type="hidden" name="destination" value={ item.DestinationGoalNote }/>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{ID: "goal-" + it.ID.String(), Name: "goal_id"}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "A goal"})
										}
										@selectbox.Content(selectbox.ContentProps{}) {
											for _, g := range active {
												@selectbox.Item(selectbox.ItemProps{Value: g.ID.String()}) {
													{ g.Title }
												}
											}
										}
									}
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
										Goal note
									}
								</form>
							}
							<form method="post" action={ templ.SafeURL("/app/inbox/" + it.ID.String() + "/dismiss") }>
								@ui.CSRFInput()
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
									Dismiss
								}
							</form>
						</div>
					}
				}
			}
		</div>
		@selectbox.Script()
	}
}
