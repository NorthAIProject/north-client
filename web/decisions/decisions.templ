package decisions

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/decisions/decision"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/dictate"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/radio"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// DecisionForm carries a submitted (or rejected) decision.
type DecisionForm struct {
	Title     string
	Options   string
	Rationale string
	Outcome   string
	Held      string
	Errors    map[string]string
}

// heldChoices are the answers to "did it hold?". id names the radio, so it
// stays the same in every language; the label is looked up per request.
var heldChoices = []struct{ value, id string }{
	{"", "not-yet"},
	{decision.HeldYes, "yes"},
	{decision.HeldPartly, "partly"},
	{decision.HeldNo, "no"},
}

// heldLabel names a stored "held" value in the reader's language. An unknown
// value shows as stored, which is what the card always did.
func heldLabel(ctx context.Context, value string) string {
	if value == "" {
		return i18n.T(ctx, "decisions.held.none")
	}
	key := "decisions.held." + value
	if got := i18n.T(ctx, key); got != key {
		return got
	}
	return value
}

func (f DecisionForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// FormFor pre-fills the edit form from an existing decision.
func FormFor(d decision.Decision) DecisionForm {
	return DecisionForm{
		Title:     d.Title,
		Options:   d.Options,
		Rationale: d.Rationale,
		Outcome:   d.Outcome,
		Held:      d.Held,
	}
}

templ IndexPage(user users.User, list []decision.Decision, f DecisionForm) {
	@layout.App(i18n.T(ctx, "decisions.title"), user, layout.BuildNav(ctx, "/app/decisions")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "decisions.label"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "decisions.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					{ i18n.T(ctx, "decisions.intro") }
				</p>
			</header>
			@decisionFormCard("/app/decisions", i18n.T(ctx, "decisions.form.new"), i18n.T(ctx, "decisions.form.save"), f, false)
			if len(list) == 0 {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "decisions.empty") }</p>
			} else {
				<section class="space-y-3">
					<h2 class="text-sm font-medium">{ i18n.T(ctx, "decisions.recent") }</h2>
					for _, d := range list {
						@decisionCard(d)
					}
				</section>
			}
		</div>
		@label.Script()
		@dictate.Script()
	}
}

templ ShowPage(user users.User, d decision.Decision, f DecisionForm) {
	@layout.App(i18n.T(ctx, "decisions.title"), user, layout.BuildNav(ctx, "/app/decisions")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "decisions.label"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ d.Title }</h1>
				<p class="text-muted-foreground mt-1 text-sm">
					{ i18n.Date(ctx, d.DecidedAt, "2 January 2006") }
				</p>
			</header>
			@decisionFormCard("/app/decisions/"+d.ID.String(), i18n.T(ctx, "decisions.edit"), i18n.T(ctx, "decisions.form.save_changes"), f, true)
			<form method="post" action={ templ.SafeURL("/app/decisions/" + d.ID.String() + "/delete") }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
					{ i18n.T(ctx, "decisions.delete") }
				}
			</form>
			<p>
				@button.Button(button.Props{Href: "/app/decisions", Variant: button.VariantGhost}) {
					{ i18n.T(ctx, "decisions.back") }
				}
			</p>
		</div>
		@label.Script()
		@dictate.Script()
	}
}

// decisionFormCard is both the create and the edit form. withOutcome is false
// on create: a call logged today has no outcome yet, and an empty "how did it
// go?" box at the moment of deciding invites a guess instead of a review.
templ decisionFormCard(action, heading, submit string, f DecisionForm, withOutcome bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ heading }
			}
		}
		@card.Content() {
			<form method="post" action={ templ.SafeURL(action) } class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label(label.Props{For: "title", Error: f.fieldError("title")}) {
						{ i18n.T(ctx, "decisions.form.title") }
					}
					@input.Input(input.Props{
						ID:          "title",
						Name:        "title",
						Value:       f.Title,
						Placeholder: i18n.T(ctx, "decisions.form.title_ph"),
						HasError:    f.fieldError("title") != "",
					})
					if f.fieldError("title") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("title") }
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "options", Error: f.fieldError("options")}) {
						{ i18n.T(ctx, "decisions.form.options") }
					}
					@dictate.Field(dictate.Props{Target: "options"}) {
						@textarea.Textarea(textarea.Props{
							ID:          "options",
							Name:        "options",
							Rows:        3,
							Placeholder: i18n.T(ctx, "decisions.form.options_ph"),
							Value:       f.Options,
							HasError:    f.fieldError("options") != "",
						})
					}
					if f.fieldError("options") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("options") }
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "rationale", Error: f.fieldError("rationale")}) {
						{ i18n.T(ctx, "decisions.form.rationale") }
					}
					@dictate.Field(dictate.Props{Target: "rationale"}) {
						@textarea.Textarea(textarea.Props{
							ID:          "rationale",
							Name:        "rationale",
							Rows:        3,
							Placeholder: i18n.T(ctx, "decisions.form.rationale_ph"),
							Value:       f.Rationale,
							HasError:    f.fieldError("rationale") != "",
						})
					}
					if f.fieldError("rationale") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("rationale") }
						}
					}
				}
				if withOutcome {
					@form.Item() {
						@label.Label(label.Props{For: "outcome", Error: f.fieldError("outcome")}) {
							{ i18n.T(ctx, "decisions.form.outcome") }
						}
						@dictate.Field(dictate.Props{Target: "outcome"}) {
							@textarea.Textarea(textarea.Props{
								ID:          "outcome",
								Name:        "outcome",
								Rows:        3,
								Placeholder: i18n.T(ctx, "decisions.form.outcome_ph"),
								Value:       f.Outcome,
								HasError:    f.fieldError("outcome") != "",
							})
						}
						if f.fieldError("outcome") != "" {
							@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
								{ f.fieldError("outcome") }
							}
						}
					}
					@form.Item() {
						@label.Label(label.Props{Error: f.fieldError("held")}) {
							{ i18n.T(ctx, "decisions.form.held") }
						}
						<div class="flex flex-wrap gap-4">
							for _, c := range heldChoices {
								<div class="flex items-center gap-2">
									@radio.Radio(radio.Props{ID: "held-" + c.id, Name: "held", Value: c.value, Checked: f.Held == c.value})
									@label.Label(label.Props{For: "held-" + c.id}) {
										{ heldLabel(ctx, c.value) }
									}
								</div>
							}
						</div>
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ submit }
				}
			</form>
		}
	}
}

templ decisionCard(d decision.Decision) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "space-y-2 py-4"}) {
			<p class="text-muted-foreground text-xs">{ i18n.Date(ctx, d.DecidedAt, "2 Jan 2006") }</p>
			<h3 class="text-sm font-medium">{ d.Title }</h3>
			if d.Options != "" {
				<p class="text-muted-foreground text-sm">{ i18n.Tf(ctx, "decisions.card.options", d.Options) }</p>
			}
			if d.Rationale != "" {
				<p class="text-muted-foreground text-sm">{ i18n.Tf(ctx, "decisions.card.why", d.Rationale) }</p>
			}
			if d.Outcome != "" {
				<p class="text-muted-foreground text-sm">{ i18n.Tf(ctx, "decisions.card.outcome", d.Outcome) }</p>
			}
			if d.Held != "" {
				<p class="text-muted-foreground text-sm">{ i18n.Tf(ctx, "decisions.card.held", heldLabel(ctx, d.Held)) }</p>
			}
			@button.Button(button.Props{Href: "/app/decisions/" + d.ID.String(), Variant: button.VariantGhost, Size: button.SizeSm}) {
				{ i18n.T(ctx, "decisions.edit") }
			}
		}
	}
}
