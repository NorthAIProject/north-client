package landing

import (
	"context"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/separator"
)

// ---------------------------------------------------------------------------
// Features
// ---------------------------------------------------------------------------

type feature struct {
	Icon templ.Component
	Name string
	Body string
}

func features(ctx context.Context) []feature {
	return []feature{
		{icon.Brain(icon.Props{Class: "size-4"}), i18n.T(ctx, "land.feat.1.name"), i18n.T(ctx, "land.feat.1.body")},
		{icon.Target(icon.Props{Class: "size-4"}), i18n.T(ctx, "land.feat.2.name"), i18n.T(ctx, "land.feat.2.body")},
		{icon.Plug(icon.Props{Class: "size-4"}), i18n.T(ctx, "land.feat.3.name"), i18n.T(ctx, "land.feat.3.body")},
		{icon.Dumbbell(icon.Props{Class: "size-4"}), i18n.T(ctx, "land.feat.4.name"), i18n.T(ctx, "land.feat.4.body")},
		{icon.FileText(icon.Props{Class: "size-4"}), i18n.T(ctx, "land.feat.5.name"), i18n.T(ctx, "land.feat.5.body")},
	}
}

templ featuresSection() {
	<section class="relative border-t border-hairline py-24">
		@waypoint(i18n.T(ctx, "land.waypoint.month8"))
		@sectionHeading(
			i18n.T(ctx, "land.feat.eyebrow"),
			i18n.T(ctx, "land.feat.title"),
			"",
		)
		// Six columns rather than three: five cards over two rows leaves a hole
		// on a three-column grid, so the last two are widened to close it.
		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
			for i, f := range features(ctx) {
				@card.Card(card.Props{Class: "border-hairline bg-surface " + featureSpan(i)}) {
					@card.Content(card.ContentProps{}) {
						<span class="flex size-8 items-center justify-center rounded-md bg-signal/12 text-signal">
							@f.Icon
						</span>
						<h3 class="mt-4 text-base font-medium">{ f.Name }</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{ f.Body }</p>
					}
				}
			}
		</div>
	</section>
}

func featureSpan(index int) string {
	if index < 3 {
		return "lg:col-span-2"
	}
	return "lg:col-span-3"
}

// ---------------------------------------------------------------------------
// How it works
// ---------------------------------------------------------------------------

type step struct {
	When string
	Name string
	Body string
}

func steps(ctx context.Context) []step {
	return []step{
		{i18n.T(ctx, "land.how.1.when"), i18n.T(ctx, "land.how.1.name"), i18n.T(ctx, "land.how.1.body")},
		{i18n.T(ctx, "land.how.2.when"), i18n.T(ctx, "land.how.2.name"), i18n.T(ctx, "land.how.2.body")},
		{i18n.T(ctx, "land.how.3.when"), i18n.T(ctx, "land.how.3.name"), i18n.T(ctx, "land.how.3.body")},
		{i18n.T(ctx, "land.how.4.when"), i18n.T(ctx, "land.how.4.name"), i18n.T(ctx, "land.how.4.body")},
	}
}

templ howItWorksSection() {
	<section class="relative border-t border-hairline py-24">
		@sectionHeading(i18n.T(ctx, "land.how.eyebrow"), i18n.T(ctx, "land.how.title"), "")
		<ol class="mt-10 space-y-0">
			for i, s := range steps(ctx) {
				<li class="grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
					<div class="pt-0.5">
						@monoLabel(s.When)
					</div>
					<div>
						<h3 class="text-lg font-medium tracking-[-0.02em]">{ s.Name }</h3>
						<p class="mt-2 max-w-[62ch] text-sm leading-relaxed text-muted-foreground">{ s.Body }</p>
					</div>
				</li>
				if i < len(steps(ctx))-1 {
					@separator.Separator(separator.Props{Class: "bg-hairline"})
				}
			}
		</ol>
	</section>
}

// ---------------------------------------------------------------------------
// Vision
// ---------------------------------------------------------------------------
templ visionSection() {
	<section class="relative border-t border-hairline py-24">
		@waypoint(i18n.T(ctx, "land.waypoint.year2"))
		<div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
			<div>
				@monoLabel(i18n.T(ctx, "land.vision.eyebrow"))
				<blockquote class="mt-5 text-2xl font-medium leading-[1.25] tracking-[-0.025em] text-balance md:text-3xl">
					“{ i18n.T(ctx, "land.vision.quote") }”
				</blockquote>
				<p class="mt-6 max-w-[58ch] text-base leading-relaxed text-muted-foreground">
					{ i18n.T(ctx, "land.vision.body") }
				</p>
			</div>
			<div class="space-y-4">
				@visionStat(i18n.T(ctx, "land.vision.1.value"), i18n.T(ctx, "land.vision.1.body"))
				@visionStat(i18n.T(ctx, "land.vision.2.value"), i18n.T(ctx, "land.vision.2.body"))
				@visionStat(i18n.T(ctx, "land.vision.3.value"), i18n.T(ctx, "land.vision.3.body"))
			</div>
		</div>
	</section>
}

templ visionStat(value string, body string) {
	<div class="rounded-lg border border-hairline bg-surface p-5">
		<div class="font-mono text-xl tracking-tight text-signal">{ value }</div>
		<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{ body }</p>
	</div>
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------
templ pricingSection() {
	<section class="relative border-t border-hairline py-24">
		@sectionHeading(i18n.T(ctx, "land.price.eyebrow"), i18n.T(ctx, "land.price.title"), "")
		<div class="mt-10 grid gap-5 lg:grid-cols-2">
			@planCard(
				i18n.T(ctx, "land.price.free"),
				i18n.T(ctx, "land.price.free.amount"),
				i18n.T(ctx, "land.price.free.period"),
				i18n.T(ctx, "land.price.free.blurb"),
				[]string{
					i18n.T(ctx, "land.price.free.1"),
					i18n.T(ctx, "land.price.free.2"),
					i18n.T(ctx, "land.price.free.3"),
					i18n.T(ctx, "land.price.free.4"),
					i18n.T(ctx, "land.price.free.5"),
					i18n.T(ctx, "land.price.free.6"),
				},
				i18n.T(ctx, "land.price.free.cta"),
				false,
			)
			@planCard(
				i18n.T(ctx, "land.price.pro"),
				i18n.T(ctx, "land.price.pro.amount"),
				i18n.T(ctx, "land.price.pro.period"),
				i18n.T(ctx, "land.price.pro.blurb"),
				[]string{
					i18n.T(ctx, "land.price.pro.1"),
					i18n.T(ctx, "land.price.pro.2"),
					i18n.T(ctx, "land.price.pro.3"),
				},
				"",
				true,
			)
		</div>
		<p class="mt-6 text-xs text-muted-foreground">
			{ i18n.T(ctx, "land.price.footnote") }
		</p>
	</section>
}

templ planCard(name string, price string, period string, blurb string, lines []string, cta string, featured bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface " + planCardAccent(featured)}) {
		@card.Content(card.ContentProps{Class: "flex h-full flex-col"}) {
			<div class="flex items-center justify-between">
				@monoLabel(name)
				if featured {
					@badge.Badge(badge.Props{Class: "border-signal/40 bg-signal/12 text-signal", Variant: badge.VariantOutline}) {
						{ i18n.T(ctx, "land.price.pro.badge") }
					}
				}
			</div>
			<div class="mt-4 flex items-baseline gap-2">
				<span class="text-4xl font-medium tracking-[-0.03em]">{ price }</span>
				@monoLabel(period)
			</div>
			<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{ blurb }</p>
			<ul class="mt-6 flex-1 space-y-2.5">
				for _, line := range lines {
					<li class="flex items-start gap-2.5 text-sm">
						@icon.Check(icon.Props{Class: "mt-0.5 size-3.5 shrink-0 text-signal"})
						<span class="text-foreground/90">{ line }</span>
					</li>
				}
			</ul>
			// No CTA means the plan cannot be bought. Rendering a button that only
			// leads to the free signup would be the dishonest half of the problem
			// this section had. The line that replaces it keeps the two cards the
			// same height, so the absence reads as deliberate rather than broken.
			if cta != "" {
				@button.Button(button.Props{
					Href:      ctaHref(ctx),
					FullWidth: true,
					Variant:   planCardVariant(featured),
					Class:     "mt-7 " + planCardButton(featured),
				}) {
					{ planCTA(ctx, cta) }
				}
			} else {
				<p class="mt-7 rounded-md border border-dashed border-hairline px-4 py-2.5 text-center text-sm text-muted-foreground">
					{ i18n.T(ctx, "land.price.pro.nothing") }
				</p>
			}
		}
	}
}

func planCardAccent(featured bool) string {
	if featured {
		return "ring-1 ring-signal/25"
	}
	return ""
}

func planCardVariant(featured bool) button.Variant {
	if featured {
		return button.VariantDefault
	}
	return button.VariantOutline
}

func planCardButton(featured bool) string {
	if featured {
		return "bg-signal text-background hover:bg-signal/90"
	}
	return "border-hairline"
}

// ---------------------------------------------------------------------------
// Close
// ---------------------------------------------------------------------------
templ finalCTA() {
	<section class="relative border-t border-hairline py-28">
		<div class="mx-auto max-w-2xl text-center">
			<span class="mx-auto flex size-10 items-center justify-center rounded-full bg-signal/12 text-signal">
				@icon.Compass(icon.Props{Class: "size-5"})
			</span>
			<h2 class="mt-7 text-3xl font-medium tracking-[-0.03em] text-balance md:text-4xl">
				{ i18n.T(ctx, "land.cta.title") }
			</h2>
			<p class="mx-auto mt-5 max-w-[48ch] text-base leading-relaxed text-muted-foreground">
				{ i18n.T(ctx, "land.cta.body") }
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				@button.Button(button.Props{Href: ctaHref(ctx), Size: button.SizeLg, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ ctaLabel(ctx) }
					@icon.ArrowRight(icon.Props{Class: "size-4"})
				}
				if !signedIn(ctx) {
					@button.Button(button.Props{Href: "/login", Size: button.SizeLg, Variant: button.VariantOutline, Class: "border-hairline"}) {
						{ i18n.T(ctx, "land.cta.signin") }
					}
				}
			</div>
		</div>
	</section>
}

templ siteFooter() {
	<footer class="border-t border-hairline">
		<div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 lg:pl-28 lg:pr-8">
			<div class="flex items-center gap-2 text-muted-foreground">
				@icon.Compass(icon.Props{Class: "size-3.5"})
				@monoLabel(i18n.T(ctx, "land.footer.tagline"))
			</div>
			<div class="flex items-center gap-5">
				<a href="/privacy" class="rounded-md text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal">
					@monoLabel(i18n.T(ctx, "land.footer.privacy"))
				</a>
				<a href="/terms" class="rounded-md text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal">
					@monoLabel(i18n.T(ctx, "land.footer.terms"))
				</a>
				<a
					href="https://github.com/NorthAIProject/north-client"
					class="flex items-center gap-2 rounded-md text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
				>
					@icon.Github(icon.Props{Class: "size-3.5"})
					@monoLabel(i18n.T(ctx, "land.footer.source"))
				</a>
				// Only for visitors. A signed-in user's language lives on their
				// account, and a second control here would write a cookie that
				// LoadUser ignores — a switch that visibly does nothing.
				if !signedIn(ctx) {
					@ui.LanguageSwitcher()
				}
			</div>
		</div>
		<div class="mx-auto w-full max-w-6xl px-6 pb-8 lg:pl-28 lg:pr-8">
			<p class="font-mono text-[10px] leading-relaxed text-muted-foreground/70">
				3D muscle model built on anatomical data from
				<a href="https://www.z-anatomy.com/" class="underline hover:text-muted-foreground">Z-Anatomy</a>
				via
				<a href="https://github.com/hpfrei/body-anatomy-3d-viewer" class="underline hover:text-muted-foreground">hpfrei/body-anatomy-3d-viewer</a>
				, licensed
				<a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline hover:text-muted-foreground">CC BY-SA 4.0</a>
				(pruned to named muscle groups, recompressed). Base body mesh by
				<a href="https://sketchfab.com/ferrumiron6" class="underline hover:text-muted-foreground">ferrumiron6</a>
				, licensed
				<a href="https://creativecommons.org/licenses/by/4.0/" class="underline hover:text-muted-foreground">CC BY 4.0</a>
				(cropped, layered as the outer body). The combined asset is CC BY-SA 4.0.
			</p>
		</div>
	</footer>
}
