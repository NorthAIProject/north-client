package landing

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
)

// The store links. Each is one line to change when a listing goes live:
//
//   - appStoreURL: the apps.apple.com listing. Empty until Khepri ships, so the
//     Apple badge points at the TestFlight invite and says so underneath.
//   - iosBetaURL: the public TestFlight invite.
//   - playStoreURL: the Google Play listing. Android has no build yet, so the
//     Play badge renders muted and is not a link.
const (
	appStoreURL  = ""
	iosBetaURL   = "https://testflight.apple.com/join/MCwG7x6H"
	playStoreURL = ""
)

// storeBadge is what one badge says: where it goes, if anywhere, the line
// under it, and what a screen reader hears.
type storeBadge struct {
	Href    string
	Caption string
	Aria    string
	Muted   bool
}

// appleBadge picks the Apple badge's state. A real listing wins; a TestFlight
// invite links with a beta caption; nothing at all mutes the badge.
func appleBadge(ctx context.Context, listing, beta string) storeBadge {
	switch {
	case listing != "":
		return storeBadge{Href: listing, Aria: i18n.T(ctx, "land.app.ios.store.aria")}
	case beta != "":
		return storeBadge{Href: beta, Caption: i18n.T(ctx, "land.app.beta"), Aria: i18n.T(ctx, "land.app.ios.aria")}
	default:
		return storeBadge{Caption: i18n.T(ctx, "land.app.soon"), Aria: i18n.T(ctx, "land.app.ios.soon.aria"), Muted: true}
	}
}

// playBadge picks the Google Play badge's state: a listing or "coming soon".
func playBadge(ctx context.Context, listing string) storeBadge {
	if listing != "" {
		return storeBadge{Href: listing, Aria: i18n.T(ctx, "land.app.android.store.aria")}
	}
	return storeBadge{Caption: i18n.T(ctx, "land.app.soon"), Aria: i18n.T(ctx, "land.app.android.aria"), Muted: true}
}

// appButtons is the native-app row: in the hero, the iPhone section and the
// final call to action. class carries the caller's spacing and alignment.
//
// Official badge artwork, unaltered. Stacked on a phone, side by side from sm,
// with at least a quarter of the badge height of clear space between them.
templ appButtons(class string) {
	<div class={ "flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-7", class }>
		@storeBadgeSlot(appleBadge(ctx, appStoreURL, iosBetaURL)) {
			@appleArtwork()
		}
		@storeBadgeSlot(playBadge(ctx, playStoreURL)) {
			@playArtwork()
		}
	</div>
}

// storeBadgeSlot wraps one badge's artwork in its state.
//
// Hand-rolled rather than button.Button: the store guidelines forbid
// restyling the badge, and Button would paint its own fill, padding and
// radius around it. A muted badge is not a link at all — a disabled control
// reads as broken, and there is nowhere for it to go.
templ storeBadgeSlot(b storeBadge) {
	<div class="flex flex-col items-center gap-1.5">
		if b.Muted {
			<span role="img" aria-label={ b.Aria } class="block opacity-45 grayscale">
				{ children... }
			</span>
		} else {
			<a
				href={ templ.SafeURL(b.Href) }
				target="_blank"
				rel="noopener noreferrer"
				aria-label={ b.Aria }
				class="block rounded-[9px] transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
			>
				{ children... }
			</a>
		}
		if b.Caption != "" {
			<span aria-hidden="true" class="font-mono text-[11px] tracking-[0.06em] text-muted-foreground">{ b.Caption }</span>
		}
	</div>
}

// appleArtwork is Apple's badge: black on the light theme, the white variant
// on the dark one. 44px tall, above the 40px minimum.
templ appleArtwork() {
	<img src="/assets/brand/badges/download-on-the-app-store.svg" alt="" width="132" height="44" class="block h-11 w-auto dark:hidden"/>
	<img src="/assets/brand/badges/download-on-the-app-store-white.svg" alt="" width="132" height="44" class="hidden h-11 w-auto dark:block"/>
}

// playArtwork is Google's badge. The PNG carries transparent padding of 41 of
// its 250px on every side, so drawn at 44px it would look a third smaller than
// Apple's. The image is scaled until the visible badge is 44px tall and the
// padding is clipped off, which makes the two badges the same visual size.
templ playArtwork() {
	<span class="block h-11 w-[147.7px] overflow-hidden">
		<img src="/assets/brand/badges/google-play-badge.png" alt="" width="169" height="65" class="-m-[10.74px] block h-[65.48px] w-auto max-w-none"/>
	</span>
}
