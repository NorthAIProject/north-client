package landing

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// iosBetaURL is the public TestFlight invite. Khepri is not on the App Store
// yet, so this is the only way onto an iPhone. When it ships, swap this for
// the apps.apple.com listing and change the kicker from the beta wording.
const iosBetaURL = "https://testflight.apple.com/join/MCwG7x6H"

// appButtons is the native-app row: the first action in the hero, repeated in
// the iPhone section and the final call to action. class carries the caller's
// spacing and alignment.
//
// On a phone the two badges share the row equally, and each takes the full
// width when a longer translation forces them to wrap, so a stacked pair still
// reads as a pair.
//
// Shaped like store badges — platform mark, two lines, inverse colours —
// because that is the shape a visitor scans for. Not the official badges: they
// say "Download on the App Store", which a TestFlight link is not. Android has
// no build yet, so it renders as a plain label rather than a link that goes
// nowhere.
templ appButtons(class string) {
	<div class={ "flex flex-wrap items-center gap-3", class }>
		@button.Button(button.Props{
			Href:       iosBetaURL,
			Target:     "_blank",
			Class:      "h-12 min-w-max flex-1 gap-3 rounded-xl bg-foreground px-4 text-background shadow-sm hover:bg-foreground/85 has-[>svg]:px-4 sm:flex-none [&_svg:not([class*='size-'])]:size-6",
			Attributes: templ.Attributes{"rel": "noopener noreferrer", "aria-label": i18n.T(ctx, "land.app.ios.aria")},
		}) {
			<span class="size-6 [&_svg]:size-6">
				@icon.BrandApple()
			</span>
			@badgeLines(i18n.T(ctx, "land.app.ios.kicker"), i18n.T(ctx, "land.app.ios"))
		}
		// Hand-rolled: Button renders a live control, and a disabled button
		// reads as broken. This is a status label shaped like its neighbour.
		<span class="inline-flex h-12 min-w-max flex-1 items-center justify-center gap-3 rounded-xl border border-dashed border-hairline px-4 text-muted-foreground sm:flex-none">
			<span class="size-6 [&_svg]:size-6">
				@icon.BrandAndroid()
			</span>
			@badgeLines(i18n.T(ctx, "land.app.android.kicker"), i18n.T(ctx, "land.app.android"))
		</span>
	</div>
}

// badgeLines is a store badge's label: a small kicker over the app's name.
templ badgeLines(kicker string, name string) {
	<span class="flex flex-col items-start text-left leading-none">
		<span class="text-[11px] font-normal opacity-75">{ kicker }</span>
		<span class="mt-1 text-[15px] font-semibold tracking-[-0.01em]">{ name }</span>
	</span>
}
