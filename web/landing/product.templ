package landing

import (
	"context"
	"strconv"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// The product sections: what a day, a month and a conversation look like
// inside Khepri, drawn as static mock-ups of the real screens. Static on
// purpose — no data, no script — so they render instantly and never show a
// visitor someone else's numbers.

// tourLinks is the strip under the hero that jumps to each section.
templ tourLinks() {
	<nav aria-label={ i18n.T(ctx, "land.tour.aria") } class="-mx-1 mt-12 flex flex-wrap gap-2">
		@tourLink("#day", i18n.T(ctx, "land.tour.day"))
		@tourLink("#patterns", i18n.T(ctx, "land.tour.patterns"))
		@tourLink("#coach-builds", i18n.T(ctx, "land.tour.plans"))
		@tourLink("#iphone", "iPhone")
		@tourLink("#muscle", i18n.T(ctx, "land.tour.muscle"))
	</nav>
}

templ tourLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="border-hairline bg-surface/60 text-muted-foreground hover:text-foreground hover:border-signal/40 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors">
		{ label }
	</a>
}

type mockEntry struct {
	Time, Title, Detail, Color, Icon string
}

// mockDay is a made-up day. Titles and details are copy; amounts that read
// the same in every language stay literal.
func mockDay(ctx context.Context) []mockEntry {
	t := func(key string) string { return i18n.T(ctx, key) }
	return []mockEntry{
		{"21:10", t("land.day.mock.1.title"), t("land.day.mock.1.detail"), "var(--color-day-protein)", "pill"},
		{"19:40", t("land.day.mock.2.title"), t("land.day.mock.2.detail"), "var(--color-day-food)", "utensils"},
		{"18:05", t("land.day.mock.3.title"), t("land.day.mock.3.detail"), "var(--color-day-fat)", "dumbbell"},
		{"13:10", t("land.day.mock.4.title"), "500 ml", "var(--color-day-water)", "droplet"},
		{"12:30", t("land.day.mock.5.title"), "650 kcal", "var(--color-day-food)", "utensils"},
		{"10:05", t("land.day.mock.6.title"), t("land.day.mock.6.detail"), "var(--color-day-caffeine)", "coffee"},
		{"07:10", t("land.day.mock.7.title"), t("land.day.mock.7.detail"), "var(--color-day-sleep)", "moon"},
	}
}

templ dayDemo() {
	<section id="day" class="border-hairline relative scroll-mt-20 border-t py-24">
		@sectionHeading(
			i18n.T(ctx, "land.day.eyebrow"),
			i18n.T(ctx, "land.day.title"),
			i18n.T(ctx, "land.day.body"),
		)
		<div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,22rem)_1fr]">
			@card.Card(card.Props{Class: "border-hairline bg-surface overflow-hidden"}) {
				@card.Content(card.ContentProps{Class: "relative space-y-2 py-5"}) {
					<div aria-hidden="true" class="absolute inset-y-4 left-[4.6rem] border-l-2 border-dashed border-[var(--color-day-fat)] opacity-60"></div>
					<p class="text-day-fat relative mb-1 pl-16 text-[10px] font-medium">{ i18n.T(ctx, "land.day.fasting") }</p>
					for _, e := range mockDay(ctx) {
						<div class="relative flex items-center gap-3">
							<span class="text-muted-foreground w-10 shrink-0 text-right text-[11px] tabular-nums">{ e.Time }</span>
							<div class="ml-3 flex min-w-0 flex-1 items-center gap-2.5 rounded-xl border border-[color-mix(in_oklch,var(--mock)_22%,transparent)] bg-[color-mix(in_oklch,var(--mock)_11%,var(--color-surface))] px-3 py-1.5" style={ "--mock:" + e.Color }>
								<span class="shrink-0 text-[var(--mock)]">
									@icon.Icon(e.Icon)(icon.Props{Class: "size-4"})
								</span>
								<span class="min-w-0 leading-tight">
									<span class="block truncate text-sm font-medium">{ e.Title }</span>
									<span class="text-muted-foreground block truncate text-[11px]">{ e.Detail }</span>
								</span>
							</div>
						</div>
					}
				}
			}
			<div class="space-y-6">
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
					@mockGauge("72", "mg", i18n.T(ctx, "land.day.gauge.caffeine"), "var(--color-day-caffeine)", 18)
					@mockGauge("68", "%", i18n.T(ctx, "land.day.gauge.energy"), "var(--color-day-move)", 68)
					@mockGauge("84", "min", i18n.T(ctx, "land.day.gauge.sun"), "var(--color-day-sun)", 84)
					@mockGauge("3h 12m", "", i18n.T(ctx, "land.day.gauge.screen"), "var(--color-day-screen)", 53)
				</div>
				<div class="grid gap-3 sm:grid-cols-3">
					@mockFact("layers", i18n.T(ctx, "land.day.fact.1.title"), i18n.T(ctx, "land.day.fact.1.body"))
					@mockFact("heart-pulse", i18n.T(ctx, "land.day.fact.2.title"), i18n.T(ctx, "land.day.fact.2.body"))
					@mockFact("person-standing", i18n.T(ctx, "land.day.fact.3.title"), i18n.T(ctx, "land.day.fact.3.body"))
				</div>
			</div>
		</div>
	</section>
}

templ mockGauge(value, unit, label, color string, pct int) {
	<div class="border-hairline bg-surface rounded-2xl border p-4 text-center">
		<svg viewBox="0 0 100 60" class="mx-auto h-12 w-20" aria-hidden="true">
			<path d="M10 55 A40 40 0 0 1 90 55" fill="none" stroke="var(--color-hairline)" stroke-width="9" stroke-linecap="round"></path>
			<path d="M10 55 A40 40 0 0 1 90 55" fill="none" stroke={ color } stroke-width="9" stroke-linecap="round" pathLength="100" stroke-dasharray={ strconv.Itoa(pct) + " 100" }></path>
		</svg>
		<p class="mt-1 text-lg font-semibold tabular-nums">
			{ value }
			if unit != "" {
				<span class="text-muted-foreground text-xs font-normal">{ unit }</span>
			}
		</p>
		<p class="text-muted-foreground text-xs">{ label }</p>
	</div>
}

templ mockFact(iconName, title, body string) {
	<div class="border-hairline bg-surface rounded-xl border p-4">
		<span class="bg-signal/12 text-signal flex size-8 items-center justify-center rounded-md">
			@icon.Icon(iconName)(icon.Props{Class: "size-4"})
		</span>
		<h3 class="mt-3 text-sm font-medium">{ title }</h3>
		<p class="text-muted-foreground mt-1 text-xs leading-relaxed">{ body }</p>
	</div>
}

templ statsDemo() {
	<section id="patterns" class="border-hairline relative scroll-mt-20 border-t py-24">
		@sectionHeading(
			i18n.T(ctx, "land.stats.eyebrow"),
			i18n.T(ctx, "land.stats.title"),
			i18n.T(ctx, "land.stats.body"),
		)
		<div class="mt-10 grid gap-4 md:grid-cols-2">
			@mockPattern(i18n.T(ctx, "land.stats.p1.title"), i18n.T(ctx, "land.stats.p1.detail"), i18n.T(ctx, "land.stats.p1.a"), "6h 38m", 90, i18n.T(ctx, "land.stats.p1.b"), "7h 20m", 100)
			@mockPattern(i18n.T(ctx, "land.stats.p2.title"), i18n.T(ctx, "land.stats.p2.detail"), i18n.T(ctx, "land.stats.p2.a"), i18n.T(ctx, "land.stats.p2.a.value"), 100, i18n.T(ctx, "land.stats.p2.b"), i18n.T(ctx, "land.stats.p2.b.value"), 79)
		</div>
		<div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
			@mockStat(i18n.T(ctx, "land.lift.backsquat"), "127 kg", i18n.T(ctx, "land.stats.squat.note"))
			@mockStat(i18n.T(ctx, "land.stats.5k"), "24:12", i18n.T(ctx, "land.stats.5k.note"))
			@mockStat(i18n.T(ctx, "land.stats.protein"), i18n.T(ctx, "land.stats.protein.value"), i18n.T(ctx, "land.stats.protein.note"))
			@mockStat(i18n.T(ctx, "land.stats.sleep"), "2h 10m", i18n.T(ctx, "land.stats.sleep.note"))
		</div>
	</section>
}

templ mockPattern(title, detail, aLabel, aValue string, aPct int, bLabel, bValue string, bPct int) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Content(card.ContentProps{Class: "space-y-4 py-5"}) {
			<div>
				<h3 class="text-base font-medium">{ title }</h3>
				<p class="text-muted-foreground mt-1 text-sm">{ detail }</p>
			</div>
			@mockBar(aLabel, aValue, aPct, "var(--north-signal)")
			@mockBar(bLabel, bValue, bPct, "var(--muted-foreground)")
		}
	}
}

templ mockBar(label, value string, pct int, color string) {
	<div class="text-sm">
		<div class="flex justify-between gap-2">
			<span>{ label }</span>
			<span class="text-muted-foreground tabular-nums">{ value }</span>
		</div>
		<div class="bg-muted mt-1 h-1.5 rounded-full">
			<div class="h-1.5 rounded-full" style={ "width:" + strconv.Itoa(pct) + "%;background:" + color }></div>
		</div>
	</div>
}

templ mockStat(label, value, note string) {
	<div class="border-hairline bg-surface/60 rounded-lg border p-4">
		<p class="text-muted-foreground font-mono text-[10px] tracking-[0.14em] uppercase">{ label }</p>
		<p class="mt-1 text-xl font-medium tabular-nums">{ value }</p>
		<p class="text-muted-foreground text-xs">{ note }</p>
	</div>
}

templ coachBuildsDemo() {
	<section id="coach-builds" class="border-hairline relative scroll-mt-20 border-t py-24">
		@sectionHeading(
			i18n.T(ctx, "land.builds.eyebrow"),
			i18n.T(ctx, "land.builds.title"),
			i18n.T(ctx, "land.builds.body"),
		)
		<div class="mt-10 grid gap-4 lg:grid-cols-2">
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Content(card.ContentProps{Class: "space-y-3 py-5"}) {
					@chatBubble(true, i18n.T(ctx, "land.builds.1.user"))
					@approvalCard(i18n.T(ctx, "land.builds.1.card.title"), i18n.T(ctx, "land.builds.1.card.body"))
					@chatBubble(false, i18n.T(ctx, "land.builds.1.reply"))
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Content(card.ContentProps{Class: "space-y-3 py-5"}) {
					@chatBubble(true, i18n.T(ctx, "land.builds.2.user"))
					@approvalCard(i18n.T(ctx, "land.builds.2.card.title"), i18n.T(ctx, "land.builds.2.card.body"))
					@chatBubble(false, i18n.T(ctx, "land.builds.2.reply"))
				}
			}
		</div>
	</section>
}

templ chatBubble(mine bool, text string) {
	if mine {
		<div class="flex justify-end">
			<p class="bg-signal/15 max-w-[85%] rounded-2xl rounded-br-sm px-3.5 py-2 text-sm">{ text }</p>
		</div>
	} else {
		<div class="flex">
			<p class="bg-muted/60 max-w-[85%] rounded-2xl rounded-bl-sm px-3.5 py-2 text-sm">{ text }</p>
		</div>
	}
}

templ approvalCard(title, body string) {
	<div class="border-signal/30 bg-signal/5 mx-auto max-w-[90%] rounded-xl border px-4 py-3">
		<div class="flex items-center gap-2 text-xs font-medium">
			@icon.Icon("shield-check")(icon.Props{Class: "text-signal size-3.5"})
			{ title }
		</div>
		<p class="text-muted-foreground mt-1 text-xs">{ body }</p>
		<div class="mt-2 flex gap-2">
			<span class="bg-signal text-background rounded-md px-2.5 py-1 text-[11px] font-medium">{ i18n.T(ctx, "land.builds.approve") }</span>
			<span class="border-hairline rounded-md border px-2.5 py-1 text-[11px]">{ i18n.T(ctx, "land.builds.change") }</span>
		</div>
	</div>
}

templ iphoneSection() {
	<section id="iphone" class="border-hairline relative scroll-mt-20 border-t py-24">
		<div class="grid items-center gap-12 lg:grid-cols-[1fr_20rem]">
			<div>
				@sectionHeading(
					i18n.T(ctx, "land.iphone.eyebrow"),
					i18n.T(ctx, "land.iphone.title"),
					i18n.T(ctx, "land.iphone.body"),
				)
				<ul class="mt-8 space-y-4">
					@phoneFeature("dumbbell", i18n.T(ctx, "land.iphone.1.title"), i18n.T(ctx, "land.iphone.1.body"))
					@phoneFeature("heart-pulse", i18n.T(ctx, "land.iphone.2.title"), i18n.T(ctx, "land.iphone.2.body"))
					@phoneFeature("timer", i18n.T(ctx, "land.iphone.3.title"), i18n.T(ctx, "land.iphone.3.body"))
					@phoneFeature("chart-line", i18n.T(ctx, "land.iphone.4.title"), i18n.T(ctx, "land.iphone.4.body"))
				</ul>
				@appButtons("mt-8")
			</div>
			@phoneMock()
		</div>
	</section>
}

templ phoneFeature(iconName, title, body string) {
	<li class="flex gap-3">
		<span class="bg-signal/12 text-signal flex size-8 shrink-0 items-center justify-center rounded-md">
			@icon.Icon(iconName)(icon.Props{Class: "size-4"})
		</span>
		<div>
			<h3 class="text-sm font-medium">{ title }</h3>
			<p class="text-muted-foreground mt-0.5 text-sm leading-relaxed">{ body }</p>
		</div>
	</li>
}

// phoneMock draws the set-entry sheet inside a phone outline.
templ phoneMock() {
	<div aria-hidden="true" class="border-hairline bg-background mx-auto w-full max-w-[18rem] rounded-[2.5rem] border-[6px] p-3 shadow-2xl shadow-black/20">
		<div class="bg-foreground/80 mx-auto mb-4 h-5 w-24 rounded-full"></div>
		<div class="px-2">
			<p class="text-muted-foreground font-mono text-[9px] tracking-[0.14em] uppercase">{ i18n.T(ctx, "land.phone.exercise") }</p>
			<p class="mt-2 text-lg font-semibold">{ i18n.T(ctx, "land.lift.backsquat") }</p>
			<p class="text-muted-foreground text-xs">{ i18n.T(ctx, "land.phone.set") }</p>
		</div>
		<div class="bg-surface border-hairline mt-4 rounded-2xl border p-4">
			<p class="text-muted-foreground text-center text-[10px] font-medium tracking-[0.1em] uppercase">{ i18n.T(ctx, "land.phone.weight") }</p>
			<div class="mt-2 flex items-center justify-between">
				<span class="text-signal flex size-8 items-center justify-center rounded-full border border-current">
					@icon.Icon("minus")(icon.Props{Class: "size-4"})
				</span>
				<span class="text-3xl font-semibold tabular-nums">{ i18n.T(ctx, "land.phone.kg") }<span class="text-muted-foreground text-sm font-normal">kg</span></span>
				<span class="text-signal flex size-8 items-center justify-center rounded-full border border-current">
					@icon.Icon("plus")(icon.Props{Class: "size-4"})
				</span>
			</div>
			<p class="text-muted-foreground mt-3 text-center text-[11px]">{ i18n.T(ctx, "land.phone.last") }</p>
			<div class="border-hairline mt-3 flex items-center justify-between border-t pt-3 text-sm">
				<span>{ i18n.T(ctx, "land.phone.reps") }</span>
				<span class="text-muted-foreground">− +</span>
			</div>
		</div>
		<div class="bg-signal text-background mt-4 rounded-xl py-2.5 text-center text-sm font-semibold">{ i18n.T(ctx, "land.phone.log") }</div>
		<p class="text-muted-foreground mt-3 mb-2 text-center text-[11px]">{ i18n.T(ctx, "land.phone.rest") }</p>
	</div>
}
