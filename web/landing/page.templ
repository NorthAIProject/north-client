package landing

import (
	"context"
	"fmt"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// Page is the signed-out marketing page.
//
// Its argument is continuity rather than capability, so it is built around
// demonstrations a visitor can operate instead of a list of features they have
// to take on trust. The sections are laid out along a time axis — the bearing
// line — because the claim Khepri is sold on is that it is still useful in month
// eight.
templ Page() {
	@layout.Public("", signedIn(ctx)) {
		<div x-data="northBearing" data-landing class="relative">
			@bearingRail()
			@hero()
			<div class="mx-auto w-full max-w-6xl px-6 lg:pl-28 lg:pr-8">
				@heroProof()
				@dayDemo()
				@statsDemo()
				@coachBuildsDemo()
				@iphoneSection()
				@muscleDemo()
				@goalDemo()
				@platformDemo()
				@toolsDemo()
				@featuresSection()
				@howItWorksSection()
				@visionSection()
				@pricingSection()
				@finalCTA()
			</div>
			@siteFooter()
		</div>
		@landingScripts()
	}
}

// bearingRail is the page's one piece of hand-rolled chrome. No component in
// the library describes a scroll-linked axis, and this one carries meaning:
// it is the horizon the product is sold on, filling as the reader travels it.
templ bearingRail() {
	<div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-10 hidden w-px bg-hairline lg:block">
		<div
			class="w-px bg-signal/70 transition-[height] duration-150 ease-out"
			x-bind:style="'height:' + progress + '%'"
		></div>
	</div>
	// Below lg the rail has nowhere to live, so the same signal becomes a
	// hairline of scroll progress pinned under the navbar.
	<div
		aria-hidden="true"
		class="pointer-events-none fixed left-0 top-14 z-40 h-px bg-signal/70 lg:hidden"
		x-bind:style="'width:' + progress + '%'"
	></div>
}

// waypoint marks a section's position on the bearing line. The labels are
// distances rather than an ordered list, which is why they are not 01 / 02 / 03.
templ waypoint(distance string) {
	<div aria-hidden="true" class="absolute -left-[4.5rem] top-14 hidden lg:block">
		<div class="-ml-[3px] flex items-center gap-2">
			<span class="size-1.5 rounded-full bg-signal"></span>
			@monoLabel(distance)
		</div>
	</div>
}

// monoLabel is a thin landing alias for the shared instrument voice.
templ monoLabel(text string) {
	@ui.MonoLabel(text)
}

// sectionHeading is the standard opening of every non-hero section.
templ sectionHeading(eyebrow string, title string, body string) {
	<div class="max-w-2xl">
		@monoLabel(eyebrow)
		<h2 class="mt-3 text-3xl font-medium tracking-[-0.03em] text-balance md:text-4xl">{ title }</h2>
		if body != "" {
			<p class="mt-4 text-base leading-relaxed text-muted-foreground">{ body }</p>
		}
	</div>
}

// hero is full-bleed so the card wall can run edge to edge; its text sits in
// the same column as every other section. Centred: the pill, a two-line
// headline, the lede, the store badges and the web call to action, with the
// wall fanned out underneath.
templ hero() {
	<section class="hero relative isolate overflow-hidden">
		<div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 h-[24rem] w-[42rem] -translate-x-1/2 -translate-y-1/4 rounded-full bg-signal/10 blur-[64px]"></div>
		<div class="mx-auto w-full max-w-6xl px-6 pt-16 md:pt-24 lg:pl-28 lg:pr-8">
			<div class="relative">
				@waypoint(i18n.T(ctx, "land.waypoint.day1"))
				<div class="mx-auto flex max-w-4xl flex-col items-center text-center">
					@heroPill()
					<h1 class="mt-7 text-4xl font-bold leading-[1.06] tracking-[-0.025em] sm:text-5xl lg:text-6xl">
						<span class="block text-balance">{ i18n.T(ctx, "land.hero.h1a") }</span>
						<span class="block text-balance text-muted-foreground">{ i18n.T(ctx, "land.hero.h1b") }</span>
					</h1>
					<p class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
						{ i18n.T(ctx, "land.hero.lede") }
					</p>
					@appButtons("mt-9 items-center justify-center")
					<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
						@button.Button(button.Props{Href: ctaHref(ctx), Size: button.SizeLg, Class: "bg-signal text-background hover:bg-signal/90"}) {
							{ ctaLabel(ctx) }
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
						@button.Button(button.Props{Href: "#product-film", Size: button.SizeLg, Variant: button.VariantOutline, Class: "border-hairline"}) {
							{ i18n.T(ctx, "land.hero.see") }
						}
					</div>
					<p class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
						@icon.Check(icon.Props{Class: "size-3.5 text-signal"})
						{ i18n.T(ctx, "land.hero.free") }
					</p>
				</div>
			</div>
		</div>
		@heroWall()
	</section>
}

// heroPill is the eyebrow over the headline, linked to the first section.
//
// Hand-rolled rather than badge.Badge: Badge renders a span, and this is a
// link with its own hover — the border warms to the signal and the arrow
// nudges right.
templ heroPill() {
	<a
		href="#day"
		class="group inline-flex max-w-full items-center gap-2 rounded-full border border-border/60 bg-surface/70 py-1 pl-2.5 pr-3 text-xs text-muted-foreground transition-colors hover:border-signal/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
	>
		<span class="size-1.5 shrink-0 rounded-full bg-signal"></span>
		<span class="text-left">{ i18n.T(ctx, "land.hero.badge") }</span>
		<span aria-hidden="true" class="text-muted-foreground/60 transition-transform group-hover:translate-x-0.5">→</span>
	</a>
}

// heroProof is what used to sit beside and under the hero: the tour strip,
// the product film and the five-month thread. It opens the content column.
templ heroProof() {
	<section class="relative pb-24 pt-14">
		@tourLinks()
		<div class="mt-10 grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
			@heroFilm()
			@heroThread()
		</div>
	</section>
}

// heroFilm is the short silent product loop for the signed-out marketing page.
// Muted + playsinline + loop so it autoplays on mobile without becoming a sound
// assault; the poster covers the first paint before the mp4 is ready.
templ heroFilm() {
	<div id="product-film" class="scroll-mt-20">
		<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
			<div>
				@monoLabel(i18n.T(ctx, "land.film.label"))
				<p class="mt-2 max-w-[54ch] text-sm leading-relaxed text-muted-foreground">
					{ i18n.T(ctx, "land.film.desc") }
				</p>
			</div>
			@monoLabel(i18n.T(ctx, "land.film.autoplay"))
		</div>
		<div class="overflow-hidden rounded-xl border border-hairline bg-surface shadow-[0_0_0_1px_color-mix(in_oklab,var(--north-signal)_12%,transparent)]">
			<video
				class="aspect-video w-full bg-background object-cover"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster="/assets/video/north-hero-poster.webp"
				aria-label={ i18n.T(ctx, "land.film.aria") }
			>
				<source src="/assets/video/north-hero.mp4" type="video/mp4"/>
			</video>
		</div>
	</div>
}

// heroThread states the memory claim and the multi-surface claim in one
// picture: a single conversation, five months long, four surfaces, nothing
// repeated back.
templ heroThread() {
	<div class="rounded-xl border border-hairline bg-surface p-5 md:p-6">
		<div class="flex items-center justify-between pb-5">
			@monoLabel(i18n.T(ctx, "land.thread.one"))
			@monoLabel(i18n.T(ctx, "land.thread.span"))
		</div>
		<ol class="space-y-5 border-l border-hairline pl-5">
			for i, e := range heroThreadEntries(ctx) {
				@threadEntry(e, i)
			}
		</ol>
	</div>
}

// threadTurn is one message in the hero conversation.
type threadTurn struct {
	Date     string
	Surface  string
	FromUser bool
	Body     string
}

// Surface names are product names and stay as they are. The dates and the
// messages come from the catalogue, and each language names its own mountain:
// a Portuguese national park in the Spanish copy is the clearest possible sign
// that the page was written for somebody else.
func heroThreadEntries(ctx context.Context) []threadTurn {
	return []threadTurn{
		{i18n.T(ctx, "land.thread.1.date"), "Web", true, i18n.T(ctx, "land.thread.1.body")},
		{i18n.T(ctx, "land.thread.2.date"), "Web", false, i18n.T(ctx, "land.thread.2.body")},
		{i18n.T(ctx, "land.thread.3.date"), "Telegram", true, i18n.T(ctx, "land.thread.3.body")},
		{i18n.T(ctx, "land.thread.4.date"), "WhatsApp", false, i18n.T(ctx, "land.thread.4.body")},
		{i18n.T(ctx, "land.thread.5.date"), "Discord", false, i18n.T(ctx, "land.thread.5.body")},
	}
}

templ threadEntry(t threadTurn, index int) {
	<li class="relative motion-safe:animate-thread-in" style={ threadDelay(index) }>
		<span
			class={ "absolute -left-[1.65rem] top-1.5 size-2 rounded-full ring-4 ring-surface",
				templ.KV("bg-muted-foreground/40", t.FromUser),
				templ.KV("bg-agent", !t.FromUser) }
		></span>
		<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
			@monoLabel(t.Date)
			<span class="text-hairline" aria-hidden="true">·</span>
			@monoLabel(t.Surface)
			if !t.FromUser {
				<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-agent">Khepri</span>
			}
		</div>
		<p class="mt-1.5 text-sm leading-relaxed text-foreground/90">{ t.Body }</p>
	</li>
}

// threadDelay staggers the entries so the thread assembles itself once on load.
// Under prefers-reduced-motion the animation utility never applies, which
// leaves the delay inert rather than merely faster.
func threadDelay(index int) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("animation-delay:%dms", 120*index))
}
