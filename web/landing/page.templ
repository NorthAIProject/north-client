package landing

import (
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/separator"
)

// principle mirrors the four ideas North is built around, as stated in the
// README. Kept as data rather than repeated markup so the page and the
// positioning cannot drift apart.
type principle struct {
	Icon templ.Component
	Name string
	Body string
}

func principles() []principle {
	return []principle{
		{
			Icon: icon.Brain(icon.Props{Class: "size-5"}),
			Name: "Persistent memory",
			Body: "Goals, preferences, check-ins, and progress carry across every conversation. You never start from scratch.",
		},
		{
			Icon: icon.Target(icon.Props{Class: "size-5"}),
			Name: "Context-aware coaching",
			Body: "Advice is built from your real life: active goals, recent reflections, calendar, and training history.",
		},
		{
			Icon: icon.Globe(icon.Props{Class: "size-5"}),
			Name: "Available everywhere",
			Body: "Web today, with Telegram, Discord, WhatsApp, and MCP sharing one continuous memory.",
		},
		{
			Icon: icon.Plug(icon.Props{Class: "size-5"}),
			Name: "Provider agnostic",
			Body: "Gemini, Claude, GPT, or Grok behind one internal interface. The model is an implementation detail.",
		},
	}
}

type capability struct {
	Icon templ.Component
	Name string
	Body string
}

func capabilities() []capability {
	return []capability{
		{icon.Dumbbell(icon.Props{Class: "size-5"}), "Training plans", "Describe your goal, your equipment, and the days you can train. Get a structured plan, not a wall of text."},
		{icon.Activity(icon.Props{Class: "size-5"}), "Form feedback", "Upload a set. Get timestamped notes on what to fix, tied to the moment it happens in your own video."},
		{icon.NotebookPen(icon.Props{Class: "size-5"}), "Daily check-ins", "Mood, energy, wins, and friction. Short entries that teach North how your weeks actually go."},
		{icon.FileText(icon.Props{Class: "size-5"}), "Your knowledge", "Documents, notes, and research the coach can search and reference when it is relevant."},
		{icon.Repeat(icon.Props{Class: "size-5"}), "Reviews", "Daily briefings and weekly reviews that summarise progress instead of asking you to remember it."},
		{icon.HeartPulse(icon.Props{Class: "size-5"}), "Fitness data", "Strava now, with Apple Health and Garmin to follow. Summaries, not raw activity dumps."},
	}
}

templ Page() {
	@layout.Public("") {
		@hero()
		@principlesSection()
		@capabilitiesSection()
		@closing()
		@footer()
	}
}

templ hero() {
	<section class="mx-auto max-w-5xl px-6 pt-20 pb-16 text-center md:pt-28">
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "mb-6"}) {
			@icon.Sparkles(icon.Props{Class: "size-3.5"})
			An operating system for personal growth
		}
		<h1 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-balance md:text-6xl">
			Most AI assistants answer questions.
			<span class="text-muted-foreground block">North helps you build a better life.</span>
		</h1>
		<p class="text-muted-foreground mx-auto mt-6 max-w-xl text-lg text-pretty">
			A coach that remembers who you are, what you are working towards, and how
			your life actually changes over months and years.
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
			@button.Button(button.Props{Size: button.SizeLg, Href: "/signup"}) {
				Create your account
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
			@button.Button(button.Props{Size: button.SizeLg, Variant: button.VariantOutline, Href: "/login"}) {
				Sign in
			}
		</div>
	</section>
}

templ principlesSection() {
	<section class="mx-auto max-w-5xl px-6 py-16">
		<div class="grid gap-4 sm:grid-cols-2">
			for _, p := range principles() {
				@card.Card() {
					@card.Header() {
						<div class="text-muted-foreground mb-2">
							@p.Icon
						</div>
						@card.Title() {
							{ p.Name }
						}
						@card.Description() {
							{ p.Body }
						}
					}
				}
			}
		</div>
	</section>
}

templ capabilitiesSection() {
	<section class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="text-2xl font-semibold tracking-tight md:text-3xl">What it does</h2>
		<p class="text-muted-foreground mt-2 max-w-xl">
			Coaching that has your context, not a chat window that forgets you.
		</p>
		@separator.Separator(separator.Props{Class: "my-8"})
		<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
			for _, c := range capabilities() {
				<div>
					<div class="text-muted-foreground mb-3">
						@c.Icon
					</div>
					<h3 class="font-medium">{ c.Name }</h3>
					<p class="text-muted-foreground mt-1 text-sm text-pretty">{ c.Body }</p>
				</div>
			}
		</div>
	</section>
}

templ closing() {
	<section class="mx-auto max-w-5xl px-6 py-16">
		@card.Card(card.Props{Class: "text-center"}) {
			@card.Header() {
				@card.Title(card.TitleProps{Class: "text-2xl"}) {
					North is not another chatbot.
				}
				@card.Description(card.DescriptionProps{Class: "mx-auto max-w-lg text-base"}) {
					It is a long-term thinking partner. The goal is not to replace your
					judgement — it is to sharpen it.
				}
			}
			@card.Content() {
				@button.Button(button.Props{Size: button.SizeLg, Href: "/signup"}) {
					Get started
					@icon.ArrowRight(icon.Props{Class: "size-4"})
				}
			}
		}
	</section>
}

templ footer() {
	<footer class="border-border/60 mt-8 border-t">
		<div class="text-muted-foreground mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-6 py-8 text-sm sm:flex-row">
			<span>North — your AI operating system for personal growth.</span>
			<a
				href="https://github.com/NorthAIProject/north-client"
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-foreground flex items-center gap-1.5 transition-colors"
			>
				@icon.Github(icon.Props{Class: "size-4"})
				Source
			</a>
		</div>
	</footer>
}
