package care

import (
	"context"
	"fmt"
	"strconv"
	"strings"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/habits"
	"github.com/NorthAIProject/north-client/internal/hydration"
	"github.com/NorthAIProject/north-client/internal/meals"
	"github.com/NorthAIProject/north-client/internal/shared/lifedomain"
	"github.com/NorthAIProject/north-client/internal/sleep"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/checkbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

// PanelID is the HTMX-swappable region for care writes.
const PanelID = "care-panel"

// Instruments holds chart configs for the care panel header.
type Instruments struct {
	HydrationChart chart.Props
	SleepChart     chart.Props
	HabitGauge     map[string]any
	HabitRate      int
	HasHydration   bool
	HasSleep       bool
	HasHabits      bool
	DueCount       int
}

// Data is everything the page renders.
type Data struct {
	DueReminders   []meals.Reminder
	AllReminders   []meals.Reminder
	CheckedInToday bool

	Water        hydration.Day
	WaterEntries []hydration.Entry

	LastNight      sleep.Log
	SleptLastNight bool

	Habits      []habits.Stats
	Instruments Instruments
}

// Forms carries whichever submission was rejected, so a failed write
// re-renders the whole page with that one form's errors rather than losing
// what someone typed.
type Forms struct {
	Reminder ReminderForm
	Water    WaterForm
	Sleep    SleepForm
	Habit    HabitForm
}

type ReminderForm struct {
	Label      string
	TimeOfDay  string
	DaysOfWeek []int
	Errors     map[string]string
}

type WaterForm struct {
	Errors map[string]string
}

type SleepForm struct {
	Hours    string
	Minutes  string
	Quality  string
	Bedtime  string
	WakeTime string
	Notes    string
	Errors   map[string]string
}

type HabitForm struct {
	Name       string
	Domain     string
	DaysOfWeek []int
	Errors     map[string]string
}

func fieldError(errs map[string]string, name string) string {
	if errs == nil {
		return ""
	}
	return errs[name]
}

func (f ReminderForm) fieldError(name string) string { return fieldError(f.Errors, name) }
func (f SleepForm) fieldError(name string) string    { return fieldError(f.Errors, name) }
func (f HabitForm) fieldError(name string) string    { return fieldError(f.Errors, name) }

func (f ReminderForm) dayChecked(day int) bool { return dayChecked(f.DaysOfWeek, day) }
func (f HabitForm) dayChecked(day int) bool    { return dayChecked(f.DaysOfWeek, day) }

// An untouched form defaults to every day: the common case for both a
// reminder and a habit is "daily", and an empty set would be rejected.
func dayChecked(days []int, day int) bool {
	if len(days) == 0 {
		return true
	}
	for _, d := range days {
		if d == day {
			return true
		}
	}
	return false
}

// weekdayLabel is the three-letter abbreviation for a Go time.Weekday index.
// Abbreviations rather than full names because seven of them sit in one row on
// a phone.
func weekdayLabel(ctx context.Context, d int) string {
	if d < 0 || d > 6 {
		return ""
	}
	return i18n.T(ctx, "weekday.short."+strconv.Itoa(d))
}

func daysSummary(ctx context.Context, days []int) string {
	if len(days) == 7 {
		return i18n.T(ctx, "care.rem.everyday")
	}
	labels := make([]string, 0, len(days))
	for _, d := range days {
		if label := weekdayLabel(ctx, d); label != "" {
			labels = append(labels, label)
		}
	}
	return strings.Join(labels, ", ")
}

func litres(ml int) string { return fmt.Sprintf("%.1fL", float64(ml)/1000) }

func amountLabel(ml int) string {
	if ml >= 1000 {
		return litres(ml)
	}
	return fmt.Sprintf("%dml", ml)
}

func panelSwapAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-target": "#" + PanelID,
		"hx-select": "#" + PanelID,
		"hx-swap":   "outerHTML",
	}
}

templ Page(user users.User, data Data, forms Forms) {
	@layout.App(i18n.T(ctx, "care.mono"), user, layout.BuildNav(ctx, "/app/care")) {
		@Panel(user, data, forms)
		@label.Script()
		@checkbox.Script()
		@input.Script()
		@selectbox.Script()
		@progress.Script()
		@ui.ChartScripts()
	}
}

templ Panel(user users.User, data Data, forms Forms) {
	<div id={ PanelID } class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
		<header>
			@ui.MonoLabel(i18n.T(ctx, "care.mono"))
			<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "care.heading") }</h1>
			<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
				{ i18n.T(ctx, "care.intro") }
			</p>
		</header>
		@kpiStrip(data)
		@instrumentsRow(data)
		@checkInCard(data.CheckedInToday)
		@waterCard(data.Water, data.WaterEntries, forms.Water)
		@sleepCard(data.LastNight, data.SleptLastNight, forms.Sleep)
		@habitsCard(data.Habits, forms.Habit)
		@remindersCard(data.DueReminders)
		@manageRemindersCard(data.AllReminders, forms.Reminder)
	</div>
}

templ kpiStrip(data Data) {
	@ui.KpiStrip() {
		@kpiCell(i18n.T(ctx, "care.kpi.water"), waterKPI(data), "", "")
		@kpiCell(i18n.T(ctx, "care.kpi.sleep"), sleepKPI(data), "", "")
		@kpiCell(i18n.T(ctx, "care.kpi.habits"), habitKPI(data), "", "")
		@kpiCell(i18n.T(ctx, "care.kpi.due"), dueKPI(ctx, data), "", "")
		@kpiCell(i18n.T(ctx, "care.kpi.checkin"), checkInKPI(ctx, data), "/app/check-ins", checkInCTA(ctx, data))
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func waterKPI(data Data) string {
	return fmt.Sprintf("%s / %s", litres(data.Water.TotalML), litres(data.Water.TargetML))
}

func sleepKPI(data Data) string {
	if !data.SleptLastNight {
		return "—"
	}
	return data.LastNight.Duration()
}

func habitKPI(data Data) string {
	if !data.Instruments.HasHabits {
		return "—"
	}
	return strconv.Itoa(data.Instruments.HabitRate) + "%"
}

func dueKPI(ctx context.Context, data Data) string {
	if data.Instruments.DueCount == 0 {
		return i18n.T(ctx, "care.kpi.none")
	}
	return strconv.Itoa(data.Instruments.DueCount)
}

func checkInKPI(ctx context.Context, data Data) string {
	if data.CheckedInToday {
		return i18n.T(ctx, "care.kpi.done")
	}
	return i18n.T(ctx, "care.kpi.pending")
}

func checkInCTA(ctx context.Context, data Data) string {
	if data.CheckedInToday {
		return i18n.T(ctx, "care.kpi.edit")
	}
	return i18n.T(ctx, "care.kpi.checkcta")
}

templ instrumentsRow(data Data) {
	<div class="grid gap-4 lg:grid-cols-3">
		@hydrationInstrument(data)
		@sleepInstrument(data)
		@habitInstrument(data)
	</div>
}

templ hydrationInstrument(data Data) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.inst.hydration") }
			}
		}
		@card.Content() {
			if data.Instruments.HasHydration {
				@chart.Chart(data.Instruments.HydrationChart)
			} else {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "care.inst.hydration.empty") }</p>
			}
		}
	}
}

templ sleepInstrument(data Data) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.inst.sleep") }
			}
		}
		@card.Content() {
			if data.Instruments.HasSleep {
				@chart.Chart(data.Instruments.SleepChart)
			} else {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "care.inst.sleep.empty") }</p>
			}
		}
	}
}

templ habitInstrument(data Data) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.inst.habits") }
			}
		}
		@card.Content() {
			if data.Instruments.HasHabits && len(data.Instruments.HabitGauge) > 0 {
				@templ.JSONScript("care-habit-gauge-option", data.Instruments.HabitGauge)
				@ui.EChartsMount("care-habit-gauge", "care-habit-gauge-option", "min-h-40 w-full")
			} else {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "care.inst.habits.empty") }</p>
			}
		}
	}
}

templ checkInCard(checkedInToday bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.checkin.title") }
			}
			@card.Description() {
				if checkedInToday {
					{ i18n.T(ctx, "care.checkin.done") }
				} else {
					{ i18n.T(ctx, "care.checkin.pending") }
				}
			}
		}
		if !checkedInToday {
			@card.Content() {
				@button.Button(button.Props{Href: "/app/check-ins", Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "care.kpi.checkcta") }
				}
			}
		}
	}
}

templ waterCard(day hydration.Day, entries []hydration.Entry, f WaterForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.water.title") }
			}
			@card.Description() {
				{ i18n.Tf(ctx, "care.water.desc", litres(day.TotalML), litres(day.TargetML)) }
			}
		}
		@card.Content() {
			@progress.Progress(progress.Props{Value: day.Percent(), Class: "mb-4"})
			if msg := fieldError(f.Errors, "amount_ml"); msg != "" {
				@form.Message(form.MessageProps{Variant: form.MessageVariantError, Class: "mb-3"}) {
					{ msg }
				}
			}
			<div class="flex flex-wrap gap-2">
				for _, amount := range hydration.QuickAmounts {
					<form method="post" action="/app/care/water" { panelSwapAttrs()... }>
						@ui.CSRFInput()
						<input type="hidden" name="amount_ml" value={ strconv.Itoa(amount) }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
							+ { amountLabel(amount) }
						}
					</form>
				}
			</div>
			if len(entries) > 0 {
				<ul class="mt-4 space-y-1">
					for _, e := range entries {
						<li class="text-muted-foreground flex items-center justify-between text-xs">
							<span>{ amountLabel(e.AmountML) } at { e.LoggedAt.Format("15:04") }</span>
							<form method="post" action={ templ.SafeURL("/app/care/water/" + e.ID.String() + "/undo") } { panelSwapAttrs()... }>
								@ui.CSRFInput()
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
									{ i18n.T(ctx, "care.water.undo") }
								}
							</form>
						</li>
					}
				</ul>
			}
		}
	}
}

templ sleepCard(last sleep.Log, logged bool, f SleepForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.sleep.title") }
			}
			@card.Description() {
				if logged {
					{ i18n.Tf(ctx, "care.sleep.last", last.Duration()) }
					if last.Quality != nil {
						{ i18n.Tf(ctx, "care.sleep.quality.suffix", strconv.Itoa(*last.Quality)) }
					}
				} else {
					{ i18n.T(ctx, "care.sleep.empty") }
				}
			}
		}
		@card.Content() {
			<form method="post" action="/app/care/sleep" class="space-y-4" { panelSwapAttrs()... }>
				@ui.CSRFInput()
				<div class="flex flex-wrap gap-4">
					@form.Item() {
						@label.Label(label.Props{For: "hours"}) {
							{ i18n.T(ctx, "care.sleep.hours") }
						}
						@input.Input(input.Props{
							ID: "hours", Name: "hours", Type: input.TypeNumber,
							Value:      f.Hours,
							HasError:   f.fieldError("duration_minutes") != "",
							Attributes: templ.Attributes{"min": "0", "max": "24", "placeholder": "7"},
						})
					}
					@form.Item() {
						@label.Label(label.Props{For: "minutes"}) {
							{ i18n.T(ctx, "care.sleep.minutes") }
						}
						@input.Input(input.Props{
							ID: "minutes", Name: "minutes", Type: input.TypeNumber,
							Value:      f.Minutes,
							Attributes: templ.Attributes{"min": "0", "max": "59", "step": "5", "placeholder": "30"},
						})
					}
					@form.Item() {
						@label.Label(label.Props{For: "quality"}) {
							{ i18n.T(ctx, "care.sleep.quality") }
						}
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "quality", Name: "quality"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "care.sleep.quality.ph")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								for _, q := range []string{"1", "2", "3", "4", "5"} {
									@selectbox.Item(selectbox.ItemProps{Value: q, Selected: f.Quality == q}) {
										{ q } / 5
									}
								}
							}
						}
					}
				</div>
				if msg := f.fieldError("duration_minutes"); msg != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ msg }
					}
				}
				<div class="flex flex-wrap gap-4">
					@form.Item() {
						@label.Label(label.Props{For: "bedtime"}) {
							{ i18n.T(ctx, "care.sleep.bedtime") }
						}
						@input.Input(input.Props{ID: "bedtime", Name: "bedtime", Type: input.TypeTime, Value: f.Bedtime, HasError: f.fieldError("bedtime") != ""})
					}
					@form.Item() {
						@label.Label(label.Props{For: "wake_time"}) {
							{ i18n.T(ctx, "care.sleep.woke") }
						}
						@input.Input(input.Props{ID: "wake_time", Name: "wake_time", Type: input.TypeTime, Value: f.WakeTime, HasError: f.fieldError("wake_time") != ""})
					}
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					if logged {
						{ i18n.T(ctx, "care.sleep.update") }
					} else {
						{ i18n.T(ctx, "care.sleep.log") }
					}
				}
			</form>
		}
	}
}

templ habitsCard(stats []habits.Stats, f HabitForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.habits.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "care.habits.desc") }
			}
		}
		@card.Content() {
			if len(stats) > 0 {
				<ul class="mb-6 space-y-2">
					for _, s := range stats {
						@habitRow(s)
					}
				</ul>
			}
			<form method="post" action="/app/care/habits" class="space-y-4" { panelSwapAttrs()... }>
				@ui.CSRFInput()
				<div class="flex flex-wrap gap-4">
					@form.Item() {
						@label.Label(label.Props{For: "name"}) {
							{ i18n.T(ctx, "care.habits.new") }
						}
						@input.Input(input.Props{
							ID: "name", Name: "name", Value: f.Name,
							Placeholder: i18n.T(ctx, "care.habits.new.ph"),
							HasError:    f.fieldError("name") != "",
						})
					}
					@form.Item() {
						@label.Label(label.Props{For: "domain"}) {
							{ i18n.T(ctx, "care.habits.area") }
						}
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "domain", Name: "domain"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "lifedomain.personal")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								for _, d := range lifedomain.Domains {
									@selectbox.Item(selectbox.ItemProps{Value: d, Selected: f.Domain == d}) {
										{ i18n.T(ctx, "lifedomain."+d) }
									}
								}
							}
						}
					}
				</div>
				if msg := f.fieldError("name"); msg != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ msg }
					}
				}
				<div>
					@label.Label() {
						{ i18n.T(ctx, "care.habits.days") }
					}
					<div class="mt-2 flex flex-wrap gap-3">
						for d := 0; d < 7; d++ {
							<label class="flex items-center gap-1 text-sm">
								@checkbox.Checkbox(checkbox.Props{Name: "days_of_week", Value: strconv.Itoa(d), Checked: f.dayChecked(d)})
								{ weekdayLabel(ctx, d) }
							</label>
						}
					</div>
					if msg := f.fieldError("days"); msg != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError, Class: "mt-2"}) {
							{ msg }
						}
					}
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "care.habits.add") }
				}
			</form>
		}
	}
}

templ habitRow(s habits.Stats) {
	<li class="border-hairline flex items-center justify-between gap-3 rounded-lg border px-3 py-2">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm font-medium">{ s.Habit.Name }</span>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ s.Habit.Domain }
				}
				if s.Streak > 0 {
					<span class="text-signal font-mono text-[10px] uppercase tracking-[0.14em]">
						{ strconv.Itoa(s.Streak) } day streak
					</span>
				}
			</div>
			<p class="text-muted-foreground mt-0.5 text-xs">
				{ s.Habit.Schedule() }
				if s.Scheduled > 0 {
					· kept { strconv.Itoa(s.Kept) } of { strconv.Itoa(s.Scheduled) } this week
				}
			</p>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			if s.ScheduledToday {
				<form method="post" action={ templ.SafeURL("/app/care/habits/" + s.Habit.ID.String() + "/toggle") } { panelSwapAttrs()... }>
					@ui.CSRFInput()
					<input type="hidden" name="done" value={ doneValue(s.DoneToday) }/>
					if s.DoneToday {
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ i18n.T(ctx, "care.habits.done") }
						}
					} else {
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
							Mark done
						}
					}
				</form>
			} else {
				// Not due today is not the same as missed, and should not read
				// like a failure.
				<span class="text-muted-foreground text-xs">Not today</span>
			}
			<form method="post" action={ templ.SafeURL("/app/care/habits/" + s.Habit.ID.String() + "/delete") } { panelSwapAttrs()... }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ i18n.T(ctx, "care.habits.delete") }
				}
			</form>
		</div>
	</li>
}

templ remindersCard(due []meals.Reminder) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.rem.title") }
			}
			@card.Description() {
				if len(due) > 0 {
					{ i18n.T(ctx, "care.rem.due") }
				} else {
					{ i18n.T(ctx, "care.rem.none") }
				}
			}
		}
		if len(due) > 0 {
			@card.Content() {
				<ul class="space-y-2">
					for _, r := range due {
						<li class="flex items-center justify-between text-sm">
							<span>{ r.Label }</span>
							<span class="text-muted-foreground text-xs">{ r.TimeOfDay }</span>
						</li>
					}
				</ul>
			}
		}
	}
}

templ manageRemindersCard(all []meals.Reminder, f ReminderForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "care.rem.manage") }
			}
		}
		@card.Content() {
			if len(all) > 0 {
				<ul class="mb-4 space-y-2">
					for _, r := range all {
						@reminderRow(r)
					}
				</ul>
			}
			<form method="post" action="/app/care/reminders" class="space-y-4" { panelSwapAttrs()... }>
				@ui.CSRFInput()
				<div class="flex gap-4">
					@form.Item() {
						@label.Label(label.Props{For: "label"}) {
							{ i18n.T(ctx, "care.rem.label") }
						}
						@input.Input(input.Props{ID: "label", Name: "label", Value: f.Label, Placeholder: i18n.T(ctx, "care.rem.label.ph"), Required: true, HasError: f.fieldError("label") != ""})
					}
					@form.Item() {
						@label.Label(label.Props{For: "time_of_day"}) {
							{ i18n.T(ctx, "care.rem.time") }
						}
						@input.Input(input.Props{ID: "time_of_day", Name: "time_of_day", Type: input.TypeTime, Value: f.TimeOfDay, Required: true, HasError: f.fieldError("time_of_day") != ""})
					}
				</div>
				<div>
					@label.Label() {
						{ i18n.T(ctx, "care.rem.days") }
					}
					<div class="mt-2 flex flex-wrap gap-3">
						for d := 0; d < 7; d++ {
							<label class="flex items-center gap-1 text-sm">
								@checkbox.Checkbox(checkbox.Props{Name: "days_of_week", Value: strconv.Itoa(d), Checked: f.dayChecked(d)})
								{ weekdayLabel(ctx, d) }
							</label>
						}
					</div>
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "care.rem.add") }
				}
			</form>
		}
	}
}

templ reminderRow(r meals.Reminder) {
	<li class="border-hairline flex items-center justify-between rounded-lg border px-3 py-2 text-sm">
		<div>
			<span class="font-medium">{ r.Label }</span>
			<span class="text-muted-foreground ml-2">{ r.TimeOfDay } · { daysSummary(ctx, r.DaysOfWeek) }</span>
		</div>
		<div class="flex items-center gap-2">
			<form method="post" action={ templ.SafeURL("/app/care/reminders/" + r.ID.String() + "/toggle") } { panelSwapAttrs()... }>
				@ui.CSRFInput()
				<input type="hidden" name="enabled" value={ toggleValue(r.Enabled) }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					if r.Enabled {
						{ i18n.T(ctx, "care.rem.disable") }
					} else {
						{ i18n.T(ctx, "care.rem.enable") }
					}
				}
			</form>
			<form method="post" action={ templ.SafeURL("/app/care/reminders/" + r.ID.String() + "/delete") } { panelSwapAttrs()... }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ i18n.T(ctx, "care.rem.delete") }
				}
			</form>
		</div>
	</li>
}

func toggleValue(currentlyEnabled bool) string {
	if currentlyEnabled {
		return "false"
	}
	return "true"
}

// The form submits the state it wants, not a flip, so a double submit is
// idempotent rather than toggling twice.
func doneValue(currentlyDone bool) string {
	if currentlyDone {
		return "false"
	}
	return "true"
}
