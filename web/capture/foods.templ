package capture

import (
	"fmt"
	"strconv"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/capture/captured"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/checkbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/dictate"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// MealVoiceData is one meal's "say what's in it" box, and what was read from
// it once somebody asked.
type MealVoiceData struct {
	MealID string
	// Text is kept across every render, so a mis-heard word is corrected in
	// the box and read again rather than retyped.
	Text   string
	Draft  captured.FoodDraft
	Parsed bool
	Error  string
}

func mealVoiceID(mealID string) string     { return "meal-voice-" + mealID }
func mealVoiceTextID(mealID string) string { return "meal-voice-text-" + mealID }

// MealVoice is swapped whole on every read. The review under the box posts
// straight to the meal, as a plain form: adding is a write to a page that then
// needs its totals redrawn, and the redirect back already does that.
//
// The page holding it must include dictate.Script().
templ MealVoice(data MealVoiceData) {
	<div id={ mealVoiceID(data.MealID) } class="space-y-3">
		@mealVoiceComposer(data)
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Description() {
					{ data.Error }
				}
			}
		}
		if data.Parsed {
			@mealVoiceReview(data)
		}
	</div>
}

templ mealVoiceComposer(data MealVoiceData) {
	<form
		hx-post="/app/capture/foods"
		hx-target={ "#" + mealVoiceID(data.MealID) }
		hx-swap="outerHTML"
		hx-disable="find button"
		method="post"
		action="/app/capture/foods"
		class="space-y-2"
	>
		@ui.CSRFInput()
		<input type="hidden" name="meal_id" value={ data.MealID }/>
		@textarea.Textarea(textarea.Props{
			ID:          mealVoiceTextID(data.MealID),
			Name:        "text",
			Value:       data.Text,
			Rows:        2,
			Placeholder: "Or say what's in it: 200 g chicken breast, 100 g rice and two eggs",
			Attributes:  templ.Attributes{"maxlength": strconv.Itoa(captured.MaxText)},
		})
		<div class="flex items-center justify-end gap-2">
			// Metered as a voice capture, not dictation: the words have a parse
			// behind them, exactly as on the quick capture page.
			@dictate.Button(dictate.Props{
				Target:  mealVoiceTextID(data.MealID),
				Surface: "capture",
				Variant: button.VariantOutline,
			})
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
				Find ingredients
			}
		</div>
	</form>
}

templ mealVoiceReview(data MealVoiceData) {
	if len(data.Draft.Lines) == 0 {
		<p class="text-sm text-muted-foreground">
			No food found in that. Name each food and how much, such as "150 g salmon".
		</p>
	} else {
		<form
			method="post"
			action={ templ.SafeURL("/app/nutrition/meals/" + data.MealID + "/ingredients/batch") }
			class="space-y-2"
		>
			@ui.CSRFInput()
			for i, line := range data.Draft.Lines {
				@mealVoiceLine(i, line)
			}
			if anyChoosable(data.Draft.Lines) {
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Add to meal
					}
				</div>
			}
		</form>
	}
	if len(data.Draft.Unparsed) > 0 {
		<div class="text-xs text-muted-foreground">
			<p>Not added:</p>
			<ul class="mt-1 space-y-0.5">
				for _, text := range data.Draft.Unparsed {
					<li>&ldquo;{ text }&rdquo;</li>
				}
			</ul>
		</div>
	}
}

// mealVoiceLine is one portion. Its fields are suffixed with the line's index
// and the checkbox posts that index, so an unticked line drops out whole
// instead of shifting every later quantity onto the wrong food.
templ mealVoiceLine(index int, line captured.FoodLine) {
	{{ n := strconv.Itoa(index) }}
	@card.Card(card.Props{Class: "p-3"}) {
		<div class="flex items-start gap-3">
			if len(line.Candidates) > 0 {
				// Ticked only when the name resolved on its own. An ambiguous line
				// waits for the person to choose, so Add can never post a line
				// with no ingredient behind it by default.
				@checkbox.Checkbox(checkbox.Props{
					Name:    "line",
					Value:   n,
					Checked: line.IngredientID != uuid.Nil,
					Class:   "mt-2.5",
				})
			} else {
				<span class="mt-2.5 inline-block size-4 shrink-0 rounded border border-dashed" aria-hidden="true"></span>
			}
			<div class="min-w-0 flex-1 space-y-1">
				<div class="flex flex-wrap items-center gap-2">
					if len(line.Candidates) > 0 {
						<div class="min-w-0 flex-1">
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "ingredient_id_" + n}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: "Which " + line.Query + "?"})
								}
								@selectbox.Content() {
									for _, c := range line.Candidates {
										@selectbox.Item(selectbox.ItemProps{Value: c.ID.String(), Selected: c.ID == line.IngredientID}) {
											{ c.Name }
										}
									}
								}
							}
						</div>
						<div class="flex items-center gap-1">
							@numberInput("quantity_grams_"+n, strconv.FormatFloat(line.Grams, 'f', -1, 64))
							<span class="text-sm text-muted-foreground">g</span>
						</div>
					} else {
						<p class="text-sm">{ fmt.Sprintf("%g g %s", line.Grams, line.Query) }</p>
					}
					if line.Uncertain {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
							estimated
						}
					}
				</div>
				if line.Source != "" {
					<p class="truncate text-xs text-muted-foreground">&ldquo;{ line.Source }&rdquo;</p>
				}
				if line.Problem != "" {
					<p class="text-xs text-destructive">{ line.Problem }</p>
				} else if line.IngredientID == uuid.Nil {
					<p class="text-xs text-muted-foreground">More than one ingredient matches. Choose one, then tick it.</p>
				}
			</div>
		</div>
	}
}

func anyChoosable(lines []captured.FoodLine) bool {
	for _, line := range lines {
		if len(line.Candidates) > 0 {
			return true
		}
	}
	return false
}
