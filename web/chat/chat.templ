package chat

import (
	"fmt"
	"net/url"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/conversations"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/markdown"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// signalCTA is the shared continuity primary for coach entry points.
const signalCTA = "bg-signal text-background hover:bg-signal/90"

// proseClasses styles rendered markdown.
//
// Written as arbitrary variants rather than a stylesheet rule so the styling
// travels with the component and nothing has to be kept in sync in input.css.
const proseClasses = "text-sm " +
	"[&>*:first-child]:mt-0 [&>*:last-child]:mb-0 " +
	"[&_p]:my-2 [&_p]:leading-relaxed " +
	"[&_ul]:my-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 " +
	"[&_ol]:my-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-1 " +
	"[&_strong]:font-semibold " +
	"[&_h1]:mt-3 [&_h1]:mb-1 [&_h1]:text-base [&_h1]:font-semibold " +
	"[&_h2]:mt-3 [&_h2]:mb-1 [&_h2]:text-sm [&_h2]:font-semibold " +
	"[&_h3]:mt-3 [&_h3]:mb-1 [&_h3]:text-sm [&_h3]:font-semibold " +
	"[&_code]:bg-background/60 [&_code]:rounded [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs " +
	"[&_pre]:bg-background/60 [&_pre]:my-2 [&_pre]:overflow-x-auto [&_pre]:rounded-md [&_pre]:p-3 " +
	"[&_pre_code]:bg-transparent [&_pre_code]:p-0 " +
	"[&_a]:underline [&_a]:underline-offset-2 " +
	"[&_blockquote]:border-l-2 [&_blockquote]:border-current/20 [&_blockquote]:pl-3 [&_blockquote]:italic " +
	"[&_table]:my-2 [&_table]:w-full [&_table]:text-left " +
	"[&_th]:border-b [&_th]:border-current/20 [&_th]:pb-1 [&_th]:font-medium " +
	"[&_td]:py-1"

// starters seed a brand new conversation. A blank box is the hardest thing to
// answer; these say what North is for better than a paragraph of explanation.
var starters = []string{
	"I want to get stronger but I don't know where to start.",
	"Help me build a habit I'll actually keep.",
	"I've been training for a month and feel stuck.",
	"I keep starting things and not finishing them.",
}

// CoachStats is sidebar instrumentation for the coach page.
type CoachStats struct {
	ThreadCount      int
	MessagesThisWeek int
}

// Page is a conversation with its history and composer.
templ Page(user users.User, conversation conversations.Conversation, messages []conversations.Message, list []conversations.Conversation, stats CoachStats) {
	@layout.App(conversation.DisplayTitle(), user, layout.BuildNav("/app/chat")) {
		<div id="chat-root" class="flex h-full" x-data="{ threads: false }">
			@threadList(list, conversation.ID, stats)
			<div class="flex min-w-0 flex-1 flex-col">
				@chatHeader(conversation)
				@transcript(messages, conversation)
				if !conversation.Ended() {
					@composer(conversation.ID, "")
				}
			</div>
		</div>
	}
}

// Empty is what a user with no conversations sees.
templ Empty(user users.User, list []conversations.Conversation, stats CoachStats) {
	@layout.App("Coach", user, layout.BuildNav("/app/chat")) {
		if len(list) > 0 {
			<div class="border-border border-b px-3 py-2 lg:hidden">
				@coachKpiStrip(stats)
			</div>
		}
		<div class="flex h-full flex-col items-center justify-center gap-4 p-8 text-center">
			@ui.MonoLabel("Day 1 · no sessions yet")
			<h1 class="text-xl font-medium tracking-tight">Talk to your coach</h1>
			<p class="text-muted-foreground max-w-sm text-sm leading-relaxed">
				North remembers what you tell it. Start with what you are working on.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-2">
				<form method="post" action="/app/chat">
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Class: signalCTA}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						New conversation
					}
				</form>
				@startReflectionForm(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline})
			</div>
		</div>
	}
}

// chatHeader carries the title and the actions that belong to this thread. On
// small screens it also owns the toggle for the thread list, which has nowhere
// else to live once the sidebar is hidden.
templ chatHeader(c conversations.Conversation) {
	<header class="border-border flex h-12 shrink-0 items-center justify-between gap-2 border-b px-3">
		<div class="flex min-w-0 items-center gap-2">
			<button
				type="button"
				@click="threads = !threads"
				class="hover:bg-accent rounded-md p-1.5 lg:hidden"
				aria-label="Show conversations"
			>
				@icon.PanelLeft(icon.Props{Class: "size-4"})
			</button>
			<span class="truncate text-sm font-medium">{ c.DisplayTitle() }</span>
			if c.IsReflection() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					Reflection
				}
			}
		</div>
		// A conversation is memory. Deleting one takes a deliberate second
		// action rather than a stray tap on a small screen.
		<form
			method="post"
			action={ templ.SafeURL("/app/chat/" + c.ID.String() + "/delete") }
			@submit="if (!confirm('Delete this conversation? Everything in it is lost.')) $event.preventDefault()"
		>
			@ui.CSRFInput()
			<button
				type="submit"
				class="text-muted-foreground hover:bg-accent hover:text-destructive rounded-md p-1.5 transition-colors"
				aria-label="Delete conversation"
			>
				@icon.Trash2(icon.Props{Class: "size-4"})
			</button>
		</form>
	</header>
}

templ threadList(list []conversations.Conversation, current uuid.UUID, stats CoachStats) {
	// Hidden off-canvas on small screens and pinned open from lg up, so one
	// piece of markup serves both rather than two that can drift.
	<aside
		class="border-border bg-card absolute inset-y-0 left-0 z-30 flex w-64 shrink-0 flex-col border-r transition-transform lg:static lg:z-auto lg:translate-x-0"
		:class="threads ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
	>
		<div class="border-border space-y-3 border-b p-3">
			@coachKpiStrip(stats)
			<div class="space-y-2">
				<form method="post" action="/app/chat">
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true, Size: button.SizeSm}) {
						@icon.Plus(icon.Props{Class: "size-4"})
						New conversation
					}
				</form>
				@startReflectionForm(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true, Size: button.SizeSm})
			</div>
		</div>
		<nav class="flex-1 space-y-0.5 overflow-y-auto p-2">
			for _, c := range list {
				@threadLink(c, c.ID == current)
			}
		</nav>
	</aside>
	<div
		x-show="threads"
		x-cloak
		@click="threads = false"
		class="fixed inset-0 z-20 bg-black/50 lg:hidden"
	></div>
}

templ coachKpiStrip(stats CoachStats) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{Label: "Threads", Value: fmt.Sprintf("%d", stats.ThreadCount)})
		@ui.KpiCell(ui.KpiCellProps{Label: "Messages", Value: fmt.Sprintf("%d", stats.MessagesThisWeek)})
	}
}

templ threadLink(c conversations.Conversation, active bool) {
	if active {
		<a
			href={ templ.SafeURL("/app/chat/" + c.ID.String()) }
			aria-current="page"
			class="text-foreground relative flex items-center gap-2 truncate rounded-md py-2 pl-3 pr-3 text-sm font-medium before:absolute before:inset-y-1.5 before:left-0 before:w-0.5 before:rounded-full before:bg-signal"
		>
			<span class="min-w-0 truncate">{ c.DisplayTitle() }</span>
			if c.IsReflection() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "shrink-0"}) {
					Reflection
				}
			}
		</a>
	} else {
		<a
			href={ templ.SafeURL("/app/chat/" + c.ID.String()) }
			class="text-muted-foreground hover:bg-accent/60 hover:text-foreground flex items-center gap-2 truncate rounded-md px-3 py-2 text-sm transition-colors"
		>
			<span class="min-w-0 truncate">{ c.DisplayTitle() }</span>
			if c.IsReflection() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "shrink-0"}) {
					Reflection
				}
			}
		</a>
	}
}

templ startReflectionForm(props button.Props) {
	<form method="post" action="/app/chat">
		@ui.CSRFInput()
		<input type="hidden" name="kind" value="reflection"/>
		@button.Button(props) {
			Start a reflection
		}
	</form>
}

// transcript holds the message history. New turns are appended into it by HTMX,
// and Alpine keeps it scrolled to the bottom as content arrives.
templ transcript(messages []conversations.Message, conversation conversations.Conversation) {
	<div
		id="transcript"
		class="min-h-0 flex-1 overflow-y-auto"
		x-data="{
			pin() { this.$el.scrollTop = this.$el.scrollHeight }
		}"
		x-init="pin(); new MutationObserver(() => pin()).observe($el, { childList: true, subtree: true, characterData: true })"
	>
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6">
			if conversation.IsReflection() && len(messages) == 0 && !conversation.Ended() {
				@beginReflectionExchange(conversation.ID)
			} else if len(messages) == 0 {
				@conversationStarters()
			} else {
				for _, m := range messages {
					@Bubble(m)
				}
			}
			if conversation.Ended() {
				@reflectionClose(conversation)
			}
		</div>
	</div>
}

templ beginReflectionExchange(conversationID uuid.UUID) {
	<div class="flex flex-col items-start gap-1" hx-ext="sse" sse-connect={ beginStreamURL(conversationID) } sse-close="done">
		<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-agent">North</span>
		<div
			class="border-hairline bg-surface max-w-[85%] rounded-2xl rounded-bl-sm border px-4 py-2.5 text-sm whitespace-pre-wrap"
			sse-swap="token,error"
			hx-swap="beforeend"
		></div>
		<div
			class="hidden"
			hx-trigger="sse:done"
			hx-get={ "/app/chat/" + conversationID.String() }
			hx-target="#chat-root"
			hx-select="#chat-root"
			hx-swap="outerHTML"
		></div>
	</div>
}

func beginStreamURL(conversationID uuid.UUID) string {
	return "/app/chat/" + conversationID.String() + "/stream?begin=1"
}

templ reflectionClose(c conversations.Conversation) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Reflection summary
			}
		}
		@card.Content(card.ContentProps{Class: proseClasses}) {
			@markdown.Render(c.Summary)
		}
	}
	<div
		id="reflection-memories"
		hx-get={ "/app/memories/for/" + c.ID.String() }
		hx-trigger="load"
		hx-swap="innerHTML"
	></div>
}

// conversationStarters fills an empty thread with something to click. Answering
// a blank box is the hardest part of talking to a coach for the first time.
templ conversationStarters() {
	<div class="flex flex-col items-center gap-4 py-12 text-center">
		@ui.MonoLabel("This thread")
		<h2 class="text-lg font-medium tracking-tight">What's on your mind?</h2>
		<p class="text-muted-foreground max-w-sm text-sm leading-relaxed">
			Tell North what you are working on. It remembers, so you only have to
			explain once.
		</p>
		// Clicking a starter fills the composer rather than sending it, so the
		// person still edits it into their own words before committing.
		<div class="mt-2 grid w-full max-w-lg gap-2 sm:grid-cols-2">
			for _, starter := range starters {
				<button
					type="button"
					@click={ "document.getElementById('message').value = " + jsString(starter) + "; document.getElementById('message').focus()" }
					class="border-hairline bg-surface hover:bg-accent/50 rounded-lg border p-3 text-left text-sm transition-colors"
				>
					{ starter }
				</button>
			}
		</div>
	</div>
}

// Bubble is one stored turn. Coach turns carry agent attribution so the
// product thread matches the landing hero grammar (signal path, agent voice).
templ Bubble(m conversations.Message) {
	if m.IsUser() {
		<div class="flex justify-end">
			<div class="bg-primary text-primary-foreground max-w-[85%] rounded-2xl rounded-br-sm px-4 py-2.5 text-sm whitespace-pre-wrap">
				{ m.Content }
			</div>
		</div>
	} else {
		<div class="group flex flex-col items-start gap-1" x-data="{ copied: false }">
			<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-agent">North</span>
			<div class={ "border-hairline bg-surface max-w-[85%] rounded-2xl rounded-bl-sm border px-4 py-2.5 " + proseClasses }>
				@markdown.Render(m.Content)
			</div>
			@muscles(m)
			@sources(m)
			<button
				type="button"
				@click={ "navigator.clipboard.writeText(" + jsString(m.Content) + "); copied = true; setTimeout(() => copied = false, 1500)" }
				class="text-muted-foreground hover:text-foreground ml-1 text-xs opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100"
			>
				<span x-show="!copied">Copy</span>
				<span x-show="copied" x-cloak>Copied</span>
			</button>
		</div>
	}
}

// muscles draws what a recommended movement trains (NOR-8).
//
// Only for replies that actually looked an exercise up: the slug comes off the
// recorded tool call, so this cannot appear under a reply that merely mentioned
// a squat in passing, and the muscles shown are the catalogue's rather than
// something the model was asked to name a second time in a parseable shape.
//
// Fetched rather than rendered inline, for the reason the sources disclosure
// gives: resolving every exercise in a long transcript on every page load is a
// query per reply. Unlike sources it loads on sight, because a picture nobody
// clicked is the point of having one.
templ muscles(m conversations.Message) {
	for _, slug := range m.ExerciseSlugs() {
		<div
			hx-get={ "/app/exercises/" + slug + "/muscles" }
			hx-trigger="load"
			hx-swap="outerHTML"
			class="w-full"
		></div>
	}
}

// sources opens the passages a reply was built from.
//
// One disclosure per message rather than a chip per citation. Labelling each
// ref separately would mean resolving every ref in the transcript to render the
// page — a query per reply on every load — and the labels are only worth
// fetching for the reply somebody actually decides to check.
//
// The refs are already stored on the message; nothing new is recorded to make
// this work. It has been possible to show these since the column was added.
templ sources(m conversations.Message) {
	if refs := m.ChunkIDs(); len(refs) > 0 {
		<div class="ml-1 w-full max-w-[85%]">
			<button
				type="button"
				hx-get={ sourcesURL(m.EvidenceRefs) }
				hx-target="this"
				hx-swap="outerHTML"
				class="text-muted-foreground hover:text-foreground text-xs underline underline-offset-2"
			>
				{ sourceLabel(len(refs)) }
			</button>
		</div>
	}
}

// sourcesURL asks the knowledge handler for the passages behind one reply.
// Refs go in as repeated query parameters and are resolved against the session
// user there; a ref lifted from somebody else's conversation resolves to
// nothing.
func sourcesURL(refs []string) string {
	q := make(url.Values, len(refs))
	for _, ref := range refs {
		q.Add("ref", ref)
	}
	return "/app/knowledge/passages?" + q.Encode()
}

func sourceLabel(n int) string {
	if n == 1 {
		return "1 source"
	}
	return fmt.Sprintf("%d sources", n)
}

// PendingExchange is what the composer swaps in on submit: the user's turn, and
// an empty coach turn that opens the SSE stream.
//
// The message is echoed straight back rather than re-fetched, so the user sees
// their own words immediately instead of after a round trip.
templ PendingExchange(conversationID uuid.UUID, message string) {
	<div class="flex justify-end">
		<div class="bg-primary text-primary-foreground max-w-[85%] rounded-2xl rounded-br-sm px-4 py-2.5 text-sm whitespace-pre-wrap">
			{ message }
		</div>
	</div>
	// The bubble and the refresh are separate elements on purpose. Each needs its
	// own hx-swap — "beforeend" to append tokens, "outerHTML" to replace the
	// page — and two hx-swap attributes on one element silently lose one of
	// them, which appends a whole copy of the page into the chat.
	//
	// sse-close="done" ends the connection when the reply does. Without it the
	// browser reconnects on close and the coach answers again, forever.
	//
	// Tokens stream in as plain text; markdown is only rendered once the reply
	// is complete and the page re-fetches it. Formatting a half-written
	// sentence would make the text jump around as it arrives.
	<div class="flex flex-col items-start gap-1" hx-ext="sse" sse-connect={ streamURL(conversationID, message) } sse-close="done">
		<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-agent">North</span>
		<div
			class="border-hairline bg-surface max-w-[85%] rounded-2xl rounded-bl-sm border px-4 py-2.5 text-sm whitespace-pre-wrap"
			sse-swap="token,error"
			hx-swap="beforeend"
		></div>
		<div
			class="hidden"
			hx-trigger="sse:done"
			hx-get={ "/app/chat/" + conversationID.String() }
			hx-target="#chat-root"
			hx-select="#chat-root"
			hx-swap="outerHTML"
		></div>
	</div>
}

// streamURL builds the SSE endpoint for a pending message.
// The message travels as a query parameter, which is why it is escaped here and
// why nothing sensitive belongs in a chat URL. It is the same text the user
// just posted and which is already stored.
func streamURL(conversationID uuid.UUID, message string) string {
	return "/app/chat/" + conversationID.String() + "/stream?m=" + url.QueryEscape(message)
}

templ composer(conversationID uuid.UUID, draft string) {
	<div class="border-border border-t">
		// x-data is required even though it holds nothing: Alpine only processes
		// directives inside a scope, so without it the Enter-to-send binding on
		// the textarea below is silently ignored.
		<form
			x-data
			class="mx-auto flex w-full max-w-3xl items-end gap-2 p-4"
			hx-post={ "/app/chat/" + conversationID.String() + "/messages" }
			hx-target="#transcript > div"
			hx-swap="beforeend"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			@ui.CSRFInput()
			@textarea.Textarea(textarea.Props{
				ID:          "message",
				Name:        "message",
				Placeholder: "What are you working on?",
				Value:       draft,
				Rows:        1,
				AutoResize:  true,
				Class:       "max-h-48 min-h-[2.5rem] resize-none",
				Attributes: templ.Attributes{
					"required": true,
					// Enter sends, shift+Enter makes a new line: what every
					// chat interface does, and what fingers expect.
					"@keydown.enter.prevent": "if (!$event.shiftKey) $el.form.requestSubmit()",
				},
			})
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeIcon}) {
				@icon.ArrowUp(icon.Props{Class: "size-4"})
			}
		</form>
	</div>
	@textarea.Script()
}

// ComposerError re-renders the composer with what was typed and why it was
// rejected.
templ ComposerError(conversationID uuid.UUID, draft, message string) {
	<p class="text-destructive px-4 pb-2 text-sm">{ message }</p>
	@composer(conversationID, draft)
}
