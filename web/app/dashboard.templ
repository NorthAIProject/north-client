package app

import (
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
)

// Nav is the application sidebar. Sections that do not exist yet are absent
// rather than disabled: a link that goes nowhere is worse than no link.
func Nav(active string) []layout.NavItem {
	items := []layout.NavItem{
		{Label: "Overview", Href: "/app"},
		{Label: "Coach", Href: "/app/chat"},
	}
	for i := range items {
		items[i].Active = items[i].Href == active
	}
	return items
}

templ Dashboard(user users.User) {
	@layout.App("Overview", user, Nav("/app")) {
		<div class="mx-auto w-full max-w-4xl p-6 md:p-8">
			<header class="mb-8">
				@ui.MonoLabel("Overview")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">
					Hello, { user.FirstName() }
				</h1>
				<p class="text-muted-foreground mt-1 max-w-lg text-sm leading-relaxed">
					Your coach still has the thread. Coaching, goals, and progress live here.
				</p>
			</header>
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						Account
					}
					@card.Description() {
						The basics North uses to keep your context straight.
					}
				}
				@card.Content() {
					<div class="grid gap-4 text-sm sm:grid-cols-2">
						@detail("Name", user.DisplayName)
						@detail("Email", user.Email)
						@detail("Timezone", user.Timezone)
						@detail("Member since", user.CreatedAt.Format("2 January 2006"))
					</div>
					<div class="mt-6">
						@button.Button(button.Props{Href: "/app/chat", Class: "bg-signal text-background hover:bg-signal/90"}) {
							Talk to your coach
						}
					</div>
				}
			}
		</div>
	}
}

templ detail(term, value string) {
	<div>
		@ui.MonoLabel(term)
		<p class="mt-1 font-medium">{ value }</p>
	</div>
}
