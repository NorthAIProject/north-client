package app

import (
	"strconv"

	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
)

// DashboardData is the overview snapshot.
type DashboardData struct {
	CheckedInToday bool
	Streak         int
	PendingMemories int
}

templ Dashboard(user users.User, data DashboardData) {
	@layout.App("Overview", user, layout.BuildNav("/app")) {
		<div class="mx-auto w-full max-w-4xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Overview")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">
					Hello, { user.FirstName() }
				</h1>
				<p class="text-muted-foreground mt-1 max-w-lg text-sm leading-relaxed">
					Your coach still has the thread. Check in, keep goals current, and review what North remembers.
				</p>
			</header>
			<div class="grid gap-4 sm:grid-cols-2">
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							Today’s check-in
						}
						@card.Description() {
							if data.CheckedInToday {
								You’re set for today.
							} else {
								Thirty seconds. Mood, energy, what went well.
							}
						}
					}
					@card.Content() {
						if data.Streak > 0 {
							<p class="text-signal mb-3 text-sm font-medium">
								{ strconv.Itoa(data.Streak) }-day streak
							</p>
						}
						@button.Button(button.Props{Href: "/app/check-ins", Class: "bg-signal text-background hover:bg-signal/90"}) {
							if data.CheckedInToday {
								Edit check-in
							} else {
								Check in
							}
						}
					}
				}
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							Memory
						}
						@card.Description() {
							if data.PendingMemories > 0 {
								{ strconv.Itoa(data.PendingMemories) } proposed facts to review.
							} else {
								Facts North may use when coaching you.
							}
						}
					}
					@card.Content() {
						@button.Button(button.Props{Href: "/app/memories", Variant: button.VariantOutline}) {
							Open memory
						}
					}
				}
			</div>
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						Coach
					}
					@card.Description() {
						Pick up the conversation. North already has your goals and check-ins when they exist.
					}
				}
				@card.Content() {
					@button.Button(button.Props{Href: "/app/chat", Class: "bg-signal text-background hover:bg-signal/90"}) {
						Talk to your coach
					}
				}
			}
		</div>
	}
}
