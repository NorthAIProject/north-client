package app

import (
	"fmt"
	"strconv"
	"time"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/conversations"
	"github.com/NorthAIProject/north-client/internal/goals/goal"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/internal/workouts/plan"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

// DashboardData is the command-center snapshot.
type DashboardData struct {
	Range RangeView

	CheckedInToday   bool
	Streak           int
	PendingMemories  int
	Goals            []goal.Goal
	LastThread       *conversations.Conversation
	NextSession      *plan.PlanDay
	PlanID           uuid.UUID
	CheckIns         CheckInSeriesView
	Habits           HabitsView
	Hydration        HydrationView
	Sleep            SleepView
	ActivityCalories float64
	Timeline         []TimelineEntryView
	Deltas           DeltasView

	MoodChart        chart.Props
	HydrationChart   chart.Props
	HabitGaugeOption map[string]any
	CheckInHeatmap   map[string]any
	ActivityDonut    map[string]any
	HasActivityDonut bool
}

// RangeOption is one choice in the period selector.
type RangeOption struct {
	Key      string
	Label    string
	Selected bool
}

type RangeView struct {
	Key     string
	Label   string
	Options []RangeOption
}

// DeltaView is a metric's change against the previous window of equal length.
//
// HasPrior false means there is nothing to compare against. The template then
// renders nothing at all: a first-week user shown "+100%" on every tile is
// being told something false.
type DeltaView struct {
	Pct       float64
	Direction int
	HasPrior  bool
}

type DeltasView struct {
	Hydration  DeltaView
	SleepHours DeltaView
	Calories   DeltaView
	CheckIns   DeltaView
}

// TimelineEntryView is one row of the activity feed.
type TimelineEntryView struct {
	Kind   string
	Label  string
	At     time.Time
	Title  string
	Detail string
	Href   string
	Icon   string
}

type CheckInDayView struct {
	Label  string
	Mood   int
	Energy int
}

type CheckInSeriesView struct {
	Days []CheckInDayView
}

func (s CheckInSeriesView) HasData() bool {
	for _, d := range s.Days {
		if d.Mood > 0 || d.Energy > 0 {
			return true
		}
	}
	return false
}

type HabitsView struct {
	HasHabits  bool
	Rate       int
	Kept       int
	Scheduled  int
	BestStreak int
}

type HydrationDayView struct {
	Label    string
	TotalML  int
	TargetML int
}

type HydrationView struct {
	TodayML  int
	TargetML int
	Percent  int
	Days     []HydrationDayView
}

func (h HydrationView) HasData() bool {
	if h.TodayML > 0 {
		return true
	}
	for _, d := range h.Days {
		if d.TotalML > 0 {
			return true
		}
	}
	return false
}

type SleepView struct {
	Logged          bool
	DurationMinutes int
	Quality         *int
}

func (d DashboardData) HasPlan() bool {
	return d.PlanID != uuid.Nil
}

func hasProgress(g goal.Goal) bool {
	_, ok := g.Progress()
	return ok
}

func progressPct(g goal.Goal) int {
	pct, _ := g.Progress()
	return pct
}

func formatLitres(ml int) string {
	if ml >= 1000 {
		return fmt.Sprintf("%.1f L", float64(ml)/1000)
	}
	return fmt.Sprintf("%d ml", ml)
}

func formatSleep(minutes int) string {
	h := minutes / 60
	m := minutes % 60
	if m == 0 {
		return fmt.Sprintf("%dh", h)
	}
	return fmt.Sprintf("%dh %dm", h, m)
}

// rangeHref keeps the selector working without JavaScript.
func rangeHref(key string) string {
	return "/app?range=" + key
}

func panelsHref(key string) string {
	return "/app/panels?range=" + key
}

// relativeTime keeps a feed row short. Anything older than a week is a date,
// because "9 days ago" is harder to place than "4 Aug".
func relativeTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	default:
		return t.Format("2 Jan")
	}
}

templ Dashboard(user users.User, data DashboardData) {
	@layout.App("Overview", user, layout.BuildNav("/app")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div>
					@ui.MonoLabel("Command center")
					<h1 class="mt-2 text-2xl font-medium tracking-tight">
						Hello, { user.FirstName() }
					</h1>
					<p class="text-muted-foreground mt-1 max-w-2xl text-sm leading-relaxed">
						Everything across North, for { data.Range.Label }.
					</p>
				</div>
				@rangeSelector(data)
			</header>
			<div id="dashboard-panels">
				@DashboardPanels(data)
			</div>
		</div>
		@progress.Script()
		@ui.ChartScripts()
	}
}

// rangeSelector swaps the panel grid rather than the page.
//
// Every option is a real link as well as an hx-get, so the page still works
// with JavaScript off — the href reloads, the hx-get swaps.
templ rangeSelector(data DashboardData) {
	<nav
		aria-label="Time period"
		class="border-hairline bg-surface/60 -mx-1 flex shrink-0 gap-1 overflow-x-auto rounded-lg border p-1"
	>
		for _, opt := range data.Range.Options {
			<a
				href={ templ.SafeURL(rangeHref(opt.Key)) }
				hx-get={ panelsHref(opt.Key) }
				hx-target="#dashboard-panels"
				hx-swap="innerHTML"
				hx-push-url={ rangeHref(opt.Key) }
				if opt.Selected {
					aria-current="true"
					class="bg-signal text-background rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap"
				} else {
					class="text-muted-foreground hover:bg-accent/60 hover:text-foreground rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors"
				}
			>
				{ opt.Label }
			</a>
		}
	</nav>
}

// DashboardPanels is everything the range selector replaces. Exported because
// the panels endpoint renders it on its own.
//
// The only <script> tags inside are type="application/json" data payloads —
// each chart's series, emitted by chart.Chart and templ.JSONScript. Those have
// to travel with the swap, since they are the new numbers. No executable
// JavaScript is in here: Chart.js picks up swapped canvases through a
// MutationObserver and ECharts through echarts-init.js's htmx:afterSwap
// listener, and both libraries are loaded once by the page around this.
templ DashboardPanels(data DashboardData) {
	<div class="space-y-6">
		@kpiStrip(data)
		<div class="grid gap-4 lg:grid-cols-3">
			<div class="lg:col-span-2">
				@checkInPanel(data)
			</div>
			@timelinePanel(data)
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			@habitsPanel(data)
			@hydrationPanel(data)
			@splitPanel(data)
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			@goalsPanel(data)
			@coachPanel(data)
			@trainingPanel(data)
		</div>
	</div>
}

templ kpiStrip(data DashboardData) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{
			Label: "Check-in", Value: checkInKPI(data),
			Href: "/app/check-ins", CTA: checkInCTA(data),
		})
		@ui.KpiCell(ui.KpiCellProps{
			Label: "Streak", Value: streakKPI(data),
			Href: "/app/check-ins", CTA: "Check in",
		})
		@kpiCellWithDelta("Water", waterKPI(data), "/app/care", "Log water", data.Deltas.Hydration)
		@kpiCellWithDelta("Sleep", sleepKPI(data), "/app/care", "Log sleep", data.Deltas.SleepHours)
		@kpiCellWithDelta("Burned", caloriesKPI(data), "/app/fitness", "Activity", data.Deltas.Calories)
	}
}

// kpiCellWithDelta is KpiCell plus a trend chip. The chip is a separate
// element rather than a KpiCell field so the shared component stays a plain
// label/value/link and every other caller is unaffected.
templ kpiCellWithDelta(label, value, href, cta string, delta DeltaView) {
	<div class="space-y-1">
		<p class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">{ label }</p>
		<div class="flex items-baseline gap-2">
			<p class="text-lg font-medium tabular-nums">{ value }</p>
			@deltaChip(delta)
		</div>
		if href != "" && cta != "" {
			<a href={ templ.SafeURL(href) } class="text-signal text-xs hover:underline">{ cta }</a>
		}
	</div>
}

// deltaChip renders nothing when there is no previous window to compare
// against. Direction is shown with an arrow as well as a colour, because
// colour alone is not a signal everyone receives.
templ deltaChip(delta DeltaView) {
	if delta.HasPrior && delta.Direction != 0 {
		<span
			class={ "inline-flex items-center gap-0.5 font-mono text-[10px] tabular-nums",
				templ.KV("text-signal", delta.Direction > 0),
				templ.KV("text-muted-foreground", delta.Direction < 0) }
		>
			if delta.Direction > 0 {
				@icon.Icon("trending-up")(icon.Props{Class: "size-3"})
			} else {
				@icon.Icon("trending-down")(icon.Props{Class: "size-3"})
			}
			{ formatPct(delta.Pct) }
		</span>
	}
}

func formatPct(pct float64) string {
	if pct < 0 {
		pct = -pct
	}
	return fmt.Sprintf("%.0f%%", pct)
}

func checkInKPI(data DashboardData) string {
	if data.CheckedInToday {
		return "Done"
	}
	return "Pending"
}

func checkInCTA(data DashboardData) string {
	if data.CheckedInToday {
		return "Edit"
	}
	return "Check in"
}

func streakKPI(data DashboardData) string {
	if data.Streak <= 0 {
		return "—"
	}
	return strconv.Itoa(data.Streak) + " days"
}

func waterKPI(data DashboardData) string {
	if data.Hydration.TargetML <= 0 && data.Hydration.TodayML <= 0 {
		return "—"
	}
	return fmt.Sprintf("%s / %s", formatLitres(data.Hydration.TodayML), formatLitres(data.Hydration.TargetML))
}

func sleepKPI(data DashboardData) string {
	if !data.Sleep.Logged {
		return "—"
	}
	text := formatSleep(data.Sleep.DurationMinutes)
	if data.Sleep.Quality != nil {
		text += fmt.Sprintf(" · %d/5", *data.Sleep.Quality)
	}
	return text
}

func caloriesKPI(data DashboardData) string {
	if data.ActivityCalories <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f kcal", data.ActivityCalories)
}

// timelinePanel is the feed of everything that happened in the window,
// assembled across every slice.
templ timelinePanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Activity
			}
			@card.Description() {
				Everything you did, { data.Range.Label }.
			}
		}
		@card.Content() {
			if len(data.Timeline) == 0 {
				<p class="text-muted-foreground mb-4 text-sm">Nothing logged in this window yet.</p>
				@button.Button(button.Props{Href: "/app/check-ins", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Check in
				}
			} else {
				<ul class="divide-border -my-2 divide-y">
					for _, e := range data.Timeline {
						<li class="py-2">
							@timelineRow(e)
						</li>
					}
				</ul>
			}
		}
	}
}

templ timelineRow(e TimelineEntryView) {
	<a
		if e.Href != "" {
			href={ templ.SafeURL(e.Href) }
		}
		class="group flex items-start gap-3"
	>
		<span class="border-hairline text-muted-foreground group-hover:text-signal mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md border transition-colors">
			@icon.Icon(e.Icon)(icon.Props{Class: "size-3"})
		</span>
		<span class="min-w-0 flex-1">
			<span class="block truncate text-sm font-medium">{ e.Title }</span>
			if e.Detail != "" {
				<span class="text-muted-foreground block truncate text-xs">{ e.Detail }</span>
			}
		</span>
		<span class="text-muted-foreground shrink-0 font-mono text-[10px] whitespace-nowrap tabular-nums">
			{ relativeTime(e.At) }
		</span>
	</a>
}

// splitPanel answers "where did my effort go" from the feed already in
// memory, rather than from another query.
templ splitPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Where it went
			}
			@card.Description() {
				Your logged activity by kind.
			}
		}
		@card.Content() {
			if data.HasActivityDonut {
				@templ.JSONScript("dashboard-split-option", data.ActivityDonut)
				@ui.EChartsMount("dashboard-split", "dashboard-split-option", "min-h-48 w-full")
			} else {
				<p class="text-muted-foreground text-sm">Nothing logged in this window yet.</p>
			}
		}
	}
}

templ checkInPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Mood & energy
			}
			@card.Description() {
				The trailing fortnight from your check-ins.
			}
		}
		@card.Content() {
			if data.CheckIns.HasData() {
				@chart.Chart(data.MoodChart)
				if len(data.CheckInHeatmap) > 0 {
					@templ.JSONScript("dashboard-checkin-heatmap-option", data.CheckInHeatmap)
					@ui.EChartsMount("dashboard-checkin-heatmap", "dashboard-checkin-heatmap-option", "border-hairline mt-4 min-h-32 w-full rounded-md border")
				}
			} else {
				<p class="text-muted-foreground mb-4 text-sm">No check-ins yet in this window.</p>
				@button.Button(button.Props{Href: "/app/check-ins", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Check in
				}
			}
		}
	}
}

templ habitsPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Habits
			}
			@card.Description() {
				if data.Habits.HasHabits {
					Seven-day adherence across active habits.
				} else {
					Recurring intentions you can keep or miss.
				}
			}
		}
		@card.Content() {
			if data.Habits.HasHabits {
				if len(data.HabitGaugeOption) > 0 {
					@templ.JSONScript("dashboard-habit-gauge-option", data.HabitGaugeOption)
					@ui.EChartsMount("dashboard-habit-gauge", "dashboard-habit-gauge-option", "min-h-48 w-full")
				}
				<p class="text-muted-foreground mt-2 text-xs">
					{ strconv.Itoa(data.Habits.Kept) } kept of { strconv.Itoa(data.Habits.Scheduled) } scheduled
					if data.Habits.BestStreak > 0 {
						<span> · best streak { strconv.Itoa(data.Habits.BestStreak) }</span>
					}
				</p>
			} else {
				<p class="text-muted-foreground mb-4 text-sm">No habits yet.</p>
				@button.Button(button.Props{Href: "/app/care", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Add a habit
				}
			}
		}
	}
}

templ hydrationPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Hydration
			}
			@card.Description() {
				if data.Hydration.HasData() {
					Daily intake in millilitres.
				} else {
					Water logged from Care.
				}
			}
		}
		@card.Content() {
			if data.Hydration.HasData() {
				<p class="text-signal mb-3 text-sm font-medium tabular-nums">
					Today { strconv.Itoa(data.Hydration.Percent) }% · { formatLitres(data.Hydration.TodayML) }
				</p>
				@chart.Chart(data.HydrationChart)
			} else {
				<p class="text-muted-foreground mb-4 text-sm">No water logged in this window.</p>
				@button.Button(button.Props{Href: "/app/care", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Log water
				}
			}
		}
	}
}

templ goalsPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Goals
			}
		}
		@card.Content() {
			if len(data.Goals) == 0 {
				<p class="text-muted-foreground mb-4 text-sm">The coach works better once it knows what you are aiming at.</p>
				@button.Button(button.Props{Href: "/app/goals", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Add a goal
				}
			} else {
				<ul class="space-y-3">
					for _, g := range data.Goals {
						<li>
							<a href={ templ.SafeURL("/app/goals/" + g.ID.String()) } class="block">
								<p class="text-sm font-medium">{ g.Title }</p>
								if hasProgress(g) {
									<div class="mt-2">
										@progress.Progress(progress.Props{Value: progressPct(g), Max: 100, Size: progress.SizeSm})
									</div>
								}
							</a>
						</li>
					}
				</ul>
				<div class="mt-4">
					@button.Button(button.Props{Href: "/app/goals", Variant: button.VariantOutline, Size: button.SizeSm}) {
						All goals
					}
				</div>
			}
		}
	}
}

templ coachPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Coach
			}
		}
		@card.Content() {
			if data.LastThread != nil {
				<p class="mb-3 text-sm font-medium">{ data.LastThread.DisplayTitle() }</p>
				@button.Button(button.Props{Href: "/app/chat/" + data.LastThread.ID.String(), Class: "bg-signal text-background hover:bg-signal/90"}) {
					Continue
				}
			} else {
				<p class="text-muted-foreground mb-4 text-sm">North already has your goals and check-ins when they exist.</p>
				@button.Button(button.Props{Href: "/app/chat", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Start a conversation
				}
			}
		}
	}
}

templ trainingPanel(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				Training
			}
		}
		@card.Content() {
			if data.NextSession != nil {
				<p class="text-sm font-medium">{ data.NextSession.Weekday } — { data.NextSession.Focus }</p>
				<p class="text-muted-foreground mt-1 mb-3 text-sm">
					{ strconv.Itoa(len(data.NextSession.Exercises)) } exercises
				</p>
				@button.Button(button.Props{Href: "/app/training/" + data.PlanID.String(), Class: "bg-signal text-background hover:bg-signal/90"}) {
					Open session
				}
			} else if data.HasPlan() {
				@button.Button(button.Props{Href: "/app/training/" + data.PlanID.String(), Variant: button.VariantOutline}) {
					Open plan
				}
			} else {
				<p class="text-muted-foreground mb-4 text-sm">A plan the coach can follow, not a paragraph of sets.</p>
				@button.Button(button.Props{Href: "/app/training", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Build a training plan
				}
			}
			if data.ActivityCalories > 0 {
				<p class="text-muted-foreground mt-4 text-xs tabular-nums">
					{ fmt.Sprintf("%.0f kcal", data.ActivityCalories) } burned in this window
				</p>
			}
		}
	}
}
