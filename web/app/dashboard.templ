package app

import (
	"strconv"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	fitnesspages "github.com/NorthAIProject/north-client/web/fitness"
	newspages "github.com/NorthAIProject/north-client/web/news"
	nudgepages "github.com/NorthAIProject/north-client/web/nudges"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/markdown"
	"github.com/NorthAIProject/north-client/web/shared/mascot"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

// The page reads top to bottom as: what to do now, what the coach has to say,
// the things you can act on, and only then how the period went. The first two
// are about today and sit outside the range swap; everything from the trends
// strip down belongs to the selected period.
templ Dashboard(user users.User, data DashboardData) {
	@layout.App(i18n.T(ctx, "nav.overview"), user, layout.BuildNav(ctx, "/app/overview")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div>
					@ui.MonoLabel(i18n.T(ctx, "dash.mono"))
					<h1 class="mt-2 text-2xl font-medium tracking-tight">
						{ i18n.Tf(ctx, "dash.hello", user.FirstName()) }
					</h1>
					<p class="text-muted-foreground mt-1 max-w-2xl text-sm leading-relaxed">
						{ i18n.Tf(ctx, "dash.intro", data.Range.LabelIn(ctx)) }
					</p>
				</div>
				@rangeSelector(data)
			</header>
			if data.HasNextStep {
				@nextStepCard(data.NextStep)
			}
			if data.showToday() {
				@todayCard(data)
			}
			<div id="dashboard-panels">
				@DashboardPanels(data)
			</div>
		</div>
		@progress.Script()
		@ui.ChartScripts()
		if data.HasNextStep {
			@mascot.Script()
		}
	}
}

// rangeSelector swaps the panel grid rather than the page.
//
// Every option is a real link as well as an hx-get, so the page still works
// with JavaScript off — the href reloads, the hx-get swaps.
templ rangeSelector(data DashboardData) {
	<nav
		aria-label={ i18n.T(ctx, "dash.range") }
		class="border-hairline bg-surface/60 -mx-1 flex shrink-0 gap-1 overflow-x-auto rounded-lg border p-1"
	>
		for _, opt := range data.Range.Options {
			<a
				href={ templ.SafeURL(rangeHref(opt.Key)) }
				hx-get={ panelsHref(opt.Key) }
				hx-target="#dashboard-panels"
				hx-swap="innerHTML"
				hx-push-url={ rangeHref(opt.Key) }
				if opt.Selected {
					aria-current="true"
					class="bg-signal text-background rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap"
				} else {
					class="text-muted-foreground hover:bg-accent/60 hover:text-foreground rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors"
				}
			>
				{ opt.LabelIn(ctx) }
			</a>
		}
	</nav>
}

templ nextStepCard(step NextStep) {
	if step.Kind == NextStepKindPush {
		// Hidden until push.js has confirmed this browser can deliver: an
		// offer to turn on notifications that the browser will refuse is
		// worse than no card. "Not now" is remembered in this browser only.
		<div data-push data-push-card hidden>
			@nextStepBody(step) {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"data-push-dismiss": "true"}}) {
					{ i18n.T(ctx, "dash.notnow") }
				}
			}
		</div>
		<script src="/assets/js/shared/push.js" defer></script>
	} else {
		@nextStepBody(step)
	}
}

templ nextStepBody(step NextStep) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Content() {
			<div class="flex justify-center">
				@mascot.Mascot(mascot.Props{Size: mascot.SizeMd})
			</div>
			@ui.Empty(ui.EmptyProps{
				Eyebrow: step.Eyebrow,
				Title:   step.Title,
				Body:    step.Body,
			}) {
				@primaryButton(step.Href, step.CTA)
				{ children... }
			}
		}
	}
}

// todayCard is the answer to "what should I do now". It names one next step
// with the only filled button on the card, then lists the day so the rest is
// visible without competing with it. Once everything is done it offers the
// reflection instead, so the card never ends on nothing to do.
templ todayCard(data DashboardData) {
	{{ items := todayItems(ctx, data) }}
	{{ next, hasNext := nextTodayItem(items) }}
	@card.Card(card.Props{Class: "border-hairline bg-surface", Attributes: templ.Attributes{"data-today": "true"}}) {
		@card.Content() {
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div class="min-w-0">
					<p class="text-muted-foreground font-mono text-[10px] tracking-[0.14em] uppercase">
						{ i18n.T(ctx, "dash.today.title") } · { i18n.Tf(ctx, "dash.today.progress", doneCount(items), len(items)) }
					</p>
					if hasNext {
						<p class="mt-1 text-lg font-medium tracking-tight">
							{ i18n.T(ctx, "dash.today.next") } { next.Label }
						</p>
						<p class="text-muted-foreground text-sm">{ next.Detail }</p>
					} else {
						<p class="mt-1 text-lg font-medium tracking-tight">{ i18n.T(ctx, "dash.today.alldone") }</p>
						<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "dash.today.alldone.body") }</p>
					}
				</div>
				<div class="shrink-0">
					if hasNext {
						@primaryButton(next.Href, next.CTA)
					} else {
						@startReflectionForm()
					}
				</div>
			</div>
			<ul class="border-hairline mt-4 grid gap-2 border-t pt-4 sm:grid-cols-2 lg:grid-cols-4">
				for _, item := range items {
					<li>
						@todayRow(item, hasNext && item.Key == next.Key)
					</li>
				}
			</ul>
		}
	}
}

// todayRow is one item on the day. Done is shown with a mark as well as a
// colour, and the row stays a link either way: a check-in can be edited, water
// topped up past the target.
templ todayRow(item TodayItem, isNext bool) {
	<a
		href={ templ.SafeURL(item.Href) }
		data-today-item={ item.Key }
		if item.Done {
			data-done="true"
		}
		class={ "group flex items-start gap-3 rounded-md border px-3 py-2 transition-colors",
			templ.KV("border-signal/40 bg-signal/5", isNext),
			templ.KV("border-hairline hover:border-signal/40", !isNext) }
	>
		<span
			class={ "mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full border",
				templ.KV("border-signal bg-signal text-background", item.Done),
				templ.KV("border-hairline text-muted-foreground", !item.Done) }
		>
			if item.Done {
				@icon.Icon("check")(icon.Props{Class: "size-3"})
			} else {
				@icon.Icon(item.Icon)(icon.Props{Class: "size-3"})
			}
		</span>
		<span class="min-w-0 flex-1">
			<span class={ "block truncate text-sm font-medium", templ.KV("text-muted-foreground line-through", item.Done) }>
				{ item.Label }
			</span>
			<span class="text-muted-foreground block truncate text-xs tabular-nums">{ item.Detail }</span>
		</span>
	</a>
}

// DashboardPanels is everything the range selector replaces. Exported because
// the panels endpoint renders it on its own.
//
// The only <script> tags inside are type="application/json" data payloads —
// each chart's series, emitted by chart.Chart and templ.JSONScript. Those have
// to travel with the swap, since they are the new numbers. No executable
// JavaScript is in here: Chart.js picks up swapped canvases through a
// MutationObserver and ECharts through echarts-init.js's htmx:after:swap
// listener, and both libraries are loaded once by the page around this.
templ DashboardPanels(data DashboardData) {
	<div class="space-y-6">
		if data.HasBriefing {
			@briefingCard(data)
		} else {
			@briefingPrompt()
		}
		@nudgepages.Card(data.Nudges)
		// Things to act on come before things to read.
		<div class="grid gap-4 lg:grid-cols-3">
			@trainingPanel(data)
			@goalsPanel(data)
			@coachPanel(data)
		</div>
		@trendsStrip(data)
		// My Day's trend cards, loaded after the page: twelve weeks of
		// readings is the slowest thing here and should not hold it up.
		<div hx-get="/app/day/trends" hx-trigger="load" hx-swap="innerHTML"></div>
		<div class="grid gap-4 lg:grid-cols-3">
			<div class="lg:col-span-2">
				@checkInPanel(data)
			</div>
			@timelinePanel(data)
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			@habitsPanel(data)
			@hydrationPanel(data)
			@splitPanel(data)
		</div>
		if data.NewsTickerEnabled {
			@newspages.TickerShell()
		}
	</div>
}

// panel is every dashboard card: one surface, a title, an optional
// description. Children are the body.
templ panel(title, description string) {
	@card.Card(card.Props{Class: "border-hairline bg-surface h-full"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
			if description != "" {
				@card.Description() {
					{ description }
				}
			}
		}
		@card.Content() {
			{ children... }
		}
	}
}

// emptyAction is a panel with nothing in it yet: one line saying so, and the
// one action that would fill it.
templ emptyAction(message, href, cta string) {
	<p class="text-muted-foreground mb-4 text-sm">{ message }</p>
	@primaryButton(href, cta)
}

templ primaryButton(href, label string) {
	@button.Button(button.Props{Href: href, Class: "bg-signal text-background hover:bg-signal/90"}) {
		{ label }
	}
}

// briefingCard is the morning note. It disappears entirely once the day it
// describes is over.
templ briefingCard(data DashboardData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Content() {
			@ui.MonoLabel(i18n.T(ctx, "dash.briefing.title"))
			<div class="prose prose-sm dark:prose-invert mt-2 max-w-none">
				@markdown.Render(data.Briefing)
			</div>
		}
	}
}

// briefingPrompt is the on-demand path: somebody who has not opted into the
// morning sweep can still ask for today's briefing from the page they are on.
templ briefingPrompt() {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Content() {
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					@ui.MonoLabel(i18n.T(ctx, "dash.briefing.title"))
					<p class="mt-1 text-sm leading-relaxed">
						{ i18n.T(ctx, "dash.briefing.empty") }
					</p>
				</div>
				<form method="post" action="/app/reports/briefing">
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "dash.briefing.write") }
					}
				</form>
			</div>
		}
	}
}

// trendsStrip is the period at a glance. Check-in done-or-not moved to the
// Today card; what stays here is what the range selector changes.
templ trendsStrip(data DashboardData) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{
			Label: i18n.T(ctx, "dash.kpi.streak"), Value: streakKPI(ctx, data),
			Href: "/app/check-ins", CTA: i18n.T(ctx, "dash.kpi.checkcta"),
		})
		@kpiCellWithDelta(i18n.T(ctx, "dash.kpi.water"), waterKPI(data), "/app/care", i18n.T(ctx, "dash.kpi.logwater"), data.Deltas.Hydration)
		@kpiCellWithDelta(i18n.T(ctx, "dash.kpi.sleep"), sleepKPI(data), "/app/care", i18n.T(ctx, "dash.kpi.logsleep"), data.Deltas.SleepHours)
		@kpiCellWithDelta(i18n.T(ctx, "dash.kpi.burned"), caloriesKPI(data), "/app/fitness", i18n.T(ctx, "dash.kpi.activity"), data.Deltas.Calories)
	}
}

// kpiCellWithDelta is KpiCell plus a trend chip. The chip is a separate
// element rather than a KpiCell field so the shared component stays a plain
// label/value/link and every other caller is unaffected.
templ kpiCellWithDelta(label, value, href, cta string, delta DeltaView) {
	<div class="space-y-1">
		<p class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">{ label }</p>
		<div class="flex items-baseline gap-2">
			<p class="text-lg font-medium tabular-nums">{ value }</p>
			@deltaChip(delta)
		</div>
		if href != "" && cta != "" {
			<a href={ templ.SafeURL(href) } class="text-signal text-xs hover:underline">{ cta }</a>
		}
	</div>
}

// deltaChip renders nothing when there is no previous window to compare
// against. Direction is shown with an arrow as well as a colour, because
// colour alone is not a signal everyone receives.
templ deltaChip(delta DeltaView) {
	if delta.HasPrior && delta.Direction != 0 {
		<span
			class={ "inline-flex items-center gap-0.5 font-mono text-[10px] tabular-nums",
				templ.KV("text-signal", delta.Direction > 0),
				templ.KV("text-muted-foreground", delta.Direction < 0) }
		>
			if delta.Direction > 0 {
				@icon.Icon("trending-up")(icon.Props{Class: "size-3"})
			} else {
				@icon.Icon("trending-down")(icon.Props{Class: "size-3"})
			}
			{ formatPct(delta.Pct) }
		</span>
	}
}

// trainingPanel is the plan, not today's session: the Today card already
// carries that. On a rest day it says when the next one is.
templ trainingPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.training.title"), "") {
		if data.DoneToday != nil {
			<p class="text-muted-foreground mb-2 flex items-center gap-1.5 text-xs">
				@icon.CircleCheck(icon.Props{Class: "text-signal size-3.5"})
				{ fitnesspages.CompletedLine(*data.DoneToday) }
			</p>
		}
		if data.HasPlan() {
			if data.NextSession != nil {
				<p class="text-sm font-medium">{ data.NextSession.Weekday } — { data.NextSession.Focus }</p>
				<p class="text-muted-foreground mt-1 mb-3 text-sm">
					{ i18n.Tf(ctx, "dash.today.train.count", len(data.NextSession.Exercises)) }
				</p>
			}
			@button.Button(button.Props{Href: "/app/training/" + data.PlanID.String(), Variant: button.VariantOutline}) {
				{ i18n.T(ctx, "dash.training.plan") }
			}
		} else {
			@emptyAction(i18n.T(ctx, "dash.training.empty"), "/app/training", i18n.T(ctx, "dash.training.build"))
		}
		<a href="/app/exercises" class="text-signal mt-4 block text-xs hover:underline">
			{ i18n.T(ctx, "dash.training.library") }
		</a>
	}
}

templ goalsPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.goals.title"), goalActivityLabel(data.GoalActivity7d)) {
		if len(data.Goals) == 0 {
			@emptyAction(i18n.T(ctx, "dash.goals.empty"), "/app/goals", i18n.T(ctx, "dash.goals.cta"))
		} else {
			<ul class="space-y-3">
				for _, g := range data.Goals {
					<li>
						<a href={ templ.SafeURL("/app/goals/" + g.ID.String()) } class="block">
							<p class="text-sm font-medium">{ g.Title }</p>
							if hasProgress(g) {
								<div class="mt-2">
									@progress.Progress(progress.Props{Value: progressPct(g), Max: 100, Size: progress.SizeSm})
								</div>
							}
						</a>
					</li>
				}
			</ul>
			<div class="mt-4">
				@button.Button(button.Props{Href: "/app/goals", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "dash.goals.all") }
				}
			</div>
		}
	}
}

templ startReflectionForm() {
	<form method="post" action="/app/chat">
		@ui.CSRFInput()
		<input type="hidden" name="kind" value="reflection"/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
			{ i18n.T(ctx, "dash.reflect") }
		}
	</form>
}

templ coachPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.coach.title"), "") {
		if data.LastThread != nil {
			<p class="mb-3 text-sm font-medium">{ data.LastThread.DisplayTitle() }</p>
			<div class="flex flex-wrap items-center gap-2">
				@button.Button(button.Props{Href: "/app/chat/" + data.LastThread.ID.String(), Variant: button.VariantOutline}) {
					{ i18n.T(ctx, "dash.coach.cont") }
				}
				@startReflectionForm()
			</div>
		} else {
			<p class="text-muted-foreground mb-4 text-sm">{ i18n.T(ctx, "dash.coach.empty") }</p>
			<div class="flex flex-wrap items-center gap-2">
				@button.Button(button.Props{Href: "/app/chat", Variant: button.VariantOutline}) {
					{ i18n.T(ctx, "dash.coach.start") }
				}
				@startReflectionForm()
			</div>
		}
	}
}

// timelinePanel is the feed of everything that happened in the window,
// assembled across every slice.
templ timelinePanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.timeline.title"), i18n.Tf(ctx, "dash.timeline.desc", data.Range.LabelIn(ctx))) {
		if len(data.Timeline) == 0 {
			<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "dash.timeline.empty") }</p>
		} else {
			<ul class="divide-border -my-2 divide-y">
				for _, e := range data.Timeline {
					<li class="py-2">
						@timelineRow(e)
					</li>
				}
			</ul>
		}
	}
}

templ timelineRow(e TimelineEntryView) {
	<a
		if e.Href != "" {
			href={ templ.SafeURL(e.Href) }
		}
		class="group flex items-start gap-3"
	>
		<span class="border-hairline text-muted-foreground group-hover:text-signal mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md border transition-colors">
			@icon.Icon(e.Icon)(icon.Props{Class: "size-3"})
		</span>
		<span class="min-w-0 flex-1">
			<span class="block truncate text-sm font-medium">{ e.Title }</span>
			if e.Detail != "" {
				<span class="text-muted-foreground block truncate text-xs">{ e.Detail }</span>
			}
		</span>
		<span class="text-muted-foreground shrink-0 font-mono text-[10px] whitespace-nowrap tabular-nums">
			{ relativeTime(e.At) }
		</span>
	</a>
}

// splitPanel answers "where did my effort go" from the feed already in
// memory, rather than from another query.
templ splitPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.activity.title"), i18n.T(ctx, "dash.activity.desc")) {
		if data.HasActivityDonut {
			@templ.JSONScript("dashboard-split-option", data.ActivityDonut)
			@ui.EChartsMount("dashboard-split", "dashboard-split-option", "min-h-48 w-full")
		} else {
			<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "dash.timeline.empty") }</p>
		}
	}
}

// The empty chart panels below say what is missing and nothing else. The
// action that fills them lives on the Today card, once, rather than as a
// filled button on every empty panel competing for the same click.
templ checkInPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.mood.title"), i18n.T(ctx, "dash.mood.desc")) {
		if data.CheckIns.HasData() {
			@chart.Chart(data.MoodChart)
			if len(data.CheckInHeatmap) > 0 {
				@templ.JSONScript("dashboard-checkin-heatmap-option", data.CheckInHeatmap)
				@ui.EChartsMount("dashboard-checkin-heatmap", "dashboard-checkin-heatmap-option", "border-hairline mt-4 min-h-32 w-full rounded-md border")
			}
		} else {
			<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "dash.mood.empty") }</p>
		}
	}
}

templ habitsPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.habits.title"), habitsDescription(ctx, data)) {
		if data.Habits.HasHabits {
			if len(data.HabitGaugeOption) > 0 {
				@templ.JSONScript("dashboard-habit-gauge-option", data.HabitGaugeOption)
				@ui.EChartsMount("dashboard-habit-gauge", "dashboard-habit-gauge-option", "min-h-48 w-full")
			}
			<p class="text-muted-foreground mt-2 text-xs">
				{ strconv.Itoa(data.Habits.Kept) } kept of { strconv.Itoa(data.Habits.Scheduled) } scheduled
				if data.Habits.BestStreak > 0 {
					<span>· best streak { strconv.Itoa(data.Habits.BestStreak) }</span>
				}
			</p>
		} else {
			// Habits are not on the Today card, so this empty state keeps its
			// own way in.
			<p class="text-muted-foreground mb-3 text-sm">{ i18n.T(ctx, "dash.habits.none") }</p>
			<a href="/app/care" class="text-signal text-xs hover:underline">{ i18n.T(ctx, "dash.habits.cta") }</a>
		}
	}
}

templ hydrationPanel(data DashboardData) {
	@panel(i18n.T(ctx, "dash.hydration.title"), hydrationDescription(ctx, data)) {
		if data.Hydration.HasData() {
			<p class="text-signal mb-3 text-sm font-medium tabular-nums">
				Today { strconv.Itoa(data.Hydration.Percent) }% · { formatLitres(data.Hydration.TodayML) }
			</p>
			@chart.Chart(data.HydrationChart)
		} else {
			<p class="text-muted-foreground mb-3 text-sm">{ i18n.T(ctx, "dash.hydration.none") }</p>
			<a href="/app/care" class="text-signal text-xs hover:underline">{ i18n.T(ctx, "dash.hydration.cta") }</a>
		}
	}
}
