package day

import (
	"context"
	"fmt"
	"strconv"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
)

// Trends is the Overview's row of sparkline cards, rendered as a fragment and
// swapped in after the page loads.
templ Trends(data TrendsData) {
	<section class="space-y-3" aria-label={ i18n.T(ctx, "day.trends") } data-testid="trends">
		<h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{ i18n.T(ctx, "day.trends") }</h2>
		if len(data.Cards) == 0 && len(data.Fasts) == 0 {
			<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "day.trends.empty") }</p>
		}
		<div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
			for _, c := range data.Cards {
				<div class="border-hairline bg-surface rounded-2xl border p-4" data-testid={ "trend-" + c.Key }>
					<div class="flex items-center justify-between gap-2">
						<span class="text-xs font-semibold tracking-wide uppercase" style={ "color:" + c.Color }>{ i18n.T(ctx, "day.trend." + c.Key) }</span>
						<span class="text-muted-foreground text-[10px] tracking-wide uppercase">{ trendMeta(ctx, c) }</span>
					</div>
					<p class="mt-2 text-2xl font-semibold tabular-nums">
						{ c.Value }<span class="text-muted-foreground text-xs font-normal"> { c.Unit }</span>
					</p>
					<svg viewBox="0 0 100 32" preserveAspectRatio="none" class="mt-2 h-10 w-full" aria-hidden="true">
						<polyline points={ c.Line } fill="none" stroke={ c.Color } stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
					</svg>
				</div>
			}
		</div>
		if len(data.Fasts) > 0 {
			<div class="border-hairline bg-surface rounded-2xl border p-4" data-testid="trend-fasts">
				<p class="text-day-fat text-xs font-semibold tracking-wide uppercase">{ i18n.T(ctx, "day.trend.fasts") }</p>
				<ul class="mt-3 space-y-2">
					for _, f := range data.Fasts {
						<li class="grid grid-cols-[6rem_1fr_4rem] items-center gap-3 text-sm tabular-nums">
							<span class="text-muted-foreground">{ f.Date }</span>
							<span class="bg-day-fat/15 h-2 overflow-hidden rounded-full">
								<span class="bg-day-fat block h-full rounded-full" style={ fmt.Sprintf("width:%.0f%%", f.Fraction*100) }></span>
							</span>
							<span class={ "text-right", templ.KV("text-day-food", f.Met) }>{ f.Hours }h</span>
						</li>
					}
				</ul>
			</div>
		}
	</section>
}

func trendMeta(ctx context.Context, c TrendCard) string {
	switch c.Key {
	case "weight", "systolic":
		return i18n.Tf(ctx, "day.trend.readings", strconv.Itoa(c.Count))
	default:
		return i18n.Tf(ctx, "day.trend.days", strconv.Itoa(c.Window))
	}
}
