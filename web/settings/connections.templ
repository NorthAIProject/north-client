package settings

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/ai/providers"
	"github.com/NorthAIProject/north-client/internal/aicreds"
	"github.com/NorthAIProject/north-client/internal/connections"
	"github.com/NorthAIProject/north-client/internal/integrations"
	"github.com/NorthAIProject/north-client/internal/messaging"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/copybutton"
	"github.com/NorthAIProject/north-client/web/shared/ui/dialog"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/tabs"
)

// ConnectForm carries the "connect an agent" fields.
type ConnectForm struct {
	Name   string
	Kind   connections.ClientKind
	Errors map[string]string
}

func (f ConnectForm) fieldError(name string) string { return f.Errors[name] }

// ProviderForm carries the bring-your-own-key fields.
//
// There is no field that can hold the key, and that is the mechanism rather
// than the discipline: the value is write-only because the type this template
// receives has nowhere to put it. Compare connections.Connection.
type ProviderForm struct {
	Provider string
	Model    string
	BaseURL  string
	Errors   map[string]string
}

func (f ProviderForm) fieldError(name string) string { return f.Errors[name] }

// ProviderFormFor pre-fills from a submission or a stored credential.
func ProviderFormFor(in aicreds.Input) ProviderForm {
	return ProviderForm{Provider: in.Provider, Model: in.Model, BaseURL: in.BaseURL}
}

// ProviderPanel is everything the model-provider card needs.
type ProviderPanel struct {
	// Enabled is false when the deployment has no encryption key, in which
	// case the card explains itself rather than offering a form it could not
	// honour safely.
	Enabled bool

	Catalog []providers.BYOProvider

	// Current is the stored credential, or nil when the user is on North's
	// own providers. It cannot carry the key.
	Current *aicreds.Credential

	Form ProviderForm
}

// TelegramPanel is everything the Telegram card needs.
// CalendarPanel is the person's own calendar, reached over MCP.
//
// Deliberately carries no token: it is sealed in the database and opened only
// on the path about to use it, so there is nothing here a render could leak.
type CalendarPanel struct {
	// Enabled is false when this process has no integrations service — which is
	// what a deployment without an encryption key gets. The card is then not
	// rendered, because connecting would fail at the point of storing a token.
	Enabled bool

	// Connected is the existing connection, or nil when there is none.
	Connected *integrations.Connection

	// Error is why the last attempt to connect was rejected, shown beside the
	// field somebody just filled in.
	Error string
}

type TelegramPanel struct {
	// Enabled is false when the deployment has no bot token, in which case the
	// card is not rendered at all — there would be nothing to message.
	Enabled bool

	// BotUsername is how a person finds the bot. Empty when nobody configured
	// it, and the card then says to ask whoever runs this North.
	BotUsername string

	// Linked is the existing link, or nil when this account has none.
	Linked *messaging.Link

	// Code is a freshly issued link code, shown on exactly one response. It is
	// stored only as a hash, so this render is the only place it can appear.
	Code string
}

// BotLink is the URL that opens a chat with the bot, or empty when no username
// is configured.
func (p TelegramPanel) BotLink() string {
	if p.BotUsername == "" {
		return ""
	}
	return "https://t.me/" + p.BotUsername
}

// Handle is the bot's @name. A method rather than an "@" in the markup, where
// templ reads a leading @ as the start of a component call.
func (p TelegramPanel) Handle() string { return "@" + p.BotUsername }

// ConnectionsPage lists the agents connected to this account, and which model
// provider answers for it.
//
// issued is non-nil for exactly one response: the one that created a token.
// The token is not stored, so this render is the only place it can ever be
// shown, and a reload of this page will not show it again.
//
// previews carries one Setup per client kind, in ClientKinds order, each built
// with connections.PlaceholderToken. It is what lets the page show what setup
// looks like before a key exists — the alternative being that somebody issues a
// live credential to find out whether they want one.
templ ConnectionsPage(user users.User, list []connections.Connection, f ConnectForm, issued *connections.Issued, setup connections.Setup, previews []connections.Setup, provider ProviderPanel, telegram TelegramPanel, calendar CalendarPanel) {
	@layout.App("Agent connections", user, layout.BuildNav("/app/settings")) {
		<div class="mx-auto w-full max-w-2xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Settings")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Agent connections</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					Let an agent you already use — Claude Code, Codex, Hermes — read your goals,
					log check-ins, and ask your coach. Each connection gets its own key, so you
					can turn one off without touching the others.
				</p>
				<a href="/app/settings" class="text-muted-foreground hover:text-foreground mt-3 inline-block text-sm underline underline-offset-4">
					Back to account settings
				</a>
			</header>
			if issued != nil {
				@issuedCard(*issued, setup)
			}
			@connectionListCard(list)
			@connectCard(f, previews)
			if telegram.Enabled {
				@telegramCard(telegram)
				@calendarCard(calendar)
			}
			@providerCard(provider)
		</div>
		@label.Script()
		@dialog.Script()
		@copybutton.Script()
		@tabs.Script()
	}
}

// issuedCard shows a new token once.
//
// Styled as the loudest thing on the page on purpose: it is the only moment
// this value exists outside the user's own machine, and somebody who scrolls
// past it has to revoke and start again.
templ issuedCard(issued connections.Issued, setup connections.Setup) {
	@card.Card(card.Props{Class: "border-signal/40 bg-signal/5"}) {
		@card.Header() {
			@card.Title() {
				{ issued.Name } is ready
			}
			@card.Description() {
				Copy this now. It is not stored, so it cannot be shown again — if you lose it,
				revoke this connection and make another.
			}
		}
		@card.Content() {
			<div class="space-y-5">
				@copyBlock("Key", "issued-token", "text", issued.Token)
				@copyBlock(setup.ConfigLabel, "issued-config", setup.ConfigLang, setup.Config)
				if setup.Safe != "" {
					<div>
						<p class="text-muted-foreground mb-2 text-sm leading-relaxed">
							{ setup.SafeNote }
						</p>
						@copyBlock(setup.SafeLabel, "issued-safe", setup.SafeLang, setup.Safe)
						@copyBlock("Environment", "issued-export", "bash", setup.Export)
					</div>
				}
				<div>
					<p class="text-muted-foreground mb-2 text-sm leading-relaxed">
						Or paste this into the agent itself and let it do the setup. It sends the key
						to whichever model that agent runs on, so use it with an agent you would
						trust with your coaching data — and revoke the key here if you change your mind.
					</p>
					@copyBlock("Setup prompt", "issued-prompt", "text", setup.Prompt)
				</div>
			</div>
		}
	}
}

// copyBlock is a labelled, scrollable, copyable snippet.
//
// Hand-rolled rather than assembled from a component: the library has a copy
// button but no code block for it to target, and this is the markup that gives
// it something with an ID to read.
templ copyBlock(heading, id, lang, body string) {
	<div>
		<div class="mb-1.5 flex items-center justify-between gap-2">
			<span class="text-muted-foreground font-mono text-xs tracking-wide uppercase">{ heading }</span>
			@copybutton.CopyButton(copybutton.Props{TargetID: id})
		</div>
		<pre
			id={ id }
			data-language={ lang }
			class="border-hairline bg-background overflow-x-auto rounded-lg border p-3 font-mono text-xs leading-relaxed break-words whitespace-pre-wrap"
		>{ body }</pre>
	</div>
}

templ connectionListCard(list []connections.Connection) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Connected agents
			}
			@card.Description() {
				Every one of these can read and write your coaching data. Revoke anything you
				do not recognise.
			}
		}
		@card.Content() {
			if len(list) == 0 {
				<p class="text-muted-foreground text-sm leading-relaxed">
					Nothing connected yet.
				</p>
			} else {
				<ul class="divide-hairline divide-y">
					for _, conn := range list {
						@connectionRow(conn)
					}
				</ul>
			}
		}
	}
}

templ connectionRow(conn connections.Connection) {
	<li class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
		<div class="min-w-0">
			<p class="truncate text-sm font-medium">{ conn.Name }</p>
			<p class="text-muted-foreground mt-0.5 font-mono text-xs">
				{ conn.Kind.Label() } · { conn.TokenPrefix }…
			</p>
			<p class="text-muted-foreground mt-0.5 text-xs">
				Added { conn.CreatedAt.Format("2 Jan 2006") } ·
				@ConnectionStatus(conn, 0)
			</p>
		</div>
		@revokeDialog(conn)
	</li>
}

// pollLimit stops the status poll after roughly two minutes.
// Someone who pasted the config into an agent finds out inside a few seconds.
// Someone who wandered off leaves a tab polling forever, which is a cost North
// pays and they never see — so it gives up and says so.
const pollLimit = 24

// ConnectionStatus is both the initial render and the polled fragment.
//
// Without it the flow ends in silence: the user pastes a config into their
// agent and this page has no idea whether it worked until they think to
// reload. That is the moment people give up, so it is worth one small poll.
//
// The poll stops by rendering markup that does not ask for another: an
// hx-trigger only appears while there is still something to wait for.
templ ConnectionStatus(conn connections.Connection, tries int) {
	if conn.Used() {
		<span id={ statusID(conn) } class="text-signal">
			connected · last used { conn.LastUsedAt.Format("2 Jan, 15:04") }
		</span>
	} else if tries >= pollLimit {
		<span id={ statusID(conn) }>not used yet</span>
	} else {
		<span
			id={ statusID(conn) }
			hx-get={ statusURL(conn, tries+1) }
			hx-trigger="load delay:5s"
			hx-swap="outerHTML"
		>
			waiting for first use…
		</span>
	}
}

func statusID(conn connections.Connection) string { return "connection-status-" + conn.ID.String() }

func statusURL(conn connections.Connection, tries int) string {
	return fmt.Sprintf("/app/settings/connections/%s/status?tries=%d", conn.ID, tries)
}

// revokeDialog asks before cutting an agent off. Revoking is instant and
// cannot be undone — the token is gone, not paused — so the confirmation is
// worth the extra click.
templ revokeDialog(conn connections.Connection) {
	{{ dialogID := "revoke-" + conn.ID.String() }}
	@dialog.Trigger(dialog.TriggerProps{For: dialogID}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Type: button.TypeButton}) {
			Revoke
		}
	}
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					Revoke { conn.Name }?
				}
				@dialog.Description() {
					That agent stops being able to read or change anything straight away. The
					key cannot be turned back on; you would connect the agent again with a new one.
				}
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
						Keep it
					}
				}
				<form method="post" action={ templ.SafeURL("/app/settings/connections/" + conn.ID.String() + "/revoke") }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						Revoke
					}
				</form>
			}
		}
	}
}

// telegramCard connects a chat to this account.
//
// Three states, and the card is one of them at a time: linked, holding a fresh
// code, or offering to make one. A page that showed all three at once would ask
// somebody who is already connected to read instructions for connecting.
templ telegramCard(p TelegramPanel) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Telegram
			}
			@card.Description() {
				Message your coach from your phone. Same memory, same goals, same conversation —
				what you ask in Telegram carries on in the web chat, and the other way round.
			}
		}
		@card.Content() {
			switch {
				case p.Linked != nil:
					@telegramLinked(*p.Linked)
				case p.Code != "":
					@telegramCode(p)
				default:
					@telegramStart()
			}
		}
	}
}

// telegramCode shows a code once, and says what to do with it.
//
// Loud for the same reason issuedCard is: the code is stored only as a hash, so
// this render is the one moment it exists anywhere a person can read it.
templ telegramCode(p TelegramPanel) {
	<div class="space-y-4">
		<div class="border-signal/40 bg-signal/5 rounded-lg border p-4">
			<p class="text-muted-foreground mb-2 text-sm leading-relaxed">
				Send this to the bot. It works once, and only for the next 15 minutes.
			</p>
			@copyBlock("Link code", "telegram-code", "text", p.Code)
		</div>
		<ol class="text-muted-foreground list-decimal space-y-1.5 pl-5 text-sm leading-relaxed">
			<li>
				if link := p.BotLink(); link != "" {
					Open
					<a href={ templ.SafeURL(link) } target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4">
						{ p.Handle() }
					</a>
					in Telegram.
				} else {
					Open North's bot in Telegram. Ask whoever runs this North for its name.
				}
			</li>
			<li>Send it the code above.</li>
			<li>It replies to confirm, and then you can just talk to it.</li>
		</ol>
	</div>
}

templ telegramLinked(link messaging.Link) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<div class="min-w-0">
			<p class="text-signal text-sm font-medium">Connected</p>
			<p class="text-muted-foreground mt-0.5 text-xs">
				Linked { link.CreatedAt.Format("2 Jan 2006") }
				if link.LastSeenAt != nil {
					· last message { link.LastSeenAt.Format("2 Jan, 15:04") }
				} else {
					· no messages yet
				}
			</p>
		</div>
		@telegramDisconnectDialog()
	</div>
}

templ telegramStart() {
	<form method="post" action="/app/settings/messaging/telegram" class="space-y-3">
		@ui.CSRFInput()
		<p class="text-muted-foreground text-sm leading-relaxed">
			You will get a short code to send to the bot. That is what tells it which
			account the chat belongs to.
		</p>
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			Get a link code
		}
	</form>
}

// telegramDisconnectDialog asks first, for the reason revokeDialog does:
// disconnecting is instant, and the way back is another code.
templ telegramDisconnectDialog() {
	{{ dialogID := "disconnect-telegram" }}
	@dialog.Trigger(dialog.TriggerProps{For: dialogID}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Type: button.TypeButton}) {
			Disconnect
		}
	}
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					Disconnect Telegram?
				}
				@dialog.Description() {
					The bot stops answering that chat straight away. Nothing you have already
					said is deleted — the conversation stays in the web app. To connect again
					you would get a new code.
				}
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
						Keep it
					}
				}
				<form method="post" action="/app/settings/messaging/telegram/disconnect">
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						Disconnect
					}
				</form>
			}
		}
	}
}

// providerCard chooses who answers the coach.
//
// Alpine holds only which half of the form is showing — local UI state, which
// is exactly what CLAUDE.md sanctions it for. Which provider is actually used
// is decided on the server, from the stored credential.
templ providerCard(p ProviderPanel) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Model provider
			}
			@card.Description() {
				By default North supplies the AI. Point this account at your own key — or at your own Hermes gateway — if you have one.
			}
		}
		@card.Content() {
			if !p.Enabled {
				<p class="text-muted-foreground text-sm leading-relaxed">
					Not available on this server — it has no encryption key configured, and North
					will not store a provider key it cannot encrypt.
				</p>
			} else {
				if p.Current != nil && p.Current.Failing() {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ p.Current.LastError } North's own model is answering in the meantime.
					}
				}
				<form
					method="post"
					action="/app/settings/ai"
					class="space-y-4"
					x-data={ templ.JSONString(providerState(p)) }
				>
					@ui.CSRFInput()
					<div class="space-y-2">
						<label class="flex items-start gap-2 text-sm">
							<input type="radio" name="mode" value="north" x-model="mode" checked?={ p.Current == nil } class="mt-1"/>
							<span>
								<span class="font-medium">Use North's AI</span>
								<span class="text-muted-foreground block text-xs leading-relaxed">
									Nothing to set up. Free accounts are served by models that cost nothing to run.
								</span>
							</span>
						</label>
						<label class="flex items-start gap-2 text-sm">
							<input type="radio" name="mode" value="own" x-model="mode" checked?={ p.Current != nil } class="mt-1"/>
							<span>
								<span class="font-medium">Use my own API key</span>
								<span class="text-muted-foreground block text-xs leading-relaxed">
									Your account pays for the tokens, and North stops paying for yours.
								</span>
							</span>
						</label>
					</div>
					<div x-show="mode === 'own'" x-cloak class="space-y-4 pt-2">
						@form.Item() {
							@label.Label() {
								Provider
							}
							<div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
								for _, entry := range p.Catalog {
									@providerTile(entry, p.Form.Provider == entry.Name)
								}
							</div>
							if p.Form.fieldError("provider") != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ p.Form.fieldError("provider") }
								}
							}
						}
						// Shown only for a provider that has no public address of
						// its own. Before this it rendered for all six, which read
						// as though an OpenRouter key needed a gateway URL too.
						// The condition comes from the catalogue rather than a
						// literal "hermes", so a second self-hosted backend picks
						// it up by setting RequiresBaseURL.
						<div x-show="needsURL.includes(provider)" x-cloak>
							@form.Item() {
								@label.Label(label.Props{For: "base_url"}) {
									Gateway URL
								}
								@input.Input(input.Props{
									ID: "base_url", Name: "base_url", Value: p.Form.BaseURL,
									Placeholder: "http://hermes-box.ts.net:8642/v1",
									HasError:    p.Form.fieldError("base_url") != "",
								})
								if p.Form.fieldError("base_url") != "" {
									@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
										{ p.Form.fieldError("base_url") }
									}
								}
								@form.Description() {
									Each account runs its own instance — tailnet, LAN, or public HTTPS.
								}
							}
						</div>
						@form.Item() {
							@label.Label(label.Props{For: "api_key"}) {
								API key
							}
							// Placeholder twice over: server-rendered for the
							// current selection so it is right without
							// JavaScript, and rebound as tiles are clicked so
							// it follows. Showing OpenRouter's sk-or-v1- shape
							// while Hermes is selected is exactly the confusion
							// a key hint exists to prevent.
							@input.Input(input.Props{
								ID: "api_key", Name: "api_key", Type: input.TypePassword,
								Placeholder: keyPlaceholder(p), HasError: p.Form.fieldError("api_key") != "",
								Attributes: templ.Attributes{
									":placeholder": "hints[provider] ? hints[provider].key : ''",
								},
							})
							if p.Form.fieldError("api_key") != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ p.Form.fieldError("api_key") }
								}
							}
							@form.Description() {
								if p.Current != nil {
									A key ending { p.Current.KeyHint } is stored. Leave this blank to keep it.
								} else {
									North stores this encrypted and can never show it back to you.
								}
							}
						}
						@form.Item() {
							@label.Label(label.Props{For: "model"}) {
								Model
							}
							@input.Input(input.Props{
								ID: "model", Name: "model", Value: p.Form.Model,
								Placeholder: defaultModel(p), HasError: p.Form.fieldError("model") != "",
								Attributes: templ.Attributes{
									":placeholder": "hints[provider] ? hints[provider].model : ''",
								},
							})
							if p.Form.fieldError("model") != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ p.Form.fieldError("model") }
								}
							}
							@form.Description() {
								Leave blank for this provider's default. Free text rather than a list,
								because a hardcoded list of models goes stale within weeks.
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
							Save provider
						}
						<p class="text-muted-foreground text-xs leading-relaxed">
							Want Claude? Use an OpenRouter key and a model beginning
							<code class="font-mono">anthropic/</code>.
						</p>
					</div>
				</form>
				if p.Current != nil {
					<form method="post" action="/app/settings/ai/remove" class="border-hairline mt-4 border-t pt-4">
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
							Remove my key
						}
					</form>
				}
			}
		}
	}
}

// providerState seeds the card's Alpine state.
// needsURL is a list rather than a "hermes" literal in the template, so the
// gateway field follows providers.BYOProvider.RequiresBaseURL — the same field
// the server validates against. Two places deciding which providers need a URL
// is how they end up disagreeing.
func providerState(p ProviderPanel) map[string]any {
	needsURL := make([]string, 0, 1)
	hints := make(map[string]map[string]string, len(p.Catalog))

	for _, entry := range p.Catalog {
		if entry.RequiresBaseURL {
			needsURL = append(needsURL, entry.Name)
		}
		// The key shape and default model for each tile, so picking one
		// updates the placeholders below without a round trip. Same source as
		// keyPlaceholder and defaultModel, which stay as the no-JS answer.
		hints[entry.Name] = map[string]string{
			"key":   entry.KeyHint,
			"model": entry.DefaultModel,
		}
	}

	// A string rather than a bool, because this is also the radio group's
	// submitted value. Binding a boolean to it — as this did — replaced the
	// radios' real values with "true"/"false" and left neither checked on a
	// first load, which is how the card opened with no mode selected at all.
	mode := "north"
	if p.Current != nil {
		mode = "own"
	}

	return map[string]any{
		"mode":     mode,
		"provider": p.Form.Provider,
		"needsURL": needsURL,
		"hints":    hints,
	}
}

// providerTile is one selectable provider.
//
// A real radio, visually hidden, with the tile as its label: keyboard focus,
// arrow-key selection within the group, and submission without JavaScript all
// come from the input rather than from anything written here. peer-checked
// carries the selected styling, so the picture and the form agree even when
// Alpine has not loaded.
templ providerTile(entry providers.BYOProvider, selected bool) {
	<label class="cursor-pointer">
		<input
			type="radio"
			name="provider"
			value={ entry.Name }
			x-model="provider"
			checked?={ selected }
			class="peer sr-only"
		/>
		<span
			class="border-hairline peer-checked:border-signal peer-checked:bg-signal/5 peer-focus-visible:ring-ring/50 hover:bg-accent/40 flex h-full flex-col gap-1.5 rounded-lg border p-3 transition-colors peer-focus-visible:ring-[3px]"
		>
			<span class="flex items-center gap-2">
				<span class="[&_svg]:size-5">
					@icon.BrandFor(entry.Name)
				</span>
				<span class="text-sm font-medium">{ entry.Label }</span>
			</span>
			if entry.Note != "" {
				<span class="text-muted-foreground text-xs leading-relaxed">{ entry.Note }</span>
			}
		</span>
	</label>
}

// keyPlaceholder shows the shape of the credential for the selected provider,
// so somebody can tell at a glance whether they pasted the right thing.
func keyPlaceholder(p ProviderPanel) string {
	for _, entry := range p.Catalog {
		if entry.Name == p.Form.Provider {
			return entry.KeyHint
		}
	}
	return "Your provider's API key"
}

func defaultModel(p ProviderPanel) string {
	for _, entry := range p.Catalog {
		if entry.Name == p.Form.Provider {
			return entry.DefaultModel
		}
	}
	return ""
}

// activeKind is the agent tab that opens.
//
// The one the user just picked when a submission came back with errors,
// otherwise the first in the catalogue. Without this a failed submit would
// throw away the choice along with the form.
func activeKind(f ConnectForm) connections.ClientKind {
	if f.Kind != "" {
		return f.Kind
	}
	return connections.ClientKinds[0]
}

// connectCard is the tabbed setup: pick the agent, read exactly what you will
// have to paste, then create the key.
//
// The order matters and is the point of the rebuild. Before this, every snippet
// lived behind issuedCard and appeared only once a key existed — so the way to
// find out what connecting Codex involved was to create a Codex credential.
// Now the snippets are shown with connections.PlaceholderToken standing in for
// the key, and creating one is the last step rather than the first.
templ connectCard(f ConnectForm, previews []connections.Setup) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Connect an agent
			}
			@card.Description() {
				Pick the agent you use. This shows what you will paste; nothing is created
				until you ask for a key.
			}
		}
		@card.Content() {
			@tabs.Tabs(tabs.Props{ID: "surface-tabs"}) {
				@tabs.List(tabs.ListProps{Class: "w-full"}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "hosted", IsActive: true}) {
						This North
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "self"}) {
						Self-hosted
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "hosted", IsActive: true, Class: "pt-4"}) {
					@hostedTabs(f, previews)
				}
				@tabs.Content(tabs.ContentProps{Value: "self", Class: "pt-4"}) {
					@selfHostedPanel()
				}
			}
			// templUI renders inactive tab panels with `hidden` and reveals them
			// in JavaScript, so without it a reader would see one agent and have
			// no way to reach the other three. The page is server-rendered and
			// has to stay readable; this is the same content, stacked.
			<noscript>
				<div class="mt-4 space-y-6">
					<p class="text-muted-foreground text-sm leading-relaxed">
						Every client's setup, since the tabs above need JavaScript to switch.
					</p>
					for _, p := range previews {
						<div>
							<h3 class="mb-2 text-sm font-medium">{ p.Kind.Label() }</h3>
							@copyBlock(p.ConfigLabel, "noscript-"+string(p.Kind), p.ConfigLang, p.Config)
						</div>
					}
				</div>
			</noscript>
		}
	}
}

// hostedTabs is one tab per agent, each showing that client's real snippet.
templ hostedTabs(f ConnectForm, previews []connections.Setup) {
	@tabs.Tabs(tabs.Props{ID: "agent-tabs"}) {
		@tabs.List(tabs.ListProps{Class: "w-full"}) {
			for _, p := range previews {
				@tabs.Trigger(tabs.TriggerProps{
					Value:    string(p.Kind),
					IsActive: p.Kind == activeKind(f),
				}) {
					<span class="[&_svg]:size-4">
						@icon.BrandFor(string(p.Kind))
					</span>
					{ p.Kind.Label() }
				}
			}
		}
		for _, p := range previews {
			@tabs.Content(tabs.ContentProps{
				Value:    string(p.Kind),
				IsActive: p.Kind == activeKind(f),
				Class:    "pt-4",
			}) {
				@agentPanel(f, p)
			}
		}
	}
}

// agentPanel is one client: what it needs, then the button that issues it.
templ agentPanel(f ConnectForm, p connections.Setup) {
	<div class="space-y-5">
		@copyBlock(p.ConfigLabel, "preview-config-"+string(p.Kind), p.ConfigLang, p.Config)
		if p.Safe != "" {
			<div>
				<p class="text-muted-foreground mb-2 text-sm leading-relaxed">
					{ p.SafeNote }
				</p>
				@copyBlock(p.SafeLabel, "preview-safe-"+string(p.Kind), p.SafeLang, p.Safe)
			</div>
		}
		<div>
			<p class="text-muted-foreground mb-2 text-sm leading-relaxed">
				Or hand this to the agent and let it configure itself.
			</p>
			@copyBlock("Setup prompt", "preview-prompt-"+string(p.Kind), "text", p.Prompt)
		</div>
		<form method="post" action="/app/settings/connections" class="border-hairline space-y-4 border-t pt-5">
			@ui.CSRFInput()
			// The tab is the choice. Carrying it as a hidden field means picking
			// the client and creating the key are one action rather than two,
			// and the snippet above is unambiguously the one being issued for.
			<input type="hidden" name="client_kind" value={ string(p.Kind) }/>
			@form.Item() {
				@label.Label(label.Props{For: "name-" + string(p.Kind)}) {
					Name this connection
				}
				@input.Input(input.Props{
					ID: "name-" + string(p.Kind), Name: "name", Value: f.Name, Required: true,
					Placeholder: "Laptop", HasError: f.fieldError("name") != "",
				})
				if f.fieldError("name") != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ f.fieldError("name") }
					}
				}
				@form.Description() {
					Name it after the machine it will live on, so you know which one to
					revoke later.
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
				Create a key for { p.Kind.Label() }
			}
		</form>
	</div>
}

// selfHostedPanel describes the standalone MCP binary.
//
// It issues nothing, because there is nothing here to issue: cmd/mcp-server
// authenticates with a token from its own environment and acts as the single
// account named in MCP_USER_ID. Saying so is the whole content of this tab —
// somebody who expects a button and does not find one should learn why in the
// same breath.
templ selfHostedPanel() {
	<div class="space-y-4 text-sm leading-relaxed">
		<p class="text-muted-foreground">
			North also ships a standalone MCP server (<code class="font-mono">cmd/mcp-server</code>)
			built to serve a single private deployment. It is a different surface with
			different rules, and no key you create here will reach it.
		</p>
		<ul class="text-muted-foreground list-disc space-y-1.5 pl-5">
			<li>Its credential is <code class="font-mono">MCP_API_TOKEN</code> from the environment, not a key from this page.</li>
			<li>Every call acts as the one account in <code class="font-mono">MCP_USER_ID</code>, whoever made it.</li>
			<li>Revoking means editing the environment and restarting, not clicking a button.</li>
			<li>It listens on <code class="font-mono">MCP_LISTEN_ADDR</code> — <code class="font-mono">127.0.0.1:8093</code> by default. Keep it on a tailnet or a loopback; it has no per-user isolation to lose.</li>
		</ul>
		<p class="text-muted-foreground">
			Prefer the hosted surface unless you are the only person using this North. Its
			keys are per person and revocable without a restart.
		</p>
	</div>
}

// calendarCard connects North to somebody's own calendar over MCP.
//
// The outbound direction, unlike everything else on this page: the tokens above
// are ones North issues so an agent can call in, this is a credential North
// uses to call out. Kept on the same page because from the reader's side both
// answer "what is North joined up to".
templ calendarCard(p CalendarPanel) {
	if p.Enabled {
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					Calendar
				}
				@card.Description() {
					Connect a calendar MCP server and your coach can see the next seven days —
					so it stops suggesting a Thursday session when you are already booked.
				}
			}
			@card.Content() {
				if p.Connected != nil {
					@calendarConnected(*p.Connected)
				} else {
					@calendarConnect(p.Error)
				}
			}
		}
	}
}

templ calendarConnected(c integrations.Connection) {
	<div class="space-y-3">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="min-w-0">
				<p class="truncate font-mono text-sm">{ c.Endpoint }</p>
				if c.Healthy() {
					<p class="text-muted-foreground mt-1 text-xs">Answering normally.</p>
				} else {
					<p class="mt-1 text-xs text-red-600 dark:text-red-400">{ c.LastError }</p>
				}
			</div>
			<form method="post" action="/app/settings/integrations/calendar/disconnect">
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					Disconnect
				}
			</form>
		</div>
	</div>
}

templ calendarConnect(errMsg string) {
	<form method="post" action="/app/settings/integrations/calendar" class="space-y-4">
		@ui.CSRFInput()
		if errMsg != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ errMsg }
			}
		}
		@form.Item() {
			@form.Label(form.LabelProps{For: "endpoint"}) {
				Server address
			}
			@input.Input(input.Props{
				ID: "endpoint", Name: "endpoint", Type: input.TypeText,
				Placeholder: "https://calendar.example.com/mcp",
			})
			@form.Description() {
				The MCP endpoint of a server that can list your calendar events.
			}
		}
		@form.Item() {
			@form.Label(form.LabelProps{For: "token"}) {
				Access token
			}
			@input.Input(input.Props{
				ID: "token", Name: "token", Type: input.TypePassword,
				Placeholder: "Leave empty if the server needs no token",
			})
			@form.Description() {
				Stored encrypted. It is never shown again after you save it.
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
			Connect calendar
		}
	</form>
}
