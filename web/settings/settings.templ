package settings

import (
	"fmt"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/calculator"
	"github.com/NorthAIProject/north-client/internal/meals"
	"github.com/NorthAIProject/north-client/internal/notifications"
	"github.com/NorthAIProject/north-client/internal/preferences"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/mascot"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/checkbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/dialog"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/separator"
	switchcomp "github.com/NorthAIProject/north-client/web/shared/ui/switch"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// ProfileForm carries the account fields (users.Service.UpdateProfile).
type ProfileForm struct {
	DisplayName   string
	Timezone      string
	CoachingStyle string
	CoachingTone  users.Tone
	Errors        map[string]string
}

func (f ProfileForm) fieldError(name string) string { return f.Errors[name] }

// tone is the tone to show as selected, defaulting for an account that
// predates the field or a form built from a rejected submission.
func (f ProfileForm) tone() users.Tone {
	if f.CoachingTone.Valid() {
		return f.CoachingTone
	}
	return users.ToneDefault
}

// ProfileFormFor pre-fills from the signed-in user.
func ProfileFormFor(u users.User) ProfileForm {
	return ProfileForm{
		DisplayName: u.DisplayName, Timezone: u.Timezone,
		CoachingStyle: u.CoachingStyle, CoachingTone: u.CoachingTone,
	}
}

// NotificationsForm carries what North may say without being asked.
type NotificationsForm struct {
	NudgeMissedCheckIn bool
	NudgeGoalDeadline  bool
	CoachActivity      bool
	TrainingReminders  bool
	WeeklyReportAuto   bool
	DailyBriefingAuto  bool
	PhotoAskEnabled    bool
	PhotoEveryDays     int
	PhotoReminderDays  int
	QuietHoursEnabled  bool
	QuietStart         string
	QuietEnd           string
	Errors             map[string]string
}

func (f NotificationsForm) fieldError(name string) string { return f.Errors[name] }

func NotificationsFormFor(p notifications.Prefs, photo notifications.Schedule) NotificationsForm {
	return NotificationsForm{
		NudgeMissedCheckIn: p.NudgeMissedCheckIn,
		NudgeGoalDeadline:  p.NudgeGoalDeadline,
		CoachActivity:      p.CoachActivity,
		TrainingReminders:  p.TrainingReminders,
		WeeklyReportAuto:   p.WeeklyReportAuto,
		DailyBriefingAuto:  p.DailyBriefingAuto,
		PhotoAskEnabled:    photo.Enabled,
		PhotoEveryDays:     photo.EveryDays,
		PhotoReminderDays:  photo.ReminderDays,
		QuietHoursEnabled:  p.QuietHoursEnabled,
		QuietStart:         p.QuietStart,
		QuietEnd:           p.QuietEnd,
	}
}

// NotificationsFormFrom re-renders a rejected submission, so a bad quiet-hours
// time does not also lose the three toggles the person just set.
func NotificationsFormFrom(in notifications.Input) NotificationsForm {
	return NotificationsForm{
		NudgeMissedCheckIn: in.NudgeMissedCheckIn,
		NudgeGoalDeadline:  in.NudgeGoalDeadline,
		CoachActivity:      in.CoachActivity,
		TrainingReminders:  in.TrainingReminders,
		WeeklyReportAuto:   in.WeeklyReportAuto,
		DailyBriefingAuto:  in.DailyBriefingAuto,
		QuietHoursEnabled:  in.QuietHoursEnabled,
		QuietStart:         in.QuietStart,
		QuietEnd:           in.QuietEnd,
	}
}

// PreferencesForm carries units/objective/macro-split defaults.
type PreferencesForm struct {
	UnitsSystem       string
	DefaultGoal       string
	DefaultMacroSplit string
	Errors            map[string]string
}

func (f PreferencesForm) fieldError(name string) string { return f.Errors[name] }

func PreferencesFormFor(p preferences.Preferences) PreferencesForm {
	return PreferencesForm{UnitsSystem: p.UnitsSystem, DefaultGoal: p.DefaultGoal, DefaultMacroSplit: p.DefaultMacroSplit}
}

// SettingsSummary is the instrument row at the top of the settings page.
type SettingsSummary struct {
	Timezone        string
	Units           string
	DietCount       int
	ConnectionCount int
}

// Page renders account settings: profile, calculator defaults, and dietary
// preferences (backed by meals.DietPreferenceService — Settings has no
// store of its own for that data).
// deleteErr is the one thing that can go wrong on this page without a form of
// its own: a confirmation that did not match. One string rather than a form
// struct because there is one field and one message, and inventing a
// view-model for that would be more machinery than the failure deserves.
templ Page(user users.User, summary SettingsSummary, profileForm ProfileForm, prefsForm PreferencesForm, notifForm NotificationsForm, allDiets []meals.Diet, selectedDietIDs map[uuid.UUID]bool, saved string, deleteErr string) {
	@layout.App("Settings", user, layout.BuildNav("/app/settings")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Settings")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Account</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					How the coach addresses you, what it defaults to, and what it should never suggest.
				</p>
			</header>
			@settingsKpiStrip(summary)
			if saved != "" {
				<p class="rounded-lg border border-signal/30 bg-signal/10 px-4 py-3 text-sm">{ saved }</p>
			}
			@profileCard(profileForm)
			@notificationsCard(notifForm)
			@preferencesCard(prefsForm)
			@dietsCard(allDiets, selectedDietIDs)
			@connectionsCard()
			@yourDataCard(user, deleteErr)
			@aboutCard()
		</div>
		@label.Script()
		@selectbox.Script()
		@checkbox.Script()
		@dialog.Script()
		@mascot.Script()
	}
}

// aboutCard is the one place in the product that is about North rather than
// about the person using it, which makes it the natural home for the mascot at
// rest. It sits last: everything above it is something you can change.
templ aboutCard() {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Content() {
			<div class="flex items-center gap-4">
				@mascot.Mascot(mascot.Props{ID: "settings-mascot", Size: mascot.SizeMd})
				<div class="space-y-1">
					@ui.MonoLabel("About")
					<p class="text-sm leading-relaxed">
						{ ui.ProductName } is an operating system for personal growth. It
						remembers what you tell it, so you only have to explain once.
					</p>
				</div>
			</div>
		}
	}
}

templ settingsKpiStrip(summary SettingsSummary) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{Label: "Timezone", Value: summary.Timezone})
		@ui.KpiCell(ui.KpiCellProps{Label: "Units", Value: summary.Units})
		@ui.KpiCell(ui.KpiCellProps{Label: "Diets", Value: fmt.Sprintf("%d", summary.DietCount), Href: "#diets", CTA: "Edit"})
		@ui.KpiCell(ui.KpiCellProps{Label: "Connections", Value: fmt.Sprintf("%d", summary.ConnectionCount), Href: "/app/settings/connections", CTA: "Manage"})
	}
}

templ profileCard(f ProfileForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Profile
			}
			@card.Description() {
				Your name, timezone, and how you want to be coached.
			}
		}
		@card.Content() {
			<form method="post" action="/app/settings/profile" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label(label.Props{For: "display_name"}) {
						Name
					}
					@input.Input(input.Props{
						ID: "display_name", Name: "display_name", Value: f.DisplayName, Required: true,
						HasError: f.fieldError("display_name") != "",
					})
					if f.fieldError("display_name") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("display_name") }
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "timezone"}) {
						Timezone
					}
					// A select rather than a text field: an unrecognised zone is
					// stored as UTC without complaint, so a typo here would move
					// somebody's whole day and tell them nothing.
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "timezone", Name: "timezone", HasError: f.fieldError("timezone") != ""}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose a timezone"})
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Search timezones..."}) {
							for _, group := range users.ZoneGroupsIncluding(f.Timezone) {
								@selectbox.Group() {
									@selectbox.Label() {
										{ group.Region }
									}
									for _, zone := range group.Zones {
										@selectbox.Item(selectbox.ItemProps{Value: zone, Selected: f.Timezone == zone}) {
											{ zone }
										}
									}
								}
							}
						}
					}
					if f.fieldError("timezone") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("timezone") }
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "coaching_tone"}) {
						Coaching tone
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "coaching_tone", Name: "coaching_tone"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Direct"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, tone := range users.Tones {
								@selectbox.Item(selectbox.ItemProps{Value: string(tone), Selected: f.tone() == tone}) {
									{ tone.Label() }
								}
							}
						}
					}
					@form.Description() {
						The voice the coach uses. The note below refines it.
					}
					if f.fieldError("coaching_tone") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("coaching_tone") }
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "coaching_style"}) {
						How you want to be coached
					}
					@textarea.Textarea(textarea.Props{
						ID: "coaching_style", Name: "coaching_style", Rows: 3,
						Placeholder: "Optional. E.g. \"Don't let me skip leg day twice.\"",
					}) {
						{ f.CoachingStyle }
					}
					if f.fieldError("coaching_style") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("coaching_style") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save profile
				}
			</form>
		}
	}
}

// notificationsCard is what North may say when nobody asked it anything.
templ notificationsCard(f NotificationsForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "notifications"}) {
		@card.Header() {
			@card.Title() {
				Notifications
			}
			@card.Description() {
				When North speaks first. Quiet hours follow your timezone.
			}
		}
		@card.Content() {
			<form method="post" action="/app/settings/notifications" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "nudge_missed_checkin", Name: "nudge_missed_checkin", Checked: f.NudgeMissedCheckIn,
					})
					@label.Label(label.Props{For: "nudge_missed_checkin"}) {
						Remind me when I stop checking in
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "nudge_goal_deadline", Name: "nudge_goal_deadline", Checked: f.NudgeGoalDeadline,
					})
					@label.Label(label.Props{For: "nudge_goal_deadline"}) {
						Warn me before a goal is due
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "coach_activity", Name: "coach_activity", Checked: f.CoachActivity,
					})
					@label.Label(label.Props{For: "coach_activity"}) {
						Tell me when the coach has something
					}
					@form.Description() {
						First-week check-ins, a reply from Telegram, a finished form check.
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "training_reminders", Name: "training_reminders", Checked: f.TrainingReminders,
					})
					@label.Label(label.Props{For: "training_reminders"}) {
						Remind me on a training day
					}
				}
				@separator.Separator()
				<p class="text-sm font-medium">Photo check-ins</p>
				<p class="text-muted-foreground text-xs">
					I ask for a photo on this cadence, then remind you if nothing arrives.
				</p>
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "photo_ask_enabled", Name: "photo_ask_enabled", Checked: f.PhotoAskEnabled,
					})
					@label.Label(label.Props{For: "photo_ask_enabled"}) {
						Ask me for a photo
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "photo_every_days"}) {
						How often
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "photo_every_days", Name: "photo_every_days"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Every 2 weeks"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "7", Selected: f.PhotoEveryDays == 7}) {
								Every week
							}
							@selectbox.Item(selectbox.ItemProps{Value: "14", Selected: f.PhotoEveryDays == 14 || f.PhotoEveryDays == 0}) {
								Every 2 weeks
							}
							@selectbox.Item(selectbox.ItemProps{Value: "21", Selected: f.PhotoEveryDays == 21}) {
								Every 3 weeks
							}
							@selectbox.Item(selectbox.ItemProps{Value: "28", Selected: f.PhotoEveryDays == 28}) {
								Every 4 weeks
							}
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "photo_reminder_days"}) {
						If I forget
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "photo_reminder_days", Name: "photo_reminder_days"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Remind me 2 days later"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: f.PhotoReminderDays == 0}) {
								No reminder
							}
							@selectbox.Item(selectbox.ItemProps{Value: "2", Selected: f.PhotoReminderDays == 2}) {
								Remind me 2 days later
							}
							@selectbox.Item(selectbox.ItemProps{Value: "3", Selected: f.PhotoReminderDays == 3}) {
								Remind me 3 days later
							}
							@selectbox.Item(selectbox.ItemProps{Value: "7", Selected: f.PhotoReminderDays == 7}) {
								Remind me a week later
							}
						}
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "weekly_report_auto", Name: "weekly_report_auto", Checked: f.WeeklyReportAuto,
					})
					@label.Label(label.Props{For: "weekly_report_auto"}) {
						Write my weekly review automatically
					}
					@form.Description() {
						Generated on Monday morning, your time, for the week that just ended.
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "daily_briefing_auto", Name: "daily_briefing_auto", Checked: f.DailyBriefingAuto,
					})
					@label.Label(label.Props{For: "daily_briefing_auto"}) {
						Write my morning briefing automatically
					}
					@form.Description() {
						A few sentences each morning, your time, from your goals and last check-in.
					}
				}
				@form.Item() {
					@switchcomp.Switch(switchcomp.Props{
						ID: "quiet_hours_enabled", Name: "quiet_hours_enabled", Checked: f.QuietHoursEnabled,
					})
					@label.Label(label.Props{For: "quiet_hours_enabled"}) {
						Stay quiet at night
					}
				}
				<div class="grid grid-cols-2 gap-3 sm:max-w-xs">
					@form.Item() {
						@label.Label(label.Props{For: "quiet_start"}) {
							From
						}
						// A native time input rather than the timepicker component:
						// this posts "HH:MM", which is exactly what the column's
						// CHECK constraint and the service both expect.
						@input.Input(input.Props{
							ID: "quiet_start", Name: "quiet_start", Type: input.TypeTime, Value: f.QuietStart,
							HasError: f.fieldError("quiet_start") != "",
						})
						if f.fieldError("quiet_start") != "" {
							@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
								{ f.fieldError("quiet_start") }
							}
						}
					}
					@form.Item() {
						@label.Label(label.Props{For: "quiet_end"}) {
							To
						}
						@input.Input(input.Props{
							ID: "quiet_end", Name: "quiet_end", Type: input.TypeTime, Value: f.QuietEnd,
							HasError: f.fieldError("quiet_end") != "",
						})
						if f.fieldError("quiet_end") != "" {
							@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
								{ f.fieldError("quiet_end") }
							}
						}
					}
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save notifications
				}
			</form>
		}
	}
}

templ preferencesCard(f PreferencesForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Fitness defaults
			}
			@card.Description() {
				Pre-fills the calculator; you can still override per calculation.
			}
		}
		@card.Content() {
			<form method="post" action="/app/settings/preferences" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label() {
						Units
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "units_system", Name: "units_system"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Metric"})
						}
						@selectbox.Content() {
							@selectbox.Item(selectbox.ItemProps{Value: preferences.UnitsMetric, Selected: f.UnitsSystem == preferences.UnitsMetric}) {
								Metric (kg, cm)
							}
							@selectbox.Item(selectbox.ItemProps{Value: preferences.UnitsImperial, Selected: f.UnitsSystem == preferences.UnitsImperial}) {
								Imperial (lb, in)
							}
						}
					}
				}
				@form.Item() {
					@label.Label() {
						Default objective
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "default_goal", Name: "default_goal"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Maintenance"})
						}
						@selectbox.Content() {
							@selectbox.Item(selectbox.ItemProps{Value: calculator.GoalCutting, Selected: f.DefaultGoal == calculator.GoalCutting}) {
								Cutting
							}
							@selectbox.Item(selectbox.ItemProps{Value: calculator.GoalMaintenance, Selected: f.DefaultGoal == calculator.GoalMaintenance}) {
								Maintenance
							}
							@selectbox.Item(selectbox.ItemProps{Value: calculator.GoalBulking, Selected: f.DefaultGoal == calculator.GoalBulking}) {
								Bulking
							}
						}
					}
				}
				@form.Item() {
					@label.Label() {
						Default macro split
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "default_macro_split", Name: "default_macro_split"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Moderate carb"})
						}
						@selectbox.Content() {
							@selectbox.Item(selectbox.ItemProps{Value: calculator.SplitHighCarb, Selected: f.DefaultMacroSplit == calculator.SplitHighCarb}) {
								High carb
							}
							@selectbox.Item(selectbox.ItemProps{Value: calculator.SplitModerateCarb, Selected: f.DefaultMacroSplit == calculator.SplitModerateCarb}) {
								Moderate carb
							}
							@selectbox.Item(selectbox.ItemProps{Value: calculator.SplitLowCarb, Selected: f.DefaultMacroSplit == calculator.SplitLowCarb}) {
								Low carb
							}
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save defaults
				}
			</form>
		}
	}
}

templ dietsCard(allDiets []meals.Diet, selected map[uuid.UUID]bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "diets"}) {
		@card.Header() {
			@card.Title() {
				Dietary preferences
			}
			@card.Description() {
				The coach won't suggest meals outside of these.
			}
		}
		@card.Content() {
			<form method="post" action="/app/settings/diets" class="space-y-4">
				@ui.CSRFInput()
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
					for _, d := range allDiets {
						<label class="flex items-center gap-2 text-sm">
							@checkbox.Checkbox(checkbox.Props{Name: "diet_ids", Value: d.ID.String(), Checked: selected[d.ID]})
							{ d.Name }
						</label>
					}
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save preferences
				}
			</form>
		}
	}
}

// connectionsCard is a doorway, not a section. Managing agent keys needs a
// list, a one-time reveal, and a destructive action, which is more than this
// page should carry — so it links to a page of its own.
templ connectionsCard() {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Agent connections
			}
			@card.Description() {
				Let Claude Code, Codex, or Hermes work with your goals, check-ins, and coach.
			}
		}
		@card.Content() {
			<div class="flex flex-wrap gap-2">
				@button.Button(button.Props{Href: "/app/settings/connections", Variant: button.VariantOutline}) {
					Manage connections
				}
				// Next to the keys that grant the access, because this is what
				// those keys have actually done.
				@button.Button(button.Props{Href: "/app/settings/activity", Variant: button.VariantOutline}) {
					View activity
				}
			</div>
		}
	}
}

// yourDataCard puts leaving with your data and leaving altogether in the same
// place, because they are the same question asked twice. Being able to take a
// copy is what makes deleting a real option rather than a threat.
templ yourDataCard(user users.User, deleteErr string) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Your data
			}
			@card.Description() {
				Take a copy of everything North holds, or close the account for good.
			}
		}
		@card.Content() {
			<div class="space-y-6">
				<div class="space-y-3">
					<p class="text-muted-foreground text-sm leading-relaxed">
						The export is a zip of plain text and your own original files: your profile,
						goals, check-ins, what North remembers, your documents, and every conversation.
						Nothing in it needs North to read it.
					</p>
					@button.Button(button.Props{Href: "/app/settings/export.zip", Variant: button.VariantOutline}) {
						Download my data
					}
				</div>
				<div class="border-hairline space-y-3 border-t pt-6">
					<p class="text-muted-foreground text-sm leading-relaxed">
						Deleting removes your account and everything in it straight away — goals,
						check-ins, conversations, documents, and the files behind them. It cannot be
						undone, and North keeps no copy to restore from. Download your data first if
						you want it.
					</p>
					if deleteErr != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ deleteErr }
						}
					}
					@deleteAccountDialog(user)
				</div>
			</div>
		}
	}
}

// deleteAccountDialog asks for the account's own email address rather than a
// password. An account here can be held entirely by a passkey or by Google, and
// a confirmation half the accounts cannot satisfy is not a confirmation.
templ deleteAccountDialog(user users.User) {
	@dialog.Trigger(dialog.TriggerProps{For: "delete-account"}) {
		@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeButton}) {
			Delete my account
		}
	}
	@dialog.Dialog(dialog.Props{ID: "delete-account"}) {
		@dialog.Content() {
			<form method="post" action="/app/settings/account/delete">
				@ui.CSRFInput()
				@dialog.Header() {
					@dialog.Title() {
						Delete your account?
					}
					@dialog.Description() {
						This erases everything North holds for you and signs you out everywhere.
						There is no undo and no grace period.
					}
				}
				<div class="py-4">
					@form.Item() {
						@label.Label(label.Props{For: "confirm_email"}) {
							Type { user.Email } to confirm
						}
						@input.Input(input.Props{
							ID: "confirm_email", Name: "confirm_email", Type: "email",
							Required: true, Placeholder: user.Email,
						})
					}
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
							Keep my account
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						Delete everything
					}
				}
			</form>
		}
	}
}
