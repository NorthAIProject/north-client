package crews

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/crews/crew"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/copybutton"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

type CreateForm struct {
	Name   string
	Errors map[string]string
}

func (f CreateForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

func challengeLabel(c *crew.Challenge) string {
	if c == nil {
		return "No challenge this week."
	}
	noun := "check-ins"
	if c.Kind == crew.ChallengeWorkouts {
		noun = "workouts"
	}
	return fmt.Sprintf("%d %s each, Monday to Sunday.", c.Target, noun)
}

func percent(done, target int) int {
	if target <= 0 {
		return 0
	}
	return min(100, done*100/target)
}

templ IndexPage(user users.User, mine []crew.Crew, f CreateForm) {
	@layout.App("Crews", user, layout.BuildNav(ctx, "/app/crews")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Progress")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Crews</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					A few people keeping each other going. Crewmates see who checked in and trained today, streaks, and the week's challenge. Nothing else.
				</p>
			</header>
			if len(mine) > 0 {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Content(card.ContentProps{Class: "pt-6"}) {
						<ul class="divide-y divide-hairline">
							for _, c := range mine {
								<li class="flex items-center justify-between py-3">
									<a class="text-sm font-medium hover:underline" href={ templ.SafeURL("/app/crews/" + c.ID.String()) }>{ c.Name }</a>
									<span class="text-muted-foreground text-xs">{ fmt.Sprint(c.Members) } people</span>
								</li>
							}
						</ul>
					}
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						Start a crew
					}
					@card.Description() {
						Up to eight people. Two is an accountability partner.
					}
				}
				@card.Content() {
					<form method="post" action="/app/crews" class="flex items-end gap-2">
						@ui.CSRFInput()
						@form.Item(form.ItemProps{Class: "flex-1"}) {
							@label.Label(label.Props{For: "name", Error: f.fieldError("name")}) {
								Name
							}
							@input.Input(input.Props{ID: "name", Name: "name", Value: f.Name, Placeholder: "e.g. Morning runners", HasError: f.fieldError("name") != ""})
							if f.fieldError("name") != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ f.fieldError("name") }
								}
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Create
						}
					</form>
				}
			}
		</div>
		@label.Script()
	}
}

templ BoardPage(user users.User, b crew.Board, joinURL string) {
	@layout.App(b.Name, user, layout.BuildNav(ctx, "/app/crews")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Crew")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ b.Name }</h1>
				<p class="text-muted-foreground mt-1 text-sm">{ challengeLabel(b.Challenge) }</p>
			</header>
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						Today
					}
				}
				@card.Content() {
					<ul class="divide-y divide-hairline">
						for _, m := range b.Members {
							<li class="py-3">
								<div class="flex items-center gap-3">
									<div class="min-w-0 flex-1">
										<p class="truncate text-sm font-medium">
											if m.Me {
												You
											} else {
												{ m.DisplayName }
											}
											if m.Owner {
												<span class="text-muted-foreground text-xs"> · owner</span>
											}
										</p>
										<p class="text-muted-foreground text-xs">{ fmt.Sprint(m.Streak) }-day check-in streak</p>
									</div>
									if m.CheckedIn {
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
											Checked in
										}
									} else {
										@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
											Not yet
										}
									}
									if m.WorkedOut {
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
											Trained
										}
									}
									if b.IsOwner && !m.Me {
										<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/members/" + m.ID.String() + "/remove") }>
											@ui.CSRFInput()
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
												Remove
											}
										</form>
									}
								</div>
								if b.Challenge != nil {
									<div class="mt-2 flex items-center gap-3">
										@progress.Progress(progress.Props{Value: percent(m.WeekProgress, b.Challenge.Target), Class: "h-1.5 flex-1"})
										<span class="text-muted-foreground text-xs tabular-nums">{ fmt.Sprintf("%d/%d", m.WeekProgress, b.Challenge.Target) }</span>
									</div>
								}
							</li>
						}
					</ul>
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						Invite to the crew
					}
					@card.Description() {
						{ fmt.Sprint(len(b.Members)) } of up to { fmt.Sprint(crew.MaxMembers) }. Anyone with the link can join.
					}
				}
				@card.Content() {
					<div class="flex items-center gap-2">
						@input.Input(input.Props{ID: "crew-url", Value: joinURL, Readonly: true, Class: "font-mono text-sm"})
						@copybutton.CopyButton(copybutton.Props{TargetID: "crew-url"})
					</div>
				}
			}
			if b.IsOwner {
				@challengeCard(b)
			}
			<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/leave") }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost}) {
					Leave crew
				}
			</form>
		</div>
		@copybutton.Script()
		@selectbox.Script()
		@progress.Script()
		@label.Script()
	}
}

templ challengeCard(b crew.Board) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Weekly challenge
			}
		}
		@card.Content() {
			<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/challenge") } class="flex flex-wrap items-end gap-2">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label(label.Props{For: "kind"}) {
						What
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "kind", Name: "kind"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose"})
						}
						@selectbox.Content(selectbox.ContentProps{}) {
							@selectbox.Item(selectbox.ItemProps{Value: crew.ChallengeCheckIns, Selected: b.Challenge != nil && b.Challenge.Kind == crew.ChallengeCheckIns}) {
								Check-ins
							}
							@selectbox.Item(selectbox.ItemProps{Value: crew.ChallengeWorkouts, Selected: b.Challenge != nil && b.Challenge.Kind == crew.ChallengeWorkouts}) {
								Workouts
							}
							@selectbox.Item(selectbox.ItemProps{Value: "none", Selected: b.Challenge == nil}) {
								No challenge
							}
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "target"}) {
						Times a week
					}
					@input.Input(input.Props{ID: "target", Name: "target", Type: input.TypeNumber, Value: targetValue(b.Challenge), Attributes: templ.Attributes{"min": "1", "max": "7"}})
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					Set
				}
			</form>
		}
	}
}

func targetValue(c *crew.Challenge) string {
	if c == nil {
		return "3"
	}
	return fmt.Sprint(c.Target)
}

// JoinPage is /i/c/<code> for somebody not signed in.
templ JoinPage(c crew.Crew) {
	@layout.Auth("Join " + c.Name) {
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					Join { c.Name } on Khepri
				}
				@card.Description() {
					{ fmt.Sprint(c.Members) } people keeping each other going. In a crew you see each other's check-ins, training, streaks and the week's challenge. Nothing else.
				}
			}
			@card.Content() {
				<div class="flex flex-col gap-2">
					@button.Button(button.Props{Href: "/signup", FullWidth: true}) {
						Create your account
					}
					@button.Button(button.Props{Href: "/login", Variant: button.VariantGhost, FullWidth: true}) {
						I already have one
					}
				</div>
			}
		}
	}
}
