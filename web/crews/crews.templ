package crews

import (
	"context"
	"fmt"

	"github.com/NorthAIProject/north-client/internal/crews/crew"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/copybutton"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

type CreateForm struct {
	Name   string
	Errors map[string]string
}

func (f CreateForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// canRemove is whether the viewer may take m out: the owner anybody else,
// an admin only plain members.
func canRemove(b crew.Board, m crew.Member) bool {
	if m.Me || !b.MyRole.CanManage() {
		return false
	}
	return b.MyRole == crew.RoleOwner || m.Role == crew.RoleMember
}

// toggledRole is the role the owner's button on m's row gives them.
func toggledRole(r crew.Role) crew.Role {
	if r == crew.RoleAdmin {
		return crew.RoleMember
	}
	return crew.RoleAdmin
}

func challengeLabel(ctx context.Context, c *crew.Challenge) string {
	if c == nil {
		return i18n.T(ctx, "crews.challenge.none")
	}
	if c.Kind == crew.ChallengeWorkouts {
		return i18n.Tf(ctx, "crews.challenge.workouts", c.Target)
	}
	return i18n.Tf(ctx, "crews.challenge.checkins", c.Target)
}

// pick chooses the singular or plural form of a counted string; the singular
// is not "1 people" in any of these languages.
func pick(ctx context.Context, n int, one, many string) string {
	if n == 1 {
		return i18n.T(ctx, one)
	}
	return i18n.Tf(ctx, many, n)
}

func percent(done, target int) int {
	if target <= 0 {
		return 0
	}
	return min(100, done*100/target)
}

templ IndexPage(user users.User, mine []crew.Crew, f CreateForm) {
	@layout.App(i18n.T(ctx, "crews.title"), user, layout.BuildNav(ctx, "/app/crews")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "crews.mono"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "crews.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					{ i18n.T(ctx, "crews.intro") }
				</p>
			</header>
			if len(mine) > 0 {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Content(card.ContentProps{Class: "pt-6"}) {
						<ul class="divide-y divide-hairline">
							for _, c := range mine {
								<li class="flex items-center justify-between py-3">
									<a class="text-sm font-medium hover:underline" href={ templ.SafeURL("/app/crews/" + c.ID.String()) }>{ c.Name }</a>
									<span class="text-muted-foreground text-xs">{ pick(ctx, c.Members, "crews.members.one", "crews.members.many") }</span>
								</li>
							}
						</ul>
					}
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "crews.start.title") }
					}
					@card.Description() {
						{ i18n.T(ctx, "crews.start.desc") }
					}
				}
				@card.Content() {
					<form method="post" action="/app/crews" class="flex items-end gap-2">
						@ui.CSRFInput()
						@form.Item(form.ItemProps{Class: "flex-1"}) {
							@label.Label(label.Props{For: "name", Error: f.fieldError("name")}) {
								{ i18n.T(ctx, "crews.name") }
							}
							@input.Input(input.Props{ID: "name", Name: "name", Value: f.Name, Placeholder: i18n.T(ctx, "crews.name.placeholder"), HasError: f.fieldError("name") != ""})
							if f.fieldError("name") != "" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ f.fieldError("name") }
								}
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "crews.create") }
						}
					</form>
				}
			}
		</div>
		@label.Script()
	}
}

// ChallengePane is the crew's challenge tab: who checked in and trained
// today, the week's challenge and each member's progress on it, and the
// invite link. The space page carries the scripts it needs.
templ ChallengePane(b crew.Board, joinURL string) {
	<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
		<header>
			@ui.MonoLabel(i18n.T(ctx, "crews.board.mono"))
			<h1 class="mt-2 text-2xl font-medium tracking-tight">{ b.Name }</h1>
			<p class="text-muted-foreground mt-1 text-sm">{ challengeLabel(ctx, b.Challenge) }</p>
		</header>
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "crews.today") }
				}
			}
			@card.Content() {
				<ul class="divide-y divide-hairline">
					for _, m := range b.Members {
						<li class="py-3">
							<div class="flex items-center gap-3">
								<div class="min-w-0 flex-1">
									<p class="truncate text-sm font-medium">
										if m.Me {
											{ i18n.T(ctx, "crews.you") }
										} else {
											{ m.DisplayName }
										}
										if m.Owner {
											<span class="text-muted-foreground text-xs">· { i18n.T(ctx, "crews.owner") }</span>
										} else if m.Role == crew.RoleAdmin {
											<span class="text-muted-foreground text-xs">· { i18n.T(ctx, "crews.admin") }</span>
										}
									</p>
									<p class="text-muted-foreground text-xs">{ i18n.Tf(ctx, "crews.streak", m.Streak) }</p>
								</div>
								if m.CheckedIn {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ i18n.T(ctx, "crews.checkedin") }
									}
								} else {
									@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
										{ i18n.T(ctx, "crews.notyet") }
									}
								}
								if m.WorkedOut {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ i18n.T(ctx, "crews.trained") }
									}
								}
								if b.IsOwner && !m.Me {
									<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/members/" + m.ID.String() + "/role") }>
										@ui.CSRFInput()
										<input type="hidden" name="role" value={ string(toggledRole(m.Role)) }/>
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
											if m.Role == crew.RoleAdmin {
												{ i18n.T(ctx, "crews.role.remove-admin") }
											} else {
												{ i18n.T(ctx, "crews.role.make-admin") }
											}
										}
									</form>
								}
								if canRemove(b, m) {
									<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/members/" + m.ID.String() + "/remove") }>
										@ui.CSRFInput()
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
											{ i18n.T(ctx, "crews.remove") }
										}
									</form>
								}
							</div>
							if b.Challenge != nil {
								<div class="mt-2 flex items-center gap-3">
									@progress.Progress(progress.Props{Value: percent(m.WeekProgress, b.Challenge.Target), Class: "h-1.5 flex-1"})
									<span class="text-muted-foreground text-xs tabular-nums">{ fmt.Sprintf("%d/%d", m.WeekProgress, b.Challenge.Target) }</span>
								</div>
							}
						</li>
					}
				</ul>
			}
		}
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "crews.invite.title") }
				}
				@card.Description() {
					{ i18n.Tf(ctx, "crews.invite.desc", len(b.Members), crew.MaxMembers) }
				}
			}
			@card.Content() {
				<div class="flex items-center gap-2">
					@input.Input(input.Props{ID: "crew-board-url", Value: joinURL, Readonly: true, Class: "font-mono text-sm"})
					@copybutton.CopyButton(copybutton.Props{TargetID: "crew-board-url"})
				</div>
			}
		}
		if b.MyRole.CanManage() {
			@challengeCard(b)
		}
		<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/leave") }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost}) {
				{ i18n.T(ctx, "crews.leave") }
			}
		</form>
	</div>
}

templ challengeCard(b crew.Board) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "crews.challenge.title") }
			}
		}
		@card.Content() {
			<form method="post" action={ templ.SafeURL("/app/crews/" + b.ID.String() + "/challenge") } class="flex flex-wrap items-end gap-2">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label(label.Props{For: "kind"}) {
						{ i18n.T(ctx, "crews.challenge.what") }
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "kind", Name: "kind"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "crews.challenge.choose")})
						}
						@selectbox.Content(selectbox.ContentProps{}) {
							@selectbox.Item(selectbox.ItemProps{Value: crew.ChallengeCheckIns, Selected: b.Challenge != nil && b.Challenge.Kind == crew.ChallengeCheckIns}) {
								{ i18n.T(ctx, "crews.challenge.opt.checkins") }
							}
							@selectbox.Item(selectbox.ItemProps{Value: crew.ChallengeWorkouts, Selected: b.Challenge != nil && b.Challenge.Kind == crew.ChallengeWorkouts}) {
								{ i18n.T(ctx, "crews.challenge.opt.workouts") }
							}
							@selectbox.Item(selectbox.ItemProps{Value: "none", Selected: b.Challenge == nil}) {
								{ i18n.T(ctx, "crews.challenge.opt.none") }
							}
						}
					}
				}
				@form.Item() {
					@label.Label(label.Props{For: "target"}) {
						{ i18n.T(ctx, "crews.challenge.times") }
					}
					@input.Input(input.Props{ID: "target", Name: "target", Type: input.TypeNumber, Value: targetValue(b.Challenge), Attributes: templ.Attributes{"min": "1", "max": "7"}})
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					{ i18n.T(ctx, "crews.challenge.set") }
				}
			</form>
		}
	}
}

func targetValue(c *crew.Challenge) string {
	if c == nil {
		return "3"
	}
	return fmt.Sprint(c.Target)
}

// JoinPage is /i/c/<code> for somebody not signed in.
templ JoinPage(c crew.Crew) {
	@layout.Auth(i18n.Tf(ctx, "crews.join.title", c.Name)) {
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.Tf(ctx, "crews.join.heading", c.Name) }
				}
				@card.Description() {
					{ pick(ctx, c.Members, "crews.join.desc.one", "crews.join.desc.many") }
				}
			}
			@card.Content() {
				<div class="flex flex-col gap-2">
					@button.Button(button.Props{Href: "/signup", FullWidth: true}) {
						{ i18n.T(ctx, "crews.join.signup") }
					}
					@button.Button(button.Props{Href: "/login", Variant: button.VariantGhost, FullWidth: true}) {
						{ i18n.T(ctx, "crews.join.login") }
					}
				</div>
			}
		}
	}
}
