package calculator

import (
	"fmt"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/biometrics"
	"github.com/NorthAIProject/north-client/internal/calculator/macroplan"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

// BiometricsForm carries submitted (or rejected) body measurements, as typed:
// in whatever units the person works in, not necessarily metric.
type BiometricsForm struct {
	Weight      string
	Height      string
	DateOfBirth string
	Sex         string
	Errors      map[string]string
}

func (f BiometricsForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// PlanForm carries the submitted choices for a new plan.
type PlanForm struct {
	ActivityLevel string
	Goal          string
	MacroSplit    string
	Errors        map[string]string
}

func (f PlanForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// choiceLabel renders one option as "Label — what it means".
//
// The description goes in the option text because the choice is meaningless
// without it: "moderate" and "heavy" are several hundred calories a day apart,
// and nothing in those two words says which one someone training four times a
// week should pick.
func choiceLabel(value string, descriptions map[string]string) string {
	label := humanize(value)
	if description, ok := descriptions[value]; ok {
		return label + " — " + description
	}
	return label
}

// humanize turns an enum value ("extra_heavy") into a label ("Extra heavy").
func humanize(value string) string {
	if value == "" {
		return ""
	}
	spaced := strings.ReplaceAll(value, "_", " ")
	return strings.ToUpper(spaced[:1]) + spaced[1:]
}

// currentMeasurements renders the stored metric biometrics in the person's own
// units. The numbers and their labels both come from macroplan, so a converted
// value and the unit beside it cannot disagree.
//
// Replaces biometrics.Summary() here, which is metric-only — it is still the
// right thing for the coach's context, which is not shown to anyone.
func currentMeasurements(bio biometrics.Biometric, units string) string {
	weight, height := macroplan.Display(bio.WeightKg, bio.HeightCm, units)
	return fmt.Sprintf("%.1f %s, %.1f %s, %d years old.",
		weight, macroplan.WeightUnit(units),
		height, macroplan.HeightUnit(units),
		bio.AgeYears(time.Now()))
}

templ Page(user users.User, bio biometrics.Biometric, hasBio bool, plan macroplan.MacroPlan, hasPlan bool, bioForm BiometricsForm, planForm PlanForm, units string) {
	@layout.App("Calculator", user, layout.BuildNav("/app/fitness")) {
		<div class="mx-auto w-full max-w-2xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Fitness")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Calorie & macro calculator</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					Mifflin-St Jeor, scaled by your own activity and goal.
				</p>
			</header>
			@biometricsCard(bio, hasBio, bioForm, units)
			@planCard(plan, hasPlan, planForm)
			if hasPlan {
				@goalComparison(plan)
			}
		</div>
		@label.Script()
		@selectbox.Script()
	}
}

templ biometricsCard(bio biometrics.Biometric, hasBio bool, f BiometricsForm, units string) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Your measurements
			}
			@card.Description() {
				if hasBio {
					{ currentMeasurements(bio, units) }
				} else {
					Needed before a plan can be generated.
				}
			}
		}
		@card.Content() {
			<form method="post" action="/app/calculator/biometrics" class="space-y-4">
				@ui.CSRFInput()
				<div class="grid grid-cols-2 gap-4">
					@form.Item() {
						@label.Label(label.Props{For: "weight"}) {
							{ "Weight (" + macroplan.WeightUnit(units) + ")" }
						}
						@input.Input(input.Props{ID: "weight", Name: "weight", Type: input.TypeNumber, Attributes: templ.Attributes{"step": "0.1"}, Value: f.Weight, Required: true, HasError: f.fieldError("weight_kg") != ""})
						if f.fieldError("weight_kg") != "" {
							@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
								{ f.fieldError("weight_kg") }
							}
						}
					}
					@form.Item() {
						@label.Label(label.Props{For: "height"}) {
							{ "Height (" + macroplan.HeightUnit(units) + ")" }
						}
						@input.Input(input.Props{ID: "height", Name: "height", Type: input.TypeNumber, Attributes: templ.Attributes{"step": "0.1"}, Value: f.Height, Required: true, HasError: f.fieldError("height_cm") != ""})
						if f.fieldError("height_cm") != "" {
							@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
								{ f.fieldError("height_cm") }
							}
						}
					}
				</div>
				@form.Item() {
					@label.Label(label.Props{For: "date_of_birth"}) {
						Date of birth
					}
					@input.Input(input.Props{ID: "date_of_birth", Name: "date_of_birth", Type: input.TypeDate, Value: f.DateOfBirth, Required: true, HasError: f.fieldError("date_of_birth") != ""})
					if f.fieldError("date_of_birth") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("date_of_birth") }
						}
					}
				}
				@form.Item() {
					@label.Label() {
						Sex
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "sex", Name: "sex"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose one"})
						}
						@selectbox.Content() {
							@selectbox.Item(selectbox.ItemProps{Value: biometrics.SexMale, Selected: f.Sex == biometrics.SexMale}) {
								Male
							}
							@selectbox.Item(selectbox.ItemProps{Value: biometrics.SexFemale, Selected: f.Sex == biometrics.SexFemale}) {
								Female
							}
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Save measurements
				}
			</form>
		}
	}
}

templ planCard(plan macroplan.MacroPlan, hasPlan bool, f PlanForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Generate a plan
			}
			@card.Description() {
				if hasPlan {
					{ plan.Summary() }
				} else {
					Record your measurements above first.
				}
			}
		}
		@card.Content() {
			<form method="post" action="/app/calculator/generate" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label() {
						Activity level
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "activity_level", Name: "activity_level"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Moderate"})
						}
						@selectbox.Content() {
							for _, level := range macroplan.ActivityLevels {
								@selectbox.Item(selectbox.ItemProps{Value: level, Selected: f.ActivityLevel == level}) {
									{ choiceLabel(level, macroplan.ActivityDescriptions) }
								}
							}
						}
					}
				}
				@form.Item() {
					@label.Label() {
						Goal
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "goal", Name: "goal"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Maintenance"})
						}
						@selectbox.Content() {
							for _, goal := range macroplan.Goals {
								@selectbox.Item(selectbox.ItemProps{Value: goal, Selected: f.Goal == goal}) {
									{ choiceLabel(goal, macroplan.GoalDescriptions) }
								}
							}
						}
					}
				}
				@form.Item() {
					@label.Label() {
						Macro split
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "macro_split", Name: "macro_split"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Moderate carb"})
						}
						@selectbox.Content() {
							for _, split := range macroplan.Splits {
								@selectbox.Item(selectbox.ItemProps{Value: split, Selected: f.MacroSplit == split}) {
									{ choiceLabel(split, macroplan.SplitDescriptions) }
								}
							}
						}
					}
				}
				if f.fieldError("_") != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ f.fieldError("_") }
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Generate plan
				}
			</form>
		}
	}
}

// goalComparison shows what each objective would cost at this TDEE.
//
// Shown after a plan exists rather than instead of one: the number that makes
// the choice concrete is the gap between the three, and someone who picked
// Maintenance should be able to see what Cutting would have meant without
// generating a second plan to find out.
templ goalComparison(plan macroplan.MacroPlan) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				What each goal would cost
			}
			@card.Description() {
				{ fmt.Sprintf("Against a TDEE of %.0f kcal a day.", plan.TDEE) }
			}
		}
		@card.Content() {
			<dl class="space-y-2">
				for _, goal := range macroplan.Goals {
					<div class="flex items-baseline justify-between gap-4">
						<dt class="text-sm">
							{ macroplan.GoalLabel(goal) }
							if goal == plan.Goal {
								<span class="text-signal ml-2 font-mono text-[10px] uppercase tracking-[0.14em]">Yours</span>
							}
						</dt>
						<dd class="text-sm font-medium tabular-nums">
							{ fmt.Sprintf("%.0f kcal", macroplan.AllGoals(plan.TDEE)[goal]) }
						</dd>
					</div>
				}
			</dl>
		}
	}
}
