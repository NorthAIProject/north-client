package planimport

import (
	"context"
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/meals/meal"
	"github.com/NorthAIProject/north-client/internal/planimport/draft"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/collapsible"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/table"
)

// MealReview is the meal review page's data.
type MealReview struct {
	Draft     draft.MealDraft
	DraftJSON string
	Error     string

	// NeedsConfirm is set after a save was refused only because a day goes
	// over its target: the page then offers to save anyway.
	NeedsConfirm bool
}

// foodField names a food line's field: food f of option o (0 being the
// meal's first option) of meal m on day d.
func foodField(d, m, o, f int, name string) string {
	return fmt.Sprintf("d%d.m%d.o%d.f%d.%s", d, m, o, f, name)
}

func grams(v *float64) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%g", *v)
}

func macroLine(ctx context.Context, m *draft.MacroGrams) string {
	if m == nil {
		return "—"
	}
	return i18n.Tf(ctx, "planimport.macros", m.ProteinG, m.CarbG, m.FatG)
}

// macroLetters are the protein, carb and fat abbreviations in the reader's
// language, held as one space-separated string: Spanish and Portuguese name
// fat "G", and pt-PT writes carbs "HC".
func macroLetters(ctx context.Context) [3]string {
	letters := [3]string{"P", "C", "F"}
	copy(letters[:], strings.Fields(i18n.T(ctx, "planimport.macro.letters")))
	return letters
}

func stated(ctx context.Context, f draft.FoodDraft) string {
	letters := macroLetters(ctx)
	var parts []string
	for _, s := range []struct {
		v     *float64
		label string
	}{{f.StatedProteinG, letters[0]}, {f.StatedCarbG, letters[1]}, {f.StatedFatG, letters[2]}} {
		if s.v != nil {
			parts = append(parts, fmt.Sprintf("%.0f %s", *s.v, s.label))
		}
	}
	return strings.Join(parts, " · ")
}

func amount(f draft.FoodDraft) string {
	if f.Quantity == nil {
		return f.Unit
	}
	return strings.TrimSpace(fmt.Sprintf("%g %s", *f.Quantity, f.Unit))
}

func ingredientValue(f draft.FoodDraft) string {
	switch {
	case f.SaveAsMine:
		return "mine"
	case f.IngredientID != nil:
		return f.IngredientID.String()
	default:
		return ""
	}
}

func hasStatedMacros(f draft.FoodDraft) bool {
	return f.StatedProteinG != nil && f.StatedCarbG != nil && f.StatedFatG != nil
}

// mealWeekdays is Monday-first, as the rest of the app lists a week, with the
// values meal.Meal stores: 0 is Sunday.
var mealWeekdays = []time.Weekday{time.Monday, time.Tuesday, time.Wednesday, time.Thursday, time.Friday, time.Saturday, time.Sunday}

// mealWeekdayName names a stored weekday (0 is Sunday) in the reader's
// language.
func mealWeekdayName(ctx context.Context, d int) string {
	return i18n.T(ctx, "weekday.long."+strconv.Itoa(d))
}

// bandLabel names a preset carb band. A band this build has no copy for
// shows the label it carries, rather than a key.
func bandLabel(ctx context.Context, band meal.CarbBand) string {
	key := "planimport.band." + string(band.Type)
	if got := i18n.T(ctx, key); got != key {
		return got
	}
	return band.Label
}

// optionName is what option o of m is shown as: the file's own label, or its
// number in the reader's language.
func optionName(ctx context.Context, m draft.MealDraftMeal, o int) string {
	if opts := m.Options(); o >= 0 && o < len(opts) && opts[o].Label != "" {
		return opts[o].Label
	}
	return i18n.Tf(ctx, "nutrition.option.numbered", o+1)
}

func anyOver(days []draft.MealDayDraft) bool {
	for _, d := range days {
		if len(d.Over) > 0 {
			return true
		}
	}
	return false
}

templ MealReviewPage(user users.User, v MealReview) {
	@layout.App(i18n.T(ctx, "planimport.review.title"), user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-5xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "planimport.label"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "planimport.meal.heading") }</h1>
				<p class="text-muted-foreground mt-1 text-sm">
					{ i18n.T(ctx, "planimport.meal.intro") }
				</p>
			</header>
			if v.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ v.Error }
					}
				}
			}
			<form method="post" action="/app/nutrition/import/review" class="space-y-6">
				@ui.CSRFInput()
				<input type="hidden" name="draft" value={ v.DraftJSON }/>
				@defaultSubmit()
				@card.Card() {
					@card.Content(card.ContentProps{Class: "grid gap-4 pt-6 sm:grid-cols-3"}) {
						<label class="block space-y-1 sm:col-span-3">
							<span class="text-muted-foreground text-xs">{ i18n.T(ctx, "planimport.plan_name") }</span>
							@input.Input(input.Props{Name: "name", Value: v.Draft.Name, Required: true})
						</label>
						<div class="space-y-1">
							<span class="text-muted-foreground text-xs">{ i18n.T(ctx, "planimport.meal.mode") }</span>
							@modePicker(v.Draft.Mode)
						</div>
						<div class="space-y-1">
							<span class="text-muted-foreground text-xs">{ i18n.T(ctx, "planimport.meal.carb_type") }</span>
							@planTypePicker(v.Draft.PlanType, v.Draft.Mode == string(meal.Advanced))
						</div>
						if v.Draft.PlanType == string(meal.Custom) {
							<label class="block space-y-1">
								<span class="text-muted-foreground text-xs">{ i18n.T(ctx, "planimport.meal.custom_pct") }</span>
								@input.Input(input.Props{Name: "custom_carb_pct", Type: input.TypeNumber, Value: grams(v.Draft.CustomCarbPct)})
							</label>
						}
						<p class="text-muted-foreground text-xs sm:col-span-3">
							if v.Draft.EveryDay {
								{ i18n.T(ctx, "planimport.meal.every_day") }
							} else if v.Draft.Mode == string(meal.Advanced) {
								{ i18n.T(ctx, "planimport.meal.advanced_help") }
							} else {
								{ i18n.T(ctx, "planimport.meal.easy_help") }
							}
						</p>
						if !v.Draft.HasTarget {
							<p class="text-destructive text-xs sm:col-span-3">
								{ i18n.T(ctx, "planimport.meal.no_target") } <a href="/app/calculator" class="underline">{ i18n.T(ctx, "planimport.meal.no_target.link") }</a>{ i18n.T(ctx, "planimport.meal.no_target.after") }
							</p>
						}
					}
				}
				if len(v.Draft.Unparsed) > 0 {
					@unparsedList(v.Draft.Unparsed)
				}
				if v.Draft.Notes != "" {
					@planNotes(v.Draft.Notes)
				}
				for i, day := range v.Draft.Days {
					@mealDay(i, day, v.Draft.Mode == string(meal.Advanced), v.Draft.EveryDay)
				}
				if v.NeedsConfirm && v.Draft.CanConfirm && anyOver(v.Draft.Days) {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							{ i18n.T(ctx, "planimport.meal.over.title") }
						}
						@alert.Description() {
							<p>{ i18n.T(ctx, "planimport.meal.over.body") }</p>
							<div class="mt-3">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"name": "action", "value": "save-confirm"}}) {
									{ i18n.T(ctx, "planimport.meal.over.confirm") }
								}
							</div>
						}
					}
				}
				<div class="flex flex-wrap items-center justify-end gap-2">
					@button.Button(button.Props{Href: "/app/nutrition/plans", Variant: button.VariantGhost}) {
						{ i18n.T(ctx, "planimport.cancel_import") }
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Attributes: templ.Attributes{"name": "action", "value": "update", "formnovalidate": true}}) {
						{ i18n.T(ctx, "planimport.meal.recalculate") }
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"name": "action", "value": "save"}}) {
						{ i18n.T(ctx, "planimport.save_plan") }
					}
				</div>
			</form>
		</div>
		@selectbox.Script()
		@input.Script()
		@collapsible.Script()
	}
}

// planNotes shows the advice, recipes and guidance the file carried beside
// its meals. They are saved with the plan as written, so nothing here is
// editable.
templ planNotes(notes string) {
	@card.Card() {
		@collapsible.Collapsible() {
			@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "planimport.meal.notes.title") }
					}
					@card.Description() {
						{ i18n.T(ctx, "planimport.meal.notes.body") }
					}
				}
			}
			@collapsible.Content() {
				@card.Content() {
					<p class="text-muted-foreground text-sm whitespace-pre-wrap">{ notes }</p>
				}
			}
		}
	}
}

templ planTypePicker(selected string, advanced bool) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "plan_type", HasError: selected == ""}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "planimport.meal.choose_one")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			for _, band := range meal.CarbBands {
				@selectbox.Item(selectbox.ItemProps{Value: string(band.Type), Selected: string(band.Type) == selected}) {
					{ fmt.Sprintf("%s (%.0f–%.0f%%)", bandLabel(ctx, band), band.MinPct, band.MaxPct) }
				}
			}
			if advanced {
				@selectbox.Item(selectbox.ItemProps{Value: string(meal.Custom), Selected: selected == string(meal.Custom)}) {
					{ i18n.T(ctx, "planimport.meal.custom") }
				}
			}
		}
	}
}

templ modePicker(selected string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "mode"}) {
			@selectbox.Value()
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			@selectbox.Item(selectbox.ItemProps{Value: string(meal.Easy), Selected: selected != string(meal.Advanced)}) {
				{ i18n.T(ctx, "planimport.meal.easy") }
			}
			@selectbox.Item(selectbox.ItemProps{Value: string(meal.Advanced), Selected: selected == string(meal.Advanced)}) {
				{ i18n.T(ctx, "planimport.meal.advanced") }
			}
		}
	}
}

templ mealDay(i int, day draft.MealDayDraft, advanced, everyDay bool) {
	@card.Card(card.Props{Class: overClass(day)}) {
		@card.Header(card.HeaderProps{Class: "flex flex-row flex-wrap items-center justify-between gap-3"}) {
			<div>
				@card.Title() {
					{ dayLabel(ctx, day.Label, i) }
				}
				<p class="text-muted-foreground mt-1 font-mono text-xs">
					{ macroLine(ctx, day.Totals) }
					if day.Target != nil {
						<span>{ i18n.Tf(ctx, "planimport.meal.target_left", macroLine(ctx, day.Target), macroLine(ctx, day.Remaining)) }</span>
					}
				</p>
				for _, o := range day.Over {
					<p class="text-destructive mt-1 text-xs font-medium">{ o }</p>
				}
			</div>
			<div class="flex items-center gap-2">
				if everyDay {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ i18n.T(ctx, "planimport.meal.every_day.badge") }
					}
				} else if advanced {
					@mealWeekdayPicker(fmt.Sprintf("d%d.weekday", i), day.Weekday)
				} else if day.Weekday != nil {
					<span class="text-muted-foreground text-sm">{ mealWeekdayName(ctx, *day.Weekday) }</span>
				}
				@button.Button(button.Props{
					Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm,
					Attributes: templ.Attributes{"name": "action", "value": fmt.Sprintf("delete-day:%d", i), "formnovalidate": true},
				}) {
					{ i18n.T(ctx, "planimport.remove_day") }
				}
			</div>
		}
		@card.Content(card.ContentProps{Class: "space-y-5"}) {
			for j, m := range day.Meals {
				<div class="space-y-2">
					<div class="flex flex-wrap items-center gap-2">
						@input.Input(input.Props{Name: fmt.Sprintf("d%d.m%d.name", i, j), Value: m.Name, Placeholder: i18n.Tf(ctx, "planimport.meal.meal_n", j+1), Class: "max-w-xs"})
						@button.Button(button.Props{
							Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm,
							Attributes: templ.Attributes{"name": "action", "value": fmt.Sprintf("delete-meal:%d:%d", i, j), "formnovalidate": true},
						}) {
							{ i18n.T(ctx, "planimport.meal.remove_meal") }
						}
						@button.Button(button.Props{
							Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm,
							Attributes: templ.Attributes{"name": "action", "value": fmt.Sprintf("toggle-meal-optional:%d:%d", i, j), "formnovalidate": true},
						}) {
							if m.Optional {
								{ i18n.T(ctx, "nutrition.meal.count") }
							} else {
								{ i18n.T(ctx, "nutrition.meal.make.optional") }
							}
						}
						if m.Optional {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								{ i18n.T(ctx, "planimport.meal.slot_optional") }
							}
						}
					</div>
					for o, opt := range m.Options() {
						@mealOption(i, j, o, m, opt)
					}
				</div>
			}
		}
	}
}

// mealOption is one option of a meal and its foods. A meal with a single
// option shows no option header, as before options existed.
templ mealOption(i, j, o int, m draft.MealDraftMeal, opt draft.MealDraftOption) {
	<div class={ "space-y-1", templ.KV("border-l-2 border-border pl-3", len(m.Alternatives) > 0) }>
		if len(m.Alternatives) > 0 {
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm font-medium">{ optionName(ctx, m, o) }</span>
				if o == 0 {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ i18n.T(ctx, "planimport.meal.counted") }
					}
				}
				@button.Button(button.Props{
					Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm,
					Attributes: templ.Attributes{"name": "action", "value": fmt.Sprintf("delete-option:%d:%d:%d", i, j, o), "formnovalidate": true, "aria-label": i18n.Tf(ctx, "planimport.remove_named", optionName(ctx, m, o))},
				}) {
					{ i18n.T(ctx, "planimport.meal.remove_option") }
				}
			</div>
		}
		<div class="overflow-x-auto">
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, "planimport.meal.col.file") }
						}
						@table.Head() {
							{ i18n.T(ctx, "planimport.meal.col.ingredient") }
						}
						@table.Head() {
							{ i18n.T(ctx, "planimport.meal.col.grams") }
						}
						@table.Head() {
							{ i18n.T(ctx, "planimport.meal.col.macros") }
						}
						@table.Head() {
							<span class="sr-only">{ i18n.T(ctx, "planimport.remove") }</span>
						}
					}
				}
				@table.Body() {
					for k, f := range opt.Foods {
						@foodRow(i, j, o, k, f)
					}
				}
			}
		</div>
	</div>
}

templ foodRow(i, j, o, k int, f draft.FoodDraft) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "min-w-40 align-top"}) {
			<div class="font-medium">{ f.Food }</div>
			<div class="text-muted-foreground text-xs">
				{ amount(f) }
				if s := stated(ctx, f); s != "" {
					{ " " + i18n.Tf(ctx, "planimport.meal.file_says", s) }
				}
			</div>
			if f.SourceText != "" {
				<div class="text-muted-foreground text-xs italic">“{ f.SourceText }”</div>
			}
			<div class="mt-1 flex flex-wrap gap-1">
				if f.Estimated {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ i18n.T(ctx, "planimport.meal.estimated") }
					}
				}
				if f.Optional {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ i18n.T(ctx, "planimport.meal.optional") }
					}
				}
				for _, flag := range f.Flags {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "whitespace-normal text-left"}) {
						{ flag }
					}
				}
				for _, c := range f.Checks {
					@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "whitespace-normal text-left"}) {
						{ c }
					}
				}
			</div>
		}
		@table.Cell(table.CellProps{Class: "min-w-48 align-top"}) {
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{Name: foodField(i, j, o, k, "ingredient"), HasError: ingredientValue(f) == ""}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "planimport.meal.choose_ingredient")})
				}
				@selectbox.Content() {
					for _, c := range f.Candidates {
						@selectbox.Item(selectbox.ItemProps{Value: c.ID.String(), Selected: f.IngredientID != nil && *f.IngredientID == c.ID}) {
							{ c.Name }
						}
					}
					if f.IngredientID != nil && f.MatchedName != "" && !candidateListed(f) {
						@selectbox.Item(selectbox.ItemProps{Value: f.IngredientID.String(), Selected: true}) {
							{ f.MatchedName }
						}
					}
					if hasStatedMacros(f) {
						@selectbox.Item(selectbox.ItemProps{Value: "mine", Selected: f.SaveAsMine}) {
							{ i18n.T(ctx, "planimport.meal.save_mine") }
						}
					}
				}
			}
		}
		@table.Cell(table.CellProps{Class: "align-top"}) {
			@input.Input(input.Props{Name: foodField(i, j, o, k, "grams"), Type: input.TypeNumber, Value: grams(f.Grams), Class: "w-24", HasError: f.Grams == nil, Attributes: templ.Attributes{"step": "any", "min": "0"}})
		}
		@table.Cell(table.CellProps{Class: "align-top font-mono text-xs"}) {
			{ macroLine(ctx, f.Macros) }
		}
		@table.Cell(table.CellProps{Class: "align-top"}) {
			@button.Button(button.Props{
				Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm,
				Attributes: templ.Attributes{"name": "action", "value": fmt.Sprintf("delete-food:%d:%d:%d:%d", i, j, o, k), "formnovalidate": true, "aria-label": i18n.Tf(ctx, "planimport.remove_named", f.Food)},
			}) {
				{ i18n.T(ctx, "planimport.remove") }
			}
		}
	}
}

func overClass(day draft.MealDayDraft) string {
	if len(day.Over) > 0 {
		return "border-destructive/60"
	}
	return ""
}

func candidateListed(f draft.FoodDraft) bool {
	for _, c := range f.Candidates {
		if f.IngredientID != nil && c.ID == *f.IngredientID {
			return true
		}
	}
	return false
}

templ mealWeekdayPicker(name string, selected *int) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: "w-40", HasError: selected == nil}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "planimport.weekday_ph")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			for _, d := range mealWeekdays {
				@selectbox.Item(selectbox.ItemProps{Value: fmt.Sprint(int(d)), Selected: selected != nil && *selected == int(d)}) {
					{ mealWeekdayName(ctx, int(d)) }
				}
			}
		}
	}
}
