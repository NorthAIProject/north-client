package nutrition

import (
	"fmt"
	"strconv"

	"github.com/NorthAIProject/north-client/internal/meals/meal"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/checkbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/radio"
)

templ PlansIndexPage(user users.User, plans []meal.MealPlan, target *meal.Macros, f PlanForm) {
	@layout.App(i18n.T(ctx, "nav.meal-plans"), user, nav(ctx)) {
		<div class="mx-auto w-full max-w-2xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "nutrition.mono"))
				<div class="mt-2 flex items-center justify-between gap-4">
					<h1 class="text-2xl font-medium tracking-tight">{ i18n.T(ctx, "nav.meal-plans") }</h1>
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: "/app/nutrition/import"}) {
						{ i18n.T(ctx, "nutrition.plans.import") }
					}
				</div>
			</header>
			@targetNotice(target)
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "nutrition.plans.new") }
					}
				}
				@card.Content() {
					@newPlanForm(target, f)
				}
			}
			if len(plans) > 0 {
				<section class="space-y-3">
					<h2 class="text-sm font-medium">{ i18n.T(ctx, "nutrition.plans.yours") }</h2>
					for _, p := range plans {
						@planCard(p)
					}
				</section>
			}
		</div>
		@label.Script()
		@checkbox.Script()
	}
}

// targetNotice shows the macro target every plan is held to, or where to get
// one.
templ targetNotice(target *meal.Macros) {
	if target == nil {
		@alert.Alert() {
			@alert.Title() {
				{ i18n.T(ctx, "nutrition.target.missing.title") }
			}
			@alert.Description() {
				// One paragraph: Description lays its children out as a grid,
				// so a bare link and full stop each landed on their own row.
				<p>
					{ i18n.T(ctx, "nutrition.target.missing.before") }
					<a href="/app/calculator" class="underline">{ i18n.T(ctx, "nutrition.target.missing.link") }</a>.
				</p>
			}
		}
	} else {
		@card.Card(card.Props{Class: "border-hairline"}) {
			@card.Content(card.ContentProps{Class: "py-4"}) {
				@ui.MonoLabel(i18n.T(ctx, "nutrition.target.label"))
				<p class="text-signal mt-1 text-sm font-medium">{ targetLine(ctx, *target) }</p>
			}
		}
	}
}

templ newPlanForm(target *meal.Macros, f PlanForm) {
	<form
		method="post"
		action="/app/nutrition/plans"
		class="space-y-5"
		x-data={ fmt.Sprintf("{ mode: %q, type: %q }", f.mode(), f.planType()) }
	>
		@ui.CSRFInput()
		<fieldset class="space-y-5" disabled?={ target == nil }>
			@form.Item() {
				@label.Label(label.Props{For: "name"}) {
					{ i18n.T(ctx, "nutrition.field.name") }
				}
				@input.Input(input.Props{ID: "name", Name: "name", Value: f.Name, Required: true, HasError: f.fieldError("name") != ""})
				@fieldMessage(f.fieldError("name"))
			}
			@form.Item() {
				@label.Label(label.Props{For: "description"}) {
					{ i18n.T(ctx, "nutrition.field.description") }
				}
				@input.Input(input.Props{ID: "description", Name: "description", Value: f.Description})
			}
			@form.Item() {
				@ui.MonoLabel(i18n.T(ctx, "nutrition.field.mode"))
				@modeChoice("new-mode-easy", meal.Easy, i18n.T(ctx, "nutrition.mode.easy.desc"), f.mode() == meal.Easy)
				@modeChoice("new-mode-advanced", meal.Advanced, i18n.T(ctx, "nutrition.mode.advanced.desc"), f.mode() == meal.Advanced)
			}
			@planTypeFields("new", target, f.planType(), f.CustomCarbPct, f.Errors)
			<div x-show="mode === 'easy'">
				@form.Item() {
					@label.Label(label.Props{For: "day_count"}) {
						{ i18n.T(ctx, "nutrition.field.daycount") }
					}
					@input.Input(input.Props{
						ID: "day_count", Name: "day_count", Type: input.TypeNumber, Value: f.dayCount(),
						Attributes: templ.Attributes{"min": "1", "max": strconv.Itoa(meal.MaxDays)}, HasError: f.fieldError("day_count") != "",
					})
					@fieldMessage(f.fieldError("day_count"))
				}
			</div>
			<div x-show="mode === 'advanced'" x-cloak>
				@form.Item() {
					@ui.MonoLabel(i18n.T(ctx, "nutrition.field.weekdays"))
					<div class="flex flex-wrap gap-4">
						for _, wd := range meal.WeekOrder {
							<div class="flex items-center gap-2">
								@checkbox.Checkbox(checkbox.Props{
									ID: "weekday-" + strconv.Itoa(int(wd)), Name: "weekdays", Value: strconv.Itoa(int(wd)),
									Checked: f.hasWeekday(wd),
								})
								@label.Label(label.Props{For: "weekday-" + strconv.Itoa(int(wd))}) {
									{ weekdayShort(ctx, wd) }
								}
							</div>
						}
					</div>
					@fieldMessage(f.fieldError("weekdays"))
				}
			</div>
			@fieldMessage(f.fieldError("macro_target"))
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
				{ i18n.T(ctx, "nutrition.plans.create") }
			}
		</fieldset>
	</form>
}

templ modeChoice(id string, m meal.Mode, text string, checked bool) {
	<div class="flex items-center gap-2">
		@radio.Radio(radio.Props{ID: id, Name: "mode", Value: string(m), Checked: checked, Attributes: templ.Attributes{"x-model": "mode"}})
		@label.Label(label.Props{For: id}) {
			{ text }
		}
	</div>
}

// planTypeFields offers the preset plan types, and in advanced mode a custom
// share of the carb target. The surrounding x-data holds mode and type.
templ planTypeFields(prefix string, target *meal.Macros, selected meal.PlanType, customPct string, errs map[string]string) {
	@form.Item() {
		@ui.MonoLabel(i18n.T(ctx, "nutrition.macro.carbs"))
		for _, b := range meal.CarbBands {
			<div class="flex items-center gap-2">
				@radio.Radio(radio.Props{
					ID: prefix + "-type-" + string(b.Type), Name: "plan_type", Value: string(b.Type),
					Checked: selected == b.Type, Attributes: templ.Attributes{"x-model": "type"},
				})
				@label.Label(label.Props{For: prefix + "-type-" + string(b.Type)}) {
					{ bandLabel(ctx, b, target) }
				}
			</div>
		}
		<div class="flex items-center gap-2" x-show="mode === 'advanced'" x-cloak>
			@radio.Radio(radio.Props{
				ID: prefix + "-type-custom", Name: "plan_type", Value: string(meal.Custom),
				Checked: selected == meal.Custom, Attributes: templ.Attributes{"x-model": "type"},
			})
			@label.Label(label.Props{For: prefix + "-type-custom"}) {
				{ i18n.T(ctx, "nutrition.type.custom.choice") }
			}
		</div>
		@fieldMessage(errs["plan_type"])
	}
	<div x-show="mode === 'advanced' && type === 'custom'" x-cloak>
		@form.Item() {
			@label.Label(label.Props{For: prefix + "-custom-carb-pct"}) {
				{ i18n.T(ctx, "nutrition.field.custompct") }
			}
			@input.Input(input.Props{
				ID: prefix + "-custom-carb-pct", Name: "custom_carb_pct", Type: input.TypeNumber, Value: customPct,
				Attributes: templ.Attributes{"min": "0", "max": "100", "step": "1"}, HasError: errs["custom_carb_pct"] != "",
			})
			@fieldMessage(errs["custom_carb_pct"])
		}
	</div>
}

templ fieldMessage(msg string) {
	if msg != "" {
		@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
			{ msg }
		}
	}
}

templ planCard(p meal.MealPlan) {
	<a href={ templ.SafeURL("/app/nutrition/plans/" + p.ID.String()) } class="block">
		@card.Card(card.Props{Class: "border-hairline hover:border-muted-foreground/30 transition-colors"}) {
			@card.Content(card.ContentProps{Class: "py-4"}) {
				<div class="flex items-center justify-between gap-4">
					<span class="font-medium">{ p.Name }</span>
					<div class="flex items-center gap-2">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ planTypeLabel(ctx, p.Settings) }
						}
						<span class="text-muted-foreground text-sm">{ daysLabel(ctx, len(p.Days)) }</span>
					</div>
				</div>
			}
		}
	</a>
}
