package lifts

import (
	"encoding/json"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// Imported is what an import did, as the page reports it.
type Imported struct {
	Workouts   int
	Duplicates int
	Sets       int
	Skipped    int
	Unmatched  []string
}

// ImportPage takes a Hevy export. result is nil before an upload.
templ ImportPage(user users.User, result *Imported, errMsg string) {
	@layout.App(i18n.T(ctx, "lifts.import.page"), user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-2xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "lifts.import.label"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "lifts.import.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm">
					{ i18n.T(ctx, "lifts.import.lede") }
				</p>
			</header>
			if errMsg != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ errMsg }
					}
				}
			}
			if result != nil {
				@importResult(*result)
			}
			@card.Card() {
				@card.Content(card.ContentProps{Class: "space-y-4 pt-6"}) {
					@importDrop()
					<ol class="text-muted-foreground list-decimal space-y-1 pl-4 text-xs">
						<li>{ i18n.T(ctx, "lifts.import.step1") }</li>
						<li>{ i18n.T(ctx, "lifts.import.step2") }</li>
						<li>{ i18n.T(ctx, "lifts.import.step3") }</li>
					</ol>
				}
			}
			@button.Button(button.Props{Href: "/app/training", Variant: button.VariantGhost}) {
				{ i18n.T(ctx, "lifts.import.back") }
			}
		</div>
	}
}

templ importResult(r Imported) {
	@alert.Alert() {
		@alert.Title() {
			if r.Workouts == 0 && r.Duplicates > 0 {
				{ i18n.T(ctx, "lifts.result.already") }
			} else {
				{ i18n.Tf(ctx, "lifts.result.imported", r.Workouts, r.Sets) }
			}
		}
		@alert.Description() {
			<ul class="space-y-1" data-testid="import-result">
				if r.Duplicates > 0 {
					<li>{ i18n.Tf(ctx, "lifts.result.duplicates", r.Duplicates) }</li>
				}
				if r.Skipped > 0 {
					<li>{ i18n.Tf(ctx, "lifts.result.skipped", r.Skipped) }</li>
				}
				if len(r.Unmatched) > 0 {
					<li>
						{ i18n.T(ctx, "lifts.result.unmatched") }
						for i, name := range r.Unmatched {
							if i > 0 {
								{ ", " }
							}
							<span class="text-foreground">{ name }</span>
						}
					</li>
				}
			</ul>
		}
	}
}

// jsString quotes s as a JavaScript string literal for an Alpine expression,
// so a translation containing a quote cannot break out of it. Marshalling a
// string cannot fail.
func jsString(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// importDrop is a drop target built as the plan import's is: no templUI
// dropzone exists, and Alpine only tracks drag-over state before submitting
// the same multipart form the file input uses.
templ importDrop() {
	<form
		method="post"
		action="/app/lifts/import"
		enctype="multipart/form-data"
		x-data="{ over: false, busy: false }"
		@dragover.prevent="over = true"
		@dragleave.prevent="over = false"
		@drop.prevent="over = false; busy = true; $refs.file.files = $event.dataTransfer.files; $el.submit()"
	>
		@ui.CSRFInput()
		<label
			for="file"
			:class="over ? 'border-signal bg-signal/8' : 'border-hairline bg-surface'"
			class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-10 text-center transition-colors duration-150"
		>
			@icon.Icon("file-up")(icon.Props{Class: "text-muted-foreground size-5"})
			<span class="text-sm font-medium" x-text={ "busy ? " + jsString(i18n.T(ctx, "lifts.import.busy")) + " : " + jsString(i18n.T(ctx, "lifts.import.drop")) }>{ i18n.T(ctx, "lifts.import.drop") }</span>
			<!-- Hidden native input: templUI Input cannot sit inside a drop
			     target without drawing its own field chrome. -->
			<input
				id="file"
				type="file"
				name="file"
				accept=".csv,text/csv"
				class="sr-only"
				x-ref="file"
				x-bind:disabled="busy"
				onchange="this.form.requestSubmit()"
				@change="busy = true"
			/>
		</label>
	</form>
}
