package knowledge

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/documents/document"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
)

// searchBox is the retrieval North already runs on every reply, made reachable.
//
// The same Service.Search the coach uses, so what a person finds here is what
// the coach would have found — which is the only way to tell whether a missing
// answer was a retrieval problem or a knowledge problem.
templ searchBox() {
	<section class="space-y-3">
		<h2 class="text-sm font-medium">Search what North has read</h2>
		@input.Input(input.Props{
			ID:          "knowledge-search",
			Name:        "q",
			Type:        input.TypeSearch,
			Placeholder: "A word from the passage you are looking for",
			Attributes: templ.Attributes{
				"hx-get":     "/app/knowledge/search",
				"hx-trigger": "input changed delay:300ms, search",
				"hx-target":  "#knowledge-search-results",
				"hx-swap":    "innerHTML",
			},
		})
		<div id="knowledge-search-results"></div>
	</section>
}

// SearchResults is the fragment the search box swaps in.
templ SearchResults(query string, hits []document.Hit) {
	if query == "" {
		<!-- nothing typed yet; an empty region reads better than a prompt -->
	} else if len(hits) == 0 {
		<p class="text-muted-foreground mt-3 text-sm">
			Nothing matched. North can only find what it has read — check the list below for
			anything still waiting.
		</p>
	} else {
		<div class="mt-3 space-y-2">
			for _, h := range hits {
				@resultRow(h)
			}
		</div>
	}
}

// Passages is the fragment behind a reply's sources.
templ Passages(hits []document.Hit) {
	<div class="mt-2 space-y-2">
		if len(hits) == 0 {
			<p class="text-muted-foreground text-xs">
				The documents behind this reply are no longer in your knowledge.
			</p>
		}
		for _, h := range hits {
			@resultRow(h)
		}
	</div>
}

// resultRow is one passage, and the link that resolves it.
//
// Title, heading trail, and line range together: the trail says where in the
// document it sits, the range says exactly which lines, and the link opens them
// highlighted. A hit that could not be opened would be an assertion.
templ resultRow(h document.Hit) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "space-y-2 py-3"}) {
			<a href={ templ.SafeURL(h.URL()) } class="block space-y-2 group">
				<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
					<span class="text-sm font-medium group-hover:underline">{ h.Title }</span>
					if trail := headingTrail(h); trail != "" {
						<span class="text-muted-foreground text-xs">{ "› " + trail }</span>
					}
					<span class="text-muted-foreground/70 font-mono text-[10px] tabular-nums">{ h.Lines() }</span>
				</div>
				<p class="text-muted-foreground text-sm leading-relaxed">
					@snippet(h)
				</p>
			</a>
		}
	}
}

// snippet renders the excerpt with the matched terms emphasised.
//
// Every segment goes through templ's text escaping; nothing here is trusted
// markup. See document.Hit.Segments.
templ snippet(h document.Hit) {
	if segments := h.Segments(); len(segments) > 0 {
		for _, s := range segments {
			if s.Matched {
				<mark class="bg-signal/20 text-foreground rounded-sm px-0.5">{ s.Text }</mark>
			} else {
				{ s.Text }
			}
		}
	} else {
		{ excerpt(h.Content) }
	}
}

// excerpt is the fallback when a hit arrived without a snippet — a vector-only
// match, which never went through ts_headline.
func excerpt(content string) string {
	const max = 240
	if len(content) <= max {
		return content
	}
	return content[:max] + "…"
}

// sourceCount labels a reply's disclosure.
func sourceCount(n int) string {
	if n == 1 {
		return "1 source"
	}
	return fmt.Sprintf("%d sources", n)
}
