package knowledge

import (
	"context"
	"net/url"

	"github.com/NorthAIProject/north-client/internal/documents/document"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
)

// SearchResults is the fragment the library search box swaps in.
templ SearchResults(query string, hits []document.Hit, hasMore bool) {
	if query == "" {
		<!-- nothing typed yet; an empty region reads better than a prompt -->
	} else if len(hits) == 0 {
		<p class="text-muted-foreground mt-3 text-sm">
			{ i18n.T(ctx, "knowledge.results.none_inline") }
		</p>
	} else {
		<div class="border-hairline mt-3 divide-y divide-hairline overflow-hidden rounded-md border">
			for _, h := range hits {
				@resultRow(h)
			}
		</div>
		if hasMore {
			<p class="mt-2">
				<a href={ templ.SafeURL("/app/knowledge/search?q=" + url.QueryEscape(query)) } class="text-sm font-medium hover:underline">
					{ i18n.T(ctx, "knowledge.results.all") }
				</a>
			</p>
		}
	}
}

// Passages is the fragment behind a reply's sources.
templ Passages(hits []document.Hit) {
	<div class="border-hairline mt-2 divide-y divide-hairline overflow-hidden rounded-md border">
		if len(hits) == 0 {
			<p class="text-muted-foreground px-3 py-2 text-xs">
				{ i18n.T(ctx, "knowledge.results.gone") }
			</p>
		}
		for _, h := range hits {
			@resultRow(h)
		}
	</div>
}

// resultRow is one passage, and the link that resolves it.
//
// Title, heading trail, and line range together: the trail says where in the
// document it sits, the range says exactly which lines, and the link opens them
// highlighted. A hit that could not be opened would be an assertion.
templ resultRow(h document.Hit) {
	<a href={ templ.SafeURL(h.URL()) } class="hover:bg-muted/50 block space-y-1.5 px-3 py-2.5 transition-colors duration-150">
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
			<span class="text-sm font-medium">{ h.Title }</span>
			if trail := headingTrail(h); trail != "" {
				<span class="text-muted-foreground text-xs">{ "› " + trail }</span>
			}
			<span class="text-muted-foreground/70 font-mono text-[10px] tabular-nums">{ h.Lines() }</span>
		</div>
		<p class="text-muted-foreground text-sm leading-relaxed">
			@snippet(h)
		</p>
	</a>
}

// snippet renders the excerpt with the matched terms emphasised.
//
// Every segment goes through templ's text escaping; nothing here is trusted
// markup. See document.Hit.Segments.
templ snippet(h document.Hit) {
	if segments := h.Segments(); len(segments) > 0 {
		for _, s := range segments {
			if s.Matched {
				<mark class="bg-signal/20 text-foreground rounded-sm px-0.5">{ s.Text }</mark>
			} else {
				{ s.Text }
			}
		}
	} else {
		{ excerpt(h.Content) }
	}
}

// excerpt is the fallback when a hit arrived without a snippet — a vector-only
// match, which never went through ts_headline.
func excerpt(content string) string {
	const max = 240
	if len(content) <= max {
		return content
	}
	return content[:max] + "…"
}

// sourceCount labels a reply's disclosure.
func sourceCount(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "knowledge.sources.one")
	}
	return i18n.Tf(ctx, "knowledge.sources.many", n)
}
