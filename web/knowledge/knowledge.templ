// Package knowledge renders what the coach can actually see.
//
// The page answers a question North could not answer before: of everything you
// have given it, what has it read, what is it still working on, and what did it
// fail on. A memory system nobody can inspect is one nobody has reason to
// trust.
package knowledge

import (
	"fmt"
	"strings"

	"github.com/NorthAIProject/north-client/internal/documents/document"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/separator"
	"github.com/NorthAIProject/north-client/web/shared/ui/table"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// NoteForm is a note written directly in North.
type NoteForm struct {
	Title  string
	Body   string
	Errors map[string]string
}

func (f NoteForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

// View is everything the page renders.
type View struct {
	Documents []document.Document
	Counts    document.Counts

	// Problems are the documents that need something done to them, worst
	// first. The counts above say how many; this says which, and why.
	Problems []document.Problem

	// EmbeddingGap is how many passages are searchable by word but not yet by
	// meaning. Zero when no embedding provider is configured.
	EmbeddingGap int

	// LastRun is the most recent indexing pass, and HasRun says whether there
	// has ever been one. A zero run and a genuinely empty one look identical
	// otherwise.
	LastRun document.IndexRun
	HasRun  bool

	Instruments Instruments
}

// Instruments holds chart configs for the knowledge index header.
type Instruments struct {
	IndexHealthDonut map[string]any
	HasDonut         bool
}

templ IndexPage(user users.User, view View, form NoteForm) {
	@layout.App("Knowledge", user, layout.BuildNav("/app/knowledge")) {
		<div class="mx-auto w-full max-w-7xl p-6 md:p-8">
			@pageHeader(view)
			if len(view.Problems) > 0 || view.EmbeddingGap > 0 {
				<div class="mt-6">
					@attention(view)
				</div>
			}
			<div class="mt-8 grid items-start gap-8 lg:grid-cols-12">
				<section class="order-2 min-w-0 lg:order-1 lg:col-span-8" x-data="{ filter: 'all' }">
					@libraryToolbar(view)
					<div id="knowledge-search-results" class="mt-4"></div>
					<div class="mt-4">
						@documentLibrary(view)
					</div>
				</section>
				<aside id="add-note" class="order-1 space-y-6 lg:sticky lg:top-6 lg:order-2 lg:col-span-4 lg:self-start">
					@addNote(form)
					@exportSection()
				</aside>
			</div>
		</div>
		@textarea.Script()
		@label.Script()
	}
}

templ pageHeader(view View) {
	<header class="flex flex-col gap-6 border-b border-hairline pb-6 lg:flex-row lg:items-end lg:justify-between">
		<div class="max-w-xl">
			<h1 class="text-2xl font-medium tracking-tight text-balance">Knowledge</h1>
			<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
				Notes and files the coach can quote. It only uses what it has read here,
				and it says where each answer came from.
			</p>
		</div>
		@indexMeter(view)
	</header>
}

// indexMeter is the index as a bar and a line of counts, not a card of KPIs.
templ indexMeter(view View) {
	<div class="w-full max-w-md space-y-2 lg:text-right">
		<div class="flex h-1.5 overflow-hidden rounded-full bg-muted" role="img" aria-label={ meterLabel(view.Counts) }>
			if view.Counts.Ready > 0 {
				<div class="bg-signal h-full" style={ meterWidth(view.Counts.Ready, view.Counts) }></div>
			}
			if view.Counts.Pending > 0 {
				<div class="bg-muted-foreground/40 h-full" style={ meterWidth(view.Counts.Pending, view.Counts) }></div>
			}
			if view.Counts.Failed > 0 {
				<div class="bg-destructive h-full" style={ meterWidth(view.Counts.Failed, view.Counts) }></div>
			}
		</div>
		<div class="text-muted-foreground flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[11px] tabular-nums lg:justify-end">
			<span><span class="text-foreground">{ fmt.Sprint(view.Counts.Ready) }</span> read</span>
			<span><span class="text-foreground">{ fmt.Sprint(view.Counts.Chunks) }</span> passages</span>
			if view.Counts.Pending > 0 {
				<span>{ fmt.Sprint(view.Counts.Pending) } waiting</span>
			}
			if view.Counts.Failed > 0 {
				<span class="text-destructive">{ fmt.Sprint(view.Counts.Failed) } unreadable</span>
			}
		</div>
		<div class="flex flex-wrap items-center gap-3 lg:justify-end">
			if view.HasRun {
				<p class="text-muted-foreground text-xs">{ runSummary(view.LastRun) }</p>
			}
			<form method="post" action="/app/knowledge/reindex">
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantGhost}) {
					Rebuild index
				}
			</form>
		</div>
	</div>
}

templ libraryToolbar(view View) {
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
		<div class="bg-muted inline-flex h-9 w-fit items-center rounded-lg p-[3px]">
			@filterTab("all", "All", len(view.Documents))
			@filterTab("notes", "Notes", countNotes(view.Documents))
			@filterTab("files", "Files", countFiles(view.Documents))
			@filterTab("waiting", "Waiting", countWaiting(view.Documents))
		</div>
		<div class="min-w-0 sm:max-w-xs sm:flex-1">
			<form method="get" action="/app/knowledge/search" class="flex gap-2">
				<div class="min-w-0 flex-1">
					@input.Input(input.Props{
						ID:          "knowledge-search",
						Name:        "q",
						Type:        input.TypeSearch,
						Placeholder: "Search passages…",
						Attributes: templ.Attributes{
							"hx-get":       "/app/knowledge/search",
							"hx-trigger":   "input changed delay:300ms, search",
							"hx-target":    "#knowledge-search-results",
							"hx-swap":      "innerHTML",
							"autocomplete": "off",
							"aria-label":   "Search what North has read",
						},
					})
				</div>
			</form>
		</div>
	</div>
}

templ filterTab(value, label string, n int) {
	<button
		type="button"
		@click={ "filter = '" + value + "'" }
		:class={ "filter === '" + value + "' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'" }
		class="inline-flex h-[calc(100%-1px)] items-center gap-1.5 rounded-md px-2.5 text-sm font-medium transition-colors duration-150"
	>
		{ label }
		<span class="font-mono text-[10px] tabular-nums opacity-70">{ fmt.Sprint(n) }</span>
	</button>
}

// attention names the documents something is wrong with, and offers the fix.
templ attention(view View) {
	@alert.Alert(alert.Props{Class: "border-hairline bg-surface"}) {
		@alert.Title() {
			Needs attention
		}
		@alert.Description() {
			<div class="mt-2 divide-y divide-hairline">
				for _, p := range view.Problems {
					@problemRow(p)
				}
			</div>
			if view.EmbeddingGap > 0 {
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<p class="text-muted-foreground text-xs leading-relaxed">
						{ fmt.Sprintf("%d passage(s) are searchable by word but not yet by meaning.", view.EmbeddingGap) }
					</p>
					<form method="post" action="/app/knowledge/retry-embeddings">
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
							Catch up embeddings
						}
					</form>
				</div>
			}
		}
	}
}

templ problemRow(p document.Problem) {
	<div class="flex flex-wrap items-center justify-between gap-3 py-2 first:pt-0 last:pb-0">
		<div class="min-w-0 space-y-0.5">
			<div class="flex flex-wrap items-center gap-2">
				<a href={ templ.SafeURL("/app/knowledge/" + p.DocumentID.String()) } class="text-sm font-medium hover:underline">
					{ p.Title }
				</a>
				@problemBadge(p.Kind)
			</div>
			<p class={ "text-xs", templ.KV("text-destructive", p.Kind == document.ProblemFailed), templ.KV("text-muted-foreground", p.Kind != document.ProblemFailed) }>
				{ p.Detail }
			</p>
		</div>
		if p.Kind != document.ProblemStuck {
			<form method="post" action={ templ.SafeURL("/app/knowledge/" + p.DocumentID.String() + "/reindex") }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
					Read again
				}
			</form>
		}
	</div>
}

templ problemBadge(kind string) {
	switch kind {
		case document.ProblemFailed:
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				could not read
			}
		case document.ProblemEmpty:
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				nothing in it
			}
		case document.ProblemStale:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				changed since read
			}
		case document.ProblemStuck:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				still waiting
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				read an older way
			}
	}
}

// addNote is the compose rail: drop a file or write a note.
templ addNote(f NoteForm) {
	<div class="space-y-5">
		<div>
			<h2 class="text-sm font-medium">Add to the library</h2>
			<p class="text-muted-foreground mt-1 text-xs leading-relaxed">
				PDF, Markdown, or plain text, up to 8 MB.
			</p>
		</div>
		@uploadDrop(f)
		@separator.Separator()
		<form method="post" action="/app/knowledge/notes" class="space-y-3">
			@ui.CSRFInput()
			@form.Item() {
				@label.Label(label.Props{For: "title", Error: f.fieldError("title")}) {
					Or write a note
				}
				@input.Input(input.Props{
					ID:          "title",
					Name:        "title",
					Value:       f.Title,
					Placeholder: "e.g. Physio notes, March",
					HasError:    f.fieldError("title") != "",
				})
				if f.fieldError("title") != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ f.fieldError("title") }
					}
				}
			}
			@form.Item() {
				@textarea.Textarea(textarea.Props{
					ID:          "body",
					Name:        "body",
					Rows:        5,
					Placeholder: "Markdown headings help North quote the right part.",
					HasError:    f.fieldError("body") != "",
				}) {
					{ f.Body }
				}
				if f.fieldError("body") != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ f.fieldError("body") }
					}
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90 w-full"}) {
				Save note
			}
		</form>
	</div>
}

// uploadDrop is a drop target. No templUI dropzone exists; Alpine only tracks
// drag-over state and submits the same multipart form the file input uses.
templ uploadDrop(f NoteForm) {
	<form
		method="post"
		action="/app/knowledge/uploads"
		enctype="multipart/form-data"
		class="space-y-2"
		x-data="{ over: false }"
		@dragover.prevent="over = true"
		@dragleave.prevent="over = false"
		@drop.prevent="over = false; $refs.file.files = $event.dataTransfer.files; $el.submit()"
	>
		@ui.CSRFInput()
		<label
			for="file"
			:class="over ? 'border-signal bg-signal/8' : 'border-hairline bg-surface'"
			class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border border-dashed px-4 py-8 text-center transition-colors duration-150"
		>
			@icon.Icon("file-up")(icon.Props{Class: "text-muted-foreground size-5"})
			<span class="text-sm font-medium">Drop a file, or browse</span>
			<span class="text-muted-foreground text-xs">PDF · Markdown · text</span>
			<!-- Hidden native input: templUI Input cannot sit inside a drop
			     target without drawing its own field chrome. -->
			<input
				id="file"
				type="file"
				name="file"
				accept=".pdf,.md,.markdown,.txt,.text,.log,.csv,application/pdf"
				class="sr-only"
				x-ref="file"
				onchange="this.form.requestSubmit()"
			/>
		</label>
		if f.fieldError("file") != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ f.fieldError("file") }
			}
		}
	</form>
}

templ documentLibrary(view View) {
	if len(view.Documents) == 0 {
		@ui.Empty(ui.EmptyProps{
			Title: "The coach has nothing to quote yet",
			Body:  "Add a note, or drop a PDF, Markdown, or text file. North only uses what it has read here.",
		}) {
			@button.Button(button.Props{Href: "#add-note", Class: "bg-signal text-background hover:bg-signal/90"}) {
				Write a note
			}
		}
	} else {
		<div class="border-hairline overflow-x-auto rounded-md border">
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head(table.HeadProps{Class: "w-12 pl-3"}) {
							Type
						}
						@table.Head() {
							Name
						}
						@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
							Size
						}
						@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
							Lines
						}
						@table.Head() {
							Status
						}
						@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
							Read
						}
						@table.Head(table.HeadProps{Class: "w-0 pr-3 text-right"}) {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, d := range view.Documents {
						@documentRow(d)
					}
				}
			}
		</div>
	}
}

templ documentRow(d document.Document) {
	@table.Row(table.RowProps{
		Attributes: templ.Attributes{
			"x-show": rowShowExpr(d),
		},
	}) {
		@table.Cell(table.CellProps{Class: "pl-3"}) {
			@typeMark(d)
		}
		@table.Cell() {
			<a href={ templ.SafeURL("/app/knowledge/" + d.ID.String()) } class="font-medium hover:underline">
				{ d.Title }
			</a>
			if d.Status == document.StatusFailed && d.ParseError != "" {
				<p class="text-destructive mt-0.5 text-xs">{ d.ParseError }</p>
			}
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground hidden tabular-nums sm:table-cell"}) {
			if d.SourceKind == document.SourceUpload && d.ByteSize > 0 {
				{ humanSize(d.ByteSize) }
			} else {
				<span class="text-muted-foreground/50">—</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground hidden tabular-nums md:table-cell"}) {
			if d.LineCount > 0 {
				{ fmt.Sprint(d.LineCount) }
			} else {
				<span class="text-muted-foreground/50">—</span>
			}
		}
		@table.Cell() {
			@statusBadge(d)
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground hidden text-xs lg:table-cell"}) {
			{ readWhen(d) }
		}
		@table.Cell(table.CellProps{Class: "pr-3 text-right"}) {
			<form method="post" action={ templ.SafeURL("/app/knowledge/" + d.ID.String() + "/delete") }>
				@ui.CSRFInput()
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantGhost}) {
					Remove
				}
			</form>
		}
	}
}

templ typeMark(d document.Document) {
	<span
		class="bg-muted text-muted-foreground inline-flex size-8 items-center justify-center rounded-md font-mono text-[9px] font-medium tracking-wide"
		title={ fileTypeLabel(d) }
	>
		{ typeCode(d) }
	</span>
}

templ statusBadge(d document.Document) {
	switch d.Status {
		case document.StatusReady:
			if d.IsStale() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					changed since read
				}
			} else {
				@badge.Badge(badge.Props{Class: "border-signal/40 bg-signal/12 text-signal", Variant: badge.VariantOutline}) {
					read
				}
			}
		case document.StatusFailed:
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				could not read
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				waiting
			}
	}
}

templ exportSection() {
	<div class="border-hairline border-t pt-4">
		<p class="text-muted-foreground text-xs leading-relaxed">
			Take everything North knows about you — Markdown and original files.
		</p>
		<div class="mt-2">
			@button.Button(button.Props{
				Href:    "/app/knowledge/export.zip",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
			}) {
				Download export
			}
		</div>
	</div>
}

// documentDetail is the one line under a title on the document page.
func documentDetail(d document.Document) string {
	parts := make([]string, 0, 5)

	if d.SourceKind == document.SourceUpload {
		parts = append(parts, "uploaded file")
		if label := fileTypeLabel(d); label != "" {
			parts = append(parts, label)
		}
		if d.ByteSize > 0 {
			parts = append(parts, humanSize(d.ByteSize))
		}
	} else {
		parts = append(parts, "note")
	}
	if d.LineCount > 0 {
		parts = append(parts, fmt.Sprintf("%d lines", d.LineCount))
	}
	if d.IndexedAt != nil {
		parts = append(parts, "read "+d.IndexedAt.In(d.CreatedAt.Location()).Format("2 Jan 2006"))
	}
	return strings.Join(parts, " · ")
}

func fileTypeLabel(d document.Document) string {
	switch {
	case strings.Contains(strings.ToLower(d.MIME), "pdf"):
		return "PDF"
	case strings.Contains(strings.ToLower(d.MIME), "markdown"):
		return "Markdown"
	case strings.Contains(strings.ToLower(d.MIME), "csv"):
		return "CSV"
	case d.SourceKind == document.SourceUpload:
		return "text"
	default:
		return "note"
	}
}

func typeCode(d document.Document) string {
	switch {
	case strings.Contains(strings.ToLower(d.MIME), "pdf"):
		return "PDF"
	case strings.Contains(strings.ToLower(d.MIME), "markdown"):
		return "MD"
	case strings.Contains(strings.ToLower(d.MIME), "csv"):
		return "CSV"
	case d.SourceKind == document.SourceUpload:
		return "TXT"
	default:
		return "NOTE"
	}
}

func humanSize(n int64) string {
	switch {
	case n < 1024:
		return fmt.Sprintf("%d B", n)
	case n < 1024*1024:
		return fmt.Sprintf("%d KB", (n+512)/1024)
	default:
		return fmt.Sprintf("%.1f MB", float64(n)/(1024*1024))
	}
}

func readWhen(d document.Document) string {
	if d.IndexedAt == nil {
		return "—"
	}
	return d.IndexedAt.In(d.CreatedAt.Location()).Format("2 Jan")
}

func documentSize(d document.Document) string {
	if d.ByteSize <= 0 {
		return "—"
	}
	return humanSize(d.ByteSize)
}

func documentLines(d document.Document) string {
	if d.LineCount <= 0 {
		return "—"
	}
	return fmt.Sprint(d.LineCount)
}

func isWaiting(d document.Document) bool {
	return d.Status == document.StatusPending ||
		d.Status == document.StatusFailed ||
		d.IsStale()
}

func rowShowExpr(d document.Document) string {
	expr := "filter === 'all'"
	if d.SourceKind == document.SourceNote {
		expr += " || filter === 'notes'"
	} else {
		expr += " || filter === 'files'"
	}
	if isWaiting(d) {
		expr += " || filter === 'waiting'"
	}
	return expr
}

func countNotes(docs []document.Document) int {
	n := 0
	for _, d := range docs {
		if d.SourceKind == document.SourceNote {
			n++
		}
	}
	return n
}

func countFiles(docs []document.Document) int {
	n := 0
	for _, d := range docs {
		if d.SourceKind == document.SourceUpload {
			n++
		}
	}
	return n
}

func countWaiting(docs []document.Document) int {
	n := 0
	for _, d := range docs {
		if isWaiting(d) {
			n++
		}
	}
	return n
}

func meterTotal(c document.Counts) int {
	return c.Ready + c.Pending + c.Failed
}

func meterWidth(n int, c document.Counts) string {
	total := meterTotal(c)
	if total == 0 || n == 0 {
		return "width:0"
	}
	return fmt.Sprintf("width:%.1f%%", float64(n)/float64(total)*100)
}

func meterLabel(c document.Counts) string {
	return fmt.Sprintf("%d read, %d waiting, %d unreadable", c.Ready, c.Pending, c.Failed)
}

// runSummary describes the last indexing pass in the terms a person would use.
func runSummary(run document.IndexRun) string {
	if run.CompletedAt == nil {
		return "Indexing is running now."
	}

	when := run.CompletedAt.Format("2 Jan, 15:04")
	switch {
	case run.Failed > 0:
		return fmt.Sprintf("Last checked %s — %d of %d could not be read.", when, run.Failed, run.Seen)
	case run.Seen == 0:
		return fmt.Sprintf("Last checked %s — nothing to read.", when)
	case run.Unchanged == run.Seen:
		return fmt.Sprintf("Last checked %s — everything was already up to date.", when)
	default:
		return fmt.Sprintf("Last checked %s — read %d of %d.", when, run.Added+run.Updated, run.Seen)
	}
}
