package awards

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/awards/award"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/medal"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
)

// PageData is one person's awards as the viewer sees them. Locked is empty
// for anyone but the owner.
type PageData struct {
	User   users.User // the viewer
	Name   string
	Handle string // empty when the owner has none
	Self   bool
	Earned []award.View
	Locked []award.View
}

// Page is /app/awards and /app/u/{handle}/awards.
templ Page(d PageData) {
	@layout.App(i18n.T(ctx, "awards.page.title"), d.User, layout.BuildNav(ctx, "/app/friends")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header class="space-y-1">
				<h1 class="text-2xl font-medium tracking-tight">
					if d.Self {
						{ i18n.T(ctx, "awards.page.title") }
					} else {
						{ i18n.Tf(ctx, "awards.page.title.other", d.Name) }
					}
				</h1>
				if d.Handle != "" {
					@button.Button(button.Props{Href: "/app/u/" + d.Handle, Variant: button.VariantGhost, Size: button.SizeSm}) {
						{ i18n.T(ctx, "awards.page.back") }
					}
				}
			</header>
			if len(d.Earned) == 0 && len(d.Locked) == 0 {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "awards.page.empty.other") }</p>
			}
			if len(d.Earned) > 0 {
				@section(i18n.T(ctx, "awards.page.earned"), d.Earned, false)
			}
			if len(d.Locked) > 0 {
				@section(i18n.T(ctx, "awards.page.locked"), d.Locked, true)
			}
		</div>
	}
}

templ section(title string, views []award.View, locked bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
		}
		@card.Content() {
			<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				for _, v := range views {
					<li class="flex items-center gap-3" data-badge={ v.ID }>
						<span class="shrink-0">
							@medal.Coin(coin(v, 56, locked))
						</span>
						<span class="min-w-0">
							<span class="block text-sm font-medium">{ v.Name }</span>
							<span class="text-muted-foreground block text-xs">{ v.Description }</span>
							if locked {
								<span class="text-muted-foreground block text-xs tabular-nums">{ progressText(v) }</span>
							} else {
								if v.EarnedAt != nil {
									<span class="text-muted-foreground block text-xs">{ i18n.Tf(ctx, "awards.unlock.earned", i18n.Date(ctx, *v.EarnedAt, "2 Jan 2006")) }</span>
								}
								@rarityLine(v, "text-xs")
							}
						</span>
					</li>
				}
			</ul>
		}
	}
}

// Strip is the awards shelf on a profile: the newest coins and a link to the
// full page. It is empty markup when there is nothing to show.
templ Strip(handle string, views []award.View) {
	if len(views) > 0 {
		@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "profile-awards"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "awards.profile.title") }
				}
			}
			@card.Content() {
				<ul class="flex flex-wrap gap-3">
					for _, v := range views {
						<li title={ v.Name }>
							@medal.Coin(coin(v, 44, false))
						</li>
					}
				</ul>
				<div class="mt-3">
					@button.Button(button.Props{Href: "/app/u/" + handle + "/awards", Variant: button.VariantGhost, Size: button.SizeSm}) {
						{ i18n.T(ctx, "awards.profile.all") }
					}
				</div>
			}
		}
	}
}

// SummaryCard is the owner's shelf on the insights summary: how many medals
// of how many, the newest few and a link to the page.
templ SummaryCard(held, total int, recent []award.View) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "insights-awards"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "awards.card.title") }
			}
			@card.Description() {
				{ i18n.Tf(ctx, "awards.card.count", held, total) }
			}
		}
		@card.Content() {
			if len(recent) == 0 {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "awards.card.empty") }</p>
			} else {
				<ul class="flex flex-wrap gap-3">
					for _, v := range recent {
						<li title={ v.Name }>
							@medal.Coin(coin(v, 44, false))
						</li>
					}
				</ul>
			}
			<div class="mt-3">
				@button.Button(button.Props{Href: "/app/awards", Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ i18n.T(ctx, "awards.card.all") }
				}
			</div>
		}
	}
}

func feedView(ctx context.Context, id string) (award.View, bool) {
	b, ok := award.ByID(id)
	if !ok {
		return award.View{}, false
	}
	return b.Project(ctx, nil, nil, ""), true
}

// Feed is the coins on a feed card for a badge moment: one coin and name per
// badge, in order. ids is every badge of the moment.
templ Feed(ids []string) {
	<ul class="mt-1 flex flex-wrap gap-x-4 gap-y-2" data-feed-badges>
		for _, id := range ids {
			if v, ok := feedView(ctx, id); ok {
				<li class="flex items-center gap-2">
					@medal.Coin(coin(v, 32, false))
					<span class="text-sm">{ v.Name }</span>
				</li>
			}
		}
	</ul>
}
