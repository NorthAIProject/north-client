package activity

import (
	"context"
	"fmt"
	"time"

	"github.com/NorthAIProject/north-client/internal/activity/activity"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

templ Page(user users.User, active activity.Session, hasActive bool, recent []activity.Session, todayCalories float64, errMsg string) {
	@layout.App(i18n.T(ctx, "activity.title"), user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-2xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "nav.fitness"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "activity.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					{ i18n.T(ctx, "activity.intro") }
				</p>
				if todayCalories > 0 {
					<p class="text-signal mt-3 text-sm font-medium">
						{ i18n.Tf(ctx, "activity.today.burned", todayCalories) }
					</p>
				}
			</header>
			if errMsg != "" {
				<p class="border-destructive/30 bg-destructive/10 rounded-lg border px-4 py-3 text-sm">{ errMsg }</p>
			}
			if hasActive {
				@activeCard(active)
			} else {
				@startCard()
			}
			@logCard()
			if len(recent) > 0 {
				<section class="space-y-3">
					<h2 class="text-sm font-medium">{ i18n.T(ctx, "activity.recent") }</h2>
					for _, s := range recent {
						@sessionCard(s)
					}
				</section>
			}
		</div>
		@label.Script()
		@selectbox.Script()
	}
}

templ startCard() {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "activity.start.title") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/activity/start" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label() {
						{ i18n.T(ctx, "activity.field.activity") }
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "activity_code", Name: "activity_code"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "activity.choose")})
						}
						@selectbox.Content() {
							for _, m := range activity.METTable {
								@selectbox.Item(selectbox.ItemProps{Value: m.Code}) {
									{ metName(ctx, m) }
								}
							}
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					{ i18n.T(ctx, "activity.start") }
				}
			</form>
		}
	}
}

// logCard records a session that already happened: the run someone did this
// morning without opening the timer. Distance is optional because a yoga
// session has none; start time is optional because "just now" is the common
// case and a blank field means exactly that.
templ logCard() {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "activity.log.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "activity.log.desc") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/activity/log" class="space-y-4">
				@ui.CSRFInput()
				@form.Item() {
					@label.Label() {
						{ i18n.T(ctx, "activity.field.activity") }
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "log_activity_code", Name: "activity_code"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "activity.choose")})
						}
						@selectbox.Content() {
							for _, m := range activity.METTable {
								@selectbox.Item(selectbox.ItemProps{Value: m.Code}) {
									{ metName(ctx, m) }
								}
							}
						}
					}
				}
				<div class="grid gap-4 sm:grid-cols-2">
					@form.Item() {
						@label.Label(label.Props{For: "log_minutes"}) {
							{ i18n.T(ctx, "activity.field.minutes") }
						}
						@input.Input(input.Props{ID: "log_minutes", Name: "minutes", Type: input.TypeNumber, Required: true, Attributes: templ.Attributes{"min": "1", "max": "1440", "step": "1"}})
					}
					@form.Item() {
						@label.Label(label.Props{For: "log_distance_km"}) {
							{ i18n.T(ctx, "activity.field.distance") }
						}
						@input.Input(input.Props{ID: "log_distance_km", Name: "distance_km", Type: input.TypeNumber, Attributes: templ.Attributes{"min": "0", "step": "0.01"}})
					}
				</div>
				@form.Item() {
					@label.Label(label.Props{For: "log_started_at"}) {
						{ i18n.T(ctx, "activity.field.started") }
					}
					@input.Input(input.Props{ID: "log_started_at", Name: "started_at", Type: input.TypeDateTime})
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					{ i18n.T(ctx, "activity.log.submit") }
				}
			</form>
		}
	}
}

templ activeCard(s activity.Session) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ activityName(ctx, s.ActivityCode) }
			}
			@card.Description() {
				if s.Status == activity.StatusPaused {
					{ i18n.T(ctx, "activity.status.paused") }
				} else {
					{ i18n.T(ctx, "activity.status.running") }
				}
			}
		}
		@card.Content() {
			<div class="flex gap-2">
				if s.Status == activity.StatusPaused {
					<form method="post" action={ templ.SafeURL("/app/activity/" + s.ID.String() + "/resume") }>
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "activity.resume") }
						}
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/app/activity/" + s.ID.String() + "/pause") }>
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "activity.pause") }
						}
					</form>
				}
				<form method="post" action={ templ.SafeURL("/app/activity/" + s.ID.String() + "/stop") }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
						{ i18n.T(ctx, "activity.stop") }
					}
				</form>
				<form method="post" action={ templ.SafeURL("/app/activity/" + s.ID.String() + "/cancel") }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost}) {
						{ i18n.T(ctx, "activity.cancel") }
					}
				</form>
			</div>
		}
	}
}

templ sessionCard(s activity.Session) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "py-4"}) {
			<div class="flex items-center justify-between text-sm">
				<span>{ activityName(ctx, s.ActivityCode) }</span>
				<span class="text-muted-foreground">
					{ sessionSummary(ctx, s) }
				</span>
			</div>
		}
	}
}

// sessionSummary is the one line a finished session reads as: when, how
// long, how far and at what pace when known, and the burn.
func sessionSummary(ctx context.Context, s activity.Session) string {
	out := i18n.Date(ctx, s.StartedAt, "2 Jan")
	if s.EndedAt != nil {
		out += " · " + formatMinutes(s.Elapsed(*s.EndedAt))
	}
	if s.DistanceM != nil && *s.DistanceM > 0 {
		out += " · " + i18n.Decimal(ctx, *s.DistanceM/1000, 1) + " km"
		if pace, ok := s.Pace(); ok {
			out += " · " + formatPace(pace) + " /km"
		}
	}
	if s.CaloriesBurned != nil {
		out += fmt.Sprintf(" · ~%.0f kcal", *s.CaloriesBurned)
	}
	return out
}

func formatMinutes(d time.Duration) string {
	return fmt.Sprintf("%d min", int(d.Round(time.Minute)/time.Minute))
}

// formatPace reads as runners say it: "5:32".
func formatPace(d time.Duration) string {
	d = d.Round(time.Second)
	return fmt.Sprintf("%d:%02d", int(d/time.Minute), int(d%time.Minute/time.Second))
}

func activityName(ctx context.Context, code string) string {
	if m, ok := activity.LookupMET(code); ok {
		return metName(ctx, m)
	}
	return code
}

// metName is the activity's name in the reader's language. The MET table keeps
// its English name as the fallback, so an entry added there before the
// catalogue still reads as a word rather than a key.
func metName(ctx context.Context, m activity.MET) string {
	key := "activity.met." + m.Code
	if got := i18n.T(ctx, key); got != key {
		return got
	}
	return m.Name
}
