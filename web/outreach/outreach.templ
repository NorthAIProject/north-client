package outreach

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// CardID is where the coach's message renders and re-renders after an answer.
const CardID = "coach-outreach"

// Card is today's message from the coach as the Today page shows it.
type Card struct {
	Show bool
	ID   string
	Body string
	// Actions are the answers still open; empty once answered.
	Actions []string
	// Outcome is what the answer did, once given.
	Outcome string
}

// Fragment is loaded into Today with hx-get and swapped after an answer. It
// renders an empty anchor when the coach has not spoken today.
templ Fragment(c Card) {
	<div id={ CardID }>
		if c.Show {
			@card.Card(card.Props{Class: "border-signal/40", Attributes: templ.Attributes{"data-testid": "coach-outreach"}}) {
				@card.Content(card.ContentProps{Class: "space-y-3 pt-5"}) {
					<p class="text-signal flex items-center gap-1.5 text-xs font-medium tracking-wide uppercase">
						@icon.Icon("message-circle")(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "outreach.title") }
					</p>
					<p class="text-sm leading-relaxed">{ c.Body }</p>
					if len(c.Actions) > 0 {
						<form
							hx-post={ "/app/outreach/" + c.ID + "/actions" }
							hx-target={ "#" + CardID }
							hx-swap="outerHTML"
							hx-disable="find button"
							method="post"
							action={ templ.SafeURL("/app/outreach/" + c.ID + "/actions") }
							class="flex flex-wrap gap-2"
						>
							@ui.CSRFInput()
							for i, a := range c.Actions {
								@button.Button(button.Props{
									Type: button.TypeSubmit, Size: button.SizeSm, Variant: actionVariant(i),
									Attributes: templ.Attributes{"name": "action", "value": a, "data-testid": "outreach-" + a},
								}) {
									{ i18n.T(ctx, "outreach.action." + a) }
								}
							}
						</form>
					} else if c.Outcome != "" {
						<p class="text-muted-foreground flex items-center gap-1.5 text-xs" data-testid="outreach-outcome">
							@icon.Icon("check")(icon.Props{Class: "size-3.5"})
							{ c.Outcome }
						</p>
					}
				}
			}
		}
	</div>
}

// The first answer is the one the coach suggests; the rest are outlined.
func actionVariant(i int) button.Variant {
	if i == 0 {
		return button.VariantDefault
	}
	return button.VariantOutline
}
