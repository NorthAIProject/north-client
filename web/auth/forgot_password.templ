package auth

import (
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
)

// ForgotPasswordForm is the request-reset step of the forget-password journey.
type ForgotPasswordForm struct {
	Email string

	// Submitted is true after a successful POST. The same success copy is shown
	// whether or not an account exists for the address.
	Submitted bool

	Errors map[string]string
	Error  string
}

func (f ForgotPasswordForm) fieldError(name string) string { return f.Errors[name] }

templ ForgotPasswordPage(f ForgotPasswordForm) {
	@layout.Auth("Reset your password") {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Forgot your password?
				}
				@card.Description() {
					if f.Submitted {
						If an account exists for that address, we sent a reset link.
					} else {
						Enter the email you use with DuxAI and we will send a link to choose a new password.
					}
				}
			}
			@card.Content() {
				if f.Error != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "mb-4"}) {
						@alert.Description() {
							{ f.Error }
						}
					}
				}
				if f.Submitted {
					@alert.Alert(alert.Props{Class: "mb-4"}) {
						@alert.Description() {
							Check your inbox for a message from DuxAI. The link expires in one hour. If nothing arrives, check spam or try again in a few minutes.
						}
					}
					@button.Button(button.Props{Href: "/login", FullWidth: true, Variant: button.VariantOutline}) {
						Back to sign in
					}
				} else {
					<form method="post" action="/forgot-password" class="space-y-4">
						@ui.CSRFInput()
						@field("email", "Email", f.fieldError("email")) {
							@input.Input(input.Props{
								ID:       "email",
								Name:     "email",
								Type:     input.TypeEmail,
								Value:    f.Email,
								Required: true,
								HasError: f.fieldError("email") != "",
								Attributes: templ.Attributes{
									"autocomplete": "email",
									"autofocus":    true,
								},
							})
						}
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true, Class: "bg-signal text-background hover:bg-signal/90"}) {
							Send reset link
						}
					</form>
				}
			}
		}
		if !f.Submitted {
			<p class="text-muted-foreground mt-6 text-center text-sm">
				Remembered it?
				<a href="/login" class="text-foreground font-medium underline underline-offset-4">Sign in</a>
			</p>
		}
		@input.Script()
		@label.Script()
	}
}
