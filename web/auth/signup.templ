package auth

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
)

// SignupForm re-renders a rejected signup with the user's answers intact.
//
// Errors are keyed by field name so each message appears under the input that
// caused it, and every problem is shown at once rather than one per submit.
type SignupForm struct {
	Email       string
	DisplayName string
	Timezone    string

	Errors map[string]string
	Error  string

	Options AuthOptions
}

func (f SignupForm) fieldError(name string) string { return f.Errors[name] }

templ SignupPage(f SignupForm) {
	@layout.Auth(i18n.T(ctx, "auth.signup.title")) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "auth.signup.title") }
				}
				@card.Description() {
					{ i18n.T(ctx, "auth.signup.desc") }
				}
			}
			@card.Content() {
				if f.Error != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "mb-4"}) {
						@alert.Description() {
							{ f.Error }
						}
					}
				}
				if f.Options.GoogleEnabled {
					<div class="mb-4 space-y-3">
						@button.Button(button.Props{
							Type:      button.TypeButton,
							Variant:   button.VariantOutline,
							FullWidth: true,
							Href:      "/auth/google",
						}) {
							@icon.BrandGoogle()
							{ i18n.T(ctx, "auth.alt.google") }
						}
						<div class="relative py-1">
							<div class="absolute inset-0 flex items-center" aria-hidden="true">
								<div class="border-border w-full border-t"></div>
							</div>
							<div class="relative flex justify-center text-xs uppercase">
								<span class="bg-card text-muted-foreground px-2">{ i18n.T(ctx, "auth.alt.or") }</span>
							</div>
						</div>
					</div>
				}
				<form method="post" action="/signup" class="space-y-4" id="signup-form">
					@ui.CSRFInput()
					// The browser reports the visitor's IANA zone, so a daily
					// briefing lands at their 07:00 without asking. The server
					// still defaults to UTC if this is absent or unparseable.
					<input type="hidden" name="timezone" id="timezone" x-data x-init="$el.value = Intl.DateTimeFormat().resolvedOptions().timeZone" value={ f.Timezone }/>
					@field("display_name", i18n.T(ctx, "auth.field.name"), f.fieldError("display_name")) {
						@input.Input(input.Props{
							ID:       "display_name",
							Name:     "display_name",
							Value:    f.DisplayName,
							Required: true,
							HasError: f.fieldError("display_name") != "",
							Attributes: templ.Attributes{
								"autocomplete": "name",
								"autofocus":    true,
							},
						})
					}
					@field("email", i18n.T(ctx, "auth.field.email"), f.fieldError("email")) {
						@input.Input(input.Props{
							ID:       "email",
							Name:     "email",
							Type:     input.TypeEmail,
							Value:    f.Email,
							Required: true,
							HasError: f.fieldError("email") != "",
							Attributes: templ.Attributes{
								"autocomplete": "email",
							},
						})
					}
					if f.Options.PasskeyEnabled {
						@button.Button(button.Props{
							Type:      button.TypeButton,
							Variant:   button.VariantOutline,
							FullWidth: true,
							ID:        "passkey-btn",
							Attributes: templ.Attributes{
								"data-passkey-mode": "register",
							},
						}) {
							{ i18n.T(ctx, "auth.signup.passkey") }
						}
						<div class="relative py-1">
							<div class="absolute inset-0 flex items-center" aria-hidden="true">
								<div class="border-border w-full border-t"></div>
							</div>
							<div class="relative flex justify-center text-xs uppercase">
								<span class="bg-card text-muted-foreground px-2">{ i18n.T(ctx, "auth.signup.orpassword") }</span>
							</div>
						</div>
					}
					@field("password", i18n.T(ctx, "auth.field.password"), f.fieldError("password")) {
						@input.Input(input.Props{
							ID:       "password",
							Name:     "password",
							Type:     input.TypePassword,
							Required: true,
							HasError: f.fieldError("password") != "",
							Attributes: templ.Attributes{
								"autocomplete": "new-password",
							},
						})
						if f.fieldError("password") == "" {
							@form.Description() {
								{ i18n.T(ctx, "auth.password.hint") }
							}
						}
					}
					@field("password_confirmation", i18n.T(ctx, "auth.field.confirm"), f.fieldError("password_confirmation")) {
						@input.Input(input.Props{
							ID:       "password_confirmation",
							Name:     "password_confirmation",
							Type:     input.TypePassword,
							Required: true,
							HasError: f.fieldError("password_confirmation") != "",
							Attributes: templ.Attributes{
								"autocomplete": "new-password",
							},
						})
					}
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true, Class: "bg-signal text-background hover:bg-signal/90"}) {
						{ i18n.T(ctx, "auth.signup.submit") }
					}
					@consent()
				</form>
				<p id="passkey-error" class="text-destructive mt-3 hidden text-sm" role="alert"></p>
			}
		}
		<p class="text-muted-foreground mt-6 text-center text-sm">
			{ i18n.T(ctx, "auth.signup.have") }
			<a href="/login" class="text-foreground font-medium underline underline-offset-4">{ i18n.T(ctx, "auth.signin.submit") }</a>
		</p>
		@input.Script()
		@label.Script()
		if f.Options.PasskeyEnabled {
			<script src="/assets/js/auth/passkey.js" defer></script>
		}
	}
}

// field pairs a label and its control, showing the validation message beneath
// when there is one.
templ field(name, labelText, errMsg string) {
	@form.Item() {
		@label.Label(label.Props{For: name, Error: errMsg}) {
			{ labelText }
		}
		{ children... }
		if errMsg != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ errMsg }
			}
		}
	}
}

// consent is the notice shown under the signup button.
//
// Khepri stores weight, sleep, biometrics and journal text, which are special
// category data under Article 9 — so consent has to be explicit, informed and
// recorded, not buried in a footer link. Whether this notice is sufficient on
// its own or has to become a ticked box is a question for the lawyer who
// reviews the policy; the copy is written so that either shape reads correctly.
templ consent() {
	<p class="text-muted-foreground mt-4 text-center text-xs leading-relaxed">
		{ i18n.T(ctx, "auth.consent.agree") }
		<a href="/terms" class="underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "auth.consent.terms") }</a>
		{ i18n.T(ctx, "auth.consent.and") }
		<a href="/privacy" class="underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "auth.consent.privacy") }</a>
		{ i18n.T(ctx, "auth.consent.health") }
	</p>
}
