package nudgepages

import (
	"context"
	"strconv"

	"github.com/NorthAIProject/north-client/internal/nudges/nudge"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/dropdown"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

const BellID = "nudge-bell"

templ Bell(list []nudge.Nudge, unread int) {
	<div
		id={ BellID }
		data-unread={ strconv.Itoa(unread) }
		data-title={ newestTitle(list) }
		data-href={ newestHref(list) }
	>
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Type:    button.TypeButton,
					Class:   "relative",
					Attributes: templ.Attributes{
						"aria-label": bellLabel(ctx, unread),
					},
				}) {
					@icon.Icon("bell")(icon.Props{Class: "size-4"})
					if unread > 0 {
						<span class="absolute top-1 right-1 size-2 rounded-full bg-signal"></span>
					}
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-80 p-1"}) {
				@dropdown.Label() {
					{ i18n.T(ctx, "nudges.title") }
					if unread > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-2"}) {
							{ unreadLabel(ctx, unread) }
						}
					}
				}
				if len(list) == 0 {
					<p class="text-muted-foreground px-2 py-3 text-sm">{ i18n.T(ctx, "nudges.empty") }</p>
				} else {
					for _, n := range list {
						@nudgeRow(n)
					}
				}
			}
		}
		@dropdown.Script()
	</div>
}

templ nudgeRow(n nudge.Nudge) {
	<div class="flex items-start gap-2 rounded-md px-2 py-2">
		<form
			method="post"
			action={ "/app/nudges/" + n.ID.String() + "/read" }
			class="min-w-0 flex-1"
		>
			@ui.CSRFInput()
			<button type="submit" class={ "w-full text-left text-sm", rowClass(n) }>
				<span class="block font-medium">{ n.Title }</span>
				<span class="text-muted-foreground mt-0.5 block">{ n.Body }</span>
			</button>
		</form>
		<form
			method="post"
			action={ "/app/nudges/" + n.ID.String() + "/dismiss" }
			hx-post={ "/app/nudges/" + n.ID.String() + "/dismiss" }
			hx-target={ "#" + BellID }
			hx-swap="outerHTML"
		>
			@ui.CSRFInput()
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeIcon,
				Type:    button.TypeSubmit,
				Attributes: templ.Attributes{
					"aria-label": i18n.T(ctx, "nudges.dismiss"),
				},
			}) {
				@icon.Icon("x")(icon.Props{Class: "size-3.5"})
			}
		</form>
	</div>
}

templ Card(list []nudge.Nudge) {
	if len(list) > 0 {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "nudges.title") }
				}
			}
			@card.Content() {
				<ul class="space-y-3">
					for _, n := range list {
						<li>
							<a href={ n.Href } class="hover:text-foreground block text-sm font-medium">
								{ n.Title }
							</a>
							<p class="text-muted-foreground mt-0.5 text-sm">{ n.Body }</p>
						</li>
					}
				</ul>
			}
		}
	}
}

func newestTitle(list []nudge.Nudge) string {
	for _, n := range list {
		if n.Unread() {
			return n.Title
		}
	}
	return ""
}

func newestHref(list []nudge.Nudge) string {
	for _, n := range list {
		if n.Unread() {
			if n.Href != "" {
				return n.Href
			}
			return "/app"
		}
	}
	return "/app"
}

func bellLabel(ctx context.Context, unread int) string {
	if unread == 0 {
		return i18n.T(ctx, "nudges.title")
	}
	return i18n.T(ctx, "nudges.bell.unread")
}

// unreadLabel has two forms because "new" agrees in number in Spanish and
// Portuguese ("1 nueva", "3 nuevas").
func unreadLabel(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "nudges.unread.one")
	}
	return i18n.Tf(ctx, "nudges.unread.many", n)
}

func rowClass(n nudge.Nudge) string {
	if n.Unread() {
		return "text-foreground"
	}
	return "text-muted-foreground"
}
