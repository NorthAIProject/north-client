package dailyposts

import (
	"github.com/NorthAIProject/north-client/internal/dailyposts/post"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

templ Page(user users.User, v View) {
	@layout.App(i18n.T(ctx, "daily.title"), user, layout.BuildNav(ctx, "/app/daily")) {
		<div class="mx-auto w-full max-w-2xl space-y-5 p-4 pb-28 md:p-6 md:pb-28">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "daily.mono"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "daily.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm">{ i18n.T(ctx, "daily.desc") }</p>
			</header>
			if v.Today != nil {
				@todayCard(*v.Today)
			} else {
				@ui.Empty(ui.EmptyProps{Title: i18n.T(ctx, "daily.empty"), Body: i18n.T(ctx, "daily.empty.body")})
			}
			if len(v.Earlier) > 0 {
				<section class="space-y-3" aria-labelledby="daily-earlier">
					<h2 id="daily-earlier" class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">
						{ i18n.T(ctx, "daily.earlier") }
					</h2>
					for _, p := range v.Earlier {
						@earlierCard(p)
					}
				</section>
			}
			<p class="text-muted-foreground text-xs">{ i18n.T(ctx, "daily.disclaimer") }</p>
		</div>
	}
}

templ todayCard(p post.Post) {
	@card.Card(card.Props{ID: "post-" + p.ID.String(), Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@meta(p)
			@card.Title(card.TitleProps{Class: "text-xl"}) {
				{ p.Title }
			}
		}
		@card.Content(card.ContentProps{Class: "space-y-3 text-[15px] leading-relaxed"}) {
			for _, para := range paragraphs(p.Body) {
				<p>{ para }</p>
			}
		}
		@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2"}) {
			@kudosButton(p)
			<form method="post" action="/app/chat">
				@ui.CSRFInput()
				<input type="hidden" name="draft" value={ draft(p) }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					@icon.MessageCircle(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "daily.ask") }
				}
			</form>
		}
	}
}

templ earlierCard(p post.Post) {
	@card.Card(card.Props{ID: "post-" + p.ID.String(), Class: "border-hairline bg-surface/60"}) {
		@card.Header() {
			@meta(p)
			@card.Title() {
				{ p.Title }
			}
		}
		@card.Content(card.ContentProps{Class: "space-y-2 text-sm leading-relaxed"}) {
			for _, para := range paragraphs(p.Body) {
				<p class="text-muted-foreground">{ para }</p>
			}
		}
		@card.Footer() {
			@kudosButton(p)
		}
	}
}

templ meta(p post.Post) {
	<div class="flex items-center gap-2">
		<span class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">
			{ i18n.Date(ctx, p.Date, "Mon 2 Jan") }
		</span>
		if p.AIGenerated {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				@icon.Sparkles(icon.Props{Class: "size-3"})
				{ i18n.T(ctx, "daily.ai") }
			}
		}
	</div>
}

templ kudosButton(p post.Post) {
	if p.Kudoed {
		<form method="post" action={ templ.SafeURL("/app/daily/" + p.ID.String() + "/kudos/undo") }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
				{ i18n.Tf(ctx, "social.feed.kudos.count", p.Kudos) }
			}
		</form>
	} else {
		<form method="post" action={ templ.SafeURL("/app/daily/" + p.ID.String() + "/kudos") }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
				if p.Kudos > 0 {
					{ i18n.Tf(ctx, "social.feed.kudos.count", p.Kudos) }
				} else {
					{ i18n.T(ctx, "social.feed.kudos.give") }
				}
			}
		</form>
	}
}
