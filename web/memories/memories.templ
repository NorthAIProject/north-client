package memories

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/memories/memory"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/dialog"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

// PanelID is the HTMX-swappable region for memory writes.
const PanelID = "memories-panel"

// Instruments holds chart configs for the memory index header.
type Instruments struct {
	PendingCount     int
	ApprovedCount    int
	PinnedCount      int
	CategoryDonut    map[string]any
	HasCategoryDonut bool
}

// MemoryForm is a manual fact entry or inline edit.
type MemoryForm struct {
	ID       string
	Category string
	Content  string
	Errors   map[string]string
}

func (f MemoryForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

templ IndexPage(user users.User, pending, approved []memory.Memory, inst Instruments, form MemoryForm, edit *MemoryForm) {
	@Page(user, pending, approved, inst, form, edit)
}

templ Page(user users.User, pending, approved []memory.Memory, inst Instruments, form MemoryForm, edit *MemoryForm) {
	@layout.App("Memory", user, layout.BuildNav("/app/memories")) {
		@Panel(user, pending, approved, inst, form, edit)
		@textarea.Script()
		@label.Script()
		@selectbox.Script()
		@dialog.Script()
		@ui.ChartScripts()
	}
}

templ Panel(user users.User, pending, approved []memory.Memory, inst Instruments, form MemoryForm, edit *MemoryForm) {
	<div id={ PanelID } class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
		@header()
		@kpiStrip(inst)
		@categoryDonut(inst)
		if len(pending) > 0 {
			<section class="space-y-3">
				<h2 class="text-sm font-medium">Proposed from conversations</h2>
				for _, m := range pending {
					@pendingCard(m)
				}
			</section>
		}
		@addForm(form)
		<section class="space-y-6">
			<h2 class="text-sm font-medium">Known facts</h2>
			if len(approved) == 0 {
				<p class="text-muted-foreground text-sm">Nothing stored yet. Approve a proposal or add a fact.</p>
			}
			for _, group := range GroupApprovedByCategory(approved) {
				<div class="space-y-3">
					<h3 class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">{ group.Category }</h3>
					for _, m := range group.Items {
						if edit != nil && edit.ID == m.ID.String() {
							@approvedCardEdit(m, *edit)
						} else {
							@approvedCard(m)
						}
					}
				</div>
			}
		</section>
	</div>
}

templ kpiStrip(inst Instruments) {
	@ui.KpiStrip() {
		@kpiCell("Pending", strconv.Itoa(inst.PendingCount), "", "")
		@kpiCell("Approved", strconv.Itoa(inst.ApprovedCount), "", "")
		@kpiCell("Pinned", pinnedKPI(inst), "", "")
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func pinnedKPI(inst Instruments) string {
	if inst.PinnedCount == 0 {
		return "None"
	}
	return strconv.Itoa(inst.PinnedCount)
}

templ categoryDonut(inst Instruments) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Facts by category
			}
		}
		@card.Content() {
			if inst.HasCategoryDonut && len(inst.CategoryDonut) > 0 {
				@templ.JSONScript("memories-category-donut-option", inst.CategoryDonut)
				@ui.EChartsMount("memories-category-donut", "memories-category-donut-option", "min-h-48 w-full max-w-sm mx-auto")
			} else {
				<p class="text-muted-foreground text-sm">No approved facts yet.</p>
			}
		}
	}
}

func panelSwapAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-target": "#" + PanelID,
		"hx-select": "#" + PanelID,
		"hx-swap":   "outerHTML",
	}
}

templ header() {
	<header>
		@ui.MonoLabel("Long-term")
		<h1 class="mt-2 text-2xl font-medium tracking-tight">Memory</h1>
		<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
			Facts Khepri may use in coaching. Proposed facts from conversations wait here until you approve them.
		</p>
	</header>
}

templ addForm(f MemoryForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Add a fact
			}
		}
		@card.Content() {
			<form method="post" action="/app/memories" class="space-y-4">
				@ui.CSRFInput()
				@categoryField("category", f.Category, f.fieldError("category"))
				@form.Item() {
					@label.Label(label.Props{For: "content", Error: f.fieldError("content")}) {
						Fact
					}
					@textarea.Textarea(textarea.Props{
						ID:          "content",
						Name:        "content",
						Rows:        3,
						Placeholder: "e.g. Prefers morning training before 8am",
						Value:       f.Content,
						HasError:    f.fieldError("content") != "",
					})
					if f.fieldError("content") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("content") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save fact
				}
			</form>
		}
	}
}

templ categoryField(id, selected, errMsg string) {
	@form.Item() {
		@label.Label() {
			Category
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{ID: id, Name: id}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose one"})
			}
			@selectbox.Content() {
				for _, c := range memory.Categories {
					@selectbox.Item(selectbox.ItemProps{Value: c, Selected: selected == c || (selected == "" && c == memory.CategoryGeneral)}) {
						{ c }
					}
				}
			}
		}
		if errMsg != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ errMsg }
			}
		}
	}
}

templ pendingCard(m memory.Memory) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "space-y-3 py-4"}) {
			<div class="flex flex-wrap items-center gap-2">
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					{ m.Category }
				}
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					proposed
				}
				if m.ProposesSupersession() {
					@badge.Badge(badge.Props{Class: "border-signal/40 bg-signal/12 text-signal", Variant: badge.VariantOutline}) {
						replaces a known fact
					}
				}
			</div>
			<p class="text-sm">{ m.Content }</p>
			if m.ProposesSupersession() {
				<p class="text-xs text-muted-foreground">
					Approving this retires an existing fact, so the coach stops being told the older one.
					A pinned fact is never retired this way.
				</p>
			}
			<div class="flex flex-wrap gap-2">
				<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/approve") } { panelSwapAttrs()... }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
						Approve
					}
				</form>
				<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/reject") } { panelSwapAttrs()... }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						Discard
					}
				</form>
			</div>
		}
	}
}

// ConversationPending is the chip list a finished reflection loads.
templ ConversationPending(conversationID uuid.UUID, pending []memory.Memory) {
	if len(pending) > 0 {
		<div class="space-y-3">
			<p class="text-sm font-medium">Save anything from this reflection?</p>
			for _, m := range pending {
				@conversationMemoryChip(conversationID, m)
			}
		</div>
	}
}

templ conversationMemoryChip(conversationID uuid.UUID, m memory.Memory) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "space-y-3 py-4"}) {
			<p class="text-sm">{ m.Content }</p>
			<div class="flex flex-wrap gap-2">
				<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/approve") } { conversationSwapAttrs()... }>
					@ui.CSRFInput()
					<input type="hidden" name="conversation_id" value={ conversationID.String() }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
						Save to memory
					}
				</form>
				<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/reject") } { conversationSwapAttrs()... }>
					@ui.CSRFInput()
					<input type="hidden" name="conversation_id" value={ conversationID.String() }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						Skip
					}
				</form>
			</div>
		}
	}
}

func conversationSwapAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-target": "#reflection-memories",
		"hx-swap":   "innerHTML",
	}
}

templ approvedCard(m memory.Memory) {
	@card.Card(card.Props{Class: "border-hairline"}) {
		@card.Content(card.ContentProps{Class: "space-y-3 py-4"}) {
			<div class="flex flex-wrap items-center gap-2">
				if m.Pinned {
					@badge.Badge(badge.Props{Class: "border-signal/40 bg-signal/12 text-signal", Variant: badge.VariantOutline}) {
						pinned
					}
				}
				if m.Excluded {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						hidden from coach
					}
				}
				if m.IsSuperseded() {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						no longer current
					}
				}
			</div>
			if m.IsSuperseded() {
				<p class="text-xs text-muted-foreground">
					A newer fact replaced this one. It is kept as history and is not shown to the coach.
				</p>
			}
			<p class="text-sm">{ m.Content }</p>
			<div class="flex flex-wrap gap-2" x-data="{ editing: false }">
				<button
					type="button"
					class="inline-flex min-h-9 items-center rounded-md border border-hairline px-3 text-sm font-medium transition-colors hover:bg-muted"
					@click="editing = !editing"
					x-show="!editing"
				>
					Edit
				</button>
				<div x-show="editing" x-cloak class="w-full space-y-3">
					<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String()) } class="space-y-3">
						@ui.CSRFInput()
						@categoryField("category-"+m.ID.String(), m.Category, "")
						@textarea.Textarea(textarea.Props{
							ID:    "content-" + m.ID.String(),
							Name:  "content",
							Rows:  3,
							Value: m.Content,
						})
						<div class="flex flex-wrap gap-2">
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
								Save
							}
							@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"@click": "editing = false"}}) {
								Cancel
							}
						</div>
					</form>
				</div>
				<div x-show="!editing" class="flex flex-wrap gap-2">
					if m.IsSuperseded() {
						<!-- No pin or hide controls on a retired fact. Both would
						     appear to work and change nothing: the context queries
						     filter on validity before they ever look at pinned or
						     excluded. -->
					} else if !m.Excluded {
						if m.Pinned {
							<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/unpin") }>
								@ui.CSRFInput()
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
									Unpin
								}
							</form>
						} else {
							<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/pin") }>
								@ui.CSRFInput()
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
									Pin
								}
							</form>
						}
						<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/exclude") }>
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
								Hide from coach
							}
						</form>
					} else {
						<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/include") }>
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
								Use in coaching
							}
						</form>
					}
					@deleteDialog(m)
				</div>
			</div>
		}
	}
}

templ approvedCardEdit(m memory.Memory, f MemoryForm) {
	@card.Card(card.Props{Class: "border-hairline border-destructive/40"}) {
		@card.Content(card.ContentProps{Class: "space-y-3 py-4"}) {
			<p class="text-sm font-medium">Fix this fact</p>
			<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String()) } class="space-y-3">
				@ui.CSRFInput()
				@categoryField("category-"+m.ID.String(), f.Category, f.fieldError("category"))
				@form.Item() {
					@label.Label(label.Props{For: "content-" + m.ID.String(), Error: f.fieldError("content")}) {
						Fact
					}
					@textarea.Textarea(textarea.Props{
						ID:       "content-" + m.ID.String(),
						Name:     "content",
						Rows:     3,
						Value:    f.Content,
						HasError: f.fieldError("content") != "",
					})
					if f.fieldError("content") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("content") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
					Save
				}
			</form>
		}
	}
}

templ deleteDialog(m memory.Memory) {
	{{ dialogID := "delete-memory-" + m.ID.String() }}
	@dialog.Trigger(dialog.TriggerProps{For: dialogID}) {
		@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost}) {
			Delete
		}
	}
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					Delete this fact?
				}
				@dialog.Description() {
					Khepri will stop remembering it. This cannot be undone from here.
				}
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
						Keep it
					}
				}
				<form method="post" action={ templ.SafeURL("/app/memories/" + m.ID.String() + "/delete") }>
					@ui.CSRFInput()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						Delete
					}
				</form>
			}
		}
	}
}
