// Package exercises renders the catalog: a filterable list, and a detail page
// that shows what a movement trains on the shared 3D model.
package exercises

import (
	"strconv"
	"strings"

	"github.com/NorthAIProject/north-client/internal/exercises/exercise"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/internal/workouts/plan"
	"github.com/NorthAIProject/north-client/web/shared/exerciseart"
	"github.com/NorthAIProject/north-client/web/shared/exerciserow"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/muscleviewer"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/pagination"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

templ Browse(user users.User, found []exercise.Exercise, f Filters, p Page) {
	@layout.App("Exercises", user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-4xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Fitness")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Exercises</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					What each movement trains, shown on the model. The coach picks from this same catalog when it writes you a plan.
				</p>
			</header>
			@filterForm(f)
			<p class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">
				{ summary(len(found), p) }
			</p>
			if len(found) == 0 {
				<div class="border-hairline text-muted-foreground rounded-lg border border-dashed px-4 py-8 text-center text-sm">
					<p>Nothing matched. Try a broader filter.</p>
					<a href="/app/exercises" class="text-signal mt-2 inline-block text-xs hover:underline">Clear filters</a>
				</div>
			} else {
				<ul class="space-y-2">
					for _, e := range found {
						@row(e)
					}
				</ul>
				@pageLinks(f, p)
				if anyIllustrated(found) {
					@exerciseart.Credit()
				}
			}
		</div>
		@selectbox.Script()
	}
}

// A GET form, so every filtered view is a URL that can be bookmarked, shared,
// or reloaded — and so the back button does what it looks like it does.
templ filterForm(f Filters) {
	<form method="get" action="/app/exercises" class="border-hairline bg-surface grid gap-3 rounded-lg border p-4 sm:grid-cols-2 lg:grid-cols-4">
		@input.Input(input.Props{
			Name:        "q",
			Value:       f.Query,
			Placeholder: "Search by name",
			Type:        input.TypeSearch,
		})
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{ID: "muscle", Name: "muscle"}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: "Any muscle"})
			}
			@selectbox.Content() {
				for _, key := range plan.MuscleGroups {
					@selectbox.Item(selectbox.ItemProps{Value: key, Selected: f.Muscle == key}) {
						{ humanize(key) }
					}
				}
			}
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{ID: "category", Name: "category"}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: "Any type"})
			}
			@selectbox.Content() {
				for _, category := range exercise.Categories {
					@selectbox.Item(selectbox.ItemProps{Value: category, Selected: f.Category == category}) {
						{ humanize(category) }
					}
				}
			}
		}
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{ID: "equipment", Name: "equipment"}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: "Any equipment"})
			}
			@selectbox.Content() {
				for _, item := range equipmentOptions {
					@selectbox.Item(selectbox.ItemProps{Value: item, Selected: f.Equipment == item}) {
						{ humanize(item) }
					}
				}
			}
		}
		<div class="flex gap-2 sm:col-span-2 lg:col-span-4">
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "bg-signal text-background hover:bg-signal/90"}) {
				Filter
			}
			@button.Button(button.Props{Href: "/app/exercises", Variant: button.VariantGhost}) {
				Clear
			}
		</div>
	</form>
}

templ row(e exercise.Exercise) {
	<li>
		<a
			href={ templ.SafeURL("/app/exercises/" + e.Slug) }
			class="border-hairline bg-surface hover:border-signal/40 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border px-4 py-3 transition-colors"
		>
			@exerciserow.Thumbnail(e, "art-row-", "w-16")
			<span class="min-w-0 flex-1 text-sm font-medium">{ e.Name }</span>
			for _, key := range e.Primary {
				@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
					{ humanize(key) }
				}
			}
			@exerciserow.Equipment(e)
		</a>
	</li>
}

// Detail is one movement: what it trains, how to do it, and — last, because
// it is the question once the rest is read — what to do with it next.
templ Detail(user users.User, v DetailView) {
	{{ e := v.Exercise }}
	@layout.App(e.Name, user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-4xl space-y-6 p-6 md:p-8">
			@detailHeader(e)
			<div class="grid gap-6 md:grid-cols-2">
				@viewer("exercise-"+e.Slug, e)
				<div class="space-y-4">
					if e.HasIllustration() {
						@exerciseart.Frames(exerciseart.Props{
							ID:    "art-" + e.Slug,
							Slug:  e.IllustrationSlug,
							Name:  e.Name,
							Class: "border-hairline bg-surface rounded-lg border p-4",
						})
					}
					@muscleCard("Primary", e.Primary)
					@muscleCard("Secondary", e.Secondary)
					if e.VideoURL != "" {
						@button.Button(button.Props{Href: e.VideoURL, Variant: button.VariantOutline, Target: "_blank"}) {
							Watch the movement
						}
					}
				</div>
			</div>
			if e.Instructions != "" {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							How to do it
						}
					}
					@card.Content() {
						<p class="text-sm leading-relaxed">{ e.Instructions }</p>
					}
				}
			}
			@nextStep(v)
			if len(v.Similar) > 0 && len(e.Primary) > 0 {
				@similarList(e, v.Similar)
			}
			if e.HasIllustration() {
				@exerciseart.Credit()
			}
		</div>
		@muscleviewer.Script()
	}
}

templ detailHeader(e exercise.Exercise) {
	<header>
		<a href="/app/exercises" class="text-muted-foreground hover:text-foreground font-mono text-[10px] uppercase tracking-[0.14em]">
			&larr; Exercises
		</a>
		<h1 class="mt-2 text-2xl font-medium tracking-tight">{ e.Name }</h1>
		<div class="mt-3 flex flex-wrap items-center gap-2">
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ humanize(e.Category) }
			}
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ humanize(e.Difficulty) }
			}
			if e.NeedsEquipment() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ humanize(e.Equipment) }
				}
			}
		</div>
	</header>
}

// nextStep answers "now what" for one exercise, in the reader's own terms:
// where it already sits in their plan, which day it could go on, or — with no
// plan yet — how to get one. Each add is a plain POST, so it works without
// JavaScript and lands on the plan with the exercise in it.
templ nextStep(v DetailView) {
	<section data-exercise-next class="border-hairline bg-surface rounded-lg border p-4">
		@ui.MonoLabel("What next")
		if !v.HasPlan() {
			<p class="mt-2 text-sm leading-relaxed">
				Build a training plan and the coach will pick movements like this one for you.
			</p>
			<div class="mt-3">
				@button.Button(button.Props{Href: "/app/training", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Build a training plan
				}
			</div>
		} else {
			if days := v.inPlanOn(); len(days) > 0 {
				<p class="mt-2 text-sm leading-relaxed">
					Already in your plan on { strings.Join(days, ", ") }.
				</p>
				<div class="mt-3">
					@button.Button(button.Props{Href: v.planHref(), Class: "bg-signal text-background hover:bg-signal/90"}) {
						Open your plan
					}
				</div>
			} else {
				<p class="mt-2 text-sm leading-relaxed">Not in your plan yet. Add it to a day:</p>
			}
			<ul class="mt-3 flex flex-wrap gap-2">
				for _, day := range v.Days {
					if !day.Includes {
						<li>
							<form method="post" action={ templ.SafeURL(v.addHref(day)) }>
								@ui.CSRFInput()
								<input type="hidden" name="catalog_slug" value={ v.Exercise.Slug }/>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
									+ { dayLabel(day) }
								}
							</form>
						</li>
					}
				}
			</ul>
		}
	</section>
}

// similarList offers other movements for the same main muscle: the next page
// to open when this one is not quite the exercise that was wanted.
templ similarList(e exercise.Exercise, similar []exercise.Exercise) {
	<section class="space-y-2">
		<div class="flex items-baseline justify-between gap-3">
			@ui.MonoLabel("Also trains " + humanize(e.Primary[0]))
			<a
				href={ templ.SafeURL(Filters{Muscle: e.Primary[0]}.pageURL(1)) }
				class="text-signal text-xs hover:underline"
			>
				See all
			</a>
		</div>
		<ul class="space-y-2">
			for _, other := range similar {
				@row(other)
			}
		</ul>
	</section>
}

// viewer is the shared 3D model for one exercise.
templ viewer(id string, e exercise.Exercise) {
	@muscleviewer.Viewer(muscleviewer.Props{
		ID:           id,
		Primary:      e.Primary,
		Secondary:    e.Secondary,
		ExerciseName: e.Name,
	})
}

// MusclePartial is the viewer on its own, for a caller that has a slug and
// wants the picture — today the coach's transcript.
//
// Carries its own Script() because it is swapped into a page that was rendered
// before anyone knew an exercise would appear on it. The OnceHandle makes the
// repeat harmless on a page that already had one.
templ MusclePartial(e exercise.Exercise) {
	<figure class="mt-3 w-full max-w-[85%]">
		if e.HasIllustration() {
			<div class="grid grid-cols-2 gap-2">
				@exerciseart.Frames(exerciseart.Props{
					ID:    "coach-art-" + e.Slug,
					Slug:  e.IllustrationSlug,
					Name:  e.Name,
					Class: "border-hairline bg-surface rounded-lg border p-2",
				})
				@viewer("coach-muscles-"+e.Slug, e)
			</div>
		} else {
			@viewer("coach-muscles-"+e.Slug, e)
		}
		<figcaption class="text-muted-foreground mt-2 text-xs">
			What <a href={ templ.SafeURL("/app/exercises/" + e.Slug) } class="underline underline-offset-2">{ e.Name }</a> trains.
			// The licence wants credit wherever the artwork appears, and a
			// transcript can hold many of these — so it goes in the caption
			// that is already here rather than adding a block per message.
			if e.HasIllustration() {
				@exerciseart.Credit()
			}
		</figcaption>
	</figure>
	@muscleviewer.Script()
}

// pageLinks renders the numbered navigation.
//
// The window of visible numbers comes from pagination.CreatePagination rather
// than being computed here: it already clamps the current page and picks which
// numbers to show around it.
templ pageLinks(f Filters, p Page) {
	if p.Last > 1 {
		{{ window := pagination.CreatePagination(p.Number, p.Last, 5) }}
		@pagination.Pagination(pagination.Props{Class: "pt-2"}) {
			@pagination.Content() {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{
						Href:     f.pageURL(p.Number - 1),
						Disabled: !window.HasPrevious,
						Label:    "Previous",
					})
				}
				// A window that does not reach page 1 gets an explicit link to
				// it: from page 12 of 19 the first page is otherwise
				// unreachable without editing the URL.
				if len(window.Pages) > 0 && window.Pages[0] > 1 {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{Href: f.pageURL(1)}) {
							1
						}
					}
					if window.Pages[0] > 2 {
						@pagination.Item() {
							@pagination.Ellipsis()
						}
					}
				}
				for _, number := range window.Pages {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							Href:     f.pageURL(number),
							IsActive: number == p.Number,
						}) {
							{ strconv.Itoa(number) }
						}
					}
				}
				if len(window.Pages) > 0 && window.Pages[len(window.Pages)-1] < p.Last {
					if window.Pages[len(window.Pages)-1] < p.Last-1 {
						@pagination.Item() {
							@pagination.Ellipsis()
						}
					}
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{Href: f.pageURL(p.Last)}) {
							{ strconv.Itoa(p.Last) }
						}
					}
				}
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{
						Href:     f.pageURL(p.Number + 1),
						Disabled: !window.HasNext,
						Label:    "Next",
					})
				}
			}
		}
	}
}

templ muscleCard(label string, keys []string) {
	if len(keys) > 0 {
		<div>
			@ui.MonoLabel(label)
			<div class="mt-2 flex flex-wrap gap-2">
				for _, key := range keys {
					@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
						{ humanize(key) }
					}
				}
			</div>
		</div>
	}
}
