// Package mascot is the Khepri companion (NOR-51).
//
// It renders the brand scarab PNG. Alpine owns the pose (idle, thinking,
// listening, working, plus the celebrate/nod gestures) and the coach-stream bridge;
// CSS in web/assets/css/input.css is what actually moves it. There is no
// WebGL path: the still is the mascot.
//
//	@mascot.Mascot(mascot.Props{ID: "onboarding", Size: mascot.SizeLg, State: mascot.StateListening})
//
// Reactive state comes from the module-level API, not from props. Anything can
// call window.NorthMascot.setState("thinking"), and the coach stream already
// does (see alpine.js's bridge). Props only say how a mascot starts.
package mascot

import "encoding/json"

// Size is how much room the mascot takes. There are three because there are
// three jobs: a hero on an otherwise empty page, a companion beside a block of
// text, and a small presence in a header.
type Size string

const (
	SizeSm Size = "sm"
	SizeMd Size = "md"
	SizeLg Size = "lg"
)

// State is the pose a mascot starts in. Gestures (celebrate, nod) are not
// valid initial states: they play once and hand back, so starting in one means
// starting in a pose that immediately unwinds.
type State string

const (
	StateIdle      State = "idle"
	StateThinking  State = "thinking"
	StateListening State = "listening"

	// StateWorking is the chat contract's name for a reply in flight
	// (_reviews/muse-chat-contract.md). It wears the idle pose: there is no
	// working art, and the host draws a ring around the avatar instead (see
	// .muse-ring in input.css).
	StateWorking State = "working"
)

// Gestures play once and hand back. They are valid for Props.Gesture, never
// for Props.State.
const (
	StateCelebrate State = "celebrate"
	StateNod       State = "nod"

	// StateCelebrating is the contract's name for the beat after a reply
	// lands. Same gesture; alpine.js maps the name the same way.
	StateCelebrating = StateCelebrate
)

type Props struct {
	// ID namespaces one mascot so NorthMascot.setState(name, {id}) can address
	// it alone. Optional — without it, the mascot follows broadcast state.
	ID string

	Size  Size
	State State

	// Gesture plays once, on this mascot only, as soon as it mounts — the
	// "you finished onboarding" celebrate. It is not broadcast: a greeting is
	// about the page you just landed on, not about every mascot on it.
	Gesture State

	// Class is appended to the wrapper, for page-level spacing only.
	Class string
}

// boxClass maps a Size onto the image box. Square so the three sizes stay
// interchangeable; the scarab is taller than it is wide and letterboxes
// inside with object-contain.
func boxClass(size Size) string {
	switch size {
	case SizeLg:
		return "size-40 sm:size-48"
	case SizeSm:
		return "size-8"
	default:
		return "size-24"
	}
}

func stateOrDefault(s State) State {
	switch s {
	case StateThinking, StateListening, StateWorking:
		return s
	default:
		return StateIdle
	}
}

// gestureOrEmpty drops anything that is not actually a gesture, so a State
// passed here by mistake mounts silently rather than pinning a pose that never
// unwinds.
func gestureOrEmpty(s State) string {
	switch s {
	case StateCelebrate, StateNod:
		return string(s)
	default:
		return ""
	}
}

// alpineData serializes Props into the object literal northMascot() expects.
// templ HTML-escapes the { expr } attribute value automatically.
func alpineData(p Props) string {
	data, _ := json.Marshal(map[string]any{
		"state":   string(stateOrDefault(p.State)),
		"id":      p.ID,
		"gesture": gestureOrEmpty(p.Gesture),
	})
	return "northMascot(" + string(data) + ")"
}

templ Mascot(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		x-data={ alpineData(p) }
		class={ "north-mascot relative shrink-0 " + boxClass(p.Size) + " " + p.Class }
		data-state={ string(stateOrDefault(p.State)) }
		:data-state="state"
	>
		// The mascot is decoration beside real copy on every surface it appears
		// on, so it carries no alt text: a screen reader announcing "Khepri"
		// here would add a second name to a page that already says it.
		<img
			x-ref="img"
			src="/assets/brand/khepri-mascot.png"
			alt=""
			aria-hidden="true"
			class="size-full object-contain"
			@animationend="onAnimationEnd($event)"
		/>
	</div>
}

var scriptOnce = templ.NewOnceHandle()

// Script must be included on any page that renders a Mascot; it registers the
// Alpine component before alpine:init fires and installs the coach-stream
// bridge. Safe to call more than once.
templ Script() {
	@scriptOnce.Once() {
		<script src="/assets/js/shared/mascot/alpine.js"></script>
	}
}
