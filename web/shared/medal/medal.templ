package medal

import (
	"fmt"
	"math"
	"strings"
	"sync/atomic"

	"github.com/NorthAIProject/north-client/docs/medals"
	"github.com/NorthAIProject/north-client/internal/awards/award"
)

// Props describes one coin. Size is in CSS pixels.
type Props struct {
	BadgeID string
	Area    award.Area
	Size    int
	Locked  bool
	Monthly bool
	Label   string
	// Month and Target make a monthly coin carry text instead of a glyph. Month
	// arrives short, upper-case and already localised.
	Month  string
	Target int
}

// MonthlyProps describes the monthly challenge coin.
type MonthlyProps struct {
	Month  string
	Target int
	Size   int
	Locked bool
	Label  string
}

const fontStack = "ui-rounded,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif"

// hasText reports whether the coin shows month and target rather than a glyph.
func hasText(p Props) bool { return p.Monthly && p.Month != "" }

func faceFill(s medals.Set, p Props) string {
	if hasText(p) {
		return s.Monthly.Fill
	}
	return s.Areas[string(p.Area)].Fill
}

// numberSize shrinks three-digit targets so they stay inside the face.
func numberSize(s medals.Set, p Props) float64 {
	size := s.Monthly.Text.NumberSize
	if p.Target >= 100 {
		size *= s.Monthly.Text.NumberWideScale
	}
	return size
}

var set = medals.Load()

// seq makes every rendered coin's gradient id its own. A badge can be on the
// page twice, once in a hidden dialog, and Chrome resolves url(#id) to the
// first match even when that sits in a display:none subtree.
var seq atomic.Uint64

func num(f float64) string { return fmt.Sprint(f) }

func rimColour(s medals.Set, p Props) string {
	if p.Monthly {
		return s.Monthly.Rim
	}
	return s.Areas[string(p.Area)].Rim
}

func coinStyle(s medals.Set, p Props) string {
	if p.Locked {
		return fmt.Sprintf("filter:grayscale(%s);opacity:%s", num(s.Coin.Locked.Grayscale), num(s.Coin.Locked.Opacity))
	}
	return ""
}

// scallop is the outline of a coin with a ring of bumps.
func scallop(s medals.Set) string {
	c := s.Coin
	mid := c.ViewBox / 2
	var b strings.Builder
	for i := 0; i < c.Scallop.Points; i++ {
		a := 2 * math.Pi * float64(i) / float64(c.Scallop.Points)
		r := c.Scallop.BaseRadius + c.Scallop.Depth*math.Cos(float64(c.Scallop.Bumps)*a)
		cmd := "L"
		if i == 0 {
			cmd = "M"
		}
		fmt.Fprintf(&b, "%s%.2f %.2f", cmd, mid+r*math.Cos(a), mid+r*math.Sin(a))
	}
	b.WriteString("Z")
	return b.String()
}

// Coin is a round medal: metallic rim, deep area face, white lucide glyph.
// Monthly medals get a gold scalloped rim; locked ones are greyscale at 40%.
// Geometry and colours come from medals.json.
templ Coin(p Props) {
	@CoinWith(set, p)
}

// MonthlyCoin is the monthly challenge coin: gold scalloped rim, deep face,
// the month above centre and the target number centred.
templ MonthlyCoin(p MonthlyProps) {
	@CoinWith(set, Props{Monthly: true, Month: p.Month, Target: p.Target, Size: p.Size, Locked: p.Locked, Label: p.Label})
}

// CoinWithMonthly renders the monthly coin from an explicit Set.
templ CoinWithMonthly(s medals.Set, p MonthlyProps) {
	@CoinWith(s, Props{Monthly: true, Month: p.Month, Target: p.Target, Size: p.Size, Locked: p.Locked, Label: p.Label})
}

// CoinWith renders from an explicit Set, so a test can prove the output
// follows the json.
templ CoinWith(s medals.Set, p Props) {
	{{ gid := fmt.Sprintf("m%d", seq.Add(1)) }}
	{{ mid := num(s.Coin.ViewBox / 2) }}
	{{ vb := num(s.Coin.ViewBox) }}
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox={ "0 0 " + vb + " " + vb }
		width={ fmt.Sprint(p.Size) }
		height={ fmt.Sprint(p.Size) }
		role="img"
		aria-label={ p.Label }
		if coinStyle(s, p) != "" {
			style={ coinStyle(s, p) }
		}
	>
		<defs>
			<linearGradient id={ gid } x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#ffffff"></stop>
				<stop offset=".35" stop-color={ rimColour(s, p) }></stop>
				<stop offset=".7" stop-color={ faceFill(s, p) }></stop>
				<stop offset="1" stop-color={ rimColour(s, p) }></stop>
			</linearGradient>
		</defs>
		if p.Monthly {
			<path class="scallop" d={ scallop(s) } fill={ "url(#" + gid + ")" }></path>
		} else {
			<circle cx={ mid } cy={ mid } r={ num(s.Coin.RimRadius) } fill={ "url(#" + gid + ")" }></circle>
		}
		<circle cx={ mid } cy={ mid } r={ num(s.Coin.FaceRadius) } fill={ faceFill(s, p) }></circle>
		<circle cx={ mid } cy={ mid } r={ num(s.Coin.FaceRadius) } fill="none" stroke={ s.Coin.FaceEdge.Color } stroke-width={ num(s.Coin.FaceEdge.Width) }></circle>
		if hasText(p) {
			<g
				fill={ s.Monthly.Text.Color }
				font-family={ fontStack }
				font-weight={ fmt.Sprint(s.Monthly.Text.FontWeight) }
				text-anchor="middle"
			>
				<text class="month" x={ mid } y={ num(s.Monthly.Text.MonthY) } font-size={ num(s.Monthly.Text.MonthSize) }>{ p.Month }</text>
				<text class="target" x={ mid } y={ num(s.Monthly.Text.NumberY) } font-size={ num(numberSize(s, p)) }>{ fmt.Sprint(p.Target) }</text>
			</g>
		} else {
		<g
			transform={ fmt.Sprintf("translate(%s %s) scale(%s)", num(s.Coin.Glyph.Translate), num(s.Coin.Glyph.Translate), num(s.Coin.Glyph.Scale)) }
			fill="none"
			stroke="#fff"
			stroke-width={ num(s.Stroke) }
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			for _, d := range s.Glyphs[p.BadgeID] {
				<path d={ d }></path>
			}
		</g>
		}
	</svg>
}
