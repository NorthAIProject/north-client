package icon

// BrandAnthropic is Anthropic's official mark.
//
// Vendored verbatim from the SVG supplied on 2026-08-15 — the path data is
// untouched. Like BrandGoogle, it is NOT part of the templUI/Lucide codegen set
// in icon_defs.go/icon_data.go: do not run it through templui's icon generator,
// and `task fmt`'s `git checkout --` of the generated icon files must never
// touch this one.
//
// currentColor, as the source has it: this mark is monochrome and takes the
// colour of the surface, so it inverts between themes on its own.
//
// This is the company mark. The Claude Code tab uses BrandClaude instead —
// Claude has its own, and the product is what somebody is connecting.
templ BrandAnthropic() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
		<path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm4.132 9.959L8.453 7.687 6.205 13.48H10.7z"></path>
	</svg>
}
