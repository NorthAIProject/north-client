package icon

// BrandApple is Apple's logo, for the iPhone store badge on the landing page.
//
// Vendored verbatim from Apple's official "Download on the App Store" badge
// SVG (the copy Norviq ships under static/images/badges/): the apple and the
// leaf, paths _Path_ and _Path_2, untouched. The viewBox crops the badge's
// coordinate space down to the logo instead of rewriting the path data. Not
// part of the templUI/Lucide codegen set — see BrandGoogle.
//
// currentColor, so the mark takes the badge's text colour in either theme.
templ BrandApple() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="7.8 8.5 20 22" fill="currentColor" aria-hidden="true">
		<path d="M24.76888,20.30068a4.94881,4.94881,0,0,1,2.35656-4.15206,5.06566,5.06566,0,0,0-3.99116-2.15768c-1.67924-.17626-3.30719,1.00483-4.1629,1.00483-.87227,0-2.18977-.98733-3.6085-.95814a5.31529,5.31529,0,0,0-4.47292,2.72787c-1.934,3.34842-.49141,8.26947,1.3612,10.97608.9269,1.32535,2.01018,2.8058,3.42763,2.7533,1.38706-.05753,1.9051-.88448,3.5794-.88448,1.65876,0,2.14479.88448,3.591.8511,1.48838-.02416,2.42613-1.33124,3.32051-2.66914a10.962,10.962,0,0,0,1.51842-3.09251A4.78205,4.78205,0,0,1,24.76888,20.30068Z"></path>
		<path d="M22.03725,12.21089a4.87248,4.87248,0,0,0,1.11452-3.49062,4.95746,4.95746,0,0,0-3.20758,1.65961,4.63634,4.63634,0,0,0-1.14371,3.36139A4.09905,4.09905,0,0,0,22.03725,12.21089Z"></path>
	</svg>
}
