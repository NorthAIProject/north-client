package ui

// BrandMark is the north-star symbol used in marketing, auth, and app chrome so
// the product is recognizable after login — not only on the landing page.
//
// Size is the rendered box; the mark is transparent and works on light and dark
// because its colour is fixed brand gradient rather than inherited.
//
// An <img> rather than an inlined SVG, deliberately. Inlining exists to let a
// mark pick up currentColor, and this one must not: the gradient is the brand.
// Inlining would also repeat the gradient's id at every call site, and ids in
// SVG are document-global — four marks in one page would leave three of them
// referencing the first one's gradient. See north-logo-mark-mono.svg for the
// variant that is meant to be inlined.
templ BrandMark(size string) {
	<img
		src="/assets/brand/north-logo-mark.svg"
		alt=""
		width="32"
		height="32"
		class={ "shrink-0 object-contain", size }
		decoding="async"
	/>
}

// BrandLockup is mark + word for headers. The mark carries identity; the text
// is the readable product name next to it.
templ BrandLockup(href string, markSize string, textClass string) {
	<a href={ templ.SafeURL(href) } class="inline-flex items-center gap-2">
		@BrandMark(markSize)
		<span class={ textClass }>North</span>
	</a>
}
