package ui

// BrandMark is the Khepri scarab used in marketing, auth, and app chrome so
// the product is recognizable after login — not only on the landing page.
//
// Size is the rendered box. The mark is a transparent PNG of the approved
// gold-and-navy scarab; its colour is the artwork, not inherited. On the dark
// background the navy body disappears and only the gold rim is left, so in
// dark mode the mark sits on a small secondary disc.
templ BrandMark(size string) {
	<img
		src="/assets/brand/khepri-logo-mark.png"
		alt=""
		width="32"
		height="32"
		class={ "shrink-0 object-contain dark:rounded-full dark:bg-muted-foreground/60 dark:p-0.5", size }
		decoding="async"
	/>
}

// BrandLockup is mark + word for headers. The mark carries identity; the text
// is the readable product name next to it.
templ BrandLockup(href string, markSize string, textClass string) {
	<a href={ templ.SafeURL(href) } class="inline-flex items-center gap-2">
		@BrandMark(markSize)
		<span class={ textClass }>{ ProductName }</span>
	</a>
}
