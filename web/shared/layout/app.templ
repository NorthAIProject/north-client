package layout

import (
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/dialog"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/sidebar"
)

// NavItem is one entry in the application sidebar.
type NavItem struct {
	Label string
	Href  string

	// Icon is a Lucide name. It is what the rail shows once collapsed, so an
	// item without one becomes unreachable in icon mode.
	Icon string

	// Active marks the section the current page belongs to. Set by BuildNav,
	// which knows the route, rather than inferred here from the URL.
	Active bool

	Children []NavItem
}

// NavGroup is a labelled run of items.
type NavGroup struct {
	Label string
	Items []NavItem
}

// App is the shell for every signed-in page.
//
// The sidebar is the vendored templUI component rather than hand-rolled
// markup. It was a plain <ul> of links for as long as it was a flat list, and
// that was the right call then. Grouping, collapsing to an icon rail, and
// remembering that choice across navigations are three behaviours the
// component already implements correctly, including the keyboard shortcut and
// the focus handling that a hand-rolled version would have skipped.
templ App(title string, user users.User, nav []NavGroup) {
	@Base(title) {
		@sidebar.Layout(sidebar.LayoutProps{Class: "min-h-dvh"}) {
			@sidebar.Sidebar(sidebar.Props{
				ID:          "app-sidebar",
				Collapsible: sidebar.CollapsibleIcon,
			}) {
				@sidebar.Header() {
					@ui.BrandLockup("/app", "size-6", "text-base font-medium tracking-tight")
				}
				@sidebar.Content() {
					for _, group := range nav {
						@navGroup(group)
					}
				}
				@sidebar.Footer() {
					@userFooter(user)
				}
			}
			@sidebar.Inset() {
				<header class="border-border flex min-h-14 shrink-0 items-center gap-2 border-b pt-[env(safe-area-inset-top)] pr-[max(1rem,env(safe-area-inset-right))] pl-[max(1rem,env(safe-area-inset-left))]">
					@sidebar.Trigger(sidebar.TriggerProps{Target: "app-sidebar"}) {
						@icon.Icon("panel-left")(icon.Props{Class: "size-4"})
					}
					<span class="md:hidden">
						@ui.BrandLockup("/app", "size-5", "text-sm font-medium tracking-tight")
					</span>
					<div class="ml-auto flex items-center gap-2">
						@commandPalette()
						<div
							hx-get="/app/nudges/bell"
							hx-trigger="load, every 20s"
							hx-swap="innerHTML"
							hx-on::after-swap="
								const el = this.querySelector('[data-unread]');
								const n = el ? parseInt(el.dataset.unread, 10) || 0 : 0;
								const title = el ? (el.dataset.title || '') : '';
								const next = el ? (el.dataset.href || '/app') : '/app';
								const toast = this.parentElement.querySelector('[data-nudge-toast]');
								if (this._seen > 0 && n > this._seen && title && toast) {
									toast.textContent = title;
									toast.setAttribute('href', next);
									toast.hidden = false;
									clearTimeout(this._hide);
									this._hide = setTimeout(() => { toast.hidden = true }, 5000);
								}
								this._seen = n;
							"
						></div>
						<a
							data-nudge-toast
							hidden
							href="/app"
							class="bg-signal text-background fixed right-4 bottom-4 z-50 max-w-xs rounded-lg px-4 py-3 text-sm shadow-lg"
						></a>
					</div>
				</header>
				<main class="min-h-0 flex-1 overflow-y-auto">
					{ children... }
				</main>
			}
		}
		@sidebar.Script()
		@dialog.Script()
		@PaletteScripts()
	}
}

templ navGroup(group NavGroup) {
	@sidebar.Group() {
		@sidebar.GroupLabel() {
			{ group.Label }
		}
		@sidebar.Menu() {
			for _, item := range group.Items {
				@navItem(item)
			}
		}
	}
}

templ navItem(item NavItem) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Href:     item.Href,
			IsActive: item.Active,
			// Doubles as the label when the rail is collapsed and the text is
			// hidden, which is the only thing left to identify the icon by.
			Tooltip: item.Label,
		}) {
			@icon.Icon(item.Icon)(icon.Props{Class: "size-4"})
			<span>{ item.Label }</span>
		}
		if len(item.Children) > 0 && item.Active {
			@sidebar.MenuSub() {
				for _, child := range item.Children {
					@sidebar.MenuSubItem() {
						@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
							Href:     child.Href,
							IsActive: child.Active,
						}) {
							<span>{ child.Label }</span>
						}
					}
				}
			}
		}
	}
}

templ userFooter(user users.User) {
	<div class="p-1">
		<div class="mb-2 px-2 group-data-[tui-sidebar-state=collapsed]:hidden">
			<p class="truncate text-sm font-medium">{ user.DisplayName }</p>
			<p class="text-muted-foreground truncate text-xs">{ user.Email }</p>
		</div>
		@signOutButton()
	</div>
}

// signOutButton posts rather than links. A GET that ends a session can be
// triggered by any image tag on any page on the internet.
templ signOutButton() {
	<form method="post" action="/logout">
		@ui.CSRFInput()
		@button.Button(button.Props{
			Type:      button.TypeSubmit,
			Variant:   button.VariantGhost,
			Size:      button.SizeSm,
			FullWidth: true,
			Class:     "justify-start",
		}) {
			@icon.Icon("log-out")(icon.Props{Class: "size-4"})
			<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Sign out</span>
		}
	</form>
}
