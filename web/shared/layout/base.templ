package layout

import (
	"github.com/NorthAIProject/north-client/web/shared/analytics"
	"github.com/NorthAIProject/north-client/web/shared/ui"
)

// Base is the outermost HTML document. Every page renders inside it.
//
// It carries no navigation of its own: the signed-out pages and the application
// shell want different chrome, so that choice belongs to the layout above this
// one rather than to the document.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="theme-color" content="#1C1C1F"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content={ ui.ProductName }/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/assets/brand/pwa-180.png"/>
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/assets/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<title>{ pageTitle(title) }</title>
			<meta name="description" content={ ui.Tagline }/>
			// Link previews. A crawler fetches og:image on its own, with no page
			// context to resolve a relative path against, so both URLs are
			// absolute — see ui.SiteURL.
			//
			// og:url is the canonical origin rather than the current path: the
			// pages that actually get shared are the public ones, and everything
			// under /app is behind a session no crawler will ever hold.
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ ui.ProductName }/>
			<meta property="og:title" content={ pageTitle(title) }/>
			<meta property="og:description" content={ ui.Tagline }/>
			<meta property="og:url" content={ ui.SiteURL }/>
			<meta property="og:image" content={ ui.SiteURL + "/assets/brand/og-card.png" }/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content={ ui.ProductName + " — " + ui.Tagline }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ pageTitle(title) }/>
			<meta name="twitter:description" content={ ui.Tagline }/>
			<meta name="twitter:image" content={ ui.SiteURL + "/assets/brand/og-card.png" }/>
			// SVG first, so a browser that understands it gets the sharp one; the
			// PNG stays as the fallback for those that do not. Install icons are
			// the opaque plates in web/assets/brand/pwa-*.png.
			<link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg"/>
			<link rel="icon" type="image/png" href="/assets/brand/khepri-logo-mark.png"/>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			// 422 is how Khepri reports a rejected form: the server answers with the
			// form re-rendered around its error messages, and that has to be swapped
			// like a success or a validated form silently does nothing. 429 is here
			// for the same reason — a rate-limit refusal carries the panel explaining
			// itself, and discarding it would leave the button looking like it did
			// nothing. Everything else in 4xx and 5xx is a plain-text http.Error and
			// does not belong in the page.
			//
			// htmx 4 replaced responseHandling with noSwap, and inverted the default:
			// every response now swaps except 204 and 304. noSwap is a flat list of
			// codes and wildcards matched most-specific-first ("422", then "42x",
			// then "4xx"), so "swap everything in 4xx except 422 and 429" has to be
			// spelled out as the decades either side of them plus the individual
			// codes that share the 42x decade. It is verbose, but it is the same
			// contract the responseHandling array used to state, and a shorter "4xx"
			// entry here would swallow the two codes this app depends on.
			//
			// One htmx 2 capability is simply gone: responseHandling could mark a
			// status "swap, but not an error", and htmx 4 fires htmx:response:error
			// for every response over 400 regardless. Nothing in this app listens
			// for that event, so there is no consumer to lose.
			//
			// Declared as meta rather than a script so it is set before htmx reads
			// its configuration, with no ordering to get wrong.
			<meta
				name="htmx-config"
				content={ `{"noSwap": [204, 304, "40x", "41x", 420, 421, 423, 424, 425, 426, 427, 428, "43x", "44x", "45x", "46x", "47x", "48x", "49x", "5xx"]}` }
			/>
			// Vendored rather than loaded from a CDN: the production binary embeds
			// its assets, so the application keeps working with no third-party
			// origin to trust, block, or outlive us.
			<script src="/assets/js/vendor/htmx.min.js"></script>
			// hx-alpine-compat is permanent, not a migration bridge: htmx 4 can morph
			// rather than replace, and a morph discards Alpine component state.
			<script src="/assets/js/vendor/hx-alpine-compat.min.js"></script>
			// htmx 4's SSE extension, replacing htmx-ext-sse. Loading the script is
			// all it takes now — hx-ext is gone, and the extension registers itself
			// under the name "sse".
			<script src="/assets/js/vendor/hx-sse.min.js"></script>
			<script defer src="/assets/js/vendor/alpine.min.js"></script>
			<script src="/assets/js/shared/pwa.js" defer></script>
			@analyticsSnippet()
		</head>
		<body class="h-full bg-background text-foreground antialiased">
			{ children... }
		</body>
	</html>
}

// analyticsSnippet reports the page to PostHog, when a key is configured.
//
// Two scripts and a JSON island rather than an inline configuration object.
// The island is templ-escaped data, so nothing here can be turned into script
// by a value that reaches it; the decisions it carries are made in
// web/shared/analytics and tested there.
//
// Not deferred, and before the reader: posthog.init has to have run before the
// first captured pageview, and a deferred pair would miss visitors who leave
// quickly — which on a landing page is most of them.
templ analyticsSnippet() {
	if cfg := analytics.Resolve(ctx); cfg.Enabled() {
		@templ.JSONScript("analytics-config", cfg)
		<script src="/assets/js/vendor/posthog.min.js"></script>
		<script src="/assets/js/shared/analytics.js"></script>
	}
}

// pageTitle suffixes the product name so a browser tab is identifiable among a
// dozen others.
func pageTitle(title string) string {
	if title == "" {
		return ui.ProductName
	}
	return title + " · " + ui.ProductName
}
