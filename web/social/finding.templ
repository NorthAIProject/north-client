package social

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/social/friend"
	"github.com/NorthAIProject/north-client/internal/social/phone"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/inputotp"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
)

// Finding is the two ways friends find you beyond a handle: a verified phone
// number and Facebook.
type Finding struct {
	Phone    PhoneSection
	Facebook FacebookSection
}

// PhoneSection is the phone number card. Enabled is false when the
// deployment cannot text codes; a number already verified still shows, so
// it can be removed.
type PhoneSection struct {
	Enabled bool
	Phone   friend.Phone
	// Dial is the calling code preselected for a national number, empty
	// when the account's timezone and language do not say.
	Dial string
}

// FacebookSection is the Facebook card.
type FacebookSection struct {
	Enabled bool
	Friends friend.FacebookFriends
	// Result is how the connection the page was opened from ended:
	// connected, cancelled, expired, taken or failed. Empty otherwise.
	Result string
}

templ phoneCard(s PhoneSection, f FriendsForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "phone-card"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.phone.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.phone.desc") }
			}
		}
		@card.Content() {
			<div class="space-y-4">
				if s.Phone.Number != "" {
					<div class="flex items-center gap-3">
						<p class="flex-1 font-mono text-sm">{ s.Phone.Number }</p>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ i18n.T(ctx, "social.phone.verified") }
						}
						<form method="post" action="/app/friends/phone/remove">
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
								{ i18n.T(ctx, "social.remove") }
							}
						</form>
					</div>
				}
				if s.Enabled {
					if s.Phone.Pending != "" {
						@phoneCodeForm(s.Phone.Pending, f)
					} else {
						@phoneStartForm(s, f)
					}
				}
			</div>
		}
	}
}

templ phoneStartForm(s PhoneSection, f FriendsForm) {
	<form method="post" action="/app/friends/phone" class="flex flex-wrap items-end gap-2">
		@ui.CSRFInput()
		@form.Item() {
			@label.Label(label.Props{For: "countryCode", Error: f.fieldError("countryCode")}) {
				{ i18n.T(ctx, "social.phone.country") }
			}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{ID: "countryCode", Name: "countryCode", HasError: f.fieldError("countryCode") != ""}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "social.phone.choose")})
				}
				@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "social.phone.search")}) {
					for _, c := range phone.Countries {
						@selectbox.Item(selectbox.ItemProps{Value: c.Dial, Selected: c.Dial == countryValue(s, f)}) {
							{ countryName(ctx, c) } (+{ c.Dial })
						}
					}
				}
			}
			if f.fieldError("countryCode") != "" {
				@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
					{ f.fieldError("countryCode") }
				}
			}
		}
		@form.Item(form.ItemProps{Class: "flex-1"}) {
			@label.Label(label.Props{For: "phone", Error: f.fieldError("phone")}) {
				if s.Phone.Number != "" {
					{ i18n.T(ctx, "social.phone.different") }
				} else {
					{ i18n.T(ctx, "social.phone.yours") }
				}
			}
			@input.Input(input.Props{ID: "phone", Name: "phone", Type: input.TypeTel, Value: f.Phone, Placeholder: i18n.T(ctx, "social.phone.placeholder"), HasError: f.fieldError("phone") != ""})
			if f.fieldError("phone") != "" {
				@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
					{ f.fieldError("phone") }
				}
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
			{ i18n.T(ctx, "social.phone.send") }
		}
	</form>
}

// countryValue is what the select shows: what was just submitted, else the
// account's best guess.
func countryValue(s PhoneSection, f FriendsForm) string {
	if f.Country != "" {
		return f.Country
	}
	return s.Dial
}

// countryName is the country in the reader's language. The English name in
// phone.Countries is the fallback for a calling code the catalogue lacks.
func countryName(ctx context.Context, c phone.Country) string {
	key := "social.country." + c.Dial
	if name := i18n.T(ctx, key); name != key {
		return name
	}
	return c.Name
}

templ phoneCodeForm(pending string, f FriendsForm) {
	<form method="post" action="/app/friends/phone/check" class="space-y-3">
		@ui.CSRFInput()
		@form.Item() {
			@label.Label(label.Props{For: "code", Error: f.fieldError("code")}) {
				{ i18n.Tf(ctx, "social.phone.code", pending) }
			}
			@inputotp.InputOTP(inputotp.Props{ID: "code", Name: "code", HasError: f.fieldError("code") != ""}) {
				@inputotp.Group() {
					for i := range 6 {
						@inputotp.Slot(inputotp.SlotProps{Index: i, HasError: f.fieldError("code") != ""})
					}
				}
			}
			if f.fieldError("code") != "" {
				@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
					{ f.fieldError("code") }
				}
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			{ i18n.T(ctx, "social.phone.verify") }
		}
	</form>
	<form method="post" action="/app/friends/phone/cancel" class="mt-2">
		@ui.CSRFInput()
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
			{ i18n.T(ctx, "social.phone.change") }
		}
	</form>
}

templ facebookCard(s FacebookSection) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "facebook"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.fb.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.fb.desc") }
			}
		}
		@card.Content() {
			<div class="space-y-4">
				if notice := facebookNotice(ctx, s.Result); notice != "" {
					@alert.Alert(alert.Props{Variant: facebookNoticeVariant(s.Result)}) {
						@alert.Description() {
							{ notice }
						}
					}
				}
				if s.Friends.Connected {
					@facebookPeople(s.Friends)
				}
				<div class="flex flex-wrap gap-2">
					if s.Enabled {
						@button.Button(button.Props{Href: "/app/friends/facebook/connect", Variant: button.VariantOutline, Size: button.SizeSm}) {
							if s.Friends.Connected {
								{ i18n.T(ctx, "social.fb.find") }
							} else {
								{ i18n.T(ctx, "social.fb.connect") }
							}
						}
					}
					if s.Friends.Connected {
						<form method="post" action="/app/friends/facebook/disconnect">
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
								{ i18n.T(ctx, "social.fb.disconnect") }
							}
						</form>
					}
				</div>
			</div>
		}
	}
}

templ facebookPeople(f friend.FacebookFriends) {
	if f.ImportedAt.IsZero() {
		<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "social.fb.connected") }</p>
	} else if len(f.People) == 0 {
		<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "social.fb.none") }</p>
	} else {
		<ul class="divide-y divide-hairline">
			for _, c := range f.People {
				@personRow(c.Person) {
					if c.Status == "" {
						@followByHandle(c.Handle)
					} else if c.Status == friend.StatusAccepted {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ i18n.T(ctx, "social.fb.following") }
						}
					}
				}
			}
		</ul>
		<p class="text-muted-foreground text-xs">{ peopleFound(ctx, len(f.People)) }</p>
	}
}

// followByHandle asks to follow somebody found by contacts or Facebook. Every
// match has a handle: having one is what made them findable.
templ followByHandle(handle string) {
	<form method="post" action="/app/friends/follow">
		@ui.CSRFInput()
		<input type="hidden" name="follow" value={ handle }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeSm}) {
			{ i18n.T(ctx, "social.follow.ask") }
		}
	</form>
}

func peopleFound(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "social.fb.found.one")
	}
	return i18n.Tf(ctx, "social.fb.found.many", n)
}

func facebookNotice(ctx context.Context, result string) string {
	switch result {
	case "connected", "cancelled", "expired", "taken", "failed":
		return i18n.T(ctx, "social.fb.notice."+result)
	}
	return ""
}

func facebookNoticeVariant(result string) alert.Variant {
	if result == "connected" || result == "cancelled" {
		return alert.VariantDefault
	}
	return alert.VariantDestructive
}
