package social

import (
	"fmt"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/achievements/achievement"
	"github.com/NorthAIProject/north-client/internal/social/friend"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/avatar"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/copybutton"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/inputotp"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	switchcomp "github.com/NorthAIProject/north-client/web/shared/ui/switch"
)

// ShareLinks are ready-made share pages for the invite link.
type ShareLinks struct {
	X        string
	Facebook string
}

// FeedSection is the friends feed and what this person shares. Enabled is
// false when the deployment has no achievements wired.
type FeedSection struct {
	Enabled bool
	Items   []achievement.Item
	Sharing achievement.Sharing
}

func ago(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", max(1, int(d.Minutes())))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	default:
		return t.Format("2 Jan")
	}
}

// FriendsForm carries the text fields back after a rejected submission.
type FriendsForm struct {
	Handle  string
	Follow  string
	Phone   string
	Country string
	Errors  map[string]string
}

func (f FriendsForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

func initials(name string) string {
	fields := strings.Fields(name)
	out := ""
	for _, f := range fields {
		if len(out) == 2 {
			break
		}
		out += strings.ToUpper(string([]rune(f)[0]))
	}
	if out == "" {
		return "?"
	}
	return out
}

func at(handle string) string {
	if handle == "" {
		return "no handle"
	}
	return "@" + handle
}

templ FriendsPage(user users.User, o friend.Overview, inviteURL string, f FriendsForm, feed FeedSection, share ShareLinks, finding Finding) {
	@layout.App("Friends", user, layout.BuildNav(ctx, "/app/friends")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Progress")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Friends</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					People who follow you only see what you choose to share. Nobody follows you without your yes.
				</p>
			</header>
			if feed.Enabled {
				@feedCard(feed.Items)
			}
			@inviteCard(inviteURL, o.Joined, share)
			@handleCard(f)
			if finding.Phone.Enabled || finding.Phone.Phone.Number != "" {
				@phoneCard(finding.Phone, f)
			}
			if finding.Facebook.Enabled || finding.Facebook.Friends.Connected {
				@facebookCard(finding.Facebook)
			}
			if len(o.Requests) > 0 {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							Waiting for your yes
						}
					}
					@card.Content() {
						<ul class="divide-y divide-hairline">
							for _, c := range o.Requests {
								@personRow(c.Person, "") {
									@action(c.ID.String(), "accept", "Accept", button.VariantDefault)
									@action(c.ID.String(), "remove", "Decline", button.VariantGhost)
								}
							}
						</ul>
					}
				}
			}
			if feed.Enabled {
				@sharingCard(feed.Sharing)
			}
			@followCard(f)
			@listCard("Following", "Nobody yet. Follow somebody by their handle, or share your link.", o.Following, true)
			@listCard("Followers", "Nobody follows you yet.", o.Followers, false)
			if len(o.Blocked) > 0 {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							Blocked
						}
					}
					@card.Content() {
						<ul class="divide-y divide-hairline">
							for _, p := range o.Blocked {
								@personRow(p, "") {
									@action(p.ID.String(), "unblock", "Unblock", button.VariantGhost)
								}
							}
						</ul>
					}
				}
			}
		</div>
		@label.Script()
		@copybutton.Script()
		@selectbox.Script()
		@inputotp.Script()
	}
}

templ inviteCard(url string, joined int, share ShareLinks) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Your invite link
			}
			@card.Description() {
				Anyone who joins through it follows you, and you follow them.
			}
		}
		@card.Content() {
			<div class="flex items-center gap-2">
				@input.Input(input.Props{ID: "invite-url", Value: url, Readonly: true, Class: "font-mono text-sm"})
				@copybutton.CopyButton(copybutton.Props{TargetID: "invite-url"})
			</div>
			<div class="mt-3 flex flex-wrap gap-2">
				@button.Button(button.Props{Href: share.X, Target: "_blank", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Share on X
				}
				@button.Button(button.Props{Href: share.Facebook, Target: "_blank", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Share on Facebook
				}
			</div>
			if joined > 0 {
				<p class="text-muted-foreground mt-3 text-sm">
					if joined == 1 {
						1 person joined through your links.
					} else {
						{ joined } people joined through your links.
					}
				</p>
			}
		}
	}
}

templ handleCard(f FriendsForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Your handle
			}
			@card.Description() {
				How friends find you. Without one, only your invite link does.
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/handle" class="flex items-end gap-2">
				@ui.CSRFInput()
				@form.Item(form.ItemProps{Class: "flex-1"}) {
					@label.Label(label.Props{For: "handle", Error: f.fieldError("handle")}) {
						Handle
					}
					@input.Input(input.Props{ID: "handle", Name: "handle", Value: f.Handle, Placeholder: "e.g. ana_runs", HasError: f.fieldError("handle") != ""})
					if f.fieldError("handle") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("handle") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save
				}
			</form>
		}
	}
}

templ followCard(f FriendsForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Follow somebody
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/follow" class="flex items-end gap-2">
				@ui.CSRFInput()
				@form.Item(form.ItemProps{Class: "flex-1"}) {
					@label.Label(label.Props{For: "follow", Error: f.fieldError("follow")}) {
						Their handle
					}
					@input.Input(input.Props{ID: "follow", Name: "follow", Value: f.Follow, Placeholder: "@handle", HasError: f.fieldError("follow") != ""})
					if f.fieldError("follow") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("follow") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					Ask to follow
				}
			</form>
		}
	}
}

templ listCard(title, empty string, list []friend.Connection, following bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
		}
		@card.Content() {
			if len(list) == 0 {
				<p class="text-muted-foreground text-sm">{ empty }</p>
			} else {
				<ul class="divide-y divide-hairline">
					for _, c := range list {
						@personRow(c.Person, c.Status) {
							if following {
								@action(c.ID.String(), "unfollow", unfollowLabel(c.Status), button.VariantGhost)
							} else {
								@action(c.ID.String(), "remove", "Remove", button.VariantGhost)
							}
							@action(c.ID.String(), "block", "Block", button.VariantGhost)
						}
					}
				</ul>
			}
		}
	}
}

func unfollowLabel(status string) string {
	if status == friend.StatusPending {
		return "Withdraw"
	}
	return "Unfollow"
}

templ personRow(p friend.Person, status string) {
	<li class="flex items-center gap-3 py-3">
		@avatar.Avatar() {
			@avatar.Fallback() {
				{ initials(p.DisplayName) }
			}
		}
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">{ p.DisplayName }</p>
			<p class="text-muted-foreground truncate text-xs">{ at(p.Handle) }</p>
		</div>
		if status == friend.StatusPending {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				Waiting
			}
		}
		<div class="flex gap-1">
			{ children... }
		</div>
	</li>
}

// action is one button that posts to /app/friends/<id>/<verb>.
templ action(id, verb, text string, variant button.Variant) {
	<form method="post" action={ templ.SafeURL("/app/friends/" + id + "/" + verb) }>
		@ui.CSRFInput()
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: variant, Size: button.SizeSm}) {
			{ text }
		}
	</form>
}

// InvitePage is /i/<code>, for somebody who is not signed in.
templ InvitePage(p friend.InvitePreview) {
	@layout.Auth(p.Inviter.DisplayName + " invited you") {
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ p.Inviter.DisplayName } invited you to Khepri
				}
				@card.Description() {
					A coach that remembers your goals, your training and how your days go, and helps you keep going. When you join, you follow each other.
				}
			}
			@card.Content() {
				<div class="flex flex-col gap-2">
					@button.Button(button.Props{Href: "/signup", FullWidth: true}) {
						Create your account
					}
					@button.Button(button.Props{Href: "/login", Variant: button.VariantGhost, FullWidth: true}) {
						I already have one
					}
				</div>
			}
		}
	}
}

templ feedCard(items []achievement.Item) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "feed"}) {
		@card.Header() {
			@card.Title() {
				Recent
			}
			@card.Description() {
				Your moments and the ones friends share with you.
			}
		}
		@card.Content() {
			if len(items) == 0 {
				<p class="text-muted-foreground text-sm">Nothing yet. Finish a workout, keep a streak, or complete a goal, and it shows here.</p>
			} else {
				<ul class="divide-y divide-hairline">
					for _, it := range items {
						<li class="flex items-start gap-3 py-3">
							@avatar.Avatar() {
								@avatar.Fallback() {
									{ initials(it.DisplayName) }
								}
							}
							<div class="min-w-0 flex-1">
								<p class="text-sm">
									<span class="font-medium">
										if it.Mine {
											You
										} else {
											{ it.DisplayName }
										}
									</span>
									<span class="text-muted-foreground">· { ago(it.OccurredAt) }</span>
								</p>
								<p class="text-sm">{ it.Title }</p>
								if it.Detail != "" {
									<p class="text-muted-foreground text-xs">{ it.Detail }</p>
								}
							</div>
							if it.Mine {
								if it.Kudos > 0 {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ fmt.Sprint(it.Kudos) } kudos
									}
								}
							} else {
								@kudosButton(it)
							}
						</li>
					}
				</ul>
			}
		}
	}
}

templ kudosButton(it achievement.Item) {
	if it.Kudoed {
		<form method="post" action={ templ.SafeURL("/app/friends/kudos/" + it.ID.String() + "/undo") }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
				Kudos · { fmt.Sprint(it.Kudos) }
			}
		</form>
	} else {
		<form method="post" action={ templ.SafeURL("/app/friends/kudos/" + it.ID.String()) }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
				if it.Kudos > 0 {
					Kudos · { fmt.Sprint(it.Kudos) }
				} else {
					Give kudos
				}
			}
		</form>
	}
}

templ sharingCard(s achievement.Sharing) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				What followers see
			}
			@card.Description() {
				Off until you turn it on. Your journal, decisions, food and health numbers are never shared.
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/sharing" class="space-y-4">
				@ui.CSRFInput()
				@shareSwitch("share_training", "Workouts you finish, and how many this week", s.Training)
				@shareSwitch("share_streaks", "Check-in streaks (7, 30, 100 days…) and your current one", s.Streaks)
				@shareSwitch("share_goals", "Goals and milestones you complete", s.Goals)
				@shareSwitch("share_xp", "Your XP and level, on friends' leaderboards", s.XP)
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					Save
				}
			</form>
		}
	}
}

templ shareSwitch(id, text string, on bool) {
	@form.Item() {
		<div class="flex items-center gap-3">
			@switchcomp.Switch(switchcomp.Props{ID: id, Name: id, Checked: on})
			@label.Label(label.Props{For: id}) {
				{ text }
			}
		</div>
	}
}
