package social

import (
	"context"
	"net/url"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/achievements/achievement"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/social/friend"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/avatar"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/copybutton"
	"github.com/NorthAIProject/north-client/web/shared/ui/form"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/inputotp"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/selectbox"
	switchcomp "github.com/NorthAIProject/north-client/web/shared/ui/switch"
	"github.com/NorthAIProject/north-client/web/shared/workoutcard"
)

// ShareLinks are ready-made share pages for the invite link.
type ShareLinks struct {
	X        string
	Facebook string
}

// FeedSection is the friends feed and what this person shares. Enabled is
// false when the deployment has no achievements wired.
type FeedSection struct {
	Enabled bool
	Items   []achievement.Item
	Sharing achievement.Sharing
}

func ago(ctx context.Context, t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Hour:
		return i18n.Tf(ctx, "social.ago.minutes", max(1, int(d.Minutes())))
	case d < 24*time.Hour:
		return i18n.Tf(ctx, "social.ago.hours", int(d.Hours()))
	case d < 7*24*time.Hour:
		return i18n.Tf(ctx, "social.ago.days", int(d.Hours()/24))
	default:
		return i18n.Date(ctx, t, "2 Jan")
	}
}

// FriendsForm carries the text fields back after a rejected submission.
type FriendsForm struct {
	Handle  string
	Follow  string
	Phone   string
	Country string
	Errors  map[string]string
}

func (f FriendsForm) fieldError(name string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[name]
}

func initials(name string) string {
	fields := strings.Fields(name)
	out := ""
	for _, f := range fields {
		if len(out) == 2 {
			break
		}
		out += strings.ToUpper(string([]rune(f)[0]))
	}
	if out == "" {
		return "?"
	}
	return out
}

func at(ctx context.Context, handle string) string {
	if handle == "" {
		return i18n.T(ctx, "social.nohandle")
	}
	return "@" + handle
}

templ FriendsPage(user users.User, o friend.Overview, inviteURL string, f FriendsForm, feed FeedSection, share ShareLinks, finding Finding) {
	@layout.App(i18n.T(ctx, "social.title"), user, layout.BuildNav(ctx, "/app/friends")) {
		<div class="mx-auto w-full max-w-3xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel(i18n.T(ctx, "social.mono"))
				<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "social.title") }</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					{ i18n.T(ctx, "social.intro") }
				</p>
			</header>
			if feed.Enabled {
				@feedCard(feed.Items)
			}
			@inviteCard(inviteURL, o.Joined, share)
			@handleCard(f, o.Handle)
			if finding.Phone.Enabled || finding.Phone.Phone.Number != "" {
				@phoneCard(finding.Phone, f)
			}
			if finding.Facebook.Enabled || finding.Facebook.Friends.Connected {
				@facebookCard(finding.Facebook)
			}
			if feed.Enabled {
				@sharingCard(feed.Sharing)
			}
			@followCard(f)
			@listCard(i18n.T(ctx, "social.following.title"), i18n.T(ctx, "social.following.empty"), o.Following, true)
			@listCard(i18n.T(ctx, "social.followers.title"), i18n.T(ctx, "social.followers.empty"), o.Followers, false)
			if len(o.Blocked) > 0 {
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "social.blocked.title") }
						}
					}
					@card.Content() {
						<ul class="divide-y divide-hairline">
							for _, p := range o.Blocked {
								@personRow(p) {
									@action(p.ID.String(), "unblock", i18n.T(ctx, "social.unblock"), button.VariantGhost)
								}
							}
						</ul>
					}
				}
			}
		</div>
		@label.Script()
		@copybutton.Script()
		@selectbox.Script()
		@inputotp.Script()
	}
}

templ inviteCard(url string, joined int, share ShareLinks) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.invite.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.invite.desc") }
			}
		}
		@card.Content() {
			<div class="flex items-center gap-2">
				@input.Input(input.Props{ID: "invite-url", Value: url, Readonly: true, Class: "font-mono text-sm"})
				@copybutton.CopyButton(copybutton.Props{TargetID: "invite-url"})
			</div>
			<div class="mt-3 flex flex-wrap gap-2">
				@button.Button(button.Props{Href: share.X, Target: "_blank", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "social.invite.share.x") }
				}
				@button.Button(button.Props{Href: share.Facebook, Target: "_blank", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "social.invite.share.facebook") }
				}
			</div>
			if joined > 0 {
				<p class="text-muted-foreground mt-3 text-sm">
					if joined == 1 {
						{ i18n.T(ctx, "social.invite.joined.one") }
					} else {
						{ i18n.Tf(ctx, "social.invite.joined.many", joined) }
					}
				</p>
			}
		}
	}
}

templ handleCard(f FriendsForm, saved string) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.handle.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.handle.desc") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/handle" class="flex items-end gap-2">
				@ui.CSRFInput()
				@form.Item(form.ItemProps{Class: "flex-1"}) {
					@label.Label(label.Props{For: "handle", Error: f.fieldError("handle")}) {
						{ i18n.T(ctx, "social.handle.label") }
					}
					@input.Input(input.Props{ID: "handle", Name: "handle", Value: f.Handle, Placeholder: i18n.T(ctx, "social.handle.placeholder"), HasError: f.fieldError("handle") != ""})
					if f.fieldError("handle") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("handle") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "social.save") }
				}
			</form>
			if saved != "" {
				<p class="mt-3 text-sm">
					@button.Button(button.Props{Href: "/app/u/" + url.PathEscape(saved), Variant: button.VariantLink, Size: button.SizeSm}) {
						{ i18n.T(ctx, "profile.yours") }
					}
				</p>
			}
		}
	}
}

templ followCard(f FriendsForm) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.follow.title") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/follow" class="flex items-end gap-2">
				@ui.CSRFInput()
				@form.Item(form.ItemProps{Class: "flex-1"}) {
					@label.Label(label.Props{For: "follow", Error: f.fieldError("follow")}) {
						{ i18n.T(ctx, "social.follow.label") }
					}
					@input.Input(input.Props{ID: "follow", Name: "follow", Value: f.Follow, Placeholder: "@handle", HasError: f.fieldError("follow") != ""})
					if f.fieldError("follow") != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ f.fieldError("follow") }
						}
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					{ i18n.T(ctx, "social.follow.ask") }
				}
			</form>
		}
	}
}

templ listCard(title, empty string, list []friend.Connection, following bool) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
		}
		@card.Content() {
			if len(list) == 0 {
				<p class="text-muted-foreground text-sm">{ empty }</p>
			} else {
				<ul class="divide-y divide-hairline">
					for _, c := range list {
						@personRow(c.Person) {
							if following {
								@action(c.ID.String(), "unfollow", i18n.T(ctx, "social.unfollow"), button.VariantGhost)
							} else {
								@action(c.ID.String(), "remove", i18n.T(ctx, "social.remove"), button.VariantGhost)
							}
							@action(c.ID.String(), "block", i18n.T(ctx, "social.block"), button.VariantGhost)
						}
					}
				</ul>
			}
		}
	}
}

func kudosCount(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "social.feed.kudos.one")
	}
	return i18n.Tf(ctx, "social.feed.kudos", n)
}

templ personRow(p friend.Person) {
	<li class="flex items-center gap-3 py-3">
		@avatar.Avatar() {
			@avatar.Fallback() {
				{ initials(p.DisplayName) }
			}
		}
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">
				@nameLink(p.DisplayName, p.Handle)
			</p>
			<p class="text-muted-foreground truncate text-xs">{ at(ctx, p.Handle) }</p>
		</div>
		<div class="flex gap-1">
			{ children... }
		</div>
	</li>
}

// nameLink links a name to the person's profile when they have a handle.
templ nameLink(name, handle string) {
	if handle != "" {
		// A hand-rolled inline anchor: templUI's button is block chrome, and
		// this is a name inside a line of text.
		<a href={ templ.SafeURL("/app/u/" + url.PathEscape(handle)) } class="hover:underline">{ name }</a>
	} else {
		{ name }
	}
}

// action is one button that posts to /app/friends/<id>/<verb>.
templ action(id, verb, text string, variant button.Variant) {
	<form method="post" action={ templ.SafeURL("/app/friends/" + id + "/" + verb) }>
		@ui.CSRFInput()
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: variant, Size: button.SizeSm}) {
			{ text }
		}
	</form>
}

// InvitePage is /i/<code>, for somebody who is not signed in.
templ InvitePage(p friend.InvitePreview) {
	@layout.Auth(i18n.Tf(ctx, "social.invitepage.title", p.Inviter.DisplayName)) {
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.Tf(ctx, "social.invitepage.heading", p.Inviter.DisplayName) }
				}
				@card.Description() {
					{ i18n.T(ctx, "social.invitepage.desc") }
				}
			}
			@card.Content() {
				<div class="flex flex-col gap-2">
					@button.Button(button.Props{Href: "/signup", FullWidth: true}) {
						{ i18n.T(ctx, "social.invitepage.signup") }
					}
					@button.Button(button.Props{Href: "/login", Variant: button.VariantGhost, FullWidth: true}) {
						{ i18n.T(ctx, "social.invitepage.login") }
					}
				</div>
			}
		}
	}
}

// workoutHref is the author's page for the workout; empty when they have no
// handle to build it from.
func workoutHref(it achievement.Item) string {
	if it.Handle == "" || it.Workout == nil {
		return ""
	}
	return "/app/u/" + it.Handle + "/workouts/" + it.Workout.ID.String()
}

templ feedCard(items []achievement.Item) {
	@card.Card(card.Props{Class: "border-hairline bg-surface", ID: "feed"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.feed.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.feed.desc") }
			}
		}
		@card.Content() {
			if len(items) == 0 {
				<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "social.feed.empty") }</p>
			} else {
				<ul class="divide-y divide-hairline">
					for _, it := range items {
						<li class="flex items-start gap-3 py-3">
							@avatar.Avatar() {
								@avatar.Fallback() {
									{ initials(it.DisplayName) }
								}
							}
							<div class="min-w-0 flex-1">
								<p class="text-sm">
									<span class="font-medium">
										if it.Mine {
											{ i18n.T(ctx, "social.feed.you") }
										} else {
											@nameLink(it.DisplayName, it.Handle)
										}
									</span>
									<span class="text-muted-foreground">· { ago(ctx, it.OccurredAt) }</span>
								</p>
								<p class="text-sm">{ it.Title }</p>
								if it.Workout != nil {
									@workoutcard.Card(*it.Workout, workoutHref(it))
								} else if it.Detail != "" {
									<p class="text-muted-foreground text-xs">{ it.Detail }</p>
								}
							</div>
							if it.Mine {
								if it.Kudos > 0 {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ kudosCount(ctx, it.Kudos) }
									}
								}
							} else {
								@kudosButton(it)
							}
						</li>
					}
				</ul>
			}
		}
	}
}

templ kudosButton(it achievement.Item) {
	if it.Kudoed {
		<form method="post" action={ templ.SafeURL("/app/friends/kudos/" + it.ID.String() + "/undo") }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
				{ i18n.Tf(ctx, "social.feed.kudos.count", it.Kudos) }
			}
		</form>
	} else {
		<form method="post" action={ templ.SafeURL("/app/friends/kudos/" + it.ID.String()) }>
			@ui.CSRFInput()
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
				if it.Kudos > 0 {
					{ i18n.Tf(ctx, "social.feed.kudos.count", it.Kudos) }
				} else {
					{ i18n.T(ctx, "social.feed.kudos.give") }
				}
			}
		</form>
	}
}

templ sharingCard(s achievement.Sharing) {
	@card.Card(card.Props{ID: "sharing", Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "social.sharing.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "social.sharing.desc") }
			}
		}
		@card.Content() {
			<form method="post" action="/app/friends/sharing" class="space-y-4">
				@ui.CSRFInput()
				@shareSwitch("share_training", i18n.T(ctx, "social.sharing.training"), s.Training)
				@shareSwitch("share_streaks", i18n.T(ctx, "social.sharing.streaks"), s.Streaks)
				@shareSwitch("share_goals", i18n.T(ctx, "social.sharing.goals"), s.Goals)
				@shareSwitch("share_xp", i18n.T(ctx, "social.sharing.xp"), s.XP)
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					{ i18n.T(ctx, "social.save") }
				}
			</form>
		}
	}
}

templ shareSwitch(id, text string, on bool) {
	@form.Item() {
		<div class="flex items-center gap-3">
			@switchcomp.Switch(switchcomp.Props{ID: id, Name: id, Checked: on})
			@label.Label(label.Props{For: id}) {
				{ text }
			}
		</div>
	}
}
