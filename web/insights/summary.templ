package insights

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
)

// ComponentRow is one weighted part of a score, shown the way a watch shows
// it: earned over available, not a percentage of a percentage.
type ComponentRow struct {
	Label  string
	Earned int
	Weight int

	// Known false renders a dash. A component nobody measured is not a zero,
	// and drawing it as one would be a claim about the person rather than
	// about the data.
	Known bool
}

// ScoreCard is one domain's ring, verdict and breakdown.
type ScoreCard struct {
	Key     string
	Label   string
	Icon    string
	Href    string
	Points  int
	Verdict string
	Reason  string

	Components []ComponentRow
	Coverage   int
	HasData    bool

	// Option is the ECharts gauge, decoded for templ.JSONScript. Nil when
	// there is nothing to draw.
	Option map[string]any
}

// PinnedCard is one headline number with its sparkline, mirroring the stack of
// cards on the Apple Health summary.
type PinnedCard struct {
	Label string
	Icon  string
	Value string
	Note  string
	Href  string
	Delta DeltaView

	// Chart is the card's sparkline. HasChart is false for a card whose
	// window holds nothing to draw — an axis with no series reads as a bug.
	Chart    chart.Props
	HasChart bool
}

// DayCell is one metric's mark for one day.
type DayCell struct {
	Label string
	Value string

	// Filled is whether anything was logged. The table shows a mark, not a
	// number, for the same reason a watch shows a ring: the question is
	// whether the day happened, and the number is on its own page.
	Filled bool
}

// DayRow is one day of the window.
type DayRow struct {
	Label string
	Cells []DayCell
}

// SummaryView is the whole page.
type SummaryView struct {
	Range      RangeView
	Scores     []ScoreCard
	Pinned     []PinnedCard
	Highlights []string

	// OnTrack counts the domains scoring OK or better, over the domains that
	// had enough data to judge. Shown instead of blending the four into one
	// number: a single figure nobody can decompose is a figure nobody can act
	// on, which is why Apple does not compute one either.
	OnTrack int
	Judged  int

	// Days is one row per day, the way the activity view lists a week.
	// HasDays is false for a window too long to list — ninety rows is a wall,
	// not a table.
	Days    []DayRow
	HasDays bool

	// Empty marks an account with nothing logged anywhere, which gets a
	// sentence rather than four empty rings.
	Empty bool
}

templ Summary(user users.User, view SummaryView) {
	@page("Summary", "summary", "/app/insights/panels", user, view.Range) {
		@SummaryPanels(view)
	}
}

templ SummaryPanels(view SummaryView) {
	if view.Empty {
		@emptyState(
			"Nothing logged in this window yet. Check in, log a night's sleep, or start a session and this page fills in.",
			"Go to today", "/app",
		)
	} else {
		<div class="space-y-6">
			@scoreGrid(view)
			if len(view.Highlights) > 0 {
				@highlights(view.Highlights)
			}
			if len(view.Pinned) > 0 {
				@pinnedGrid(view.Pinned)
			}
			if view.HasDays {
				@dayTable(view.Days)
			}
		</div>
	}
}

templ scoreGrid(view SummaryView) {
	<section class="space-y-3">
		<div class="flex items-baseline justify-between">
			@ui.MonoLabel("Scores")
			if view.Judged > 0 {
				<p class="text-muted-foreground text-xs tabular-nums">
					{ fmt.Sprintf("%d of %d on track", view.OnTrack, view.Judged) }
				</p>
			}
		</div>
		<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
			for _, s := range view.Scores {
				@scoreRing(s)
			}
		</div>
	</section>
}

// scoreRing is hand-rolled rather than built from the card component: the
// breakdown rows, the ring mount and the verdict have to share one link target
// and one border, and wrapping card around that only adds a box.
templ scoreRing(s ScoreCard) {
	<a
		href={ templ.SafeURL(s.Href) }
		class="border-hairline bg-surface/60 hover:bg-accent/40 block space-y-3 rounded-lg border p-4 transition-colors"
	>
		<div class="flex items-center gap-1.5">
			@icon.Icon(s.Icon)(icon.Props{Class: "size-3.5 text-muted-foreground"})
			@ui.MonoLabel(s.Label)
		</div>
		if s.HasData {
			@templ.JSONScript("insights-score-"+s.Key+"-option", s.Option)
			@ui.EChartsMount("insights-score-"+s.Key, "insights-score-"+s.Key+"-option", "min-h-32 w-full")
			<p class="text-sm font-medium">{ s.Verdict }</p>
			<dl class="space-y-1">
				for _, c := range s.Components {
					@componentRow(c)
				}
			</dl>
			if s.Reason != "" {
				<p class="text-muted-foreground text-xs leading-relaxed">{ s.Reason }</p>
			}
		} else {
			<div class="flex min-h-32 items-center justify-center">
				<p class="text-muted-foreground text-2xl font-medium tabular-nums">&mdash;</p>
			</div>
			<p class="text-muted-foreground text-xs leading-relaxed">
				Not enough logged in this window to score.
			</p>
		}
	</a>
}

templ componentRow(c ComponentRow) {
	<div class="flex items-baseline justify-between gap-2 text-xs">
		<dt class="text-muted-foreground truncate">{ c.Label }</dt>
		if c.Known {
			<dd class="tabular-nums">{ fmt.Sprintf("%d/%d", c.Earned, c.Weight) }</dd>
		} else {
			<dd class="text-muted-foreground tabular-nums">&mdash;</dd>
		}
	</div>
}

templ highlights(lines []string) {
	<section class="space-y-3">
		@ui.MonoLabel("Highlights")
		<ul class="border-hairline bg-surface/60 divide-hairline divide-y rounded-lg border">
			for _, line := range lines {
				<li class="flex items-start gap-2.5 p-4">
					@icon.Icon("sparkles")(icon.Props{Class: "text-signal mt-0.5 size-3.5 shrink-0"})
					<p class="text-sm leading-relaxed">{ line }</p>
				</li>
			}
		</ul>
	</section>
}

templ pinnedGrid(cards []PinnedCard) {
	<section class="space-y-3">
		@ui.MonoLabel("Pinned")
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			for _, c := range cards {
				@pinnedCard(c)
			}
		</div>
	</section>
}

templ pinnedCard(c PinnedCard) {
	<a
		href={ templ.SafeURL(c.Href) }
		class="border-hairline bg-surface/60 hover:bg-accent/40 block space-y-1 rounded-lg border p-4 transition-colors"
	>
		<div class="flex items-center gap-1.5">
			@icon.Icon(c.Icon)(icon.Props{Class: "size-3.5 text-muted-foreground"})
			@ui.MonoLabel(c.Label)
		</div>
		<div class="flex items-baseline gap-2">
			<p class="text-xl font-medium tabular-nums">{ c.Value }</p>
			@deltaChip(c.Delta)
		</div>
		if c.HasChart {
			@chart.Chart(c.Chart)
		}
		if c.Note != "" {
			<p class="text-muted-foreground text-xs">{ c.Note }</p>
		}
	</a>
}

templ dayTable(days []DayRow) {
	<section class="space-y-3">
		@ui.MonoLabel("Day by day")
		<div class="border-hairline bg-surface/60 overflow-x-auto rounded-lg border">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-hairline border-b">
						<th scope="col" class="text-muted-foreground px-4 py-2 text-left font-mono text-[10px] font-normal uppercase tracking-[0.14em]">Day</th>
						if len(days) > 0 {
							for _, c := range days[0].Cells {
								<th scope="col" class="text-muted-foreground px-4 py-2 text-right font-mono text-[10px] font-normal uppercase tracking-[0.14em]">
									{ c.Label }
								</th>
							}
						}
					</tr>
				</thead>
				<tbody class="divide-hairline divide-y">
					for _, d := range days {
						<tr>
							<th scope="row" class="text-muted-foreground px-4 py-2 text-left font-normal whitespace-nowrap">{ d.Label }</th>
							for _, c := range d.Cells {
								<td class="px-4 py-2 text-right tabular-nums">
									if c.Filled {
										<span class="text-foreground">{ c.Value }</span>
									} else {
										<span class="text-muted-foreground/50">&mdash;</span>
									}
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
