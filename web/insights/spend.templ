package insights

import (
	"context"
	"fmt"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
)

templ Spend(user users.User, view SpendView) {
	@page(i18n.T(ctx, "insights.spend.title"), "spend", "/app/insights/spend/body", user, view.Range) {
		@SpendBody(view)
	}
}

templ SpendBody(view SpendView) {
	if !view.HasData {
		@emptyState(i18n.T(ctx, "insights.spend.empty"), "", "")
	} else {
		<div class="space-y-6">
			<div class="grid gap-3 sm:grid-cols-3">
				@statTile(i18n.T(ctx, "insights.spend.cost"), view.TotalCost, i18n.T(ctx, "insights.spend.cost.note"), DeltaView{})
				@statTile(i18n.T(ctx, "insights.spend.generations"), fmt.Sprintf("%d", view.Generations), i18n.T(ctx, "insights.spend.generations.note"), DeltaView{})
				@statTile(i18n.T(ctx, "insights.spend.tokens"), formatTokens(ctx, view.TotalTokens), i18n.T(ctx, "insights.spend.tokens.note"), DeltaView{})
			</div>
			@spendTable(i18n.T(ctx, "insights.spend.surfaces"), view.Surfaces)
			@spendTable(i18n.T(ctx, "insights.spend.models"), view.Models)
		</div>
	}
}

templ spendTable(title string, rows []SpendRow) {
	if len(rows) > 0 {
		<section class="space-y-3">
			@ui.MonoLabel(title)
			<div class="border-hairline bg-surface/60 divide-hairline divide-y rounded-lg border">
				for _, r := range rows {
					<div class="space-y-1.5 p-4">
						<div class="flex items-baseline justify-between gap-3 text-sm">
							<span class="truncate">{ r.Label }</span>
							<span class="shrink-0 tabular-nums">{ r.Cost }</span>
						</div>
						<div class="bg-accent/40 h-1.5 w-full overflow-hidden rounded-full">
							<div class="bg-signal h-full rounded-full" style={ fmt.Sprintf("width: %d%%", r.Pct) }></div>
						</div>
						<p class="text-muted-foreground text-xs tabular-nums">
							{ i18n.Tf(ctx, "insights.spend.row", r.Generations, formatTokens(ctx, r.Tokens)) }
						</p>
					</div>
				}
			</div>
		</section>
	}
}

// formatTokens keeps a six-figure token count readable. Exact numbers matter
// to nobody here; the order of magnitude is the whole message.
func formatTokens(ctx context.Context, n int64) string {
	switch {
	case n >= 1_000_000:
		return i18n.Decimal(ctx, float64(n)/1_000_000, 1) + "M"
	case n >= 1_000:
		return fmt.Sprintf("%.0fk", float64(n)/1_000)
	default:
		return fmt.Sprintf("%d", n)
	}
}
