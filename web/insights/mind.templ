package insights

import (
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
)

type MindView struct {
	Range RangeView

	MoodChart    chart.Props
	JournalChart chart.Props
	MoodHeatmap  map[string]any

	CheckInCount int
	JournalCount int
	AvgMood      float64
	AvgEnergy    float64

	HasCheckIns bool
	HasJournal  bool
}

templ Mind(user users.User, view MindView) {
	@page(sectionTitle(ctx, "mind"), "mind", "/app/insights/mind/body", user, view.Range) {
		@MindPanels(view)
	}
}

templ MindPanels(view MindView) {
	<div class="space-y-6">
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			@statTile(i18n.T(ctx, "insights.mind.checkins"), formatCount(view.CheckInCount), i18n.T(ctx, "insights.mind.checkins.note"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.mind.mood"), formatScore(ctx, view.AvgMood), i18n.T(ctx, "insights.mind.overDays"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.mind.energy"), formatScore(ctx, view.AvgEnergy), i18n.T(ctx, "insights.mind.overDays"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.mind.journal"), formatCount(view.JournalCount), "", DeltaView{})
		</div>
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "insights.mind.moodEnergy") }
				}
				@card.Description() {
					{ i18n.T(ctx, "insights.mind.moodEnergy.desc") }
				}
			}
			@card.Content() {
				if view.HasCheckIns {
					@chart.Chart(view.MoodChart)
					if len(view.MoodHeatmap) > 0 {
						@templ.JSONScript("insights-mind-heatmap-option", view.MoodHeatmap)
						@ui.EChartsMount("insights-mind-heatmap", "insights-mind-heatmap-option", "border-hairline mt-4 min-h-32 w-full rounded-md border")
					}
				} else {
					@emptyState(i18n.T(ctx, "insights.mind.moodEnergy.empty"), i18n.T(ctx, "insights.mind.moodEnergy.cta"), "/app/check-ins")
				}
			}
		}
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "insights.mind.journalling") }
				}
				@card.Description() {
					{ i18n.T(ctx, "insights.mind.journalling.desc") }
				}
			}
			@card.Content() {
				if view.HasJournal {
					@chart.Chart(view.JournalChart)
				} else {
					@emptyState(i18n.T(ctx, "insights.mind.journalling.empty"), i18n.T(ctx, "insights.mind.journalling.cta"), "/app/mind")
				}
			}
		}
	</div>
}
