package insights

import (
	"context"
	"fmt"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/workoutsummary"
)

templ Training(user users.User, view TrainingView) {
	@page(sectionTitle(ctx, "training"), "training", "/app/insights/training/body", user, view.Range) {
		@TrainingPanels(view)
	}
}

templ TrainingPanels(view TrainingView) {
	<div class="space-y-6">
		if view.Plan.HasPlan || view.Recap != nil {
			@planSection(view)
		}
		<div class="grid gap-3 sm:grid-cols-3">
			@statTile(i18n.T(ctx, "insights.training.burned"), formatKcal(view.Calories), i18n.T(ctx, "insights.training.burned.note"), view.Delta)
			@statTile(i18n.T(ctx, "insights.training.sessions"), formatCount(view.SessionCount), i18n.T(ctx, "insights.training.sessions.note"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.training.time"), timeLabel(view), "", DeltaView{})
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			@card.Card(card.Props{Class: "border-hairline bg-surface lg:col-span-2"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.training.energy") }
					}
					@card.Description() {
						{ i18n.T(ctx, "insights.training.energy.desc") }
					}
				}
				@card.Content() {
					if view.HasSessions {
						@chart.Chart(view.BurnChart)
					} else {
						@emptyState(i18n.T(ctx, "insights.training.empty"), i18n.T(ctx, "insights.training.cta"), "/app/fitness")
					}
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.training.kinds") }
					}
				}
				@card.Content() {
					if view.HasDonut {
						@templ.JSONScript("insights-training-donut-option", view.KindDonut)
						@ui.EChartsMount("insights-training-donut", "insights-training-donut-option", "min-h-48 w-full")
					} else {
						@emptyState(i18n.T(ctx, "insights.training.kinds.empty"), "", "")
					}
				}
			}
		</div>
		@lifting(view.Lifting)
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "insights.training.sessions") }
				}
			}
			@card.Content() {
				if len(view.Sessions) == 0 {
					@emptyState(i18n.T(ctx, "insights.training.empty"), i18n.T(ctx, "insights.training.cta"), "/app/fitness")
				} else {
					<ul class="divide-border -my-2 divide-y">
						for _, s := range view.Sessions {
							<li class="flex items-baseline justify-between gap-3 py-2">
								<span class="truncate text-sm font-medium">{ s.Name }</span>
								<span class="text-muted-foreground shrink-0 font-mono text-[10px] whitespace-nowrap tabular-nums">
									{ s.Duration }
									if s.Calories > 0 {
										<span>· { formatKcal(s.Calories) }</span>
									}
									<span>· { relativeTime(ctx, s.At) }</span>
								</span>
							</li>
						}
					</ul>
				}
			}
		}
	</div>
}

// planSection is the plan read against what was done — the view a coach or
// trainer starts from: adherence, then the latest workout in words and bars.
templ planSection(view TrainingView) {
	<section class="grid gap-4 lg:grid-cols-5" data-testid="insights-plan">
		if view.Plan.HasPlan {
			@card.Card(card.Props{Class: "border-hairline bg-surface lg:col-span-2"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.training.plan") }
					}
				}
				@card.Content() {
					<div class="space-y-4">
						@workoutsummary.WeekStrip(view.Plan.Week)
						if view.Plan.Planned > 0 {
							<div class="border-hairline border-t pt-3">
								<div class="flex items-baseline justify-between gap-2">
									<p class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">{ i18n.T(ctx, "insights.training.plan.window") }</p>
									<p class="text-xl font-medium tabular-nums">{ view.Plan.Rate() }</p>
								</div>
								<p class="text-muted-foreground text-xs">{ view.Plan.Sentence }</p>
							</div>
						}
					</div>
				}
			}
		}
		if view.Recap != nil {
			<div class={ templ.KV("lg:col-span-3", view.Plan.HasPlan), templ.KV("lg:col-span-5", !view.Plan.HasPlan) }>
				@workoutsummary.RecapCard(*view.Recap)
			</div>
		}
	</section>
}

func timeLabel(view TrainingView) string {
	if view.SessionCount == 0 {
		return "—"
	}
	return view.TotalTime
}

templ lifting(view LiftingView) {
	<section class="space-y-4" data-testid="insights-lifting">
		<h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">{ i18n.T(ctx, "insights.lifting.title") }</h2>
		if !view.HasSets {
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Content() {
					@emptyState(i18n.T(ctx, "insights.lifting.empty"), i18n.T(ctx, "insights.lifting.cta"), "/app/training")
				}
			}
		} else {
			<div class="grid gap-3 sm:grid-cols-3">
				@statTile(i18n.T(ctx, "insights.lifting.volume"), view.Volume, i18n.T(ctx, "insights.lifting.volume.note"), view.Delta)
				@statTile(i18n.T(ctx, "insights.lifting.sets"), formatCount(view.Sets), i18n.T(ctx, "insights.lifting.sets.note"), DeltaView{})
				@statTile(i18n.T(ctx, "insights.lifting.workouts"), formatCount(view.Workouts), i18n.T(ctx, "insights.lifting.workouts.note"), DeltaView{})
			</div>
			<div class="grid gap-4 lg:grid-cols-3">
				@card.Card(card.Props{Class: "border-hairline bg-surface lg:col-span-2"}) {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "insights.lifting.exercises") }
						}
						@card.Description() {
							{ i18n.T(ctx, "insights.lifting.exercises.desc") }
						}
					}
					@card.Content() {
						<div class="-mx-2 overflow-x-auto">
							<table class="w-full text-sm">
								<thead class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.1em]">
									<tr>
										<th class="px-2 py-1 text-left font-normal">{ i18n.T(ctx, "insights.lifting.col.exercise") }</th>
										<th class="px-2 py-1 text-right font-normal">{ i18n.T(ctx, "insights.lifting.col.sets") }</th>
										<th class="px-2 py-1 text-right font-normal">{ i18n.T(ctx, "insights.lifting.col.best") }</th>
										<th class="px-2 py-1 text-right font-normal">{ i18n.T(ctx, "insights.lifting.col.e1rm") }</th>
										<th class="hidden px-2 py-1 text-right font-normal sm:table-cell">{ i18n.T(ctx, "insights.lifting.col.volume") }</th>
									</tr>
								</thead>
								<tbody class="divide-border divide-y">
									for _, e := range view.Exercises {
										<tr>
											<td class="max-w-[12rem] truncate px-2 py-2 font-medium">{ e.Name }</td>
											<td class="px-2 py-2 text-right tabular-nums">{ formatCount(e.Sets) }</td>
											<td class="px-2 py-2 text-right tabular-nums">{ e.Best }</td>
											<td class="px-2 py-2 text-right tabular-nums">
												{ e.E1RM }
												if e.Change > 0 {
													<span class="text-signal ml-1 text-xs">{ changeLabel(ctx, e.Change) }</span>
												} else if e.Change < 0 {
													<span class="text-muted-foreground ml-1 text-xs">{ changeLabel(ctx, e.Change) }</span>
												}
											</td>
											<td class="text-muted-foreground hidden px-2 py-2 text-right tabular-nums sm:table-cell">{ e.Volume }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
				@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "insights.lifting.records") }
						}
						@card.Description() {
							{ i18n.T(ctx, "insights.lifting.records.desc") }
						}
					}
					@card.Content() {
						if len(view.Records) == 0 {
							@emptyState(i18n.T(ctx, "insights.lifting.records.empty"), "", "")
						} else {
							<ul class="divide-border -my-2 divide-y" data-testid="lifting-records">
								for _, r := range view.Records {
									<li class="py-2">
										<div class="flex items-baseline justify-between gap-2">
											<span class="truncate text-sm font-medium">{ r.Exercise }</span>
											<span class="text-signal shrink-0 text-xs tabular-nums">+{ r.Gain }</span>
										</div>
										<p class="text-muted-foreground text-xs tabular-nums">{ r.Lift } · { i18n.Tf(ctx, "insights.lifting.records.est", r.E1RM) } · { r.On }</p>
									</li>
								}
							</ul>
						}
					}
				}
			</div>
			<div class="grid gap-4 lg:grid-cols-3">
				if view.HasWeekly {
					@card.Card(card.Props{Class: "border-hairline bg-surface lg:col-span-2"}) {
						@card.Header() {
							@card.Title() {
								{ i18n.T(ctx, "insights.lifting.weekly") }
							}
						}
						@card.Content() {
							@chart.Chart(view.WeeklyChart)
						}
					}
				}
				if len(view.Muscles) > 0 {
					@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
						@card.Header() {
							@card.Title() {
								{ i18n.T(ctx, "insights.lifting.muscles") }
							}
							@card.Description() {
								{ i18n.T(ctx, "insights.lifting.muscles.desc") }
							}
						}
						@card.Content() {
							<ul class="space-y-2">
								for _, m := range view.Muscles {
									<li class="text-sm">
										<div class="flex justify-between gap-2">
											<span>{ m.Name }</span>
											<span class="text-muted-foreground tabular-nums">{ formatCount(m.Sets) }</span>
										</div>
										<div class="bg-muted mt-1 h-1.5 rounded-full">
											<div class="bg-signal h-1.5 rounded-full" style={ "width:" + formatCount(m.Pct) + "%" }></div>
										</div>
									</li>
								}
							</ul>
						}
					}
				}
			</div>
		}
	</section>
}

func changeLabel(ctx context.Context, kg float64) string {
	sign := "+"
	if kg < 0 {
		sign = "−"
		kg = -kg
	}
	return sign + formatKgShort(ctx, kg)
}

func formatKgShort(ctx context.Context, v float64) string {
	if v == float64(int64(v)) {
		return fmt.Sprintf("%.0f kg", v)
	}
	return i18n.Decimal(ctx, v, 1) + " kg"
}
