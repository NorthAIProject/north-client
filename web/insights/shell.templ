package insights

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

// RangeOption is one choice in the period selector.
type RangeOption struct {
	Key      string
	Label    string
	Selected bool
}

type RangeView struct {
	Key     string
	Label   string
	Options []RangeOption
}

// DeltaView is a change against the previous window of equal length.
// HasPrior false renders nothing at all, rather than a fabricated gain.
type DeltaView struct {
	Pct       float64
	Direction int
	HasPrior  bool
}

// section names the insights page being viewed, for the sub-nav. Its label is
// the catalogue's "insights.section.<Key>", which the summary's rings share.
type section struct {
	Key  string
	Href string
	Icon string
}

func sections() []section {
	return []section{
		{Key: "summary", Href: "/app/insights", Icon: "gauge"},
		{Key: "timeline", Href: "/app/insights/timeline", Icon: "list"},
		{Key: "body", Href: "/app/insights/body", Icon: "heart-pulse"},
		{Key: "mind", Href: "/app/insights/mind", Icon: "brain"},
		{Key: "progress", Href: "/app/insights/progress", Icon: "target"},
		{Key: "training", Href: "/app/insights/training", Icon: "dumbbell"},
		{Key: "nutrition", Href: "/app/insights/nutrition", Icon: "utensils"},
		{Key: "sleep", Href: "/app/insights/sleep", Icon: "moon"},
		{Key: "cardio", Href: "/app/insights/cardio", Icon: "footprints"},
		{Key: "patterns", Href: "/app/insights/patterns", Icon: "sparkles"},
		{Key: "coach", Href: "/app/insights/coach", Icon: "messages-square"},
		{Key: "spend", Href: "/app/insights/spend", Icon: "receipt"},
	}
}

// sectionNavKeys are the sections whose name is a loanword every language
// keeps ("Cardio", "Coaching"). They read the sidebar's entry for the same
// page rather than carry a second copy of a word that is not translated.
var sectionNavKeys = map[string]string{
	"cardio": "nav.cardio-insights.nav",
	"coach":  "nav.coach-insights.nav",
}

// sectionTitle is a section's name, for a page heading and the sub-nav.
func sectionTitle(ctx context.Context, key string) string {
	if navKey, ok := sectionNavKeys[key]; ok {
		return i18n.T(ctx, navKey)
	}
	return i18n.T(ctx, "insights.section."+key)
}

// page is the shell every insights view shares: title, sub-nav, range
// selector, and a swap target the selector replaces.
//
// bodyHref is the endpoint that renders just the panels, so switching the
// range costs one fragment instead of a whole document.
templ page(title, active, bodyHref string, user users.User, rg RangeView) {
	@layout.App(title, user, layout.BuildNav(ctx, "/app/insights")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header class="space-y-4">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div>
						@ui.MonoLabel(i18n.T(ctx, "insights.label"))
						<h1 class="mt-2 text-2xl font-medium tracking-tight">{ title }</h1>
						<p class="text-muted-foreground mt-1 max-w-2xl text-sm leading-relaxed">
							{ i18n.Tf(ctx, "insights.intro", rg.Label) }
						</p>
					</div>
					@rangeSelector(bodyHref, rg)
				</div>
				@sectionNav(active)
			</header>
			<div id="insights-panels">
				{ children... }
			</div>
		</div>
		@progress.Script()
		@ui.ChartScripts()
	}
}

templ sectionNav(active string) {
	<nav aria-label={ i18n.T(ctx, "insights.nav.sections") } class="-mx-1 flex gap-1 overflow-x-auto">
		for _, s := range sections() {
			<a
				href={ templ.SafeURL(s.Href) }
				if s.Key == active {
					aria-current="page"
					class="border-hairline bg-surface text-foreground flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs font-medium whitespace-nowrap"
				} else {
					class="text-muted-foreground hover:bg-accent/60 hover:text-foreground flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors"
				}
			>
				@icon.Icon(s.Icon)(icon.Props{Class: "size-3.5"})
				{ sectionTitle(ctx, s.Key) }
			</a>
		}
	</nav>
}

// rangeSelector swaps the panels. Each option is a real link as well as an
// hx-get, so the page still works with JavaScript off.
templ rangeSelector(bodyHref string, rg RangeView) {
	<nav
		aria-label={ i18n.T(ctx, "insights.nav.period") }
		class="border-hairline bg-surface/60 -mx-1 flex shrink-0 gap-1 overflow-x-auto rounded-lg border p-1"
	>
		for _, opt := range rg.Options {
			<a
				href={ templ.SafeURL(pageHref(bodyHref, opt.Key)) }
				hx-get={ bodyHref + "?range=" + opt.Key }
				hx-target="#insights-panels"
				hx-swap="innerHTML"
				hx-push-url={ pageHref(bodyHref, opt.Key) }
				if opt.Selected {
					aria-current="true"
					class="bg-signal text-background rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap"
				} else {
					class="text-muted-foreground hover:bg-accent/60 hover:text-foreground rounded-md px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors"
				}
			>
				{ opt.Label }
			</a>
		}
	</nav>
}

// pageHref turns a fragment endpoint back into its page URL, so the
// no-JavaScript link lands on a whole document rather than on a bare panel.
//
// Two suffixes because the summary's fragment cannot be called "/body": that
// path is already the Body section's own page.
func pageHref(bodyHref, key string) string {
	page := bodyHref
	for _, suffix := range []string{"/body", "/panels"} {
		if trimmed, found := strings.CutSuffix(page, suffix); found {
			page = trimmed
			break
		}
	}
	if page == "" {
		page = "/app/insights"
	}
	return page + "?range=" + key
}

// statTile is one headline number, optionally with a trend chip.
templ statTile(label, value, note string, delta DeltaView) {
	<div class="border-hairline bg-surface/60 space-y-1 rounded-lg border p-4">
		<p class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">{ label }</p>
		<div class="flex items-baseline gap-2">
			<p class="text-xl font-medium tabular-nums">{ value }</p>
			@deltaChip(delta)
		</div>
		if note != "" {
			<p class="text-muted-foreground text-xs">{ note }</p>
		}
	</div>
}

// deltaChip renders nothing without a previous window to compare against.
// Direction is carried by an arrow as well as a colour, since colour alone is
// not a signal everyone receives.
templ deltaChip(delta DeltaView) {
	if delta.HasPrior && delta.Direction != 0 {
		<span
			class={ "inline-flex items-center gap-0.5 font-mono text-[10px] tabular-nums",
				templ.KV("text-signal", delta.Direction > 0),
				templ.KV("text-muted-foreground", delta.Direction < 0) }
		>
			if delta.Direction > 0 {
				@icon.Icon("trending-up")(icon.Props{Class: "size-3"})
			} else {
				@icon.Icon("trending-down")(icon.Props{Class: "size-3"})
			}
			{ formatPct(delta.Pct) }
		</span>
	}
}

// emptyState is what a window with nothing in it says. Every panel has one:
// a chart axis with no series reads as a bug.
templ emptyState(message, cta, href string) {
	<div class="py-6 text-center">
		<p class="text-muted-foreground text-sm">{ message }</p>
		if cta != "" && href != "" {
			<a href={ templ.SafeURL(href) } class="text-signal mt-2 inline-block text-sm hover:underline">{ cta }</a>
		}
	</div>
}

func formatPct(pct float64) string {
	if pct < 0 {
		pct = -pct
	}
	return fmt.Sprintf("%.0f%%", pct)
}

func formatKcal(v float64) string {
	if v <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f kcal", v)
}

func formatLitres(ml int) string {
	if ml <= 0 {
		return "—"
	}
	if ml >= 1000 {
		return fmt.Sprintf("%.1f L", float64(ml)/1000)
	}
	return fmt.Sprintf("%d ml", ml)
}

func formatHours(minutes float64) string {
	if minutes <= 0 {
		return "—"
	}
	h := int(minutes) / 60
	m := int(minutes) % 60
	if m == 0 {
		return fmt.Sprintf("%dh", h)
	}
	return fmt.Sprintf("%dh %dm", h, m)
}

func formatScore(v float64) string {
	if v <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.1f/5", v)
}

func formatCount(n int) string {
	return fmt.Sprintf("%d", n)
}

func relativeTime(ctx context.Context, t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return i18n.T(ctx, "insights.ago.now")
	case d < time.Hour:
		return i18n.Tf(ctx, "insights.ago.minutes", int(d.Minutes()))
	case d < 24*time.Hour:
		return i18n.Tf(ctx, "insights.ago.hours", int(d.Hours()))
	case d < 7*24*time.Hour:
		return i18n.Tf(ctx, "insights.ago.days", int(d.Hours()/24))
	default:
		return i18n.Date(ctx, t, "2 Jan")
	}
}
