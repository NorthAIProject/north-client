package insights

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

templ Body(user users.User, view BodyView) {
	@page(sectionTitle(ctx, "body"), "body", "/app/insights/body/body", user, view.Range) {
		@BodyPanels(view)
	}
}

templ BodyPanels(view BodyView) {
	<div class="space-y-6">
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			@statTile(i18n.T(ctx, "insights.body.water"), formatLitres(ctx, view.TotalWaterML), i18n.T(ctx, "insights.body.water.note"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.body.nights"), formatCount(view.Nights), "", DeltaView{})
			@statTile(i18n.T(ctx, "insights.body.avgSleep"), formatHours(view.AvgSleep), i18n.T(ctx, "insights.body.avgSleep.note"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.body.quality"), formatScore(ctx, view.AvgQuality), qualityNote(ctx, view), DeltaView{})
		</div>
		<div class="grid gap-4 lg:grid-cols-2">
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.body.hydration") }
					}
					@card.Description() {
						{ i18n.T(ctx, "insights.body.hydration.desc") }
					}
				}
				@card.Content() {
					if view.HasWater {
						@chart.Chart(view.WaterChart)
					} else {
						@emptyState(i18n.T(ctx, "insights.body.hydration.empty"), i18n.T(ctx, "insights.body.hydration.cta"), "/app/care")
					}
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.body.sleep") }
					}
					@card.Description() {
						{ i18n.T(ctx, "insights.body.sleep.desc") }
					}
				}
				@card.Content() {
					if view.HasSleep {
						@chart.Chart(view.SleepChart)
					} else {
						@emptyState(i18n.T(ctx, "insights.body.sleep.empty"), i18n.T(ctx, "insights.body.sleep.cta"), "/app/care")
					}
				}
			}
		</div>
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "insights.body.habits") }
				}
				@card.Description() {
					{ i18n.T(ctx, "insights.body.habits.desc") }
				}
			}
			@card.Content() {
				if view.HasHabits {
					<div class="grid gap-6 lg:grid-cols-3">
						<div>
							if len(view.HabitGauge) > 0 {
								@templ.JSONScript("insights-habit-gauge-option", view.HabitGauge)
								@ui.EChartsMount("insights-habit-gauge", "insights-habit-gauge-option", "min-h-48 w-full")
							}
						</div>
						<ul class="space-y-3 lg:col-span-2">
							for _, h := range view.Habits {
								<li>
									<div class="mb-1 flex items-baseline justify-between gap-3">
										<span class="truncate text-sm font-medium">{ h.Name }</span>
										<span class="text-muted-foreground shrink-0 font-mono text-[10px] tabular-nums">
											{ formatCount(h.Kept) }/{ formatCount(h.Scheduled) }
											if h.Streak > 0 {
												<span>· { i18n.Tf(ctx, "insights.body.habits.streak", h.Streak) }</span>
											}
										</span>
									</div>
									@progress.Progress(progress.Props{Value: h.Rate, Max: 100, Size: progress.SizeSm})
								</li>
							}
						</ul>
					</div>
				} else {
					@emptyState(i18n.T(ctx, "insights.body.habits.empty"), i18n.T(ctx, "insights.body.habits.cta"), "/app/care")
				}
			}
		}
	</div>
}

// qualityNote says what the average is actually an average of. Quality is
// optional on a sleep log, so the count is the difference between a claim and
// a misleading one.
func qualityNote(ctx context.Context, view BodyView) string {
	switch view.QualityCount {
	case 0:
		return i18n.T(ctx, "insights.body.quality.none")
	case 1:
		return i18n.T(ctx, "insights.body.quality.one")
	default:
		return i18n.Tf(ctx, "insights.body.quality.many", view.QualityCount)
	}
}
