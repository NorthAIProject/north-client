package insights

import (
	"context"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

templ Progress(user users.User, view ProgressView) {
	@page(sectionTitle(ctx, "progress"), "progress", "/app/insights/progress/body", user, view.Range) {
		@ProgressPanels(view)
	}
}

templ ProgressPanels(view ProgressView) {
	<div class="space-y-6">
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			@statTile(i18n.T(ctx, "insights.progress.active"), formatCount(view.ActiveCount), openedNote(ctx, view), DeltaView{})
			@statTile(i18n.T(ctx, "insights.progress.average"), percentLabel(view.AvgProgress), i18n.T(ctx, "insights.progress.average.note"), DeltaView{})
			@statTile(i18n.T(ctx, "insights.progress.streak"), streakLabel(ctx, view.Streak), "", DeltaView{})
			@statTile(i18n.T(ctx, "insights.progress.overdue"), formatCount(view.Overdue), overdueNote(ctx, view), DeltaView{})
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			@card.Card(card.Props{Class: "border-hairline bg-surface lg:col-span-2"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.progress.goals") }
					}
				}
				@card.Content() {
					if len(view.Goals) == 0 {
						@emptyState(i18n.T(ctx, "insights.progress.goals.empty"), i18n.T(ctx, "insights.progress.addGoal"), "/app/goals")
					} else {
						<ul class="space-y-4">
							for _, g := range view.Goals {
								<li>
									<a href={ templ.SafeURL("/app/goals/" + g.ID) } class="block">
										<div class="mb-1 flex items-baseline justify-between gap-3">
											<span class="truncate text-sm font-medium">{ g.Title }</span>
											if g.Deadline != "" {
												<span
													class={ "shrink-0 font-mono text-[10px] whitespace-nowrap",
														templ.KV("text-signal", g.Overdue),
														templ.KV("text-muted-foreground", !g.Overdue) }
												>
													{ g.Deadline }
												</span>
											}
										</div>
										if g.HasProgress {
											@progress.Progress(progress.Props{Value: g.Progress, Max: 100, Size: progress.SizeSm})
										} else {
											<p class="text-muted-foreground text-xs">{ i18n.T(ctx, "insights.progress.goals.none") }</p>
										}
									</a>
								</li>
							}
						</ul>
					}
				}
			}
			@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
				@card.Header() {
					@card.Title() {
						{ i18n.T(ctx, "insights.progress.status") }
					}
				}
				@card.Content() {
					if view.HasDonut {
						@templ.JSONScript("insights-progress-donut-option", view.StatusDonut)
						@ui.EChartsMount("insights-progress-donut", "insights-progress-donut-option", "min-h-48 w-full")
					} else {
						@emptyState(i18n.T(ctx, "insights.progress.status.empty"), i18n.T(ctx, "insights.progress.addGoal"), "/app/goals")
					}
				}
			}
		</div>
		@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "insights.progress.notes") }
				}
				@card.Description() {
					{ i18n.T(ctx, "insights.progress.notes.desc") }
				}
			}
			@card.Content() {
				if view.HasNotes {
					@chart.Chart(view.NotesChart)
				} else {
					@emptyState(i18n.T(ctx, "insights.progress.notes.empty"), i18n.T(ctx, "insights.progress.notes.cta"), "/app/goals")
				}
			}
		}
	</div>
}

func percentLabel(pct int) string {
	if pct <= 0 {
		return "—"
	}
	return formatCount(pct) + "%"
}

func streakLabel(ctx context.Context, days int) string {
	if days <= 0 {
		return "—"
	}
	if days == 1 {
		return i18n.T(ctx, "insights.progress.streak.one")
	}
	return i18n.Tf(ctx, "insights.progress.streak.many", days)
}

func openedNote(ctx context.Context, view ProgressView) string {
	switch view.OpenedCount {
	case 0:
		return i18n.T(ctx, "insights.progress.opened.none")
	case 1:
		return i18n.T(ctx, "insights.progress.opened.one")
	default:
		return i18n.Tf(ctx, "insights.progress.opened.many", view.OpenedCount)
	}
}

// overdueNote is deliberately quiet when the count is zero. A dashboard that
// congratulates you for having nothing wrong is noise.
func overdueNote(ctx context.Context, view ProgressView) string {
	if view.Overdue == 0 {
		return ""
	}
	return i18n.T(ctx, "insights.progress.overdue.note")
}
