package insights

import (
	"fmt"

	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
)

templ Coach(user users.User, view CoachView) {
	@page(sectionTitle(ctx, "coach"), "coach", "/app/insights/coach/body", user, view.Range) {
		@CoachBody(view)
	}
}

templ CoachBody(view CoachView) {
	if !view.HasData {
		@emptyState(i18n.T(ctx, "insights.coach.empty"), i18n.T(ctx, "insights.coach.cta"), "/app/chat")
	} else {
		<div class="space-y-6">
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				@statTile(i18n.T(ctx, "insights.coach.turns"), formatCount(view.Turns), i18n.T(ctx, "insights.coach.turns.note"), DeltaView{})
				@statTile(i18n.T(ctx, "insights.coach.yours"), formatCount(view.YourMessages), "", DeltaView{})
				@statTile(i18n.T(ctx, "insights.coach.replies"), formatCount(view.CoachReplies), "", DeltaView{})
				if view.HasRatings {
					@statTile(i18n.T(ctx, "insights.coach.useful"), fmt.Sprintf("%d%%", view.HelpfulRate),
						i18n.Tf(ctx, "insights.coach.useful.rated", view.Rated), DeltaView{})
				} else {
					@statTile(i18n.T(ctx, "insights.coach.useful"), "—", i18n.T(ctx, "insights.coach.useful.none"), DeltaView{})
				}
			</div>
			<div class="border-hairline bg-surface/60 space-y-3 rounded-lg border p-4">
				@ui.MonoLabel(i18n.T(ctx, "insights.coach.conversation"))
				@chart.Chart(view.Chart)
			</div>
			if view.Truncated {
				<p class="text-muted-foreground text-xs">
					{ i18n.T(ctx, "insights.coach.truncated") }
				</p>
			}
			if len(view.Highlights) > 0 {
				@highlights(view.Highlights)
			}
		</div>
	}
}
