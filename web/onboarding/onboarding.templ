package onboarding

import (
	"context"

	"github.com/NorthAIProject/north-client/internal/firstweek"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/shared/lifedomain"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/mascot"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/checkbox"
	"github.com/NorthAIProject/north-client/web/shared/ui/dictate"
	"github.com/NorthAIProject/north-client/web/shared/ui/input"
	"github.com/NorthAIProject/north-client/web/shared/ui/label"
	"github.com/NorthAIProject/north-client/web/shared/ui/radio"
	"github.com/NorthAIProject/north-client/web/shared/ui/textarea"
)

const (
	styleDirect     = "direct"
	styleSupportive = "supportive"
	styleSocratic   = "socratic"
	styleCustom     = "custom"
)

// focusAreas matches internal/onboarding.FocusAreas — duplicated here to avoid
// an import cycle between web and internal packages.
var focusAreas = []string{
	lifedomain.Fitness,
	lifedomain.Health,
	lifedomain.Work,
	lifedomain.Learning,
	lifedomain.Personal,
}

// Form carries submitted answers back when validation fails.
type Form struct {
	FocusAreas  []string
	StylePreset string
	StyleCustom string
	GoalTitle   string
	Errors      map[string]string

	// FirstWeek offers the pick of what to change in the first seven days,
	// when the server starts first weeks at all.
	FirstWeek         bool
	FirstWeekTemplate string
}

// firstWeekTemplate is the picked template, custom until one is chosen.
func (f Form) firstWeekTemplate() string {
	if t, ok := firstweek.NormalizeTemplate(f.FirstWeekTemplate); ok {
		return t
	}
	return firstweek.TemplateCustom
}

func (f Form) fieldError(name string) string { return f.Errors[name] }

func (f Form) focusChecked(area string) bool {
	for _, a := range f.FocusAreas {
		if a == area {
			return true
		}
	}
	return false
}

func (f Form) stylePreset() string {
	if f.StylePreset != "" {
		return f.StylePreset
	}
	return styleDirect
}

// focusLabel names a focus area through the shared life-domain vocabulary,
// the same words goals use for their categories.
func focusLabel(ctx context.Context, area string) string {
	return i18n.T(ctx, "lifedomain."+area)
}

templ FormPage(f Form) {
	@layout.AuthWide(i18n.T(ctx, "onboarding.page")) {
		@checkbox.Script()
		@mascot.Script()
		@card.Card() {
			@card.Header() {
				<div class="flex justify-center pb-2">
					@mascot.Mascot(mascot.Props{Size: mascot.SizeMd, State: mascot.StateListening})
				</div>
				@card.Title() {
					{ i18n.T(ctx, "onboarding.title") }
				}
				@card.Description() {
					{ i18n.T(ctx, "onboarding.desc") }
				}
			}
			@card.Content() {
				if f.fieldError("focus_areas") != "" || f.fieldError("coaching_style") != "" || f.fieldError("goal_title") != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "mb-4"}) {
						@alert.Description() {
							{ i18n.T(ctx, "onboarding.fix") }
						}
					}
				}
				<form
					method="post"
					action="/app/onboarding"
					class="space-y-8"
					x-data={ "{ preset: '" + f.stylePreset() + "' }" }
				>
					@ui.CSRFInput()
					<section class="space-y-3">
						@label.Label(label.Props{For: "focus-fitness"}) {
							{ i18n.T(ctx, "onboarding.focus.label") }
						}
						<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "onboarding.focus.hint") }</p>
						<div class="grid grid-cols-2 gap-3">
							for _, area := range focusAreas {
								<label class="flex items-center gap-2 text-sm">
									@checkbox.Checkbox(checkbox.Props{
										ID:      "focus-" + area,
										Name:    "focus_areas",
										Value:   area,
										Checked: f.focusChecked(area),
									})
									{ focusLabel(ctx, area) }
								</label>
							}
						</div>
						if f.fieldError("focus_areas") != "" {
							<p class="text-destructive text-sm">{ f.fieldError("focus_areas") }</p>
						}
					</section>
					<section class="space-y-3">
						@label.Label(label.Props{For: "style-direct"}) {
							{ i18n.T(ctx, "onboarding.style.label") }
						}
						<div class="space-y-2">
							@styleOption("style-direct", styleDirect, i18n.T(ctx, "onboarding.style.direct"), i18n.T(ctx, "onboarding.style.direct.desc"), f)
							@styleOption("style-supportive", styleSupportive, i18n.T(ctx, "onboarding.style.supportive"), i18n.T(ctx, "onboarding.style.supportive.desc"), f)
							@styleOption("style-socratic", styleSocratic, i18n.T(ctx, "onboarding.style.socratic"), i18n.T(ctx, "onboarding.style.socratic.desc"), f)
							@styleOption("style-custom", styleCustom, i18n.T(ctx, "onboarding.style.custom"), i18n.T(ctx, "onboarding.style.custom.desc"), f)
						</div>
						<div x-show="preset === 'custom'" x-cloak class="space-y-2">
							@dictate.Field(dictate.Props{Target: "coaching_style_custom"}) {
								@textarea.Textarea(textarea.Props{
									ID:          "coaching_style_custom",
									Name:        "coaching_style_custom",
									Rows:        3,
									Placeholder: i18n.T(ctx, "onboarding.style.placeholder"),
									Value:       f.StyleCustom,
								})
							}
						</div>
						if f.fieldError("coaching_style") != "" {
							<p class="text-destructive text-sm">{ f.fieldError("coaching_style") }</p>
						}
					</section>
					if f.FirstWeek {
						<fieldset class="space-y-3">
							<legend class="text-sm font-medium">{ i18n.T(ctx, "onboarding.firstweek.label") }</legend>
							<p class="text-muted-foreground text-sm">{ i18n.T(ctx, "onboarding.firstweek.hint") }</p>
							<div class="grid gap-2 sm:grid-cols-2">
								for _, t := range firstweek.Templates {
									@firstWeekOption(t, f)
								}
							</div>
						</fieldset>
					}
					<section class="space-y-2">
						@label.Label(label.Props{For: "goal_title"}) {
							{ i18n.T(ctx, "onboarding.goal.label") }
						}
						@input.Input(input.Props{
							ID:          "goal_title",
							Name:        "goal_title",
							Value:       f.GoalTitle,
							Placeholder: i18n.T(ctx, "onboarding.goal.placeholder"),
						})
						if f.fieldError("goal_title") != "" {
							<p class="text-destructive text-sm">{ f.fieldError("goal_title") }</p>
						}
					</section>
					@button.Button(button.Props{
						Type:      button.TypeSubmit,
						Class:     "bg-signal text-background hover:bg-signal/90",
						FullWidth: true,
					}) {
						{ i18n.T(ctx, "onboarding.submit") }
					}
				</form>
			}
		}
		// Its own form, and outside the card: skipping ignores every field
		// above it (see internal/onboarding.Handler.skip), and a form cannot be
		// nested inside another. Below the card rather than beside the primary
		// action, so the choice reads as leaving rather than as an alternative
		// way to finish.
		<form method="post" action="/app/onboarding/skip" class="mt-4 flex justify-center">
			@ui.CSRFInput()
			@button.Button(button.Props{
				Type:    button.TypeSubmit,
				Variant: button.VariantGhost,
				Class:   "text-muted-foreground",
			}) {
				{ i18n.T(ctx, "onboarding.skip") }
			}
		</form>
		@dictate.Script()
	}
}

templ styleOption(id, value, title, desc string, f Form) {
	<label class="flex cursor-pointer items-start gap-3 rounded-md border border-border p-3 has-[:checked]:border-signal/50 has-[:checked]:bg-signal/5">
		@radio.Radio(radio.Props{
			ID:      id,
			Name:    "coaching_style_preset",
			Value:   value,
			Checked: f.stylePreset() == value,
			Attributes: templ.Attributes{
				"x-model": "preset",
			},
		})
		<span class="space-y-0.5">
			<span class="block text-sm font-medium">{ title }</span>
			<span class="text-muted-foreground block text-sm">{ desc }</span>
		</span>
	</label>
}

templ firstWeekOption(template string, f Form) {
	<label class="flex cursor-pointer items-center gap-3 rounded-md border border-border p-3 has-[:checked]:border-signal/50 has-[:checked]:bg-signal/5">
		@radio.Radio(radio.Props{
			ID:      "first_week_" + template,
			Name:    "first_week_template",
			Value:   template,
			Checked: f.firstWeekTemplate() == template,
		})
		<span class="text-sm font-medium">{ i18n.T(ctx, "firstweek."+template+".label") }</span>
	</label>
}

// thread is the conversation seeded from the answers, or empty when none was
// opened — a deployment with no AI provider, or a provider that was down.
//
// connect shows the "connect one source" step that starts a first week: a
// coach with nothing of the person's to read has nothing to say on day 1.
templ DonePage(user users.User, thread string, connect bool) {
	@layout.AuthWide(i18n.T(ctx, "onboarding.done.page")) {
		@mascot.Script()
		@card.Card() {
			@card.Header() {
				// The one place a gesture fires on mount: finishing setup is the
				// only moment in the product that is unambiguously worth a
				// celebrate, and it belongs to this page rather than to every
				// mascot on it.
				<div class="flex justify-center pb-2">
					@mascot.Mascot(mascot.Props{Size: mascot.SizeLg, Gesture: mascot.StateCelebrate})
				</div>
				@card.Title() {
					{ i18n.Tf(ctx, "onboarding.done.title", user.FirstName()) }
				}
				@card.Description() {
					if thread != "" {
						{ i18n.T(ctx, "onboarding.done.writing") }
					} else {
						{ i18n.T(ctx, "onboarding.done.ready") }
					}
				}
			}
			@card.Content() {
				<div class="flex flex-col gap-3">
					if thread != "" {
						@button.Button(button.Props{
							Href:      "/app/chat/" + thread,
							Class:     "bg-signal text-background hover:bg-signal/90 w-full",
							FullWidth: true,
						}) {
							{ i18n.T(ctx, "onboarding.done.read") }
						}
					} else {
						<form method="post" action="/app/chat">
							@ui.CSRFInput()
							@button.Button(button.Props{
								Type:      button.TypeSubmit,
								Class:     "bg-signal text-background hover:bg-signal/90 w-full",
								FullWidth: true,
							}) {
								{ i18n.T(ctx, "onboarding.done.talk") }
							}
						</form>
					}
					if !connect {
						@button.Button(button.Props{
							Href:      "/app",
							Variant:   button.VariantOutline,
							FullWidth: true,
						}) {
							{ i18n.T(ctx, "onboarding.done.dashboard") }
						}
					}
				</div>
			}
		}
		if connect {
			@connectCard()
		}
	}
}

// connectCard is day 0's second step. Each choice goes to the page that
// already connects that source; logging by hand is a choice too, not a skip.
templ connectCard() {
	@card.Card(card.Props{Class: "mt-4"}) {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "onboarding.done.connect.title") }
			}
			@card.Description() {
				{ i18n.T(ctx, "onboarding.done.connect.desc") }
			}
		}
		@card.Content() {
			<div class="grid gap-2 sm:grid-cols-2">
				@connectOption("/app/fitness", "onboarding.done.connect.strava")
				@connectOption("/app/settings/connections", "onboarding.done.connect.telegram")
				@connectOption("/app/knowledge", "onboarding.done.connect.upload")
				@connectOption("/app", "onboarding.done.connect.manual")
			</div>
		}
	}
}

templ connectOption(href, key string) {
	@button.Button(button.Props{
		Href:      href,
		Variant:   button.VariantOutline,
		FullWidth: true,
	}) {
		{ i18n.T(ctx, key) }
	}
}
