package fitness

import (
	"fmt"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/fitness/strava"
	"github.com/NorthAIProject/north-client/internal/meals"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/internal/workouts/plan"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
)

type tile struct {
	Title       string
	Description string
	Href        string
}

var tiles = []tile{
	{"Training", "AI-generated workout plans.", "/app/training"},
	{"Exercises", "What each movement trains, on the model.", "/app/exercises"},
	{"Form check", "Upload a clip, get feedback.", "/app/form"},
	{"Activity", "Track a session, see calories burned.", "/app/activity"},
	{"Calculator", "BMR, TDEE, and a macro target.", "/app/calculator"},
	{"Ingredients", "Shared and your own foods.", "/app/nutrition/ingredients"},
	{"Meal plans", "Build plans, track totals.", "/app/nutrition/plans"},
	{"Food log", "Log today, see progress.", "/app/nutrition/log"},
}

// Instruments holds chart configs and KPI values for the fitness hub header.
type Instruments struct {
	CalorieChart chart.Props
	HasCalories  bool
	Calories7d   float64
	PlanID       uuid.UUID
	NextSession  *plan.PlanDay
	HasMealProgress bool
	MealProgress    *meals.Progress
}

// HubData is everything the fitness hub renders.
type HubData struct {
	StravaStatus strava.Status
	Instruments  Instruments
	Notice       string
}

func (d HubData) HasPlan() bool {
	return d.Instruments.PlanID != uuid.Nil
}

templ Hub(user users.User, data HubData) {
	@layout.App("Fitness", user, layout.BuildNav("/app/fitness")) {
		<div class="mx-auto w-full max-w-6xl space-y-6 p-6 md:p-8">
			<header>
				@ui.MonoLabel("Fitness")
				<h1 class="mt-2 text-2xl font-medium tracking-tight">Fitness</h1>
				<p class="text-muted-foreground mt-1 text-sm leading-relaxed">
					Training, form, activity, and the numbers behind them.
				</p>
			</header>
			if data.Notice != "" {
				<div class="border-hairline bg-signal/10 rounded-lg border px-4 py-3 text-sm">
					{ data.Notice }
				</div>
			}
			@kpiStrip(data)
			@calorieInstrument(data)
			<div class="grid gap-4 sm:grid-cols-2">
				for _, t := range tiles {
					@tileCard(t)
				}
			</div>
			@stravaCard(data.StravaStatus)
		</div>
		@ui.ChartScripts()
	}
}

templ kpiStrip(data HubData) {
	@ui.KpiStrip() {
		@kpiCell("Burned 7d", burnedKPI(data), "/app/activity", "Track activity")
		@kpiCell("Training", trainingKPI(data), trainingHref(data), trainingCTA(data))
		@kpiCell("Nutrition", nutritionKPI(data), "/app/nutrition/log", "Log food")
		@kpiCell("Strava", stravaKPI(data.StravaStatus), "/app/fitness", stravaCTA(data.StravaStatus))
	}
}

templ kpiCell(label, value, href, cta string) {
	@ui.KpiCell(ui.KpiCellProps{Label: label, Value: value, Href: href, CTA: cta})
}

func burnedKPI(data HubData) string {
	if data.Instruments.Calories7d <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f kcal", data.Instruments.Calories7d)
}

func trainingKPI(data HubData) string {
	if data.Instruments.NextSession != nil {
		return data.Instruments.NextSession.Weekday
	}
	if data.HasPlan() {
		return "Plan ready"
	}
	return "—"
}

func trainingHref(data HubData) string {
	if data.HasPlan() {
		return "/app/training/" + data.Instruments.PlanID.String()
	}
	return "/app/training"
}

func trainingCTA(data HubData) string {
	if data.Instruments.NextSession != nil {
		return "Open session"
	}
	if data.HasPlan() {
		return "Open plan"
	}
	return "Build plan"
}

func nutritionKPI(data HubData) string {
	if !data.Instruments.HasMealProgress || data.Instruments.MealProgress == nil {
		return "—"
	}
	p := data.Instruments.MealProgress
	return fmt.Sprintf("%.0f / %.0f kcal", p.Logged.Calories, p.Goal.Calories)
}

func stravaKPI(status strava.Status) string {
	if !status.Configured {
		return "Off"
	}
	if status.Connected {
		return "Connected"
	}
	return "Not linked"
}

func stravaCTA(status strava.Status) string {
	if !status.Configured {
		return ""
	}
	if status.Connected {
		return "Manage"
	}
	return "Connect"
}

templ calorieInstrument(data HubData) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() { Activity 7d }
			@card.Description() {
				Calories burned from tracked and imported sessions.
			}
		}
		@card.Content() {
			if data.Instruments.HasCalories {
				@chart.Chart(data.Instruments.CalorieChart)
			} else {
				<p class="text-muted-foreground text-sm">No activity logged this week.</p>
			}
		}
	}
}

// stravaCard is the whole surface of the integration: connect, sync,
// disconnect, and when it last ran. Nothing about tokens reaches here — the
// handler is given a Status, which cannot carry them.
templ stravaCard(status strava.Status) {
	@card.Card(card.Props{Class: "border-hairline bg-surface"}) {
		@card.Header() {
			@card.Title() {
				Strava
			}
			@card.Description() {
				if !status.Configured {
					Not configured on this server.
				} else if status.Connected {
					Connected.
					if status.LastSyncedAt != nil {
						Last synced { status.LastSyncedAt.Format("2 Jan, 15:04") }.
					} else {
						No sync yet.
					}
				} else {
					Import your runs and rides automatically.
				}
			}
		}
		@card.Content() {
			if !status.Configured {
				<p class="text-muted-foreground text-xs leading-relaxed">
					Set STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET to enable this.
				</p>
			} else if status.Connected {
				<div class="flex flex-wrap gap-2">
					@button.Button(button.Props{Href: "/app/fitness/activities", Class: "bg-signal text-background hover:bg-signal/90"}) {
						View activities in 3D
					}
					<form method="post" action="/app/fitness/strava/sync">
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
							Sync now
						}
					</form>
					<form method="post" action="/app/fitness/strava/disconnect">
						@ui.CSRFInput()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
							Disconnect
						}
					</form>
				</div>
			} else {
				@button.Button(button.Props{Href: "/app/fitness/strava/connect", Class: "bg-signal text-background hover:bg-signal/90"}) {
					Connect Strava
				}
			}
		}
	}
}

templ tileCard(t tile) {
	<a href={ templ.SafeURL(t.Href) } class="block">
		@card.Card(card.Props{Class: "border-hairline bg-surface hover:border-muted-foreground/30 transition-colors"}) {
			@card.Header() {
				@card.Title() {
					{ t.Title }
				}
				@card.Description() {
					{ t.Description }
				}
			}
		}
	</a>
}
