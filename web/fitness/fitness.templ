package fitness

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"

	"github.com/NorthAIProject/north-client/internal/fitness/strava"
	"github.com/NorthAIProject/north-client/internal/meals"
	"github.com/NorthAIProject/north-client/internal/shared/durfmt"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/internal/workouts/plan"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/alert"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/card"
	"github.com/NorthAIProject/north-client/web/shared/ui/chart"
	"github.com/NorthAIProject/north-client/web/shared/ui/icon"
	"github.com/NorthAIProject/north-client/web/shared/ui/progress"
)

// tiles are the Body pages the sidebar does not carry, which is exactly what
// this hub exists to be an entrance to.
//
// Derived from the destination registry rather than listed again here. This
// was a second hardcoded copy of eight pages, and it was the only way to reach
// most of them — so it drifted from the rail silently and there was no third
// place that knew about all of them. layout.Destinations() is now that place.
func tiles() []layout.Destination {
	var out []layout.Destination
	for _, d := range layout.Destinations() {
		if d.Group != layout.GroupBody || d.Nav.Show {
			continue
		}
		// The 3D view is offered by the Strava card below, in the state where
		// it has something to show. A tile for it here would be a dead end for
		// anyone who has not connected.
		if d.Href == "/app/fitness/activities" {
			continue
		}
		out = append(out, d)
	}
	return out
}

// Instruments holds the plan and nutrition state the side rail reads.
type Instruments struct {
	PlanID          uuid.UUID
	NextSession     *plan.PlanDay
	DoneToday       *plan.PlanDay
	HasMealProgress bool
	MealProgress    *meals.Progress
}

// HubData is everything the fitness hub renders.
type HubData struct {
	StravaStatus strava.Status
	Instruments  Instruments
	Notice       string

	Week   WeekView
	Recent []RecentRow

	// Steps and VO2 are nil unless a device has pushed that metric; the page
	// leaves the card out rather than drawing a flat line of zeros.
	Steps *Trend
	VO2   *Trend

	Weight *Weight

	// Strength and Cardio are the last 30 days; nil leaves the card out.
	Strength *StrengthView
	Cardio   *CardioView

	// DeviceReadings is the last week from a wearable or phone, already
	// rendered as sentences by internal/health. Empty is the normal state.
	DeviceReadings    []string
	HasDeviceReadings bool

	Location *time.Location
	Now      time.Time
}

func (d HubData) HasPlan() bool {
	return d.Instruments.PlanID != uuid.Nil
}

// activitiesHref is where "see all" goes: the Strava view when there is one to
// show, the activity timer's history otherwise.
func (d HubData) activitiesHref() string {
	if d.StravaStatus.Connected {
		return "/app/fitness/activities"
	}
	return "/app/activity"
}

templ Hub(user users.User, data HubData) {
	@layout.App(i18n.T(ctx, "nav.fitness"), user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-6xl p-4 md:p-8">
			<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
				<div>
					@ui.MonoLabel(layout.GroupLabel(ctx, layout.GroupBody))
					<h1 class="mt-2 text-2xl font-semibold tracking-tight">{ i18n.T(ctx, "nav.fitness") }</h1>
					<p class="text-muted-foreground mt-1 text-sm">
						{ i18n.T(ctx, "fitness.hub.lede") }
					</p>
				</div>
				<div class="flex gap-2">
					@button.Button(button.Props{Href: "/app/nutrition/log", Variant: button.VariantOutline, Size: button.SizeSm}) {
						@icon.Utensils(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "fitness.hub.logfood") }
					}
					@button.Button(button.Props{Href: "/app/activity", Size: button.SizeSm, Class: "bg-signal text-background hover:bg-signal/90"}) {
						@icon.Timer(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "fitness.hub.track") }
					}
				</div>
			</header>
			if data.Notice != "" {
				<div class="border-hairline bg-signal/10 mb-6 rounded-lg border px-4 py-3 text-sm">
					{ data.Notice }
				</div>
			}
			<div class="grid gap-6 lg:grid-cols-12">
				<div class="min-w-0 space-y-6 lg:col-span-8">
					@weekCard(data)
					if data.Strength != nil || data.Cardio != nil {
						<div class="grid gap-6 md:grid-cols-2">
							if data.Strength != nil {
								@strengthCard(*data.Strength)
							}
							if data.Cardio != nil {
								@cardioCard(*data.Cardio)
							}
						</div>
					}
					@recentCard(data)
					@bodyCard(data)
					if data.Steps != nil {
						@stepsCard(*data.Steps, data.Location)
					}
					if data.VO2 != nil {
						@vo2Card(*data.VO2)
					}
				</div>
				<aside class="min-w-0 space-y-6 lg:col-span-4">
					@upNextCard(data)
					@nutritionCard(data)
					@stravaCard(data.StravaStatus)
					@exploreCard()
					@deviceCard(data)
				</aside>
			</div>
		</div>
		@ui.ChartScripts()
	}
}

// panel is the hub's card: one surface and padding for every section, so the
// page reads as a single instrument rather than a stack of differently padded
// boxes.
templ panel() {
	@card.Card(card.Props{Class: "border-hairline bg-surface gap-0 overflow-hidden py-0"}) {
		{ children... }
	}
}

templ panelHeading(label string) {
	<div class="flex items-center justify-between px-5 pt-5">
		@ui.MonoLabel(label)
		{ children... }
	</div>
}

templ weekCard(data HubData) {
	@panel() {
		@panelHeading(i18n.T(ctx, "fitness.week.label"))
		<div class="grid grid-cols-3 gap-2 px-5 pt-4 text-center">
			@weekStat(fmt.Sprintf("%.0f", data.Week.Minutes), i18n.T(ctx, "fitness.week.active"), i18n.Tf(ctx, "fitness.week.perday", data.Week.avgMinutesPerDay()))
			@weekStat(compact(ctx, data.Week.Calories), i18n.T(ctx, "fitness.week.burned"), "")
			@weekStat(oneDecimal(ctx, data.Week.DistanceKm), "km", sessionsLabel(ctx, data.Week.Sessions))
		</div>
		// Hand-rolled rather than chart.Chart: seven proportional bars with no
		// axes and a marker on today is a few divs, and a canvas would add a
		// script and a blank frame on load for no extra information.
		<div class="px-5 pt-6 pb-5" role="img" aria-label={ i18n.Tf(ctx, "fitness.week.aria", fmt.Sprintf("%.0f", data.Week.Minutes)) }>
			<div class="flex h-24 items-end gap-2">
				for _, b := range data.Week.Bars {
					<div class="flex h-full flex-1 items-end" title={ i18n.Tf(ctx, "fitness.week.bar", barLabel(ctx, b.Label), fmt.Sprintf("%.0f", b.Minutes)) }>
						<div
							class={ "w-full rounded-md transition-colors", templ.KV("bg-signal", b.Minutes > 0), templ.KV("bg-muted", b.Minutes <= 0) }
							style={ "height: " + data.Week.barHeight(b) }
						></div>
					</div>
				}
			</div>
			<div class="mt-2 flex gap-2">
				for _, b := range data.Week.Bars {
					<div class="flex flex-1 flex-col items-center gap-1">
						<span class={ "text-[11px]", templ.KV("text-foreground font-semibold", b.IsToday), templ.KV("text-muted-foreground", !b.IsToday) }>{ barLabel(ctx, b.Label) }</span>
						<span class={ "size-1 rounded-full", templ.KV("bg-signal", b.IsToday) }></span>
					</div>
				}
			</div>
		</div>
		<a href={ templ.SafeURL(data.activitiesHref()) } class="border-hairline text-muted-foreground hover:text-foreground flex items-center justify-between border-t px-5 py-3 text-xs transition-colors">
			<span>{ weekSource(ctx, data) }</span>
			@icon.ChevronRight(icon.Props{Class: "size-4"})
		</a>
	}
}

templ weekStat(value, unit, sub string) {
	<div>
		<p class="text-3xl font-semibold tracking-tight tabular-nums">{ value }</p>
		<p class="text-muted-foreground mt-0.5 text-xs">{ unit }</p>
		if sub != "" {
			<p class="text-muted-foreground/80 text-[11px]">{ sub }</p>
		}
	</div>
}

func sessionsLabel(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "fitness.sessions.one")
	}
	return i18n.Tf(ctx, "fitness.sessions.n", n)
}

// weekSource says where the week's numbers came from, so an empty strip reads
// as "nothing is feeding this" rather than "you did nothing".
func weekSource(ctx context.Context, data HubData) string {
	s := data.StravaStatus
	switch {
	case s.Connected && s.LastSyncedAt != nil:
		return i18n.Tf(ctx, "fitness.source.synced", ago(ctx, *s.LastSyncedAt, data.Now))
	case s.Connected:
		return i18n.T(ctx, "fitness.source.waiting")
	case data.Week.hasActivity():
		return i18n.T(ctx, "fitness.source.tracked")
	default:
		return i18n.T(ctx, "fitness.source.none")
	}
}

templ recentCard(data HubData) {
	@panel() {
		@panelHeading(i18n.T(ctx, "fitness.recent.label")) {
			if len(data.Recent) > 0 {
				<a href={ templ.SafeURL(data.activitiesHref()) } class="text-muted-foreground hover:text-foreground text-xs">{ i18n.T(ctx, "fitness.recent.all") }</a>
			}
		}
		if len(data.Recent) == 0 {
			@ui.Empty(ui.EmptyProps{Title: i18n.T(ctx, "fitness.recent.empty.title"), Body: i18n.T(ctx, "fitness.recent.empty.body"), Class: "py-8"}) {
				@button.Button(button.Props{Href: "/app/activity", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "fitness.recent.start") }
				}
			}
		} else {
			<ul class="divide-hairline mt-2 divide-y">
				for _, r := range data.Recent {
					@recentItem(r, data.Location)
				}
			</ul>
		}
	}
}

templ recentItem(r RecentRow, loc *time.Location) {
	<li class="flex items-center gap-3 px-5 py-3.5">
		<span class="bg-muted text-muted-foreground flex size-9 shrink-0 items-center justify-center rounded-full">
			@icon.Icon(recentIcon(r))(icon.Props{Class: "size-4"})
		</span>
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">{ recentTitle(ctx, r) }</p>
			<p class="text-muted-foreground truncate text-xs tabular-nums">{ strings.Join(recentDetail(ctx, r), " · ") }</p>
		</div>
		<time class="text-muted-foreground shrink-0 text-xs tabular-nums" datetime={ r.EndedAt.Format(time.RFC3339) }>
			{ when(ctx, r.EndedAt, loc) }
		</time>
	</li>
}

templ bodyCard(data HubData) {
	@panel() {
		<div class="flex items-start justify-between gap-4 p-5">
			<div>
				@ui.MonoLabel(i18n.T(ctx, "fitness.weight.label"))
				if data.Weight != nil {
					<p class="mt-2 text-2xl font-semibold tracking-tight tabular-nums">
						{ oneDecimal(ctx, data.Weight.Kg) }
						<span class="text-muted-foreground text-sm font-normal">kg</span>
					</p>
					<p class="text-muted-foreground mt-0.5 text-xs">
						if data.Weight.HasDelta {
							{ i18n.Tf(ctx, "fitness.weight.since", signed(ctx, data.Weight.DeltaKg, 1)) }
						}
						{ i18n.Date(ctx, data.Weight.At.In(data.Location), "2 Jan") }
					</p>
				} else {
					<p class="text-muted-foreground mt-2 text-sm">{ i18n.T(ctx, "fitness.weight.none") }</p>
				}
			</div>
			<a href="/app/calculator" class="text-signal shrink-0 text-xs hover:underline">{ i18n.T(ctx, "fitness.weight.log") }</a>
		</div>
	}
}

templ stepsCard(t Trend, loc *time.Location) {
	@panel() {
		{{ latest, _ := t.latest() }}
		@panelHeading(i18n.T(ctx, "fitness.steps.label"))
		<div class="flex items-end justify-between gap-4 px-5 pt-3">
			<p class="text-3xl font-semibold tracking-tight tabular-nums">
				{ compact(ctx, latest.Value) }
				<span class="text-muted-foreground text-sm font-normal">{ i18n.T(ctx, "fitness.steps.unit") }</span>
			</p>
			<div class="text-muted-foreground text-right text-xs tabular-nums">
				<p>{ i18n.Tf(ctx, "fitness.week.perday", compact(ctx, t.perDay())) }</p>
				<p>{ i18n.Date(ctx, latest.Day, "2 Jan") }</p>
			</div>
		</div>
		<div class="px-3 pt-3">
			@chart.Chart(t.Chart)
		</div>
		@trendAxis(i18n.Date(ctx, t.first().Day, "2 Jan"), i18n.Tf(ctx, "fitness.steps.days", len(t.Days)), i18n.Date(ctx, t.last().Day, "2 Jan"))
		<ul class="border-hairline divide-hairline mx-5 mb-5 divide-y overflow-hidden rounded-lg border">
			for _, row := range t.recentRows(5) {
				<li class="flex items-center justify-between px-3 py-2.5">
					<div>
						<p class="text-sm font-medium tabular-nums">{ i18n.Tf(ctx, "fitness.steps.row", compact(ctx, row.Value)) }</p>
						<p class="text-muted-foreground text-[11px]">{ i18n.Date(ctx, row.Day, "2 Jan") }</p>
					</div>
					if row.HasDelta {
						<span class={ "text-xs tabular-nums", deltaClass(row.Delta) }>{ signed(ctx, row.Delta, 0) }</span>
					}
				</li>
			}
		</ul>
	}
}

templ vo2Card(t Trend) {
	@panel() {
		{{ latest, _ := t.latest() }}
		@panelHeading(i18n.T(ctx, "fitness.vo2.label"))
		<div class="flex items-end justify-between gap-4 px-5 pt-3">
			<p class="text-3xl font-semibold tracking-tight tabular-nums">
				{ oneDecimal(ctx, latest.Value) }
				<span class="text-muted-foreground text-sm font-normal">ml/kg/min</span>
			</p>
			<div class="text-right text-xs tabular-nums">
				<p class="text-ember">{ vo2Band(ctx, latest.Value) }</p>
				<p class="text-muted-foreground">{ i18n.Date(ctx, latest.Day, "2 Jan") }</p>
			</div>
		</div>
		<div class="px-3 pt-3">
			@chart.Chart(t.Chart)
		</div>
		<div class="pb-4">
			@trendAxis(i18n.Date(ctx, t.first().Day, "2 Jan"), i18n.Tf(ctx, "fitness.vo2.readings", len(t.Days)), i18n.Date(ctx, t.last().Day, "2 Jan"))
		</div>
	}
}

templ trendAxis(left, middle, right string) {
	<div class="text-muted-foreground flex justify-between px-5 pt-1 pb-3 text-[11px] tabular-nums">
		<span>{ left }</span>
		<span>{ middle }</span>
		<span>{ right }</span>
	</div>
}

templ upNextCard(data HubData) {
	@panel() {
		<div class="p-5">
			@ui.MonoLabel(i18n.T(ctx, "fitness.next.label"))
			if d := data.Instruments.DoneToday; d != nil {
				@doneTodayLine(*d)
			}
			if s := data.Instruments.NextSession; s != nil {
				<p class="mt-2 text-lg font-semibold tracking-tight">
					{ capitalize(weekdayName(ctx, s.Weekday)) }
					if s.StartTime != "" {
						<span class="text-muted-foreground text-sm font-normal">{ i18n.Tf(ctx, "fitness.next.at", s.StartTime) }</span>
					}
				</p>
				if s.Focus != "" {
					<p class="text-muted-foreground text-sm">{ s.Focus }</p>
				}
				<p class="text-muted-foreground mt-1 text-xs">{ exerciseCount(ctx, len(s.Exercises)) }</p>
				<div class="mt-4">
					@button.Button(button.Props{Href: trainingHref(data), Size: button.SizeSm, FullWidth: true, Class: "bg-signal text-background hover:bg-signal/90"}) {
						@icon.Dumbbell(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "fitness.next.open") }
					}
				</div>
			} else if data.HasPlan() {
				<p class="mt-2 text-sm">{ i18n.T(ctx, "fitness.next.noneleft") }</p>
				<div class="mt-4">
					@button.Button(button.Props{Href: trainingHref(data), Variant: button.VariantOutline, Size: button.SizeSm, FullWidth: true}) {
						{ i18n.T(ctx, "fitness.next.openplan") }
					}
				</div>
			} else {
				<p class="mt-2 text-sm">{ i18n.T(ctx, "fitness.next.noplan") }</p>
				<p class="text-muted-foreground text-xs">{ i18n.T(ctx, "fitness.next.generate") }</p>
				<div class="mt-4">
					@button.Button(button.Props{Href: "/app/training/new", Variant: button.VariantOutline, Size: button.SizeSm, FullWidth: true}) {
						{ i18n.T(ctx, "fitness.next.build") }
					}
				</div>
			}
		</div>
	}
}

// doneTodayLine names the plan day already finished today, so "Up next"
// pointing at Friday does not read as if today's session were skipped.
templ doneTodayLine(d plan.PlanDay) {
	<p class="text-muted-foreground mt-2 flex items-center gap-1.5 text-xs">
		@icon.CircleCheck(icon.Props{Class: "text-signal size-3.5"})
		{ CompletedLineIn(ctx, d) }
	</p>
}

// CompletedLineIn reads "Wednesday completed — Push" in the request's language.
func CompletedLineIn(ctx context.Context, d plan.PlanDay) string {
	day := weekdayName(ctx, d.Weekday)
	if d.Focus == "" {
		return i18n.Tf(ctx, "fitness.next.done", day)
	}
	return i18n.Tf(ctx, "fitness.next.donefocus", day, d.Focus)
}

func exerciseCount(ctx context.Context, n int) string {
	if n == 1 {
		return i18n.T(ctx, "fitness.exercises.one")
	}
	return i18n.Tf(ctx, "fitness.exercises.n", n)
}

func trainingHref(data HubData) string {
	if data.HasPlan() {
		return "/app/training/" + data.Instruments.PlanID.String()
	}
	return "/app/training"
}

templ nutritionCard(data HubData) {
	@panel() {
		<div class="p-5">
			<div class="flex items-center justify-between">
				@ui.MonoLabel(i18n.T(ctx, "fitness.food.label"))
				<a href="/app/nutrition/log" class="text-signal text-xs hover:underline">{ i18n.T(ctx, "fitness.hub.logfood") }</a>
			</div>
			if p := data.Instruments.MealProgress; data.Instruments.HasMealProgress && p != nil {
				<p class="mt-2 text-2xl font-semibold tracking-tight tabular-nums">
					{ fmt.Sprintf("%.0f", p.Logged.Calories) }
					<span class="text-muted-foreground text-sm font-normal">/ { fmt.Sprintf("%.0f", p.Goal.Calories) } kcal</span>
				</p>
				<div class="mt-3">
					@progress.Progress(progress.Props{Max: 100, Value: percentOf(p.Logged.Calories, p.Goal.Calories), Size: progress.SizeSm, Label: i18n.T(ctx, "fitness.food.progress")})
				</div>
				<div class="mt-4 grid grid-cols-3 gap-2 text-center">
					@macroStat(i18n.T(ctx, "day.food.protein"), p.Logged.ProteinG, p.Goal.ProteinG)
					@macroStat(i18n.T(ctx, "day.food.carb"), p.Logged.CarbG, p.Goal.CarbG)
					@macroStat(i18n.T(ctx, "day.food.fat"), p.Logged.FatG, p.Goal.FatG)
				</div>
			} else {
				<p class="text-muted-foreground mt-2 text-sm">
					{ i18n.T(ctx, "fitness.food.nogoal1") }
					<a href="/app/calculator" class="text-foreground underline underline-offset-2">{ i18n.T(ctx, "fitness.food.nogoal2") }</a>
					{ i18n.T(ctx, "fitness.food.nogoal3") }
				</p>
			}
		</div>
	}
}

templ macroStat(label string, logged, goal float64) {
	<div class="bg-muted/50 rounded-md px-2 py-2">
		<p class="text-sm font-medium tabular-nums">{ fmt.Sprintf("%.0f", logged) }<span class="text-muted-foreground text-[11px]">/{ fmt.Sprintf("%.0fg", goal) }</span></p>
		<p class="text-muted-foreground text-[11px]">{ label }</p>
	</div>
}

func percentOf(v, of float64) int {
	if of <= 0 {
		return 0
	}
	pct := int(v / of * 100)
	return min(max(pct, 0), 100)
}

templ exploreCard() {
	@panel() {
		@panelHeading(i18n.T(ctx, "fitness.explore.label"))
		<ul class="mt-2 pb-2">
			for _, t := range tiles() {
				<li>
					<a href={ templ.SafeURL(t.Href) } class="hover:bg-muted/50 flex items-center gap-3 px-5 py-2.5 transition-colors">
						<span class="text-muted-foreground flex size-8 shrink-0 items-center justify-center">
							@icon.Icon(t.Icon)(icon.Props{Class: "size-4"})
						</span>
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-medium">{ t.LabelIn(ctx) }</p>
							<p class="text-muted-foreground truncate text-xs">{ t.DescriptionIn(ctx) }</p>
						</div>
						@icon.ChevronRight(icon.Props{Class: "text-muted-foreground size-4 shrink-0"})
					</a>
				</li>
			}
		</ul>
	}
}

// stravaCard is the whole surface of the integration: connect, sync,
// disconnect, and when it last ran. Nothing about tokens reaches here — the
// handler is given a Status, which cannot carry them.
templ stravaCard(status strava.Status) {
	@panel() {
		<div class="p-5">
			@ui.MonoLabel("Strava")
			<p class="mt-2 text-sm">
				if !status.Configured {
					{ i18n.T(ctx, "fitness.strava.unconfigured") }
				} else if status.Unavailable {
					{ i18n.T(ctx, "fitness.strava.unreadable") }
				} else if status.Connected {
					{ i18n.T(ctx, "fitness.strava.connected") }
					if status.SyncPending {
						{ i18n.T(ctx, "fitness.strava.queued") }
					} else if status.LastSyncedAt != nil {
						{ i18n.Tf(ctx, "fitness.strava.lastsynced", i18n.Date(ctx, *status.LastSyncedAt, "2 Jan, 15:04")) }
					} else if status.LastSyncAttemptedAt != nil {
						{ i18n.T(ctx, "fitness.strava.noimports") }
					} else {
						{ i18n.T(ctx, "fitness.strava.nosync") }
					}
				} else {
					{ i18n.T(ctx, "fitness.strava.pitch") }
				}
			</p>
			<div class="mt-4">
				if !status.Configured {
					<p class="text-muted-foreground text-xs leading-relaxed">
						{ i18n.T(ctx, "fitness.strava.envhint") }
					</p>
				} else if status.Unavailable {
					// Deliberately offers no Connect button. The connection may
					// well exist and be fine; reconnecting to fix a read error
					// would replace a working credential for no reason.
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							{ i18n.T(ctx, "fitness.strava.unavail.title") }
						}
						@alert.Description() {
							{ i18n.T(ctx, "fitness.strava.unavail.body") }
						}
					}
				} else if status.Connected {
					if status.LastSyncError != "" {
						@stravaSyncError(status)
					}
					if status.SyncPending && status.LastSyncedAt == nil {
						<p class="text-muted-foreground mb-4 text-xs leading-relaxed">
							{ i18n.T(ctx, "fitness.strava.pending") } <code>task worker</code>.
						</p>
					}
					<div class="flex flex-wrap gap-2">
						@button.Button(button.Props{Href: "/app/fitness/activities", Class: "bg-signal text-background hover:bg-signal/90"}) {
							{ i18n.T(ctx, "fitness.strava.view3d") }
						}
						<form method="post" action="/app/fitness/strava/sync">
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
								{ i18n.T(ctx, "fitness.strava.sync") }
							}
						</form>
						<form method="post" action="/app/fitness/strava/disconnect">
							@ui.CSRFInput()
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
								{ i18n.T(ctx, "fitness.strava.disconnect") }
							}
						</form>
					</div>
				} else {
					@button.Button(button.Props{Href: "/app/fitness/strava/connect", Class: "bg-signal text-background hover:bg-signal/90"}) {
						{ i18n.T(ctx, "fitness.strava.connect") }
					}
				}
			</div>
		</div>
	}
}

// stravaSyncError reports why the last import did not happen.
//
// The message is a wrapped Go error, never a Strava response body: the client
// discards those and keeps the status code, so nothing token-shaped can reach
// this template.
templ stravaSyncError(status strava.Status) {
	<div class="mb-4">
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
			@alert.Title() {
				{ i18n.T(ctx, "fitness.strava.failed") }
			}
			@alert.Description() {
				<span class="block">{ status.LastSyncError }</span>
				if status.LastSyncAttemptedAt != nil {
					<span class="block text-xs opacity-80">
						{ i18n.Tf(ctx, "fitness.strava.tried", i18n.Date(ctx, *status.LastSyncAttemptedAt, "2 Jan, 15:04")) }
					</span>
				}
			}
		}
	</div>
}

// deviceCard shows what a wearable or phone has pushed in the last week.
//
// It renders even when empty, because the useful answer for most people is
// "nothing is connected yet, and here is how to change that" — a card that
// disappeared would leave no route to setting one up.
templ deviceCard(data HubData) {
	@panel() {
		<div class="p-5">
			@ui.MonoLabel(i18n.T(ctx, "fitness.device.label"))
			<p class="mt-2 text-sm">
				if data.HasDeviceReadings {
					{ i18n.T(ctx, "fitness.device.some") }
				} else {
					{ i18n.T(ctx, "fitness.device.none") }
				}
			</p>
			<div class="mt-3">
				if data.HasDeviceReadings {
					<ul class="space-y-1.5">
						for _, line := range data.DeviceReadings {
							<li class="text-muted-foreground text-xs leading-relaxed">{ line }</li>
						}
					</ul>
				} else {
					<p class="text-muted-foreground text-xs leading-relaxed">
						{ i18n.T(ctx, "fitness.device.howto") }
						<code class="bg-muted rounded px-1 py-0.5">/ingest/health/apple_health</code>.
					</p>
				}
			</div>
		</div>
	}
}

// StrengthView is the month's lifting, from logged sets.
type StrengthView struct {
	Workouts  int
	Sets      int
	VolumeKg  float64
	Exercises []StrengthRow
	Record    *StrengthRecord
}

type StrengthRow struct {
	Name     string
	BestKg   float64
	E1RMKg   float64
	ChangeKg float64
}

type StrengthRecord struct {
	Exercise string
	WeightKg float64
	Reps     int
	E1RMKg   float64
	On       time.Time
}

// CardioView is the month's runs, rides and walks.
type CardioView struct {
	Sessions        int
	Minutes         int
	DistanceKm      float64
	Runs            int
	BestPaceSeconds float64
	Best5KSeconds   float64
	LongestKm       float64
	RestingHR       float64
}

func kg(ctx context.Context, v float64) string {
	if v == float64(int64(v)) {
		return fmt.Sprintf("%.0f kg", v)
	}
	return i18n.Decimal(ctx, v, 1) + " kg"
}

func paceLabel(seconds float64) string {
	s := int(seconds + 0.5)
	return fmt.Sprintf("%d:%02d /km", s/60, s%60)
}

func clockLabel(seconds float64) string {
	s := int(seconds + 0.5)
	if s >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", s/3600, s%3600/60, s%60)
	}
	return fmt.Sprintf("%d:%02d", s/60, s%60)
}

templ strengthCard(v StrengthView) {
	@panel() {
		@panelHeading(i18n.T(ctx, "fitness.strength.label")) {
			<a href="/app/insights/training" class="text-signal text-xs hover:underline">{ i18n.T(ctx, "fitness.strength.all") }</a>
		}
		<div class="space-y-4 px-5 pt-3 pb-5" data-testid="fitness-strength">
			<div class="grid grid-cols-3 gap-3">
				@miniStat(fmt.Sprintf("%d", v.Workouts), "", i18n.T(ctx, "fitness.strength.workouts"))
				@miniStat(fmt.Sprintf("%d", v.Sets), "", i18n.T(ctx, "fitness.strength.sets"))
				@miniStat(i18n.Decimal(ctx, v.VolumeKg/1000, 1), "t", i18n.T(ctx, "fitness.strength.volume"))
			</div>
			<ul class="divide-border divide-y text-sm">
				for _, e := range v.Exercises {
					<li class="py-2">
						<div class="flex items-baseline justify-between gap-3">
							<span class="truncate font-medium">{ e.Name }</span>
							if e.ChangeKg > 0 {
								<span class="text-signal shrink-0 text-xs tabular-nums">+{ kg(ctx, e.ChangeKg) }</span>
							}
						</div>
						<p class="text-muted-foreground text-xs tabular-nums">{ i18n.Tf(ctx, "fitness.strength.best", kg(ctx, e.BestKg), kg(ctx, e.E1RMKg)) }</p>
					</li>
				}
			</ul>
			if v.Record != nil {
				<div class="bg-signal/10 rounded-lg px-3 py-2 text-xs">
					<span class="text-signal font-semibold">{ i18n.T(ctx, "fitness.strength.record") }</span>
					· { v.Record.Exercise } { kg(ctx, v.Record.WeightKg) } × { fmt.Sprintf("%d", v.Record.Reps) }
					<span class="text-muted-foreground">{ i18n.Tf(ctx, "fitness.strength.est", kg(ctx, v.Record.E1RMKg), i18n.Date(ctx, v.Record.On, "2 Jan")) }</span>
				</div>
			}
		</div>
	}
}

templ cardioCard(v CardioView) {
	@panel() {
		@panelHeading(i18n.T(ctx, "fitness.cardio.label")) {
			<a href="/app/insights/cardio" class="text-signal text-xs hover:underline">{ i18n.T(ctx, "fitness.cardio.all") }</a>
		}
		<div class="space-y-4 px-5 pt-3 pb-5" data-testid="fitness-cardio">
			<div class="grid grid-cols-3 gap-3">
				@miniStat(fmt.Sprintf("%d", v.Sessions), "", i18n.T(ctx, "fitness.cardio.sessions"))
				if v.DistanceKm > 0 {
					@miniStat(i18n.Decimal(ctx, v.DistanceKm, 1), "km", i18n.T(ctx, "fitness.cardio.distance"))
				} else {
					@miniStat(fmt.Sprintf("%d", v.Runs), "", i18n.T(ctx, "fitness.cardio.runs"))
				}
				@miniStat(durfmt.HoursMinutes(v.Minutes), "", i18n.T(ctx, "fitness.cardio.moving"))
			</div>
			<dl class="divide-border divide-y text-sm">
				if v.Runs > 0 {
					if v.LongestKm > 0 {
						<div class="flex justify-between py-2"><dt class="text-muted-foreground">{ i18n.T(ctx, "fitness.cardio.longest") }</dt><dd class="tabular-nums">{ i18n.Decimal(ctx, v.LongestKm, 1) + " km" }</dd></div>
					}
				}
				if v.BestPaceSeconds > 0 {
					<div class="flex justify-between py-2"><dt class="text-muted-foreground">{ i18n.T(ctx, "fitness.cardio.pace") }</dt><dd class="tabular-nums">{ paceLabel(v.BestPaceSeconds) }</dd></div>
				}
				if v.Best5KSeconds > 0 {
					<div class="flex justify-between py-2"><dt class="text-muted-foreground">{ i18n.T(ctx, "fitness.cardio.best5k") }</dt><dd class="tabular-nums">{ clockLabel(v.Best5KSeconds) }</dd></div>
				}
				if v.RestingHR > 0 {
					<div class="flex justify-between py-2"><dt class="text-muted-foreground">{ i18n.T(ctx, "fitness.cardio.resthr") }</dt><dd class="tabular-nums">{ fmt.Sprintf("%.0f bpm", v.RestingHR) }</dd></div>
				}
			</dl>
		</div>
	}
}

templ miniStat(value, unit, label string) {
	<div>
		<p class="text-xl font-semibold tracking-tight tabular-nums">
			{ value }
			if unit != "" {
				<span class="text-muted-foreground text-xs font-normal">{ unit }</span>
			}
		</p>
		<p class="text-muted-foreground text-[11px]">{ label }</p>
	</div>
}
