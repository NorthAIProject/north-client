package fitness

import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/NorthAIProject/north-client/internal/fitness/strava"
	"github.com/NorthAIProject/north-client/internal/shared/i18n"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/pagination"
)

// ActivitiesPage draws the record, with the calendar terrain above it.
//
// The scene used to be the page: a 68vh hero that pushed the weeks below the
// fold, which made a page about someone's training history open on no history
// at all. It is a banner now. The list is the content, the terrain is the
// shape of it, and both are on screen at once.
templ ActivitiesPage(user users.User, status strava.Status, trend strava.Trend, sessions strava.SessionPage) {
	@layout.App(i18n.T(ctx, "nav.strava-activities"), user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-5xl space-y-6 p-6 md:p-8">
			<header class="flex flex-wrap items-start justify-between gap-4">
				<div>
					@ui.MonoLabel("Strava")
					<h1 class="mt-2 text-2xl font-medium tracking-tight">{ i18n.T(ctx, "fitness.act.h1") }</h1>
				</div>
				@button.Button(button.Props{Href: "/app/fitness", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "fitness.act.back") }
				}
			</header>
			switch trendState(status, trend) {
				case stateUnconfigured:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   i18n.T(ctx, "fitness.act.unconfigured.title"),
						Body:    i18n.T(ctx, "fitness.act.unconfigured.body"),
					})
				case stateDisconnected:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   i18n.T(ctx, "fitness.act.disconnected.title"),
						Body:    i18n.T(ctx, "fitness.act.disconnected.body"),
					}) {
						@button.Button(button.Props{Href: "/app/fitness/strava/connect", Class: "bg-signal text-background hover:bg-signal/90"}) {
							{ i18n.T(ctx, "fitness.strava.connect") }
						}
					}
				case stateUnavailable:
					// This state existed in the handler and nowhere else: it
					// set Unavailable and the template rendered "nothing
					// imported yet", which told someone their history was
					// empty when in fact it could not be read.
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   i18n.T(ctx, "fitness.act.unavail.title"),
						Body:    i18n.T(ctx, "fitness.act.unavail.body"),
					}) {
						@button.Button(button.Props{Href: "/app/fitness/activities", Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "fitness.act.retry") }
						}
					}
				case stateEmpty:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   i18n.T(ctx, "fitness.act.empty.title"),
						Body:    i18n.T(ctx, "fitness.act.empty.body"),
					}) {
						@button.Button(button.Props{Href: "/app/fitness", Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "fitness.act.goto") }
						}
					}
				default:
					@kpis(trend)
					@verdict(trend)
					@trendChart(trend)
					@ActivitySessions(sessions, user.Location())
			}
		</div>
		@ui.ChartScripts()
	}
}

// kpis is the window in numbers.
//
// "Load this week" used to head this strip, in MET-minutes. It was the same
// arithmetic the old 3D scene was built on, and the same problem: a unit
// nobody has a feel for, standing where the most-read number on the page goes.
// Time is what somebody actually spent.
templ kpis(trend strava.Trend) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{Label: i18n.T(ctx, "fitness.week.label"), Value: humanMinutes(trend.RecentMinutes)})
		@ui.KpiCell(ui.KpiCellProps{Label: i18n.T(ctx, "fitness.act.kpi.sessions"), Value: fmt.Sprintf("%d", trend.Sessions)})
		@ui.KpiCell(ui.KpiCellProps{Label: i18n.T(ctx, "fitness.act.kpi.distance"), Value: fmt.Sprintf("%.0f km", totalDistanceKm(trend))})
		@ui.KpiCell(ui.KpiCellProps{Label: i18n.T(ctx, "fitness.act.kpi.climb"), Value: fmt.Sprintf("%.0f m", trend.ElevationM)})
		@ui.KpiCell(ui.KpiCellProps{
			Label: i18n.T(ctx, "fitness.act.kpi.active"),
			Value: i18n.Tf(ctx, "fitness.act.kpi.activeof", trend.ActiveDays, trend.CountedDays),
			Href:  "/app/fitness",
			CTA:   i18n.T(ctx, "fitness.act.kpi.sync"),
		})
	}
}

// verdict is the sentence that makes the chart mean something.
//
// The chart shows the shape; this says what the shape amounts to. Without it
// the page is a record again — which was the whole complaint about the thing
// this replaced.
templ verdict(trend strava.Trend) {
	<div class="space-y-1">
		<p class="text-base leading-relaxed">{ trendSentence(ctx, trend) }</p>
		if line := streakSentence(ctx, trend); line != "" {
			@ui.MonoLabel(line)
		}
	</div>
}

// trendChart is the training chart: a stacked bar per day, coloured by sport,
// with a dashed line for what a normal day holds.
//
// It replaced a WebGL landscape whose vertical axis was MET-minutes. Bars and a
// line, in minutes, because the question being asked of this page is "am I
// keeping it up", and that question is answered by putting what you did this
// week next to what you usually do — not by rendering it in three dimensions.
templ trendChart(trend strava.Trend) {
	if option, err := trendChartOption(ctx, trend); err == nil {
		@templ.JSONScript("activity-trend-option", json.RawMessage(option))
		@ui.EChartsMount("activity-trend", "activity-trend-option", "h-72 w-full sm:h-80")
	}
}

// ActivitySessions is the record: a flat, numbered list of what somebody did,
// newest first, ten to a page.
//
// It replaced a week-grouped strip that paged by week cursor. A cursor is the
// right shape for the terrain, which extends ground behind what is already
// drawn, and the wrong shape for a list somebody reads: "page 7 of 31" cannot
// be built from one, and the week a session fell in is not how anyone looks
// for it.
//
// The id is the swap target. Turning a page replaces this element and nothing
// else, so the WebGL scene above it keeps its context and its resident weeks.
templ ActivitySessions(page strava.SessionPage, loc *time.Location) {
	<div id="activity-sessions" class="mt-6">
		if len(page.Sessions) == 0 {
			@ui.MonoLabel(i18n.T(ctx, "fitness.act.nothing"))
		} else {
			<ul class="divide-border divide-y">
				for _, session := range page.Sessions {
					@sessionRow(session, loc)
				}
			</ul>
			@sessionsFooter(page)
		}
	</div>
}

// sessionRow is one activity: when it was, what it was, and its numbers.
//
// A session used to be decoration inside a day-sized button, with no way to
// reach one and no way to open it where the rest of its detail lives. The name
// is the link to Strava; selecting the day on the terrain is its own control,
// so the two do not fight over the same click.
templ sessionRow(session strava.Session, loc *time.Location) {
	<li
		class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2.5"
		if day := routeDayKey(session, loc); day != "" {
			data-day={ day }
			x-bind:class={ fmt.Sprintf("isSelected(%q) ? 'bg-signal/5' : ''", day) }
		}
	>
		<span class="text-muted-foreground w-28 shrink-0 font-mono text-[11px]">
			{ routeWhen(ctx, session, loc) }
		</span>
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px]"}) {
			{ session.Sport }
		}
		if url := stravaActivityURL(session); url != "" {
			<a
				href={ templ.SafeURL(url) }
				target="_blank"
				rel="noopener noreferrer"
				class="min-w-0 flex-1 truncate text-sm hover:underline"
			>{ session.Name }</a>
		} else {
			<span class="min-w-0 flex-1 truncate text-sm">{ session.Name }</span>
		}
		<span class="text-muted-foreground font-mono text-[11px]">
			{ routeSummary(ctx, session) }
		</span>
		if day := routeDayKey(session, loc); day != "" {
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "h-6 shrink-0 px-2 font-mono text-[10px] uppercase tracking-[0.14em]",
				Attributes: templ.Attributes{
					"x-on:click":          fmt.Sprintf("pick(%q)", day),
					"x-bind:aria-pressed": fmt.Sprintf("isSelected(%q)", day),
				},
			}) {
				{ i18n.T(ctx, "fitness.act.show") }
			}
		}
	</li>
}

// sessionsFooter is where the reader is, and how to get elsewhere.
templ sessionsFooter(page strava.SessionPage) {
	<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
		@ui.MonoLabel(i18n.Tf(ctx, "fitness.act.range", page.First(), page.Last(), page.Total))
		if page.TotalPages > 1 {
			@sessionsPager(page)
		}
	</div>
}

// sessionsPager is the numbered pager.
//
// Every control carries both an href and an hx-get: the href is a real page,
// bookmarkable and usable with no JavaScript, and the hx-get swaps only the
// list so the terrain above keeps its WebGL context and its resident weeks.
// hx-push-url is given the document URL rather than the fragment's, or the
// address bar would end up pointing at a bare list.
templ sessionsPager(page strava.SessionPage) {
	@pagination.Pagination() {
		@pagination.Content() {
			@pagination.Item() {
				@pagination.Previous(pagination.PreviousProps{
					Href:       sessionsPageURL(page.Page - 1),
					Disabled:   !page.HasPrevious(),
					Label:      i18n.T(ctx, "fitness.act.newer"),
					Attributes: pagerSwap(page.Page - 1),
				})
			}
			for _, n := range sessionPageNumbers(page) {
				@pagination.Item() {
					if n == ellipsis {
						@pagination.Ellipsis()
					} else {
						@pagination.Link(pagination.LinkProps{
							Href:       sessionsPageURL(n),
							IsActive:   n == page.Page,
							Attributes: pagerSwap(n),
						}) {
							{ fmt.Sprintf("%d", n) }
						}
					}
				}
			}
			@pagination.Item() {
				@pagination.Next(pagination.NextProps{
					Href:       sessionsPageURL(page.Page + 1),
					Disabled:   !page.HasNext(),
					Label:      i18n.T(ctx, "fitness.act.older"),
					Attributes: pagerSwap(page.Page + 1),
				})
			}
		}
	}
}

// pagerSwap is the HTMX half of a pager control.
func pagerSwap(page int) templ.Attributes {
	return templ.Attributes{
		"hx-get":      sessionsFragmentURL(page),
		"hx-target":   "#activity-sessions",
		"hx-swap":     "outerHTML",
		"hx-push-url": sessionsPageURL(page),
	}
}
