package fitness

import (
	"fmt"
	"time"

	"github.com/NorthAIProject/north-client/internal/fitness/strava"
	"github.com/NorthAIProject/north-client/internal/users"
	"github.com/NorthAIProject/north-client/web/shared/layout"
	"github.com/NorthAIProject/north-client/web/shared/ui"
	"github.com/NorthAIProject/north-client/web/shared/ui/badge"
	"github.com/NorthAIProject/north-client/web/shared/ui/button"
	"github.com/NorthAIProject/north-client/web/shared/ui/separator"
	"github.com/NorthAIProject/north-client/web/shared/utils"
)

// ActivitiesPage draws the calendar terrain.
//
// The scene is the page now, not a square beside a list. It used to sit in an
// aspect-square box next to an equally wide column of rows, which gave the
// visualisation about a quarter of the available space and left the rest to a
// list that repeated everything it showed.
templ ActivitiesPage(user users.User, status strava.Status, page strava.TerrainPage) {
	@layout.App("Activities", user, layout.BuildNav(ctx, "/app/fitness")) {
		<div class="mx-auto w-full max-w-5xl space-y-6 p-6 md:p-8" x-data="northActivityTerrain">
			<header class="flex flex-wrap items-start justify-between gap-4">
				<div>
					@ui.MonoLabel("Strava")
					<h1 class="mt-2 text-2xl font-medium tracking-tight">Your training, as ground</h1>
					<p class="text-muted-foreground mt-1 max-w-xl text-sm leading-relaxed">
						Each column is a day, each row a week, and the height is the effort
						you put in — measured in MET-minutes, so a gym session and a run
						stand next to each other. Drag to travel back through the weeks.
					</p>
				</div>
				@button.Button(button.Props{Href: "/app/fitness", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Back to Fitness
				}
			</header>
			switch terrainState(status, page) {
				case stateUnconfigured:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   "Strava is not configured",
						Body:    "This server has no Strava credentials, so there is nothing to connect to yet.",
					})
				case stateDisconnected:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   "Not connected",
						Body:    "Connect Strava and your rides, runs and gym sessions will build the landscape below.",
					}) {
						@button.Button(button.Props{Href: "/app/fitness/strava/connect", Class: "bg-signal text-background hover:bg-signal/90"}) {
							Connect Strava
						}
					}
				case stateUnavailable:
					// This state existed in the handler and nowhere else: it
					// set Unavailable and the template rendered "nothing
					// imported yet", which told someone their history was
					// empty when in fact it could not be read.
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   "Your activities could not be read",
						Body:    "Something went wrong reading what has already been imported. Nothing has been lost — try again in a moment.",
					}) {
						@button.Button(button.Props{Href: "/app/fitness/activities", Variant: button.VariantOutline}) {
							Try again
						}
					}
				case stateEmpty:
					@ui.Empty(ui.EmptyProps{
						Eyebrow: "Strava",
						Title:   "Nothing imported yet",
						Body:    "Connected, but no activities have arrived. Run a sync from the Fitness page and the ground will fill in.",
					}) {
						@button.Button(button.Props{Href: "/app/fitness", Variant: button.VariantOutline}) {
							Go to Fitness
						}
					}
				default:
					@templ.JSONScript("activity-terrain-data", NewTerrainPayload(page))
					@kpis(page, user.Location())
					@hero()
					@legend()
					@ActivityStrip(page, user.Location())
			}
		</div>
		@activitiesBehaviour()
	}
}

// hero is the scene. Full-bleed: it breaks out of the reading column rather
// than sitting inside it, because the terrain is the page's content and a
// landscape needs width to read as one.
templ hero() {
	<div class="-mx-6 md:-mx-8">
		<div class="border-hairline bg-background/40 relative h-[min(68vh,720px)] min-h-[420px] overflow-hidden border-y">
			// Hand-rolled: a WebGL surface has no counterpart in the component
			// library. Everything it shows is also in the strip below, so it
			// is hidden from assistive technology rather than described twice.
			<canvas
				x-ref="canvas"
				aria-hidden="true"
				class="size-full cursor-grab touch-none active:cursor-grabbing"
			></canvas>
			// Axis labels, projected from world space by the scene.
			<div x-ref="labels" aria-hidden="true" class="pointer-events-none absolute inset-0"></div>
			// The day readout. Deliberately not ui.HoverCard: that anchors to
			// a DOM element, and a day here is an instanced mesh with no node
			// to anchor to. The scene hands back a projected screen position.
			<div
				x-show="hovered"
				x-cloak
				x-ref="tooltip"
				class="border-hairline bg-surface/95 pointer-events-none absolute z-10 max-w-xs rounded-md border p-3 backdrop-blur"
			>
				<p class="text-sm font-medium" x-text="hovered && hovered.label"></p>
				<p class="text-muted-foreground mt-0.5 font-mono text-[11px]" x-text="hovered && daySummary(hovered)"></p>
				<template x-if="hovered && hovered.mixed">
					<p class="text-muted-foreground mt-1 font-mono text-[10px] uppercase tracking-[0.14em]" x-text="mixSummary(hovered)"></p>
				</template>
			</div>
			<div
				x-show="!ready || failed"
				class="pointer-events-none absolute inset-0 flex items-center justify-center p-6 text-center"
			>
				<span
					class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]"
					x-text="failed ? 'The landscape needs WebGL — your weeks are listed below' : 'Building the landscape'"
				>Building the landscape</span>
			</div>
		</div>
	</div>
}

// kpis is the week in numbers, above the scene.
templ kpis(page strava.TerrainPage, loc *time.Location) {
	@ui.KpiStrip() {
		@ui.KpiCell(ui.KpiCellProps{Label: "Load this week", Value: fmt.Sprintf("%.0f MET-min", currentWeekLoad(page))})
		@ui.KpiCell(ui.KpiCellProps{Label: "Sessions", Value: fmt.Sprintf("%d", totalSessions(page))})
		@ui.KpiCell(ui.KpiCellProps{Label: "Distance", Value: fmt.Sprintf("%.0f km", totalDistanceKm(page))})
		@ui.KpiCell(ui.KpiCellProps{Label: "Climb", Value: fmt.Sprintf("%.0f m", totalClimbM(page))})
		@ui.KpiCell(ui.KpiCellProps{
			Label: "Active days",
			Value: fmt.Sprintf("%d of %d", activeDays(page), countedDays(page)),
			Href:  "/app/fitness",
			CTA:   "Sync",
		})
	}
}

// ActivityStrip is the accessible equivalent of the scene, and the thing that
// pages alongside it.
//
// Grouped by day rather than a flat list of sessions, because the scene now
// shows a per-day figure that a flat list could not reconstruct. A reader
// using it instead of the canvas should be able to rebuild the landscape from
// it: which days, how much load, what kind of work.
templ ActivityStrip(page strava.TerrainPage, loc *time.Location) {
	<div id="activity-strip">
		for _, week := range page.Weeks {
			if weekHasSessions(week) {
				@weekGroup(week)
			}
		}
		@stripTail(page)
	</div>
}

templ weekGroup(week strava.TerrainWeek) {
	<section class="mt-6">
		<div class="flex items-baseline justify-between gap-3">
			<h2 class="text-sm font-medium tracking-tight">
				{ fmt.Sprintf("Week of %s", week.Start.Format("2 January 2006")) }
			</h2>
			@ui.MonoLabel(fmt.Sprintf("%.0f MET-min", week.LoadMETMin))
		</div>
		@separator.Separator()
		<ul class="mt-3 space-y-3">
			for _, day := range week.Days {
				if day.Sessions > 0 {
					@dayRow(day)
				}
			}
		</ul>
	</section>
}

templ dayRow(day strava.TerrainDay) {
	<li>
		<button
			type="button"
			class="border-hairline hover:border-muted-foreground/40 w-full rounded-lg border px-3 py-2 text-left transition-colors"
			x-bind:class={ fmt.Sprintf("isSelected(%q) ? 'border-signal/60 bg-signal/5' : ''", day.Date.Format(time.DateOnly)) }
			x-bind:aria-pressed={ fmt.Sprintf("isSelected(%q)", day.Date.Format(time.DateOnly)) }
			x-on:click={ fmt.Sprintf("pick(%q)", day.Date.Format(time.DateOnly)) }
		>
			<div class="flex items-baseline justify-between gap-2">
				<h3 class="text-sm font-medium">{ day.Date.Format("Mon 2 Jan") }</h3>
				<span class="text-muted-foreground shrink-0 font-mono text-[10px]">
					{ fmt.Sprintf("%.0f MET-min", day.LoadMETMin) }
				</span>
			</div>
			<ul class="mt-2 space-y-1.5">
				for _, route := range day.Routes {
					<li class="flex flex-wrap items-center gap-2">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px]"}) {
							{ route.Sport }
						}
						<span class="truncate text-xs">{ route.Name }</span>
						<span class="text-muted-foreground font-mono text-[11px]">
							{ routeSummary(route) }
						</span>
					</li>
				}
			</ul>
		</button>
	</li>
}

// stripTail is where the next page of weeks arrives.
//
// The scene asks for this over HTMX as it travels, so the rows exist in one
// .templ file and are never re-implemented in a client template. It is also
// the whole keyboard route into the past: the camera is driven by dragging,
// which has no keyboard equivalent, so without this button older weeks would
// be unreachable without a pointer.
templ stripTail(page strava.TerrainPage) {
	<div id="activity-strip-tail" class="mt-6">
		if page.HasOlder && len(page.Weeks) > 0 {
			<a
				href={ templ.SafeURL(olderURL(page)) }
				class="text-sm font-medium hover:underline"
				hx-get={ olderURL(page) }
				hx-target="#activity-strip-tail"
				hx-swap="outerHTML"
				hx-select="#activity-strip-tail"
				x-on:htmx:after-swap.window="onOlderWeeks()"
			>
				Load earlier weeks
			</a>
		} else if page.OldestAt != nil {
			@ui.MonoLabel(fmt.Sprintf("Nothing recorded before %s", page.OldestAt.Format("2 January 2006")))
		} else {
			@ui.MonoLabel("That is the whole record")
		}
	</div>
}

// The legend walks strava.Families, so it cannot show a swatch for a family
// the server does not know about, or quietly omit one it does.
//
// The swatch classes are written out rather than built from the family name.
// Tailwind finds a utility by scanning source text for the literal string, so
// "bg-sport-" + family compiles fine and renders unstyled — a failure with no
// build error and nothing to grep for.
templ legend() {
	<div class="mt-4 flex flex-wrap items-center gap-3">
		for _, f := range strava.Families {
			@legendKey(f.Label(), sportSwatch(f))
		}
	</div>
}

// sportSwatch is the Tailwind class for a family's colour. The colours live in
// web/assets/css/input.css as --north-sport-* tokens, which the scene reads
// too; web/fitness/palette_test.go asserts the three stay in step.
func sportSwatch(f strava.SportFamily) string {
	switch f {
	case strava.FamilyRun:
		return "bg-sport-run"
	case strava.FamilyRide:
		return "bg-sport-ride"
	case strava.FamilySwim:
		return "bg-sport-swim"
	case strava.FamilyWalk:
		return "bg-sport-walk"
	case strava.FamilyStrength:
		return "bg-sport-strength"
	default:
		return "bg-sport-other"
	}
}

templ legendKey(name string, swatch string) {
	<span class="flex items-center gap-1.5">
		<span class={ "size-2 rounded-[2px]", swatch }></span>
		<span class="text-muted-foreground font-mono text-[10px] uppercase tracking-[0.14em]">{ name }</span>
	</span>
}

var activitiesScriptOnce = templ.NewOnceHandle()

// activitiesBehaviour loads the page script.
//
// Deliberately not deferred, for the reason the landing page states: Alpine is
// deferred from the head, and a deferred script runs after the parser finishes
// — by which point Alpine has already dispatched alpine:init. Loading this
// synchronously at the end of the body registers the component before that
// event. It blocks nothing; the document is parsed by then.
//
// Routed through utils.ScriptURL so a rebuild is picked up despite the
// immutable cache header in production. The old tag did not do this, which
// meant the ?v= that alpine.js forwards to its dynamic import was always
// absent and the scene module was never busted at all.
templ activitiesBehaviour() {
	@activitiesScriptOnce.Once() {
		if nonce := templ.GetNonce(ctx); nonce != "" {
			<script nonce={ nonce } src={ activitiesScriptURL() }></script>
		} else {
			<script src={ activitiesScriptURL() }></script>
		}
	}
}

func activitiesScriptURL() string {
	return utils.ScriptURL("/assets/js/shared/strava-activities/alpine.js")
}
