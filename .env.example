# Copy to .env for local development. Never commit .env.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
GO_ENV=development
PORT=8090
# Used to build absolute URLs (OAuth callbacks, signed links, emails).
BASE_URL=http://localhost:8090
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://north:north@localhost:5434/north?sslmode=disable

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# How long a session stays valid without activity.
SESSION_LIFETIME=720h

# ---------------------------------------------------------------------------
# Google OAuth (optional — leave empty to hide "Continue with Google")
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# WebAuthn / passkeys
# ---------------------------------------------------------------------------
# Relying Party ID must be the hostname only (localhost, or example.com).
# Not a URL. Leave empty to use the host of BASE_URL. Do not put a comment
# on this line — godotenv treats everything after = as the value.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_DISPLAY_NAME=North

# ---------------------------------------------------------------------------
# Telegram (optional — leave empty to disable messaging entirely)
# ---------------------------------------------------------------------------
# One brain, many mouths: a Telegram message reaches the same CoachService the
# web chat does, in the same conversation thread.
#
# Step-by-step setup — creating the bot, choosing polling vs webhook, and
# linking an account — is in README.md under "Setting up Telegram".
#
# A chat is bound to an account with a one-time code from
# Settings -> Connected apps. An unlinked chat can do nothing else — it never
# reaches the coach, so finding the bot buys a stranger nothing.
TELEGRAM_BOT_TOKEN=
# Shown in Settings so people can find the bot. Cosmetic; with or without the @.
TELEGRAM_BOT_USERNAME=

# How updates arrive, and the two modes are mutually exclusive per bot.
#
#   empty -> long polling. Needs nothing but an outbound connection, so this is
#            the only mode that works on localhost. Leave it empty for dev.
#   set   -> webhook at {BASE_URL}/webhooks/telegram. Needs a public HTTPS URL,
#            and the secret is the only thing separating a real delivery from
#            anyone who guesses the path, so it is required rather than
#            optional. Register it once:
#
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url="$BASE_URL/webhooks/telegram" \
#     -d secret_token="$TELEGRAM_WEBHOOK_SECRET"
#
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Providers are tried in order, most preferred first. When one refuses because
# it is out of credit, rate limited, overloaded, or its key is rejected, the
# next one answers and the user sees nothing. Anything else — a malformed
# request — fails immediately, because it would fail everywhere.
#
# Known names: gemini | openrouter | nvidia | xai | hermes | fake
# A name whose credentials are absent is skipped, so one chain can be shared
# between a laptop with two keys and a deployment with five.
AI_PROVIDER_CHAIN=openrouter,hermes,nvidia

# The chain for users on the free tier (users.tier = 'free'). Defaults to
# AI_PROVIDER_CHAIN when unset. NVIDIA's free models and the self-hosted Hermes
# cost nothing per token, which is the point.
AI_PROVIDER_CHAIN_FREE=nvidia,hermes

# The older single-provider form. Still honoured as a one-element chain when
# AI_PROVIDER_CHAIN is unset.
# AI_PROVIDER=gemini

# Override the model for whichever provider answers. Usually left empty so each
# provider uses its own model below — a single name here cannot be right for
# five different vendors.
AI_MODEL=
AI_FAST_MODEL=

# Form video analysis needs a provider with a real file upload API, which the
# OpenAI-dialect backends do not have. Not part of the chain: there is nothing
# useful to fall back to.
AI_UPLOAD_PROVIDER=gemini

# --- Providers -------------------------------------------------------------
# Each is enabled by its API key. Model IDs change; check the vendor's model
# list rather than trusting these defaults.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Sent as OpenRouter's ranking headers. Optional.
OPENROUTER_SITE_URL=http://localhost:8090
OPENROUTER_SITE_NAME=North

# https://build.nvidia.com — a free tier with credits, which is why it is the
# head of the free-tier chain.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Self-hosted Hermes gateway, reached over the tailnet. No default base URL:
# there is no public address to fall back on. The key is the gateway's
# API_SERVER_KEY on the VPS (not a Hermes chat login).
#
# From a laptop already joined to the same tailnet this is just MagicDNS —
# no Kubernetes SNAT, no extra tunnel. Confirm health before putting it
# in the chain:
#
#   curl -s http://hermes-vps-2.tail562587.ts.net:8642/health
#   curl -s -H "Authorization: Bearer $HERMES_API_KEY" \
#     http://hermes-vps-2.tail562587.ts.net:8642/v1/models
#
# Then:
#   HERMES_BASE_URL=http://hermes-vps-2.tail562587.ts.net:8642/v1
#   AI_PROVIDER_CHAIN=hermes,fake
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MODEL=hermes-3

# ---------------------------------------------------------------------------
# AI Observability (PostHog)
# ---------------------------------------------------------------------------
# Reports the coach's LLM calls to PostHog as a session -> trace -> generation
# tree. Optional: empty in production just means no events; empty in
# development fails the boot, so a missing key is caught at start-up rather
# than by an empty dashboard.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3 or Cloudflare R2 in production)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=north-media
STORAGE_ACCESS_KEY=north
STORAGE_SECRET_KEY=northnorth
# MinIO needs path-style addressing; S3 and R2 do not.
STORAGE_USE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# MCP server (cmd/mcp-server)
# ---------------------------------------------------------------------------
# Exposes North's coaching capabilities as MCP tools, so Hermes or any other
# agent can use them. See skills/north-connect/SKILL.md.
#
# SECURITY: one static token maps to one account, with no scopes and no way to
# act as anyone else. Anyone holding the token has full read and write access to
# that user's coaching data. Keep it on the tailnet or loopback — never expose
# this port publicly. The default listen address is loopback for that reason.
MCP_LISTEN_ADDR=127.0.0.1:8093
MCP_API_TOKEN=
MCP_USER_ID=

# --- Semantic retrieval (optional) ---------------------------------------
# Off unless both PROVIDER and MODEL are set. With them unset North retrieves
# by full text alone, which is a complete feature rather than a degraded one.
#
# The provider must be an OpenAI-dialect backend that serves /embeddings.
# NVIDIA NIM does; OpenRouter and xAI do not.
#
# DIMENSIONS must be 1024 — the width of the chunk_embeddings column. A model
# of another width needs a migration, and startup refuses rather than failing
# midway through somebody's reindex.
# EMBEDDING_PROVIDER=nvidia
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_DIMENSIONS=1024

# --- MCP hardening --------------------------------------------------------
# Browser origins allowed to reach /mcp, comma separated. Empty rejects every
# browser, which is correct: real MCP clients send no Origin header at all.
# MCP_ALLOWED_ORIGINS=
# Calls per minute, per account. Default 120.
# MCP_REQUESTS_PER_MINUTE=120

# --- Per-account quotas ---------------------------------------------------
# Bounds on the actions that cost money or real work, counted per account per
# hour in the quota_counters table. Every one has a working default, so leaving
# this whole block commented out is a supported configuration.
#
# Per hour rather than per minute because these are human actions with bursty
# shapes: three coach messages in a row is somebody thinking out loud.
#
# Exceeding a limit returns 429 with a Retry-After header and a panel that says
# when the budget returns — never a 500, and nothing is lost.
#
# Two operational notes:
#
#   * Zero, or a variable you misspelled, means "use the default" rather than
#     "refuse everything". A guarded route can never be taken offline by its
#     own configuration.
#   * If the database cannot be reached the check fails open: the request goes
#     through and the reason is logged. The limiter must not be able to take
#     the application down with it.
#
# These are separate from MCP_REQUESTS_PER_MINUTE and the health ingest bounds,
# which are in-memory and per process because they guard cheap requests behind
# a bearer token. These count in Postgres, so they stay correct across replicas.
# QUOTA_COACH_MESSAGES_PER_HOUR=30
# QUOTA_DOCUMENT_UPLOADS_PER_HOUR=60
# QUOTA_DOCUMENT_REINDEX_PER_HOUR=10
# QUOTA_REPORT_GENERATIONS_PER_HOUR=10
# QUOTA_MEDIA_ANALYSES_PER_HOUR=20

# --- Encryption at rest ---------------------------------------------------
# Seals user-supplied secrets — today, the API key someone brings for their own
# AI provider. Unset means those features report themselves unavailable rather
# than storing a credential in the clear; set but malformed fails the boot.
#
#   openssl rand -base64 32
#
# Rotation: put the new key first with a higher id, redeploy, then drop the old
# one once nothing is stamped with it.
#
#   ENCRYPTION_KEY=2:<new base64 32 bytes>,1:<old base64 32 bytes>
#
# ENCRYPTION_KEY=

# --- Grounding evals ------------------------------------------------------
# Read only by `task test:live`, never by the running application. They choose
# which real model the grounding evals are graded against; see the Testing
# section of the README for what the evals assert.
#
# The offline tier (`task test:eval`) needs none of this — it runs on every
# push with no key and no database.
#
# Each provider reads its own key, and an eval skips rather than fails when the
# key is missing, so one key is enough to run the evals it can pay for:
#
#   gemini      GEMINI_API_KEY       (the default)
#   openrouter  OPENROUTER_API_KEY   OPENROUTER_BASE_URL
#   nvidia      NVIDIA_API_KEY       NVIDIA_BASE_URL
#   xai         XAI_API_KEY          XAI_BASE_URL
#   hermes      HERMES_API_KEY       HERMES_BASE_URL  (no default; unset skips)
#
# EVAL_PROVIDER=gemini
# EVAL_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Metrics (Prometheus)
# ---------------------------------------------------------------------------
# Where Prometheus scrapes. Its own listener, not a route on the public server:
# request rates, model spend, and job failure counts describe the business to
# anyone who can reach them. /healthz is public because it answers one bit;
# this answers rather more.
#
# Loopback by default. Point a scraper at it over the tailnet, or bind it wider
# only behind something that authenticates. Empty turns the listener off, and
# with it the counting — a process with no listener collects nothing rather
# than filling memory with numbers nobody reads.
#
# Both cmd/web and cmd/worker read this. They are separate processes, so give
# them different ports when running both on one host.
METRICS_LISTEN_ADDR=127.0.0.1:9090
